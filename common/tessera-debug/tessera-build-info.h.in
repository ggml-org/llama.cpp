// tessera-build-info.h
//
// Auto-generated by CMake at configure time. The values are baked into
// the binary at compile time, so a sidecar's provenance can record
// the exact branch and commit used to build the dump tool without
// requiring an out-of-band config. The fallback values ("unknown" for
// both) are used when Git is not present at configure time, which is
// the case for release tarball builds.

#pragma once

#define TESSERA_KERNEL_VERSION "@TESSERA_KERNEL_VERSION@"
#define TESSERA_MAIN_TIP        "@TESSERA_MAIN_TIP@"
