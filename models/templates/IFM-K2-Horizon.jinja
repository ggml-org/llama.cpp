{%- if type_name == "array" -%}
array of {% if 'items' in spec %}{{ render_markdown_type(spec['items']) }}{% else %}any{% endif %}
{%- elif type_name -%}
{{- type_name -}}
{%- else -%}
any
{%- endif -%}
