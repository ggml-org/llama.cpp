@@ -0,0 +1,55 @@
+package com.m5.offline;
+
+import java.io.DataInputStream;
+import java.io.DataOutputStream;
+import java.io.IOException;
+import java.nio.ByteBuffer;
+import java.nio.ByteOrder;
+import java.nio.FloatBuffer;
+import java.util.List;
+
+final class NativeBackbone implements AutoCloseable {
+    private static final int WIDTH = 512;
+    private final Process process;
+    private final DataOutputStream input;
+    private final DataInputStream output;
+    private final byte[] response = new byte[WIDTH * Float.BYTES];
+
+    NativeBackbone(List<String> command) throws IOException {
+        process = new ProcessBuilder(command).redirectError(ProcessBuilder.Redirect.INHERIT).start();
+        input = new DataOutputStream(process.getOutputStream());
+        output = new DataInputStream(process.getInputStream());
+    }
+
+    void reset() throws IOException { input.writeInt(0); }
+
+    void run(FloatBuffer hidden, FloatBuffer result) throws IOException {
+        FloatBuffer source = hidden.duplicate();
+        if (source.remaining() == 0 || source.remaining() % WIDTH != 0) {
+            throw new IOException("Invalid native backbone input size");
+        }
+        int rows = source.remaining() / WIDTH;
+        ByteBuffer payload = ByteBuffer.allocate(source.remaining() * Float.BYTES).order(ByteOrder.LITTLE_ENDIAN);
+        payload.asFloatBuffer().put(source);
+        input.writeInt(Integer.reverseBytes(rows));
+        input.write(payload.array());
+        input.flush();
+        output.readFully(response);
+        result.clear();
+        result.put(ByteBuffer.wrap(response).order(ByteOrder.LITTLE_ENDIAN).asFloatBuffer());
+        result.flip();
+    }
+
+    @Override
+    public void close() throws IOException {
+        try {
+            input.close();
+        } finally {
+            try {
+                output.close();
+            } finally {
+                process.destroy();
+            }
+        }
+    }
+}
