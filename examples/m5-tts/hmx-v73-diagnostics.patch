diff --git a/ggml/src/ggml-hexagon/htp/hmx-mm-kernels-tiled.h b/ggml/src/ggml-hexagon/htp/hmx-mm-kernels-tiled.h
index a828012dd..550d2fa5f 100644
--- a/ggml/src/ggml-hexagon/htp/hmx-mm-kernels-tiled.h
+++ b/ggml/src/ggml-hexagon/htp/hmx-mm-kernels-tiled.h
@@ -1092,6 +1092,23 @@ static void core_dot_chunk_fp16_short(__fp16 *restrict output, const __fp16 *res
 static void core_dot_chunk_fp16(__fp16 *restrict output, const __fp16 *restrict activation,
                           const __fp16 *restrict weight, const __fp16 *restrict scales,
                           uint32_t n_row_tiles, uint32_t n_col_tiles, uint32_t n_dot_tiles) {
+#if __HEXAGON_ARCH__ == 73
+    asm volatile(HMX_SET_BIAS("%0") :: "r"((unsigned int)scales));
+    const size_t stride = n_dot_tiles * HTP_MM_HMX_TILE_N_ELMS;
+    for (uint32_t r = 0; r < n_row_tiles; ++r) {
+        for (uint32_t c = 0; c < n_col_tiles; ++c) {
+            asm volatile(HMX_CLRACC_F16());
+            for (uint32_t k = 0; k < n_dot_tiles; ++k) {
+                const __fp16 * a = activation + r * stride + k * HTP_MM_HMX_TILE_N_ELMS;
+                const __fp16 * b = weight + c * stride + k * HTP_MM_HMX_TILE_N_ELMS;
+                asm volatile(HMX_LOAD_MPY_F16("%0", "%1", "%2") :: "r"(a), "r"(b), "r"(2047));
+            }
+            __fp16 * out = output + (r * n_col_tiles + c) * HTP_MM_HMX_TILE_N_ELMS;
+            asm volatile(HMX_STORE_AFTER_F16("%0", "%1") :: "r"(out), "r"(0) : "memory");
+        }
+    }
+    return;
+#endif
     if (n_dot_tiles <= 32) {
         core_dot_chunk_fp16_short(output, activation, weight, scales, n_row_tiles, n_col_tiles, n_dot_tiles);
         return;
diff --git a/ggml/src/ggml-hexagon/htp/hmx-queue.c b/ggml/src/ggml-hexagon/htp/hmx-queue.c
