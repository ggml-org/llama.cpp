--- a/ggml/src/ggml-hexagon/htp/hmx-queue.c
+++ b/ggml/src/ggml-hexagon/htp/hmx-queue.c
@@ -17,7 +17,9 @@
 static inline void hmx_lock(hmx_queue_t q)
 {
     if (!q->hmx_locked) {
-        HAP_compute_res_hmx_lock(q->hap_rctx);
+        const int result = HAP_compute_res_hmx_lock(q->hap_rctx);
+        FARF(ERROR, "M5 HMX lock result %d context %u", result, q->hap_rctx);
+        if (result != 0) abort();
         q->hmx_locked = true;
     }
 }
diff --git a/ggml/src/ggml-hexagon/htp/matmul-ops.c b/ggml/src/ggml-hexagon/htp/matmul-ops.c
index 2d0750954..2ce585ba5 100644
--- a/ggml/src/ggml-hexagon/htp/matmul-ops.c
+++ b/ggml/src/ggml-hexagon/htp/matmul-ops.c
@@ -2587,6 +2587,20 @@ static void hmx_matmul_worker_fn(const htp_thread_t * th, void * data) {
     hmx_matmul_job_t * job = (hmx_matmul_job_t *) data;
     FARF(HIGH, "hmx-mm-job: n_row_tiles %u n_col_tiles %u n_dot_tiles %u", job->n_row_tiles, job->n_col_tiles, job->n_dot_tiles);
     core_dot_chunk_fp16(job->output, job->activation, job->weight, job->scales, job->n_row_tiles, job->n_col_tiles, job->n_dot_tiles);
+    // Diagnostic only: check the first input and output tiles.
+    const volatile uint16_t * a = (const volatile uint16_t *) job->activation;
+    const volatile uint16_t * b = (const volatile uint16_t *) job->weight;
+    const volatile uint16_t * y = (const volatile uint16_t *) job->output;
+    unsigned na = 0, nb = 0, ny = 0;
+    for (unsigned i = 0; i < HTP_MM_HMX_TILE_N_ELMS; ++i) {
+        na += (a[i] & 0x7fff) != 0;
+        nb += (b[i] & 0x7fff) != 0;
+        ny += (y[i] & 0x7fff) != 0;
+    }
+    FARF(ALWAYS, "M5 HMX tiles %u %u %u", na, nb, ny);
+    if (!na || !nb) abort();
+    if (ny) abort();
+
 }
 
