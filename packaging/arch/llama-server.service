[Unit]
Description=llama.cpp server (TurboQuant+ SYCL fork)
After=syslog.target network.target local-fs.target remote-fs.target nss-lookup.target

[Service]
Type=simple
EnvironmentFile=/etc/conf.d/llama-server
ExecStart=/usr/bin/llama-server $LLAMA_ARGS
# No ExecReload: llama-server handles only SIGINT/SIGTERM (tools/server/server.cpp),
# so SIGHUP would terminate it, and systemd counts a SIGHUP exit as clean, which
# Restart=on-failure does not recover from. Use `systemctl restart` instead.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
