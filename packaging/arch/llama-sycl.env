# Example systemd drop-in enabling SYCL graph capture at runtime.
#
# GGML_SYCL_GRAPH=ON is compiled in by this package's PKGBUILD, but the feature
# stays inert unless GGML_SYCL_ENABLE_GRAPH=1 is also set at runtime (default 0).
# See docs/research/ for this fork's turbo-KV notes; graph capture itself only
# benefits batch-1 decode by amortizing per-op launch overhead, and has not been
# benchmarked end-to-end on this fork (see PR #58's review discussion).
#
# Install as a systemd override:
#   sudo cp sycl-graph.conf.example /etc/systemd/system/llama-server.service.d/sycl-graph.conf
#   sudo systemctl daemon-reload
#   sudo systemctl restart llama-server
#
# Or apply interactively:
#   systemctl edit llama-server.service

[Service]
Environment=GGML_SYCL_ENABLE_GRAPH=1
