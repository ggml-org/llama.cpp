// TEST: javascript
// DESC: promise-based async queue with concurrency limit
// EXPECT: accept_all
class AsyncQueue {
    constructor(concurrency = 4) {
        this.concurrency = concurrency;
        this.running = 0;
        this.queue = [];
    }

    add(task) {
        return new Promise((resolve, reject) => {
            this.queue.push({ task, resolve, reject });
            this._runNext();
        });
    }

    _runNext() {
        if (this.running >= this.concurrency || this.queue.length === 0) {
            return;
        }
        const { task, resolve, reject } = this.queue.shift();
        this.running++;
        Promise.resolve()
            .then(() => task())
            .then(resolve, reject)
            .finally(() => {
                this.running--;
                this._runNext();
            });
    }

    get size() {
        return this.queue.length;
    }

    get active() {
        return this.running;
    }

    async drain() {
        while (this.queue.length > 0 || this.running > 0) {
            await new Promise((resolve) => setTimeout(resolve, 10));
        }
    }
}

async function fetchMock(url, delay = 100) {
    return new Promise((resolve) => {
        setTimeout(() => resolve({ url, status: 200, body: `response from ${url}` }), delay);
    });
}

async function main() {
    const queue = new AsyncQueue(3);
    const urls = [
        "https://api.example.com/1",
        "https://api.example.com/2",
        "https://api.example.com/3",
        "https://api.example.com/4",
        "https://api.example.com/5",
        "https://api.example.com/6",
    ];
    const results = await Promise.all(
        urls.map((url) => queue.add(() => fetchMock(url, 50)))
    );
    for (const r of results) {
        console.log(`${r.url} -> ${r.status}`);
    }
}

main().catch(console.error);
