#!/usr/bin/env python3
from __future__ import annotations

import json
import os
from pathlib import Path
import re
import readline
import shlex
import shutil
import signal
import subprocess
import sys

REPO = Path(os.environ.get("SUMMER_REPO", str(Path.home() / "Summer.cpp"))).expanduser()
MODEL_DIR = Path(os.environ.get("SUMMER_MODEL_DIR", str(Path.home() / "models"))).expanduser()
CONFIG_DIR = Path.home() / ".config/summer"
CONFIG_FILE = CONFIG_DIR / "config.json"
DATA_DIR = Path.home() / ".local/share/summer"
HISTORY_FILE = DATA_DIR / "command_history"
DEFAULT_MODEL = MODEL_DIR / "Qwen3.6-35B-A3B-UD-IQ1_M.gguf"
DEFAULTS = {
    "model": str(DEFAULT_MODEL),
    "vram_mib": 3800,
    "dram_mib": 6500,
    "max_tokens": 256,
    "python_timeout": 15,
}
MAX_TURNS = 8
SYSTEM_PROMPT = """あなたの名前はSummerです。
日本語を中心に、明確で自然な回答をしてください。
分からないことは推測せず、分からないと伝えてください。
回答だけを出力し、内部思考やthinkingタグは表示しないでください。"""

COLOR = sys.stdout.isatty() and os.environ.get("NO_COLOR") is None


def c(code: str) -> str:
    return f"\033[{code}m" if COLOR else ""


RESET, BOLD, DIM = c("0"), c("1"), c("2")
BLUE, PURPLE, CYAN = c("38;5;75"), c("38;5;141"), c("38;5;45")
GREEN, YELLOW, RED, GRAY = c("38;5;84"), c("38;5;220"), c("38;5;203"), c("38;5;244")


def binary_path() -> Path:
    override = os.environ.get("SUMMER_BINARY")
    if override:
        return Path(override).expanduser()
    installed = Path.home() / ".local/bin/llama-tiered"
    return installed if installed.is_file() else REPO / "build/bin/llama-tiered"


def load_config() -> dict[str, object]:
    config = dict(DEFAULTS)
    try:
        value = json.loads(CONFIG_FILE.read_text(encoding="utf-8"))
        if isinstance(value, dict):
            config.update(value)
    except (OSError, json.JSONDecodeError):
        pass
    return config


def save_config(config: dict[str, object]) -> None:
    CONFIG_DIR.mkdir(parents=True, exist_ok=True)
    tmp = CONFIG_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(config, ensure_ascii=False, indent=2) + "\n", encoding="utf-8")
    tmp.replace(CONFIG_FILE)


def setup_history() -> None:
    DATA_DIR.mkdir(parents=True, exist_ok=True)
    try:
        readline.read_history_file(HISTORY_FILE)
    except FileNotFoundError:
        pass
    readline.set_history_length(500)


def save_history() -> None:
    try:
        readline.write_history_file(HISTORY_FILE)
    except OSError:
        pass


def models() -> list[Path]:
    if not MODEL_DIR.is_dir():
        return []
    return sorted((p for p in MODEL_DIR.rglob("*.gguf") if p.is_file()), key=lambda p: p.name.lower())


def resolve_model(text: str) -> Path | None:
    available = models()
    if text.isdigit():
        index = int(text) - 1
        return available[index] if 0 <= index < len(available) else None
    candidate = Path(text).expanduser()
    for path in (candidate, MODEL_DIR / candidate):
        if path.is_file() and path.suffix.lower() == ".gguf":
            return path.resolve()
    matches = [p for p in available if text.lower() in p.name.lower()]
    return matches[0] if len(matches) == 1 else None


def choose_initial_model(config: dict[str, object]) -> Path:
    selected = Path(str(config["model"])).expanduser()
    if selected.is_file():
        return selected
    if DEFAULT_MODEL.is_file():
        selected = DEFAULT_MODEL
    else:
        available = models()
        selected = available[0] if available else DEFAULT_MODEL
    config["model"] = str(selected)
    save_config(config)
    return selected


def banner(model: Path) -> None:
    width = min(64, max(52, shutil.get_terminal_size((80, 24)).columns - 2))
    inner = width - 2
    label = model.name if len(model.name) <= inner - 2 else model.name[: inner - 3] + "…"
    print(f"{PURPLE}╭{'─' * inner}╮{RESET}")
    print(f"{PURPLE}│{RESET}{BOLD}{CYAN}{' Summer.CPP '.center(inner)}{RESET}{PURPLE}│{RESET}")
    print(f"{PURPLE}│{RESET}{DIM}{'streaming local AI chat'.center(inner)}{RESET}{PURPLE}│{RESET}")
    print(f"{PURPLE}│{RESET}{GRAY}{label.center(inner)}{RESET}{PURPLE}│{RESET}")
    print(f"{PURPLE}╰{'─' * inner}╯{RESET}")
    print(f"{DIM}/help  /models  /model  /py  /runlast  /clear  /exit{RESET}\n")


def build_prompt(history: list[tuple[str, str]], message: str) -> str:
    lines = [SYSTEM_PROMPT, "", "以下はユーザーとSummerの会話です。", ""]
    for role, text in history[-MAX_TURNS * 2 :]:
        lines.append(f"{'ユーザー' if role == 'user' else 'Summer'}: {text}")
    lines += [f"ユーザー: {message}", "Summer:"]
    return "\n".join(lines)


class ThinkFilter:
    def __init__(self) -> None:
        self.hidden = False
        self.pending = ""

    def feed(self, data: str, emit) -> None:
        self.pending += data
        while self.pending:
            tag = "</think>" if self.hidden else "<think>"
            pos = self.pending.lower().find(tag)
            if pos >= 0:
                if not self.hidden:
                    emit(self.pending[:pos])
                self.pending = self.pending[pos + len(tag) :]
                self.hidden = not self.hidden
                continue
            keep = 0
            for n in range(min(len(self.pending), len(tag) - 1), 0, -1):
                if self.pending[-n:].lower() == tag[:n]:
                    keep = n
                    break
            body = self.pending[:-keep] if keep else self.pending
            if not self.hidden:
                emit(body)
            self.pending = self.pending[-keep:] if keep else ""
            break

    def finish(self, emit) -> None:
        if not self.hidden:
            emit(self.pending)
        self.pending = ""


def run_model(prompt: str, model: Path, config: dict[str, object], debug: bool) -> tuple[int, str]:
    binary = binary_path()
    command = [
        str(binary), "-m", str(model),
        "--vram-mib", str(config["vram_mib"]),
        "--dram-mib", str(config["dram_mib"]),
        "-n", str(config["max_tokens"]), prompt,
    ]
    if shutil.which("stdbuf"):
        command = ["stdbuf", "-o0", "-e0", *command]

    print(f"{DIM}Summer.CPP is loading…{RESET}", end="\r", flush=True)
    process: subprocess.Popen[str] | None = None
    parts: list[str] = []
    started = False
    probe = ""
    decided = False
    filter_ = ThinkFilter()

    def emit(text: str) -> None:
        nonlocal started
        if not text:
            return
        if not started:
            text = text.lstrip()
            if not text:
                return
            print(" " * 80, end="\r")
            print(f"{BOLD}{PURPLE}Summer.CPP ❯{RESET} ", end="", flush=True)
            started = True
        print(text, end="", flush=True)
        parts.append(text)

    try:
        process = subprocess.Popen(
            command, cwd=REPO if REPO.is_dir() else Path.home(),
            stdout=subprocess.PIPE,
            stderr=None if debug else subprocess.DEVNULL,
            text=True, encoding="utf-8", errors="replace", bufsize=0,
        )
        assert process.stdout is not None
        while True:
            ch = process.stdout.read(1)
            if ch == "":
                break
            if not decided:
                probe += ch
                candidate = probe.lstrip("\r\n")
                if prompt.startswith(candidate):
                    continue
                if candidate.startswith(prompt):
                    decided = True
                    filter_.feed(candidate[len(prompt):], emit)
                    probe = ""
                    continue
                decided = True
                filter_.feed(probe, emit)
                probe = ""
                continue
            filter_.feed(ch, emit)
        if probe:
            candidate = probe.lstrip("\r\n")
            filter_.feed(candidate[len(prompt):] if candidate.startswith(prompt) else candidate, emit)
        filter_.finish(emit)
        code = process.wait()
    except KeyboardInterrupt:
        if process is not None:
            process.send_signal(signal.SIGINT)
        code = 130
    finally:
        print(" " * 80, end="\r")
        if started:
            print()

    answer = "".join(parts).strip()
    answer = re.split(r"\n\s*(?:ユーザー|User)\s*:", answer, maxsplit=1, flags=re.I)[0].strip()
    answer = re.sub(r"^\s*(?:Summer|Assistant|アシスタント)\s*:\s*", "", answer, flags=re.I)
    return code, answer


def run_python(code: str, timeout: int) -> None:
    print(f"{GRAY}{'─' * 60}{RESET}")
    try:
        result = subprocess.run(
            [sys.executable, "-u", "-c", code], cwd=REPO if REPO.is_dir() else Path.home(),
            capture_output=True, text=True, timeout=timeout, check=False,
        )
    except subprocess.TimeoutExpired:
        print(f"{RED}Pythonを{timeout}秒で停止しました。{RESET}\n")
        return
    if result.stdout:
        print(result.stdout, end="" if result.stdout.endswith("\n") else "\n")
    if result.stderr:
        print(f"{RED}{result.stderr}{RESET}", end="" if result.stderr.endswith("\n") else "\n")
    if not result.stdout and not result.stderr:
        print(f"{DIM}(出力なし){RESET}")
    print(f"{GRAY}{'─' * 60}{RESET}\nexit code: {result.returncode}\n")


def multiline_python() -> str:
    print(f"{DIM}単独の .end で実行します。{RESET}")
    lines: list[str] = []
    while True:
        line = input(f"{YELLOW}py …{RESET} ")
        if line.strip() == ".end":
            return "\n".join(lines)
        lines.append(line)


def help_text() -> None:
    print("""/models              GGUF一覧
/model               現在のモデル
/model N|NAME|PATH   モデル変更
/tokens N            最大生成token数
/py CODE             Python実行
/py                  複数行Python
/pyfile PATH         Python file実行
/runlast             直前回答のPython blockを確認後実行
/pytimeout N         Python timeout
/debug on|off        llama.cpp log切替
/history             会話履歴
/clear               会話履歴消去
/about               現在の設定
/exit                終了
""")


def main() -> int:
    setup_history()
    config = load_config()
    model = choose_initial_model(config)
    history: list[tuple[str, str]] = []
    debug = False
    banner(model)

    binary = binary_path()
    if not binary.is_file():
        print(f"{RED}llama-tieredが見つかりません: {binary}{RESET}")
        return 1
    if not model.is_file():
        print(f"{RED}GGUFが見つかりません。{MODEL_DIR}へ配置してください。{RESET}")
        return 1

    while True:
        try:
            message = input(f"{BOLD}{BLUE}you ❯{RESET} ").strip()
        except EOFError:
            break
        except KeyboardInterrupt:
            print()
            continue
        if not message:
            continue
        try:
            args = shlex.split(message)
        except ValueError as error:
            print(f"{RED}{error}{RESET}")
            continue
        command = args[0].lower()

        if command in {"/exit", "/quit", "/q"}:
            break
        if command == "/help":
            help_text()
            continue
        if command == "/clear":
            history.clear()
            print("\033[2J\033[H", end="")
            banner(model)
            continue
        if command == "/models":
            for i, item in enumerate(models(), 1):
                mark = "●" if item.resolve() == model.resolve() else " "
                print(f"{mark} {i:>2}. {item.name} ({item.stat().st_size / 1024**3:.2f} GiB)")
            print()
            continue
        if command == "/model":
            if len(args) == 1:
                print(f"{model}\n")
                continue
            selected = resolve_model(" ".join(args[1:]))
            if selected is None:
                print(f"{RED}モデルを特定できません。/modelsで確認してください。{RESET}\n")
                continue
            model = selected
            config["model"] = str(model)
            save_config(config)
            history.clear()
            print(f"{GREEN}model: {model.name}{RESET}\n")
            continue
        if command == "/tokens":
            if len(args) != 2 or not args[1].isdigit() or not 16 <= int(args[1]) <= 4096:
                print("使い方: /tokens 256\n")
                continue
            config["max_tokens"] = int(args[1])
            save_config(config)
            print()
            continue
        if command == "/pytimeout":
            if len(args) != 2 or not args[1].isdigit() or not 1 <= int(args[1]) <= 600:
                print("使い方: /pytimeout 15\n")
                continue
            config["python_timeout"] = int(args[1])
            save_config(config)
            print()
            continue
        if command == "/debug":
            if len(args) != 2 or args[1] not in {"on", "off"}:
                print("使い方: /debug on|off\n")
                continue
            debug = args[1] == "on"
            print(f"debug: {args[1]}\n")
            continue
        if command == "/history":
            for role, text in history:
                print(f"{'you' if role == 'user' else 'Summer.CPP'} ❯ {text}\n")
            continue
        if command == "/about":
            print(json.dumps({**config, "binary": str(binary), "repo": str(REPO)}, ensure_ascii=False, indent=2), "\n")
            continue
        if command == "/py":
            code = message[3:].lstrip() if len(message) > 3 else multiline_python()
            if code:
                run_python(code, int(config["python_timeout"]))
            continue
        if command == "/pyfile":
            if len(args) != 2:
                print("使い方: /pyfile script.py\n")
                continue
            path = Path(args[1]).expanduser()
            if not path.is_file():
                print(f"{RED}file not found: {path}{RESET}\n")
                continue
            run_python(path.read_text(encoding="utf-8"), int(config["python_timeout"]))
            continue
        if command == "/runlast":
            last = next((text for role, text in reversed(history) if role == "assistant"), "")
            blocks = re.findall(r"```(?:python|py)\s*\n(.*?)```", last, flags=re.S | re.I)
            if not blocks:
                print("Python code blockがありません。\n")
                continue
            code = "\n\n".join(block.strip() for block in blocks)
            print(f"{YELLOW}{code}{RESET}\n")
            if input("実行しますか? [y/N] ").strip().lower() in {"y", "yes"}:
                run_python(code, int(config["python_timeout"]))
            continue

        prompt = build_prompt(history, message)
        status, answer = run_model(prompt, model, config, debug)
        if status == 130:
            print(f"{YELLOW}中断しました。{RESET}\n")
            continue
        if status != 0 or not answer:
            print(f"{RED}実行に失敗しました。/debug onで確認してください。{RESET}\n")
            continue
        history += [("user", message), ("assistant", answer)]

    save_history()
    print(f"\n{DIM}またね。{RESET}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
