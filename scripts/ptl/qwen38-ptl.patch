diff --git a/scripts/ptl/bf16_to_q8.cpp b/scripts/ptl/bf16_to_q8.cpp
new file mode 100644
index 000000000..e497a6295
--- /dev/null
+++ b/scripts/ptl/bf16_to_q8.cpp
@@ -0,0 +1,145 @@
+// Rewrite one GGUF split: selected BF16 tensors become Q8_0, everything else is copied byte for byte.
+// Selected: blk.N.hc_{attn,ffn}_{down,up}.weight and blk.N.ffn_gate_inp.weight (2D, k multiple of 32).
+// usage: bf16_to_q8 --dry-run|--stats|--write IN.gguf [OUT.gguf]
+//   --dry-run: list what changes and the output size, reads no tensor data
+//   --stats:   also convert in memory and print the round trip error per tensor group, writes nothing
+//   --write:   write OUT.gguf, refuses to overwrite and checks free disk space first
+#include "ggml.h"
+#include "gguf.h"
+
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <map>
+#include <regex>
+#include <string>
+#include <sys/stat.h>
+#include <sys/statvfs.h>
+#include <vector>
+
+static bool selected(const std::string & name) {
+    static const std::regex re(R"(^blk\.\d+\.(hc_(attn|ffn)_(down|up)|ffn_gate_inp)\.weight$)");
+    return std::regex_match(name, re);
+}
+
+struct err_stat { double se = 0, sr = 0, max_abs = 0; size_t n = 0; };
+
+int main(int argc, char ** argv) {
+    if (argc < 3) { fprintf(stderr, "usage: %s --dry-run|--stats|--write IN.gguf [OUT.gguf]\n", argv[0]); return 1; }
+    const std::string mode = argv[1];
+    const bool write = mode == "--write", stats = mode == "--stats";
+    if (!write && !stats && mode != "--dry-run") { fprintf(stderr, "unknown mode\n"); return 1; }
+    if (write && argc < 4) { fprintf(stderr, "--write needs OUT.gguf\n"); return 1; }
+    const char * in_path = argv[2];
+    const char * out_path = write ? argv[3] : nullptr;
+
+    ggml_context * meta = nullptr;
+    gguf_init_params ip = { true, &meta };
+    gguf_context * in = gguf_init_from_file(in_path, ip);
+    if (!in) { fprintf(stderr, "cannot read %s\n", in_path); return 1; }
+    const size_t in_data = gguf_get_data_offset(in);
+
+    gguf_context * out = gguf_init_empty();
+    gguf_set_kv(out, in);
+    const int64_t n = gguf_get_n_tensors(in);
+    size_t n_conv = 0, bytes_before = 0, bytes_after = 0;
+    std::vector<bool> conv(n, false);
+    for (int64_t i = 0; i < n; i++) {
+        ggml_tensor * t = ggml_get_tensor(meta, gguf_get_tensor_name(in, i));
+        gguf_add_tensor(out, t);
+    }
+    for (int64_t i = 0; i < n; i++) {
+        const char * name = gguf_get_tensor_name(in, i);
+        ggml_tensor * t = ggml_get_tensor(meta, name);
+        if (!selected(name)) continue;
+        if (t->type != GGML_TYPE_BF16) { fprintf(stderr, "%s is %s, expected bf16\n", name, ggml_type_name(t->type)); return 1; }
+        if (t->ne[0] % ggml_blck_size(GGML_TYPE_Q8_0) != 0 || t->ne[2] != 1) { fprintf(stderr, "%s: bad shape\n", name); return 1; }
+        conv[i] = true;
+        n_conv++;
+        bytes_before += gguf_get_tensor_size(in, i);
+        gguf_set_tensor_type(out, name, GGML_TYPE_Q8_0);
+        bytes_after += ggml_row_size(GGML_TYPE_Q8_0, t->ne[0]) * t->ne[1];
+    }
+    size_t out_size = gguf_get_meta_size(out);
+    for (int64_t i = 0; i < n; i++) out_size += GGML_PAD(gguf_get_tensor_size(out, i), gguf_get_alignment(out));
+    printf("tensors %lld, converted %zu: %.3f GiB BF16 -> %.3f GiB Q8_0; output about %.2f GiB\n", (long long) n, n_conv,
+           bytes_before / 1073741824.0, bytes_after / 1073741824.0, out_size / 1073741824.0);
+    if (mode == "--dry-run") return 0;
+
+    FILE * fi = fopen(in_path, "rb");
+    if (!fi) { perror(in_path); return 1; }
+    FILE * fo = nullptr;
+    if (write) {
+        struct stat st;
+        if (stat(out_path, &st) == 0) { fprintf(stderr, "%s exists, not overwriting\n", out_path); return 1; }
+        std::string dir(out_path);
+        const size_t slash = dir.rfind('/');
+        dir = slash == std::string::npos ? "." : dir.substr(0, slash);
+        struct statvfs vfs;
+        if (statvfs(dir.c_str(), &vfs) != 0) { perror(dir.c_str()); return 1; }
+        const double free_b = (double) vfs.f_bavail * vfs.f_frsize;
+        if (free_b < out_size + 2.0 * (1ull << 30)) { fprintf(stderr, "not enough disk: %.1f GiB free\n", free_b / 1073741824.0); return 1; }
+        fo = fopen(out_path, "wb");
+        if (!fo) { perror(out_path); return 1; }
+        std::vector<uint8_t> m(gguf_get_meta_size(out));
+        gguf_get_meta_data(out, m.data());
+        fwrite(m.data(), 1, m.size(), fo);
+    }
+
+    std::map<std::string, err_stat> errs;
+    const std::regex group(R"(blk\.\d+\.)");
+    std::vector<uint8_t> src, dst, zeros(gguf_get_alignment(out), 0);
+    std::vector<float> f32, back;
+    for (int64_t i = 0; i < n; i++) {
+        const char * name = gguf_get_tensor_name(in, i);
+        ggml_tensor * t = ggml_get_tensor(meta, name);
+        if (!write && !conv[i]) continue;
+        const size_t in_size = gguf_get_tensor_size(in, i);
+        src.resize(in_size);
+        if (fseeko(fi, (off_t) (in_data + gguf_get_tensor_offset(in, i)), SEEK_SET) != 0 || fread(src.data(), 1, in_size, fi) != in_size) {
+            fprintf(stderr, "read failed: %s\n", name);
+            return 1;
+        }
+        const uint8_t * data = src.data();
+        size_t size = in_size;
+        if (conv[i]) {
+            const int64_t nx = t->ne[0], ny = t->ne[1], ne = nx * ny;
+            f32.resize(ne);
+            ggml_bf16_to_fp32_row((const ggml_bf16_t *) src.data(), f32.data(), ne);
+            size = ggml_row_size(GGML_TYPE_Q8_0, nx) * ny;
+            dst.resize(size);
+            const size_t got = ggml_quantize_chunk(GGML_TYPE_Q8_0, f32.data(), dst.data(), 0, ny, nx, nullptr);
+            if (got != size) { fprintf(stderr, "%s: size %zu != %zu\n", name, got, size); return 1; }
+            data = dst.data();
+            if (stats) {
+                back.resize(ne);
+                ggml_get_type_traits(GGML_TYPE_Q8_0)->to_float(dst.data(), back.data(), ne);
+                err_stat & e = errs[std::regex_replace(std::string(name), group, "blk.N.")];
+                for (int64_t j = 0; j < ne; j++) {
+                    const double d = (double) back[j] - f32[j];
+                    e.se += d * d;
+                    e.sr += (double) f32[j] * f32[j];
+                    e.max_abs = std::max(e.max_abs, std::fabs(d));
+                }
+                e.n += ne;
+            }
+        }
+        if (write) {
+            if (fwrite(data, 1, size, fo) != size) { fprintf(stderr, "write failed: %s\n", name); return 1; }
+            const size_t pad = GGML_PAD(size, gguf_get_alignment(out)) - size;
+            if (pad) fwrite(zeros.data(), 1, pad, fo);
+        }
+    }
+    for (const auto & kv : errs) {
+        const err_stat & e = kv.second;
+        printf("%-30s elements %11zu  NMSE %.3e  max abs %.4f  rms %.4f\n", kv.first.c_str(), e.n, e.sr > 0 ? e.se / e.sr : 0.0, e.max_abs, std::sqrt(e.sr / e.n));
+    }
+    fclose(fi);
+    if (fo && fclose(fo) != 0) { perror("close"); return 1; }
+    if (write) printf("wrote %s\n", out_path);
+    gguf_free(out);
+    gguf_free(in);
+    ggml_free(meta);
+    return 0;
+}
diff --git a/scripts/ptl/start-qwen38-server.sh b/scripts/ptl/start-qwen38-server.sh
new file mode 100755
index 000000000..eb0729f9b
--- /dev/null
+++ b/scripts/ptl/start-qwen38-server.sh
@@ -0,0 +1,79 @@
+#!/usr/bin/env bash
+# Qwen3.8-Flash-Next Q2_0 + MTP on Intel Panther Lake (Arc B390 iGPU), llama.cpp SYCL.
+# Verified setup: 30.1 tok/s decode over Agents4PLC (strict pass 66.7 %), prefill ~225 tok/s at 34k context.
+# No root needed.
+#
+#   MODEL_DIR=/path/to/models HOST=0.0.0.0 PORT=8601 scripts/ptl/start-qwen38-server.sh
+#
+# MODEL_DIR must contain:
+#   Q2_0_hcq8/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00002.gguf (+ -00002-of-00002.gguf), see README step 3
+#   mtp/mtp-Qwen3.8-Flash-Next-Q4_0.gguf
+# NEW=0 runs the 7 Nov setup instead (original Q2_0 files in Q2_0/, 27.7 tok/s).
+# Stop the server with: kill <pid>. Wait >= 30 s before starting it again.
+set -u
+ROOT=$(cd "$(dirname "$0")/../.." && pwd)
+MODEL_DIR=${MODEL_DIR:-$HOME/models}
+HOST=${HOST:-127.0.0.1}
+PORT=${PORT:-8601}
+CTX=${CTX:-65536}
+ALIAS=${ALIAS:-qwen38-flash-next-q2_0-mtp}
+CPUS=${CPUS:-0-3}          # P-cores on PTL; the host thread must not land on the slow E-cores
+ONEAPI=${ONEAPI:-/opt/intel/oneapi/setvars.sh}
+BIN=$ROOT/build/bin/llama-server
+NEW=${NEW:-1}
+MSUB=Q2_0_hcq8; [ "$NEW" = 1 ] || MSUB=Q2_0
+MODEL=$MODEL_DIR/$MSUB/Qwen3.8-Flash-Next-GSQ-RCO-Q2_0-00001-of-00002.gguf
+MTP=$MODEL_DIR/mtp/mtp-Qwen3.8-Flash-Next-Q4_0.gguf
+
+for f in "$BIN" "$MODEL" "$MTP"; do
+    [ -e "$f" ] || { echo "missing: $f"; exit 1; }
+done
+if pgrep -x llama-server > /dev/null; then
+    echo "llama-server is already running (only one GPU job at a time):"
+    pgrep -xa llama-server | cut -c1-120
+    exit 1
+fi
+
+set +u
+# shellcheck disable=SC1090
+source "$ONEAPI" > /dev/null 2>&1
+set -u
+export ONEAPI_DEVICE_SELECTOR=level_zero:0 UR_LOADER_USE_LEVEL_ZERO_V2=0 UR_L0_ENABLE_RELAXED_ALLOCATION_LIMITS=1
+# GGML_SYCL_Q2_0_FAST=1       faster Q2_0 MoE expert kernel
+# GGML_SYCL_MMID_SMALL_BATCH=8 MTP verify (up to 8 tokens) uses the fused one-token expert path per token
+# LLAMA_DIO_BOUNCE=1          with -lm dio: keep direct IO for the model load (no page cache, no memory pressure)
+export GGML_SYCL_Q2_0_FAST=1 GGML_SYCL_MMID_SMALL_BATCH=8 LLAMA_DIO_BOUNCE=1
+if [ "$NEW" = 1 ]; then
+    # GGML_SYCL_BF16_FAST=1          BF16 mat-vec for the remaining BF16 tensors (1-8 tokens)
+    # GGML_SYCL_TOP_K_MASK=1         fused sparse-attention mask
+    # GGML_SYCL_XMX_Q2_0=1, GGML_SYCL_DYNAMIC_PRECISION=BF16   prefill: Q2_0 experts on the XMX units (bf16, f32 acc.)
+    # GGML_SYCL_DNNL_FPMATH=bf16     prefill: dense oneDNN GEMMs on the XMX units
+    # GGML_SYCL_SPARSE_FA=1, GGML_SYCL_SPARSE_FA_ROWS=8, GGML_SYCL_FA_SKIP_MASKED=1
+    #                                decode: attention only over the cells the indexer picked, also for MTP verify
+    export GGML_SYCL_BF16_FAST=1 GGML_SYCL_TOP_K_MASK=1
+    export GGML_SYCL_XMX_Q2_0=1 GGML_SYCL_DYNAMIC_PRECISION=BF16 GGML_SYCL_DNNL_FPMATH=bf16
+    export GGML_SYCL_SPARSE_FA=1 GGML_SYCL_SPARSE_FA_ROWS=8 GGML_SYCL_FA_SKIP_MASKED=1
+fi
+# SYCL graphs stay off (GGML_SYCL_ENABLE_GRAPH unset): with MTP no graph is replayed and the cache grows per request.
+# -cram 0: no host prompt cache (it grew 120-230 MB per request); the slot still reuses the prefix of the last request.
+
+# The model is read with direct IO, so cached copies of the model files only take memory; with little free memory
+# at launch the GPU buffer gets fragmented and decode runs up to 3x slower. Evict them first (no root needed).
+python3 -c 'import os,sys
+for f in sys.argv[1:]:
+    fd=os.open(f,os.O_RDONLY); os.posix_fadvise(fd,0,0,os.POSIX_FADV_DONTNEED); os.close(fd)' "$(dirname "$MODEL")"/*.gguf "$MTP"
+
+LOG=${LOG:-$ROOT/qwen38-server-$(date +%Y%m%d-%H%M).log}
+setsid nohup taskset -c "$CPUS" "$BIN" -m "$MODEL" -lm dio -lzm on -ngl 99 -fa on \
+    --jinja --reasoning off --no-reasoning-preserve \
+    -c "$CTX" -np 1 -b 4096 -ub 2048 \
+    -md "$MTP" -ngld 99 --spec-type draft-mtp --spec-draft-n-max 5 --spec-draft-p-min 0.5 \
+    -cram 0 --alias "$ALIAS" --host "$HOST" --port "$PORT" > "$LOG" 2>&1 < /dev/null &
+PID=$!
+echo "pid $PID, log $LOG"
+for _ in $(seq 1 100); do
+    grep -q "listening on" "$LOG" && break
+    kill -0 $PID 2> /dev/null || { echo "server exited:"; tail -20 "$LOG"; exit 1; }
+    sleep 3
+done
+grep -E "listening on" "$LOG" || { echo "not ready after 300 s, see $LOG"; exit 1; }
