{
	"name": "@ggml/llama-ui",
	"version": "0.2.0",
	"description": "Shared UI library for llama.cpp frontend apps.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ggml-org/llama.cpp.git",
		"directory": "ui/lib/ui"
	},
	"homepage": "https://github.com/ggml-org/llama.cpp/tree/master/ui/lib/ui",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.stories.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./ui/*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js"
		},
		"./utils": {
			"types": "./dist/components/ui/utils.d.ts",
			"svelte": "./dist/components/ui/utils.js"
		},
		"./styles/*": "./dist/styles/*",
		"./theme.css": "./dist/styles/theme.css",
		"./tokens.css": "./dist/styles/tokens.css",
		"./fonts.css": "./dist/styles/fonts.css",
		"./surfaces.css": "./dist/styles/surfaces.css"
	},
	"scripts": {
		"dev": "bash scripts/dev.sh",
		"build": "vp build && npm run prepack",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vp test",
		"test": "npm run test:unit -- --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"watch:package": "svelte-kit sync && svelte-package -w"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "latest",
		"@storybook/addon-a11y": "^10.6.2",
		"@storybook/addon-docs": "^10.6.2",
		"@storybook/addon-mcp": "10.6.2",
		"@storybook/addon-svelte-csf": "latest",
		"@storybook/addon-vitest": "^10.6.2",
		"@storybook/sveltekit": "^10.6.2",
		"@sveltejs/adapter-auto": "^8.0.0",
		"@sveltejs/kit": "^3.0.0",
		"@sveltejs/package": "^2.5.8",
		"@sveltejs/vite-plugin-svelte": "^7.2.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/coverage-v8": "5.0.5",
		"mdsvex": "0.12.7",
		"mode-watcher": "^1.1.0",
		"playwright": "^1.60.0",
		"publint": "^0.3.21",
		"storybook": "^10.6.2",
		"svelte": "^5.57.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vite-plus": "1.3.0",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "^2.1.1"
	},
	"peerDependencies": {
		"mode-watcher": "^1.1.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.1.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "1.46.0",
		"bits-ui": "2.18.1",
		"clsx": "^2.1.1",
		"highlight.js": "^11.11.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tw-animate-css": "1.4.0"
	}
}
