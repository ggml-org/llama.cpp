{
	"name": "@ggml-org/llama-ui",
	"version": "0.7.0",
	"description": "Shared UI library for llama.cpp frontend apps.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ggml-org/llama.cpp.git",
		"directory": "ui/lib/ui"
	},
	"homepage": "https://github.com/ggml-org/llama.cpp/tree/master/ui/lib/ui",
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*",
		"!dist/**/*.stories.*"
	],
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"types": "./dist/index.d.ts",
	"svelte": "./dist/index.js",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		},
		"./ui/*": {
			"types": "./dist/components/ui/*/index.d.ts",
			"svelte": "./dist/components/ui/*/index.js"
		},
		"./app/*": {
			"types": "./dist/components/app/*/index.d.ts",
			"svelte": "./dist/components/app/*/index.js"
		},
		"./constants": {
			"types": "./dist/constants/index.d.ts",
			"svelte": "./dist/constants/index.js"
		},
		"./enums": {
			"types": "./dist/enums/index.d.ts",
			"svelte": "./dist/enums/index.js"
		},
		"./code": {
			"types": "./dist/utils/index.d.ts",
			"svelte": "./dist/utils/index.js"
		},
		"./models": {
			"types": "./dist/components/models/index.d.ts",
			"svelte": "./dist/components/models/index.js"
		},
		"./voice": {
			"types": "./dist/components/voice/index.d.ts",
			"svelte": "./dist/components/voice/index.js"
		},
		"./utils": {
			"types": "./dist/components/ui/utils.d.ts",
			"svelte": "./dist/components/ui/utils.js"
		},
		"./styles/*": "./dist/styles/*",
		"./theme.css": "./dist/styles/theme.css",
		"./tokens.css": "./dist/styles/tokens.css",
		"./fonts.css": "./dist/styles/fonts.css",
		"./surfaces.css": "./dist/styles/surfaces.css"
	},
	"scripts": {
		"dev": "bash scripts/dev.sh",
		"build": "vp build && npm run prepack",
		"preview": "vp preview",
		"prepare": "svelte-kit sync || echo ''",
		"prepack": "svelte-kit sync && svelte-package && publint",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:unit": "vp test",
		"test": "npm run test:unit -- --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"watch:package": "svelte-kit sync && svelte-package -w"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.5.1",
		"@storybook/addon-a11y": "10.6.6",
		"@storybook/addon-docs": "10.6.6",
		"@storybook/addon-mcp": "10.6.6",
		"@storybook/addon-svelte-csf": "5.1.6",
		"@storybook/addon-vitest": "10.6.6",
		"@storybook/sveltekit": "10.6.6",
		"@sveltejs/adapter-auto": "8.0.0",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/package": "2.5.8",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.19.2",
		"@vitest/browser-playwright": "5.0.5",
		"@vitest/coverage-v8": "5.0.5",
		"mdsvex": "0.12.7",
		"mode-watcher": "1.1.0",
		"playwright": "1.64.1",
		"publint": "0.3.25",
		"storybook": "10.6.6",
		"svelte": "5.57.3",
		"svelte-check": "4.7.7",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vite-plus": "1.3.0",
		"vitest": "5.0.5",
		"vitest-browser-svelte": "2.2.1"
	},
	"peerDependencies": {
		"mode-watcher": "^1.1.0",
		"svelte": "^5.0.0",
		"tailwindcss": "^4.1.0",
		"tw-animate-css": "^1.4.0"
	},
	"overrides": {
		"vite": "npm:@voidzero-dev/vite-plus-core@1.3.0",
		"vitest": "5.0.5"
	},
	"dependencies": {
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.46.0",
		"bits-ui": "2.18.1",
		"clsx": "2.1.1",
		"highlight.js": "11.11.1",
		"lowlight": "3.3.0",
		"@ggml-org/llama-brand": "0.1.0",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"vaul-svelte": "1.0.0-next.7"
	}
}
