{
	"name": "@ggml-org/llama-chat",
	"version": "0.3.1",
	"description": "Llama Chat, the chat app for llama.cpp. Run it with npx @ggml-org/llama-chat against any llama-server.",
	"keywords": [
		"llama.cpp",
		"llama-server",
		"llm",
		"chat",
		"local-ai"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ggml-org/llama.cpp.git",
		"directory": "ui/apps/chat"
	},
	"homepage": "https://github.com/ggml-org/llama.cpp/tree/master/ui/apps/chat#readme",
	"bugs": "https://github.com/ggml-org/llama.cpp/issues",
	"type": "module",
	"bin": {
		"llama-chat": "bin/cli.js"
	},
	"exports": {
		"./cli": "./bin/cli.js",
		"./server": "./cli/server.js",
		"./dist/*": "./dist/*",
		"./package.json": "./package.json"
	},
	"files": [
		"bin",
		"cli",
		"dist",
		"!dist/**/*.map"
	],
	"engines": {
		"node": ">=20"
	},
	"publishConfig": {
		"access": "public"
	},
	"scripts": {
		"build": "npm run build-pwa-assets && vite build",
		"build-pwa-assets": "pwa-assets-generator --root . --config pwa-assets.config.ts && pwa-assets-generator --root . --config pwa-assets-dark.config.ts && node scripts/make-icons-circular.js",
		"dev": "bash scripts/dev.sh",
		"dev:chat-only": "VITE_PUBLIC_AGENTIC=false bash scripts/dev.sh",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:design": "node scripts/design-md.js --check",
		"design:tokens": "node scripts/design-md.js",
		"reset": "rm -rf .svelte-kit node_modules",
		"format": "eslint --fix . && prettier --write .",
		"format:files": "sh -c 'eslint --fix \"$@\" && prettier --write \"$@\"' sh",
		"lint": "svelte-kit sync && prettier --check . && eslint .",
		"test": "npm run test:ui -- --run && npm run test:client -- --run && npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright test",
		"test:e2e:pwa": "playwright test tests/e2e/pwa.e2e.ts",
		"demo:codegen": "playwright codegen --target=playwright-test --viewport-size=1440,900 --output=demo/recording.demo.ts http://localhost:5180/",
		"demo:docs": "node demo/cli.ts docs",
		"demo:pr": "node demo/cli.ts pr",
		"demo:record": "playwright test --config=demo/playwright.config.ts",
		"demo:traces": "node demo/cli.ts traces",
		"test:client": "vitest --project=client",
		"test:unit": "vitest --project=unit",
		"test:unit:pwa": "vitest --project=unit --run tests/unit/pwa.spec.ts",
		"test:pwa": "npm run test:unit:pwa && npm run test:e2e:pwa",
		"test:ui": "vitest --project=ui",
		"storybook": "svelte-kit sync && storybook dev -p 6006",
		"build-storybook": "svelte-kit sync && storybook build",
		"cleanup": "rm -rf .svelte-kit build node_modules test-results dist dev-dist debug-storybook.log static/pwa-*.png static/maskable-icon-*.png static/apple-touch-icon-*.png static/apple-splash-*.png static/favicon*.ico",
		"start": "node bin/cli.js"
	},
	"devDependencies": {
		"@chromatic-com/storybook": "5.5.1",
		"@codemirror/commands": "6.11.1",
		"@codemirror/lang-markdown": "6.5.2",
		"@codemirror/language": "6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.15",
		"@eslint/compat": "2.1.1",
		"@eslint/js": "10.0.1",
		"@ggml-org/llama-brand": "0.1.0",
		"@ggml-org/llama-demo": "file:../../lib/demo",
		"@internationalized/date": "3.12.2",
		"@lezer/highlight": "1.2.5",
		"@lucide/svelte": "1.46.0",
		"@modelcontextprotocol/sdk": "1.32.1",
		"@playwright/test": "1.56.1",
		"@storybook/addon-a11y": "10.6.6",
		"@storybook/addon-docs": "10.6.6",
		"@storybook/addon-mcp": "10.6.6",
		"@storybook/addon-svelte-csf": "5.1.6",
		"@storybook/addon-vitest": "10.6.6",
		"@storybook/sveltekit": "10.6.6",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.2.0",
		"@sveltejs/load-config": "0.2.3",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/forms": "0.5.10",
		"@tailwindcss/typography": "0.5.20",
		"@tailwindcss/vite": "4.3.5",
		"@types/mdast": "4.0.4",
		"@types/node": "24.13.0",
		"@vite-pwa/assets-generator": "1.0.4",
		"@vitest/browser": "4.1.12",
		"@vitest/browser-playwright": "4.1.12",
		"@vitest/coverage-v8": "4.1.12",
		"bits-ui": "2.18.1",
		"clsx": "2.1.1",
		"dexie": "4.4.3",
		"dompurify": "3.4.17",
		"eslint": "10.14.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-perfectionist": "5.13.0",
		"eslint-plugin-simple-import-sort": "14.0.0",
		"eslint-plugin-storybook": "10.6.6",
		"eslint-plugin-svelte": "3.24.1",
		"fflate": "0.8.3",
		"globals": "16.5.0",
		"highlight.js": "11.11.1",
		"http-server": "14.1.1",
		"mdsvex": "0.12.7",
		"mode-watcher": "1.1.0",
		"pdfjs-dist": "5.4.54",
		"pele": "1.13.0",
		"playwright": "1.56.1",
		"prettier": "3.8.3",
		"prettier-plugin-svelte": "4.1.0",
		"prettier-plugin-tailwindcss": "0.8.0",
		"rehype-highlight": "7.0.2",
		"rehype-katex": "7.0.1",
		"rehype-stringify": "10.0.1",
		"remark": "15.0.1",
		"remark-breaks": "4.0.0",
		"remark-gfm": "4.0.1",
		"remark-html": "16.0.1",
		"remark-math": "6.0.0",
		"remark-rehype": "11.1.2",
		"sass": "1.100.0",
		"storybook": "10.6.6",
		"svelte": "5.57.3",
		"svelte-check": "4.7.8",
		"svelte-sonner": "1.1.1",
		"tailwind-merge": "3.6.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.1",
		"unified": "11.0.5",
		"unist-util-visit": "5.1.0",
		"uuid": "13.0.2",
		"vaul-svelte": "1.0.0-next.7",
		"vite": "8.3.6",
		"vite-plugin-devtools-json": "1.1.2",
		"vitest": "4.1.12",
		"vitest-browser-svelte": "2.1.1"
	},
	"overrides": {
		"@storybook/svelte": "10.6.6",
		"cookie": "1.1.1",
		"http-server": {
			"html-encoding-sniffer": "6.0.0"
		},
		"katex": "0.19.0",
		"minimatch": "11.0.5",
		"postcss-selector-parser": "7.1.6",
		"sharp": "0.35.5",
		"valibot": "1.4.2"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	}
}
