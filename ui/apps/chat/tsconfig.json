{
	"extends": "$app/tsconfig",
	"compilerOptions": {
		"paths": {
			"@ggml-org/llama-ui/ui/*": ["../../lib/ui/src/lib/components/ui/*/index.ts"],
			"@ggml-org/llama-ui/app/*": ["../../lib/ui/src/lib/components/app/*/index.ts"],
			"@ggml-org/llama-ui/models": ["../../lib/ui/src/lib/components/models/index.ts"],
			"@ggml-org/llama-ui/constants": ["../../lib/ui/src/lib/constants/index.ts"],
			"@ggml-org/llama-ui/enums": ["../../lib/ui/src/lib/enums/index.ts"],
			"@ggml-org/llama-ui/code": ["../../lib/ui/src/lib/utils/index.ts"],
			"@ggml-org/llama-ui/utils": ["../../lib/ui/src/lib/components/ui/utils.ts"],
			"@ggml-org/llama-ui/styles/*": ["../../lib/ui/src/lib/styles/*"],
			"@ggml-org/llama-ui/theme.css": ["../../lib/ui/src/lib/styles/theme.css"],
			"@ggml-org/llama-ui/tokens.css": ["../../lib/ui/src/lib/styles/tokens.css"],
			"@ggml-org/llama-ui/fonts.css": ["../../lib/ui/src/lib/styles/fonts.css"],
			"@ggml-org/llama-ui/surfaces.css": ["../../lib/ui/src/lib/styles/surfaces.css"],
			"@ggml-org/llama-ui": ["../../lib/ui/src/lib/index.ts"],
			"$llama-ui-stories/*": ["../../lib/ui/tests/stories/*"],
			"@internationalized/date": ["./node_modules/@internationalized/date"],
			"@internationalized/date/*": ["./node_modules/@internationalized/date/*"],
			"@lucide/svelte": ["./node_modules/@lucide/svelte"],
			"@lucide/svelte/*": ["./node_modules/@lucide/svelte/*"],
			"bits-ui": ["./node_modules/bits-ui"],
			"bits-ui/*": ["./node_modules/bits-ui/*"],
			"clsx": ["./node_modules/clsx"],
			"clsx/*": ["./node_modules/clsx/*"],
			"highlight.js": ["./node_modules/highlight.js"],
			"highlight.js/*": ["./node_modules/highlight.js/*"],
			"@ggml-org/llama-brand": ["./node_modules/@ggml-org/llama-brand"],
			"@ggml-org/llama-brand/*": ["./node_modules/@ggml-org/llama-brand/*"],
			"mode-watcher": ["./node_modules/mode-watcher"],
			"mode-watcher/*": ["./node_modules/mode-watcher/*"],
			"svelte": ["./node_modules/svelte"],
			"svelte/*": ["./node_modules/svelte/*", "./node_modules/svelte/types/index.d.ts"],
			"tailwind-merge": ["./node_modules/tailwind-merge"],
			"tailwind-merge/*": ["./node_modules/tailwind-merge/*"],
			"tailwind-variants": ["./node_modules/tailwind-variants"],
			"tailwind-variants/*": ["./node_modules/tailwind-variants/*"],
			"tailwindcss": ["./node_modules/tailwindcss"],
			"tailwindcss/*": ["./node_modules/tailwindcss/*"],
			"tw-animate-css": ["./node_modules/tw-animate-css"],
			"tw-animate-css/*": ["./node_modules/tw-animate-css/*"],
			"vaul-svelte": ["./node_modules/vaul-svelte"],
			"vaul-svelte/*": ["./node_modules/vaul-svelte/*"],
			"@lucide/svelte/icons/*": ["./node_modules/@lucide/svelte/dist/icons/*"]
		},
		"sourceMap": true,
		"strict": true
	},
	"include": [
		".svelte-kit/ambient.d.ts",
		".svelte-kit/non-ambient.d.ts",
		".svelte-kit/types/**/$types.d.ts",
		"vite.config.js",
		"vite.config.ts",
		"src/**/*.js",
		"src/**/*.ts",
		"src/**/*.svelte",
		"tests/**/*.ts",
		"tests/**/*.svelte",
		".storybook/**/*.ts",
		"../../lib/ui/tests/stories/svx.d.ts",
		".storybook/**/*.svelte"
	],
	"exclude": ["src/lib/services/sandbox-worker.js", "src/lib/vendors/**", "src/service-worker"]
}
