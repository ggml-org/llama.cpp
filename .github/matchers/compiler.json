{
    "problemMatcher": [
        {
            "owner": "llama-cxx-colon",
            "pattern": [
                {
                    "regexp": "^\\s*(.+?):([1-9][0-9]*)(?::([1-9][0-9]*))?:\\s+((?:fatal )?error: .+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            ]
        },
        {
            "owner": "llama-cxx-parentheses",
            "pattern": [
                {
                    "regexp": "^\\s*(?:[0-9]+>)?(.+?)\\(([1-9][0-9]*)(?:,\\s*([1-9][0-9]*))?\\):\\s+((?:fatal )?error(?: [A-Z]+[0-9]+)?: .+)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "message": 4
                }
            ]
        }
    ]
}
