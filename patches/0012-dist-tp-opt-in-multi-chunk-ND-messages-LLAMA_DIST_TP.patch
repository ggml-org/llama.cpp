+// ND_POLL_TICK_MS in QueryPerformanceCounter ticks
+static int64_t nd_tick_ticks() {
+    static const int64_t ticks = []() {
+        LARGE_INTEGER f;
+        QueryPerformanceFrequency(&f);
+        return (int64_t)f.QuadPart * ND_POLL_TICK_MS / 1000;
+    }();
+    return ticks;
+}
