+                             "dist-tp: NetworkDirect not established on ring edge %d->%d "
+                             "(rank %d, %s); that edge stays on TCP\n",
+                             u, v, cfg.rank, nd_err.c_str());
+            }
+            if (i_am_u) {
+                nd_send = c;
+            } else {
+                nd_recv = c;
+            }
+        }
+    }
