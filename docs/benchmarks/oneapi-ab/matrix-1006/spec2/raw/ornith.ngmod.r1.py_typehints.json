ue", -0.10495544224977493], [" over", -2.37339186668396]]}, {"t": " per", "lp": -0.02861356921494007, "top": [[" per", -0.02861356921494007], [" over", -4.033498287200928]]}, {"t": " arm", "lp": -0.9210712313652039, "top": [[" arm", -0.9210712313652039], [" test", -1.1142951250076294]]}, {"t": " and", "lp": -0.2799854874610901, "top": [[" and", -0.2799854874610901], [" per", -1.4652596712112427]]}, {"t": " test", "lp": -0.10988668352365494, "top": [[" test", -0.10988668352365494], [" per", -2.272728443145752]]}, {"t": ",", "lp": -0.02949097938835621, "top": [[",", -0.02949097938835621], [" (", -4.239406108856201]]}, {"t": " and", "lp": -0.05012310668826103, "top": [[" and", -0.05012310668826103], [" then", -3.271207571029663]]}, {"t": " prints", "lp": -0.04283476620912552, "top": [[" prints", -0.04283476620912552], [" reports", -3.7729201316833496]]}, {"t": " a", "lp": -0.15676464140415192, "top": [[" a", -0.15676464140415192], [" how", -2.816842555999756]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    The file is expected to contain pipe-delimited rows. For each row, if the\n    second-to-last column matches one of the known TESTS and the last column\n    begins with a number, that number is recorded under the test name.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each recognised test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Collects results across all round files in `ROOT/<d>`, computes the mean\n    value per arm and test, and prints a"}