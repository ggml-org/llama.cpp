nst char * ur;\n    const char * pi;\n};\nstatic constexpr ggml_sycl_xe_copy_var V1_COPY_VARS[] = {\n    { \"UR_L0_USE_COPY_ENGINE\", \"SYCL_PI_LEVEL_ZERO_USE_COPY_ENGINE\" },\n    { \"UR"}