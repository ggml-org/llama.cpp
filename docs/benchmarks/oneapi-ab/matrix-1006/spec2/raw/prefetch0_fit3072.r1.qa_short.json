9058752059937]]}, {"t": "\u2014for", "lp": -0.7575318813323975, "top": [["\u2014for", -0.7575318813323975], [" itself", -1.5342118740081787]]}, {"t": " the", "lp": -0.03572152554988861, "top": [[" the", -0.03572152554988861], [" confirmation", -4.626488208770752]]}, {"t": " exact", "lp": -0.11921071261167526, "top": [[" exact", -0.11921071261167526], [" definitive", -2.385444164276123]]}, {"t": " definitions", "lp": -0.5307994484901428, "top": [[" definitions", -0.5307994484901428], [" definition", -1.798242211341858]]}, {"t": " on", "lp": -0.8903520107269287, "top": [[" on", -0.8903520107269287], [" applicable", -1.7866151332855225]]}, {"t": " your", "lp": -0.0013107899576425552, "top": [[" your", -0.0013107899576425552], [" *", -7.519758701324463]]}, {"t": " specific", "lp": -1.1939642429351807, "top": [[" specific", -1.1939642429351807], [" kernel", -1.3486311435699463]]}, {"t": " kernel", "lp": -0.5542901158332825, "top": [[" kernel", -0.5542901158332825], [" driver", -1.1438038349151611]]}, {"t": " version", "lp": -0.0008521132986061275, "top": [[" version", -0.0008521132986061275], ["\u7248\u672c", -8.337250709533691]]}, {"t": "?", "lp": -0.0007022700156085193, "top": [["?", -0.0007022700156085193], [" that", -7.618138790130615]]}], "text": "# CCS Modes on Intel Arc (xe driver)\n\nThe `ccs_mode` parameter controls how Compute Slice (CCS) contexts are handled by the Xe driver. Here's what each mode does:\n\n## CCS Mode 1\n- **Context stealing / preemption-based**\n- CCS contexts can be *stolen* from the main compute slices when needed\n- Allows more concurrent contexts than there are physical CCS engines\n- Better for workloads with many small/short-lived contexts\n- More flexible but can introduce some overhead from the stealing mechanism\n\n## CCS Mode 2\n- **Dedicated/static assignment**\n- Each CCS context gets a dedicated CCS engine\n- No stealing/preemption of CCS resources\n- Lower overhead, more predictable latency\n- Limited by the actual number of CCS engines available\n\n## CCS Mode 4\n- This is typically the **manual/explicit** mode\n- Gives you finer-grained control over CCS allocation\n- Useful when you want to explicitly manage which contexts use CCS vs. GCS (Graphics CCS)\n\n## When to use which\n\n| Mode | Best for |\n|------|----------|\n| **1** | Mixed workloads, many concurrent contexts, GPU sharing |\n| **2** | Consistent low-latency compute, predictable performance |\n| **4** | Tuning for specific workloads, debugging, explicit control |\n\n---\n\n**A note of caution:** I'm not fully certain about the exact semantics of mode 4 versus the others, and these driver parameters can vary between kernel driver versions. The Xe driver has evolved significantly, and the precise behavior of these modes may differ.\n\nWould you like me to help you find the authoritative source\u2014such as the current kernel documentation (`Documentation/gpu/xe.rst` or similar) or the driver source\u2014for the exact definitions on your specific kernel version?"}