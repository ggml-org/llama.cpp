op": [[" the", -0.01586601324379444], [" mean", -4.575924396514893]]}, {"t": " mean", "lp": -0.00025925421505235136, "top": [[" mean", -0.00025925421505235136], [" average", -9.676236152648926]]}, {"t": " value", "lp": -0.6587940454483032, "top": [[" value", -0.6587940454483032], [" over", -0.779370903968811]]}, {"t": " per", "lp": -0.3274230360984802, "top": [[" per", -0.3274230360984802], [" over", -1.7112959623336792]]}, {"t": " test", "lp": -0.20729155838489532, "top": [[" test", -0.20729155838489532], [" round", -1.6871271133422852]]}, {"t": " and", "lp": -1.0316554307937622, "top": [[" and", -1.0316554307937622], [" over", -2.0135507583618164]]}, {"t": " the", "lp": -0.06842446327209473, "top": [[" the", -0.06842446327209473], [" comparing", -3.4171392917633057]]}, {"t": " percentage", "lp": -0.5584961175918579, "top": [[" percentage", -0.5584961175918579], [" delta", -0.8668152093887329]]}, {"t": " delta", "lp": -0.0030970200896263123, "top": [[" delta", -0.0030970200896263123], [" change", -6.267772197723389]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, expecting pipe-delimited table rows. For each\n    row, the second-to-last cell must be one of the known TESTS names; the last\n    cell is parsed as a float. Matching entries are collected and returned.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dictionary mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Collects per-arm results across all markdown files in the directory,\n    computing the mean value per test and the percentage delta"}