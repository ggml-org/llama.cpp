", -0.2688008248806], [" your", -1.9364358186721802]]}, {"t": "xe", "lp": -0.2634040415287018, "top": [["xe", -0.2634040415287018], ["d", -2.710686683654785]]}, {"t": "`", "lp": -0.050946153700351715, "top": [["`", -0.050946153700351715], ["-d", -4.834841728210449]]}, {"t": " driver", "lp": -0.08031865209341049, "top": [[" driver", -0.08031865209341049], [" module", -3.353801965713501]]}, {"t": " documentation", "lp": -0.5195180177688599, "top": [[" documentation", -0.5195180177688599], [" debug", -1.7713547945022583]]}, {"t": " or", "lp": -0.279024213552475, "top": [[" or", -0.279024213552475], [" for", -1.935461163520813]]}, {"t": " `", "lp": -0.6954285502433777, "top": [[" `", -0.6954285502433777], [" kernel", -1.1278167963027954]]}, {"t": "mod", "lp": -0.3499293029308319, "top": [["mod", -0.3499293029308319], ["d", -1.3872771263122559]]}, {"t": "probe", "lp": -0.2280174195766449, "top": [["probe", -0.2280174195766449], ["options", -1.827130913734436]]}, {"t": "`", "lp": -0.08620811998844147, "top": [["`", -0.08620811998844147], [" xe", -2.506133794784546]]}, {"t": " options", "lp": -0.6908057928085327, "top": [[" options", -0.6908057928085327], [" parameters", -0.7649120092391968]]}, {"t": " for", "lp": -0.22776544094085693, "top": [[" for", -0.22776544094085693], ["\n", -2.16334867477417]]}, {"t": " your", "lp": -0.1180216372013092, "top": [[" your", -0.1180216372013092], [" the", -2.43438982963562]]}], "text": "# CCS Modes on Intel Arc (xe driver)\n\nCCS stands for **Compute Control Set**. These modes control how the GPU's compute units are partitioned and managed, which affects how you can target work to specific parts of the GPU.\n\n## The Modes\n\n**CCS Mode 1:**\n- All CCS units are enabled and managed together as a single pool\n- The driver treats the entire compute subsystem uniformly\n- Simplest configuration\u2014good for general-purpose compute where you don't need fine-grained control\n\n**CCS Mode 2:**\n- CCS units are partitioned/separated\n- Allows more granular control over which compute units execute which work\n- Useful when you want to isolate compute workloads or manage resource allocation between different queues/contexts\n\n## When to Use Mode 4\n\nMode 4 is typically used when you need **explicit control over CCS partitioning**\u2014for example:\n\n- **Multi-tenant or isolated workloads** where you want to guarantee compute separation\n- **Performance tuning** for specific HPC or AI inference patterns where targeting particular compute slices reduces contention\n- **Debugging** compute issues where you need deterministic mapping of work to hardware\n\n## Practical Guidance\n\nFor most users, **CCS Mode 1 is the default and recommended setting**\u2014it gives the driver maximum flexibility to schedule work efficiently. Mode 2 and especially Mode 4 are advanced options for specialized scenarios.\n\n---\n\n**A note on accuracy:** I want to be upfront that I'm not fully certain about the exact semantics of Mode 4 specifically, as these driver-level details can vary between driver versions and I may not have precise information. The CCS mode behavior is also somewhat documentation-light in the public Xe driver docs.\n\nIf you're working with a specific use case, I'd recommend:\n- Checking `xe` driver documentation or `modprobe` options for your"}