0.7172058820724487], [" authoritative", -1.6693543195724487]]}, {"t": " documentation", "lp": -0.14249594509601593, "top": [[" documentation", -0.14249594509601593], [" source", -2.447845220565796]]}, {"t": " for", "lp": -0.7562036514282227, "top": [[" for", -0.7562036514282227], [",", -0.8948755264282227]]}, {"t": " your", "lp": -0.04603996127843857, "top": [[" your", -0.04603996127843857], [" the", -3.9093708992004395]]}, {"t": " setup", "lp": -0.5916975140571594, "top": [[" setup", -0.5916975140571594], [" driver", -0.8601911067962646]]}, {"t": ",", "lp": -0.42110058665275574, "top": [[",", -0.42110058665275574], ["?", -1.0777606964111328]]}, {"t": " or", "lp": -0.023183343932032585, "top": [[" or", -0.023183343932032585], [" and", -3.873013973236084]]}, {"t": " are", "lp": -0.1184040829539299, "top": [[" are", -0.1184040829539299], [" can", -3.038123846054077]]}, {"t": " you", "lp": -0.0006584307993762195, "top": [[" you", -0.0006584307993762195], [" working", -7.771259784698486]]}], "text": "# CCS Modes on Intel Arc (xe driver)\n\nThe `ccs_mode` parameter controls how Compute Slice (CCS) contexts are distributed across the GPU's compute engines. This is set via the `xe` kernel module parameter (e.g., `modprobe xe ccs_mode=1`).\n\n## The Modes\n\n**ccs_mode 0 (default)**\n- CCS contexts are distributed across **all** CCS engines in a round-robin fashion.\n- This is the standard, balanced behavior.\n\n**ccs_mode 1**\n- CCS contexts are pinned to a **single CCS engine** for the lifetime of the context.\n- A context binds to one specific compute engine and stays there.\n\n**ccs_mode 2**\n- CCS contexts are distributed across CCS engines, but with **different affinity/pinning semantics** than mode 1.\n- Historically this relates to how contexts map to engines for load balancing versus isolation.\n\n## When to use mode 4\n\nMode 4 is typically used for **debugging or specific workload isolation scenarios**. It's often referenced in driver development/testing contexts where you want explicit control over engine assignment.\n\n---\n\n**Important caveat:** I'm not fully confident in the precise behavioral distinctions between these specific numeric modes, as this is a fairly niche driver parameter and the exact semantics can vary between driver versions and hardware generations. The Arc A770 (Alchemist) has a specific CCS layout that affects how these modes behave.\n\n**My recommendation:** Check the actual source or documentation for your specific driver version:\n- The `xe` driver documentation in the kernel tree (`Documentation/gpu/xe.rst`)\n- The `ccs_mode` parameter definition in the driver source\n- Intel's Arc Linux driver documentation\n\nWould you like me to help you find the specific documentation for your setup, or are you"}