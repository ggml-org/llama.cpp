 {"t": " results", "lp": -1.2370184659957886, "top": [[" results", -1.2370184659957886], [" mean", -1.2639235258102417]]}, {"t": " across", "lp": -0.06916594505310059, "top": [[" across", -0.06916594505310059], [" from", -2.946235418319702]]}, {"t": " all", "lp": -0.005347337573766708, "top": [[" all", -0.005347337573766708], [" every", -5.668182373046875]]}, {"t": " markdown", "lp": -1.270176887512207, "top": [[" markdown", -1.270176887512207], [" matching", -1.2864179611206055]]}, {"t": " files", "lp": -0.0010439836187288165, "top": [[" files", -0.0010439836187288165], [" round", -7.46012020111084]]}, {"t": " in", "lp": -0.012364276684820652, "top": [[" in", -0.012364276684820652], [" matching", -5.045924186706543]]}, {"t": " ROOT", "lp": -1.1532150506973267, "top": [[" ROOT", -1.1532150506973267], [" <", -1.218957543373108]]}, {"t": "/<", "lp": -0.054364897310733795, "top": [["/<", -0.054364897310733795], ["/d", -2.991729497909546]]}, {"t": "d", "lp": -0.23848770558834076, "top": [["d", -0.23848770558834076], ["dir", -1.5709692239761353]]}], "text": "Here's the file with docstrings added to every function:\n\n```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, treating each line as a pipe-delimited table.\n    For any row whose second-to-last column matches one of the TESTS names and\n    whose last column begins with a number, that number is recorded.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matched test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects per-arm results across all markdown files in ROOT/<d"}