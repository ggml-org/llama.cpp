, -0.0031138809863477945], [" repeats", -7.131653785705566]]}, {"t": " for", "lp": -0.002294309204444289, "top": [[" for", -0.002294309204444289], [" per", -6.418389320373535]]}, {"t": " each", "lp": -0.00035697632119990885, "top": [[" each", -0.00035697632119990885], [" every", -8.404797554016113]]}, {"t": " test", "lp": -0.09867306053638458, "top": [[" test", -0.09867306053638458], [" arm", -2.4342234134674072]]}, {"t": ",", "lp": -0.11259189993143082, "top": [[",", -0.11259189993143082], [" per", -2.8533105850219727]]}, {"t": " and", "lp": -0.01065528579056263, "top": [[" and", -0.01065528579056263], [" then", -4.6793317794799805]]}, {"t": " prints", "lp": -0.1489788442850113, "top": [[" prints", -0.1489788442850113], [" reports", -2.377929449081421]]}, {"t": " a", "lp": -0.12262990325689316, "top": [[" a", -0.12262990325689316], [" the", -2.7703845500946045]]}, {"t": " table", "lp": -0.16256819665431976, "top": [[" table", -0.16256819665431976], [" markdown", -2.4567062854766846]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown results file.\n\n    Reads the file line by line, treating each line as a pipe-delimited table\n    row. For rows whose second-to-last column matches one of the known TESTS,\n    the trailing numeric value is extracted and stored in a dict keyed by the\n    test name.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matched test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Collects per-arm results across all markdown files in `ROOT/<d>`, computes\n    the mean over rounds for each test, and prints a table"}