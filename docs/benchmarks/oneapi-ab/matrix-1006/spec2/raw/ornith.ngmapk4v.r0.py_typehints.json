, -11.034475326538086]]}, {"t": " computing", "lp": -1.00192391872406, "top": [[" computing", -1.00192391872406], [" then", -1.2866947650909424]]}, {"t": " the", "lp": -0.21358755230903625, "top": [[" the", -0.21358755230903625], [" each", -1.9010189771652222]]}, {"t": " delta", "lp": -0.09275925159454346, "top": [[" delta", -0.09275925159454346], [" mean", -3.2247707843780518]]}, {"t": " relative", "lp": -1.1475679874420166, "top": [[" relative", -1.1475679874420166], [" against", -1.6197246313095093]]}, {"t": " to", "lp": -0.0012541526230052114, "top": [[" to", -0.0012541526230052114], [" a", -10.54522705078125]]}, {"t": " the", "lp": -0.4748605489730835, "top": [[" the", -0.4748605489730835], [" a", -0.9755644202232361]]}, {"t": " specified", "lp": -0.5521676540374756, "top": [[" specified", -0.5521676540374756], [" baseline", -0.971851110458374]]}, {"t": " baseline", "lp": -0.005962469149380922, "top": [[" baseline", -0.005962469149380922], [" base", -5.251625061035156]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, treating each line as a pipe-delimited table.\n    For lines whose second-to-last column matches one of the known TESTS, the\n    leading numeric token of the last column is extracted and stored as a float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dictionary mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects per-arm mean values across all round files in the directory,\n    computing the delta relative to the specified baseline"}