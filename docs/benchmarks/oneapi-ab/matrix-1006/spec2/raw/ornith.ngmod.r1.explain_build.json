2172088623]]}, {"t": "\n", "lp": -0.0003418314445298165, "top": [["\n", -0.0003418314445298165], ["-", -8.803977966308594]]}, {"t": "-", "lp": -0.1484173983335495, "top": [["-", -0.1484173983335495], ["Where", -2.108527183532715]]}, {"t": " **", "lp": -0.023648474365472794, "top": [[" **", -0.023648474365472794], [" Where", -4.27066707611084]]}, {"t": "`", "lp": -0.022709526121616364, "top": [["`", -0.022709526121616364], ["Install", -3.9041848182678223]]}, {"t": "-", "lp": -0.1331433206796646, "top": [["-", -0.1331433206796646], ["INSTALL", -2.3679206371307373]]}, {"t": "DC", "lp": -0.02477177046239376, "top": [["DC", -0.02477177046239376], ["D", -3.800431251525879]]}, {"t": "MAKE", "lp": -7.474701851606369e-05, "top": [["MAKE", -7.474701851606369e-05], [" MAKE", -10.584693908691406]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. This is essential because we're using Intel's `icx`/`icpx` compilers, which aren't on the default PATH.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command returns a non-zero (error) status. A safety net so a failed command doesn't cascade into broken output.\n\n## The CMake Configuration\n\nNow the main `cmake` command. Let me flag by flag:\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- **`-S \"${srcdir}/llama.cpp`** \u2014 Source directory (where the CMakeLists.txt lives). `${srcdir}` is the PKGBUILD build directory where git cloned the repo.\n- **`-B \"${srcdir}/build`** \u2014 Build directory (out-of-source build, keeps the source tree clean).\n- **`-G Ninja`** \u2014 Use the Ninja build system instead of Make. Ninja is faster and produces cleaner parallel build output.\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimization level. `Release` enables `-O3` optimizations and disables debug symbols. (Note: `!debug` in options also strips debug info.)\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib\n```\n- **`-DCMAKE"}