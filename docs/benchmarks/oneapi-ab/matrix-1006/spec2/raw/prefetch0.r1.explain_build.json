796875]]}, {"t": " compilers", "lp": -1.0026285648345947, "top": [[" compilers", -1.0026285648345947], [" **", -1.497869849205017]]}, {"t": ":", "lp": -0.00980453286319971, "top": [[":", -0.00980453286319971], [" for", -5.547066688537598]]}, {"t": "\n", "lp": -0.395398885011673, "top": [["\n", -0.395398885011673], [" `", -1.2380292415618896]]}, {"t": "-", "lp": -0.00019653582421597093, "top": [["-", -0.00019653582421597093], [" ", -11.110153198242188]]}, {"t": " **", "lp": -0.36998671293258667, "top": [[" **", -0.36998671293258667], [" `", -1.1745636463165283]]}, {"t": "`", "lp": -0.060440029948949814, "top": [["`", -0.060440029948949814], ["ic", -2.850576400756836]]}, {"t": "ic", "lp": -0.0005211399984546006, "top": [["ic", -0.0005211399984546006], [" ic", -8.985355377197266]]}, {"t": "x", "lp": -0.000801825022790581, "top": [["x", -0.000801825022790581], [" x", -8.824124336242676]]}, {"t": "`", "lp": -0.0005445174174383283, "top": [["`", -0.0005445174174383283], ["**", -8.157843589782715]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line, explaining each flag and its purpose.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. This is essential because we're using Intel's `icx`/`icpx` compilers.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command returns a non-zero (error) status. A safety net for the build process.\n\n## The CMake Invocation\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S \"${srcdir}/llama.cpp\"` \u2014 **Source directory**: where the source code lives\n- `-B \"${srcdir}/build\"` \u2014 **Build directory**: where build artifacts go\n- `-G Ninja` \u2014 **Generator**: use Ninja as the build system (fast, efficient)\n\n## Build Type & Installation\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimized build with performance flags enabled (no debug symbols).\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr\n```\nWhere files will be installed (`/usr` \u2014 the standard system location).\n\n```bash\n-DCMAKE_INSTALL_LIBDIR=lib\n```\nPlace libraries in `/usr/lib` (not `/usr/lib64` or other variants).\n\n## Compiler Selection\n\n```bash\n-DCMAKE_C_COMPILER=icx\n-DCMAKE_CXX_COMPILER=icpx\n```\nUse Intel's compilers:\n- **`icx`"}