-0.011074122972786427, "top": [[" by", -0.011074122972786427], [" per", -4.52984619140625]]}, {"t": " arm", "lp": -0.6297205686569214, "top": [[" arm", -0.6297205686569214], [" \"", -0.8659074902534485]]}, {"t": " (", "lp": -0.18419896066188812, "top": [[" (", -0.18419896066188812], [".", -2.672018527984619]]}, {"t": "derived", "lp": -0.4659830331802368, "top": [["derived", -0.4659830331802368], ["the", -1.0881143808364868]]}, {"t": " from", "lp": -0.0019230247708037496, "top": [[" from", -0.0019230247708037496], [" by", -6.74154806137085]]}, {"t": " the", "lp": -0.42317941784858704, "top": [[" the", -0.42317941784858704], [" each", -1.1284655332565308]]}, {"t": " file", "lp": -0.06718120723962784, "top": [[" file", -0.06718120723962784], [" filename", -2.7451882362365723]]}, {"t": " stem", "lp": -0.03912714123725891, "top": [[" stem", -0.03912714123725891], [" name", -3.9126851558685303]]}, {"t": ").", "lp": -1.2688435316085815, "top": [[").", -1.2688435316085815], [")", -1.344523310661316]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown results file and extract per-arm timing values.\n\n    Reads the file line by line, treating each line as a pipe-delimited table row.\n    For rows whose second-to-last column matches one of the known TESTS, the leading\n    numeric token of the last column is captured as a float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matched test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects parsed values across all markdown files in `ROOT/<d>`, grouping them\n    by arm (derived from the file stem)."}