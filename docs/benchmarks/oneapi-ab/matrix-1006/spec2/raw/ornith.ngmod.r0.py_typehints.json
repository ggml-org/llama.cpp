53655693e-05], [" computes", -12.292472839355469]]}, {"t": "   ", "lp": -0.0001394845894537866, "top": [["   ", -0.0001394845894537866], [" averaging", -10.305489540100098]]}, {"t": " computes", "lp": -0.8615939617156982, "top": [[" computes", -0.8615939617156982], [" computing", -0.925499677658081]]}, {"t": " the", "lp": -0.02300175465643406, "top": [[" the", -0.02300175465643406], [" mean", -4.14539909362793]]}, {"t": " mean", "lp": -0.00039006926817819476, "top": [[" mean", -0.00039006926817819476], [" per", -8.66574764251709]]}, {"t": " over", "lp": -0.6850088238716125, "top": [[" over", -0.6850088238716125], [" value", -0.7788065075874329]]}, {"t": " rounds", "lp": -0.0017720058094710112, "top": [[" rounds", -0.0017720058094710112], [" repeats", -7.749683380126953]]}, {"t": " for", "lp": -0.004854342434555292, "top": [[" for", -0.004854342434555292], [" per", -5.4643144607543945]]}, {"t": " each", "lp": -0.0002247943775728345, "top": [[" each", -0.0002247943775728345], [" every", -9.592241287231445]]}, {"t": " test", "lp": -0.04849342629313469, "top": [[" test", -0.04849342629313469], [" arm", -3.130457878112793]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown results file into a dict of {test_name: value}.\n\n    Reads the file line by line, treating each line as a pipe-delimited table.\n    For lines whose second-to-last column matches one of the known TESTS, the\n    leading numeric token of the last column is extracted and stored as a float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dictionary mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory's results.\n\n    Collects per-arm results across all matching markdown files in the directory,\n    computes the mean over rounds for each test"}