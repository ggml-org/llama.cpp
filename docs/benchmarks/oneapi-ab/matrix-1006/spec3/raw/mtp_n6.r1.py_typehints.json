mparing", -1.892889142036438]]}, {"t": "\n", "lp": -0.28422826528549194, "top": [["\n", -0.28422826528549194], [" \n", -1.49724280834198]]}, {"t": "   ", "lp": -0.0004913822049275041, "top": [["   ", -0.0004913822049275041], ["           ", -8.917426109313965]]}, {"t": " each", "lp": -1.3671793937683105, "top": [[" each", -1.3671793937683105], [" means", -1.635810375213623]]}, {"t": " arm", "lp": -0.002261691028252244, "top": [[" arm", -0.002261691028252244], [" test", -6.466521739959717]]}, {"t": "'s", "lp": -0.000217044071177952, "top": [["'s", -0.000217044071177952], ["\u2019s", -9.7094144821167]]}, {"t": " performance", "lp": -0.7178958654403687, "top": [[" performance", -0.7178958654403687], [" mean", -1.264000415802002]]}, {"t": " relative", "lp": -1.0820200443267822, "top": [[" relative", -1.0820200443267822], [" and", -1.529236078262329]]}, {"t": " to", "lp": -5.6506800319766626e-05, "top": [[" to", -5.6506800319766626e-05], [" (", -10.855154991149902]]}, {"t": " the", "lp": -0.04752605780959129, "top": [[" the", -0.04752605780959129], [" a", -3.1044795513153076]]}, {"t": " baseline", "lp": -0.016521524637937546, "top": [[" baseline", -0.016521524637937546], [" specified", -4.536928176879883]]}, {"t": " arm", "lp": -0.0016418456798419356, "top": [[" arm", -0.0016418456798419356], [".", -6.660029888153076]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm per test, and prints a markdown table showing\n    each arm's performance relative to the baseline arm"}