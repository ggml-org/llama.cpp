, "lp": -0.0001019291375996545, "top": [[" test", -0.0001019291375996545], [" metric", -10.313332557678223]]}, {"t": ",", "lp": -0.004412177950143814, "top": [[",", -0.004412177950143814], [" type", -6.307236194610596]]}, {"t": " and", "lp": -0.20385771989822388, "top": [[" and", -0.20385771989822388], [" calculates", -2.286907434463501]]}, {"t": " prints", "lp": -0.22506234049797058, "top": [[" prints", -0.22506234049797058], [" calculates", -2.294367790222168]]}, {"t": " a", "lp": -0.008170874789357185, "top": [[" a", -0.008170874789357185], [" them", -5.921718597412109]]}, {"t": " markdown", "lp": -0.5023163557052612, "top": [[" markdown", -0.5023163557052612], [" formatted", -1.1580514907836914]]}, {"t": " table", "lp": -0.1922703981399536, "top": [[" table", -0.1922703981399536], ["-form", -1.9444600343704224]]}, {"t": " showing", "lp": -0.2480228692293167, "top": [[" showing", -0.2480228692293167], [" comparing", -2.2071902751922607]]}, {"t": "\n", "lp": -0.2979860305786133, "top": [["\n", -0.2979860305786133], [" \n", -1.4599581956863403]]}, {"t": "   ", "lp": -0.0005147589836269617, "top": [["   ", -0.0005147589836269617], ["           ", -8.71722412109375]]}, {"t": " each", "lp": -1.271478295326233, "top": [[" each", -1.271478295326233], [" means", -1.579978585243225]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float results from the last column of matching table rows.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm per test, and prints a markdown table showing\n    each"}