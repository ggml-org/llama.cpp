op": [[" and", -0.0005054558860138059], [" a", -8.127245903015137]]}, {"t": " print", "lp": -0.0005130891804583371, "top": [[" print", -0.0005130891804583371], [" pretty", -9.08802604675293]]}, {"t": " a", "lp": -0.05992696434259415, "top": [[" a", -0.05992696434259415], [" the", -3.178302764892578]]}, {"t": " summary", "lp": -0.12265376001596451, "top": [[" summary", -0.12265376001596451], [" markdown", -2.7285726070404053]]}, {"t": " table", "lp": -0.021640010178089142, "top": [[" table", -0.021640010178089142], [" markdown", -4.610201835632324]]}, {"t": " for", "lp": -0.05380801856517792, "top": [[" for", -0.05380801856517792], [" of", -3.119312047958374]]}, {"t": " one", "lp": -0.6589040756225586, "top": [[" one", -0.6589040756225586], [" a", -0.7867116928100586]]}, {"t": " results", "lp": -1.2353192567825317, "top": [[" results", -1.2353192567825317], [" result", -1.4251405000686646]]}, {"t": " directory", "lp": -0.008698215708136559, "top": [[" directory", -0.008698215708136559], [" sub", -4.773304462432861]]}], "text": "Here's the file with docstrings added to every function:\n\n```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, expecting pipe-delimited table rows. For each\n    row, the second-to-last cell must match one of the TESTS names; the trailing\n    cell is scanned for a leading number, which is stored as the value for that\n    test. Rows that don't fit this shape are ignored.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each recognised test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for one results directory"}