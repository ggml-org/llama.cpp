9056326001882553], [" per", -4.736139297485352]]}, {"t": " arm", "lp": -0.5456269383430481, "top": [[" arm", -0.5456269383430481], [" \"", -0.9435341954231262]]}, {"t": " (", "lp": -0.10224232077598572, "top": [[" (", -0.10224232077598572], [".", -2.7676992416381836]]}, {"t": "derived", "lp": -0.4074043035507202, "top": [["derived", -0.4074043035507202], ["the", -1.1882613897323608]]}, {"t": " from", "lp": -0.002075798576697707, "top": [[" from", -0.002075798576697707], [" by", -6.646698474884033]]}, {"t": " the", "lp": -0.45416849851608276, "top": [[" the", -0.45416849851608276], [" each", -1.0620691776275635]]}, {"t": " file", "lp": -0.047038380056619644, "top": [[" file", -0.047038380056619644], [" filename", -3.0933220386505127]]}, {"t": " stem", "lp": -0.0722452849149704, "top": [[" stem", -0.0722452849149704], [" name", -3.237511396408081]]}, {"t": ").", "lp": -1.2351293563842773, "top": [[").", -1.2351293563842773], [",", -1.2798357009887695]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown results file and extract per-arm timing values.\n\n    Reads the file line by line, expecting pipe-delimited table rows. For each\n    row whose second-to-last column matches one of the known TESTS, the leading\n    numeric token of the last column is captured as a float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each test name found in the file to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects parsed values across all markdown files in `ROOT/<d>`, grouping them\n    by arm (derived from the file stem)."}