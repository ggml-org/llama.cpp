t": "\n", "lp": -0.27837443351745605, "top": [["\n", -0.27837443351745605], [" \n", -1.4935615062713623]]}, {"t": "   ", "lp": -0.0004915014724247158, "top": [["   ", -0.0004915014724247158], ["       ", -8.843414306640625]]}, {"t": " performance", "lp": -1.4374486207962036, "top": [[" performance", -1.4374486207962036], [" each", -1.7129117250442505]]}, {"t": " deltas", "lp": -0.32779714465141296, "top": [[" deltas", -0.32779714465141296], [" metrics", -2.1036455631256104]]}, {"t": " relative", "lp": -0.2957211136817932, "top": [[" relative", -0.2957211136817932], [" compared", -1.6511592864990234]]}, {"t": " to", "lp": -2.6464813345228322e-05, "top": [[" to", -2.6464813345228322e-05], [" the", -11.283020973205566]]}, {"t": " the", "lp": -0.26314297318458557, "top": [[" the", -0.26314297318458557], [" a", -1.4657891988754272]]}, {"t": " baseline", "lp": -0.024879923090338707, "top": [[" baseline", -0.024879923090338707], [" specified", -3.957115650177002]]}, {"t": " arm", "lp": -0.00035959985689260066, "top": [[" arm", -0.00035959985689260066], [" arms", -9.638644218444824]]}, {"t": ".", "lp": -0.004082657862454653, "top": [[".", -0.004082657862454653], ["'s", -5.779696464538574]]}, {"t": "\n", "lp": -0.010061043314635754, "top": [["\n", -0.010061043314635754], [" Sk", -5.789113998413086]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm and test, and prints a markdown table showing\n    performance deltas relative to the baseline arm.\n"}