" comparing", -1.9863766431808472]]}, {"t": "\n", "lp": -0.3073495030403137, "top": [["\n", -0.3073495030403137], [" \n", -1.4247487783432007]]}, {"t": "   ", "lp": -0.00047659309348091483, "top": [["   ", -0.00047659309348091483], ["           ", -8.898687362670898]]}, {"t": " each", "lp": -1.3892889022827148, "top": [[" each", -1.3892889022827148], [" means", -1.6503286361694336]]}, {"t": " arm", "lp": -0.00239832466468215, "top": [[" arm", -0.00239832466468215], [" test", -6.458127021789551]]}, {"t": "'s", "lp": -0.00024136833962984383, "top": [["'s", -0.00024136833962984383], ["\u2019s", -9.209025382995605]]}, {"t": " performance", "lp": -0.6543392539024353, "top": [[" performance", -0.6543392539024353], [" mean", -1.3260902166366577]]}, {"t": " relative", "lp": -0.9862117171287537, "top": [[" relative", -0.9862117171287537], [" and", -1.5780315399169922]]}, {"t": " to", "lp": -5.6029934057733044e-05, "top": [[" to", -5.6029934057733044e-05], [" (", -10.787701606750488]]}, {"t": " the", "lp": -0.04758187755942345, "top": [[" the", -0.04758187755942345], [" a", -3.107215166091919]]}, {"t": " baseline", "lp": -0.017045771703124046, "top": [[" baseline", -0.017045771703124046], [" specified", -4.511201858520508]]}, {"t": " arm", "lp": -0.0017759467009454966, "top": [[" arm", -0.0017759467009454966], [".", -6.576913833618164]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm per test, and prints a markdown table showing\n    each arm's performance relative to the baseline arm"}