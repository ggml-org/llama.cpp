}, {"t": " test", "lp": -0.00010777100396808237, "top": [[" test", -0.00010777100396808237], [" metric", -10.366837501525879]]}, {"t": ",", "lp": -0.004736057482659817, "top": [[",", -0.004736057482659817], [" type", -6.215538024902344]]}, {"t": " and", "lp": -0.20226936042308807, "top": [[" and", -0.20226936042308807], [" calculates", -2.3568942546844482]]}, {"t": " prints", "lp": -0.20742811262607574, "top": [[" prints", -0.20742811262607574], [" calculates", -2.430227279663086]]}, {"t": " a", "lp": -0.007276480086147785, "top": [[" a", -0.007276480086147785], [" them", -6.0122833251953125]]}, {"t": " markdown", "lp": -0.5296727418899536, "top": [[" markdown", -0.5296727418899536], [" formatted", -1.1046658754348755]]}, {"t": " table", "lp": -0.19854500889778137, "top": [[" table", -0.19854500889778137], ["-form", -1.9064345359802246]]}, {"t": " showing", "lp": -0.2596587538719177, "top": [[" showing", -0.2596587538719177], [" comparing", -2.085916519165039]]}, {"t": "\n", "lp": -0.29670363664627075, "top": [["\n", -0.29670363664627075], [" \n", -1.4761450290679932]]}, {"t": "   ", "lp": -0.0005298468167893589, "top": [["   ", -0.0005298468167893589], ["           ", -8.658527374267578]]}, {"t": " each", "lp": -1.3796838521957397, "top": [[" each", -1.3796838521957397], [" means", -1.512843370437622]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float results from the last column of matching table rows.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm per test, and prints a markdown table showing\n    each"}