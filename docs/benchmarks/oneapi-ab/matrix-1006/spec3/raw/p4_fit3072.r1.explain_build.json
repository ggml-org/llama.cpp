534188471735], ["_COMPILER", -9.604927062988281]]}, {"t": "_COMPILER", "lp": -0.0003436201950535178, "top": [["_COMPILER", -0.0003436201950535178], [" Compiler", -10.099681854248047]]}, {"t": "=", "lp": -0.00048470322508364916, "top": [["=", -0.00048470322508364916], [" ic", -11.309704780578613]]}, {"t": "ic", "lp": -3.433286474319175e-05, "top": [["ic", -3.433286474319175e-05], [" ic", -10.977179527282715]]}, {"t": "px", "lp": -6.234840111574158e-05, "top": [["px", -6.234840111574158e-05], ["\n", -11.979573249816895]]}, {"t": "\n", "lp": -0.0007737291161902249, "top": [["\n", -0.0007737291161902249], [" \\", -8.8336763381958]]}, {"t": "```", "lp": -8.535749657312408e-05, "top": [["```", -8.535749657312408e-05], ["-", -11.946078300476074]]}, {"t": "\n", "lp": -0.00024136833962984383, "top": [["\n", -0.00024136833962984383], ["\n\n", -8.924559593200684]]}], "text": "# PKGBUILD build() Function: Step by Step\n\nLet me break down this `build()` function line by line, explaining each flag and its purpose.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. Without this, `icx`/`icpx` won't be found.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command returns a non-zero status (an error). A safety net so a failed compile doesn't continue silently.\n\n## The CMake Invocation\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S` \u2014 **source directory**: where the source code lives\n- `-B` \u2014 **build directory**: where build artifacts go\n- `-G Ninja` \u2014 selects the **Ninja** build generator (fast, parallel-friendly, preferred over Make here)\n\n## Build Type & Install Paths\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimized build with `-O3`-level optimizations and no debug symbols. (Note: `!debug` option already strips debug info at the package level.)\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib\n```\n- Install prefix `/usr` \u2014 standard location\n- `LIBDIR=lib` \u2014 puts libraries in `/usr/lib` (not `/usr/lib64`, which some distros use)\n\n## The Compilers\n\n```bash\n-DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx\n```\n"}