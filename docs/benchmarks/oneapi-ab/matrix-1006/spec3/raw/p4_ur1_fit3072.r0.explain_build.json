360759735107]]}, {"t": "make", "lp": -0.07666138559579849, "top": [["make", -0.07666138559579849], ["cm", -3.1813042163848877]]}, {"t": " install", "lp": -0.0008188858046196401, "top": [[" install", -0.0008188858046196401], [" INSTALL", -8.505351066589355]]}, {"t": "`", "lp": -0.000499969522934407, "top": [["`", -0.000499969522934407], ["()`", -10.499282836914062]]}, {"t": " will", "lp": -0.18408173322677612, "top": [[" will", -0.18408173322677612], [" places", -2.7457425594329834]]}, {"t": " place", "lp": -0.10260709375143051, "top": [[" place", -0.10260709375143051], [" put", -2.3871471881866455]]}, {"t": " files", "lp": -0.006839664652943611, "top": [[" files", -0.006839664652943611], [" final", -5.693269729614258]]}, {"t": ".", "lp": -0.607397735118866, "top": [[".", -0.607397735118866], [" (", -0.8897520899772644]]}, {"t": "\n", "lp": -0.006068965885788202, "top": [["\n", -0.006068965885788202], [" Standard", -5.914707183837891]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. This is essential because we're using Intel's `icx`/`icpx` compilers, which aren't on the default PATH.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command returns a non-zero (error) status. A safety net so a failed command doesn't cascade into broken output.\n\n## The CMake Configuration\n\nNow the main `cmake` command. Let me flag each part:\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- **`-S \"${srcdir}/llama.cpp`** \u2014 Source directory (where the CMakeLists.txt lives).\n- **`-B \"${srcdir}/build`** \u2014 Build directory (where all compiled artifacts go).\n- **`-G Ninja`** \u2014 Use the **Ninja** build generator instead of the default Makefiles. Ninja is faster and produces cleaner parallel build output.\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimization level. **Release** enables `-O3`-style optimizations and strips debug info (consistent with the `!debug` option flagged earlier).\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib\n```\n- **`-DCMAKE_INSTALL_PREFIX=/usr`** \u2014 Where `make install` will place files.\n"}