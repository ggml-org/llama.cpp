], [" aggregates", -9.384140014648438]]}, {"t": " Collect", "lp": -0.6466178894042969, "top": [[" Collect", -0.6466178894042969], [" Ag", -2.1853599548339844]]}, {"t": "s", "lp": -0.0005513160722330213, "top": [["s", -0.0005513160722330213], [" results", -9.457432746887207]]}, {"t": " per", "lp": -0.5215138792991638, "top": [[" per", -0.5215138792991638], [" parsed", -1.6450375318527222]]}, {"t": "-arm", "lp": -0.030242782086133957, "top": [["-arm", -0.030242782086133957], ["-round", -3.576942205429077]]}, {"t": " results", "lp": -1.3619942665100098, "top": [[" results", -1.3619942665100098], [" mean", -1.7197270393371582]]}, {"t": " across", "lp": -0.06451041996479034, "top": [[" across", -0.06451041996479034], [" from", -3.118131637573242]]}, {"t": " all", "lp": -0.012648004107177258, "top": [[" all", -0.012648004107177258], [" every", -4.640455722808838]]}, {"t": " markdown", "lp": -0.8485170006752014, "top": [[" markdown", -0.8485170006752014], [" matching", -1.2949110269546509]]}, {"t": " files", "lp": -0.0006774573703296483, "top": [[" files", -0.0006774573703296483], [" round", -8.32980728149414]]}], "text": "Here's the file with docstrings added to every function:\n\n```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, keeping only table rows that have more than\n    two pipe-delimited columns and whose second-to-last column matches one of\n    the TESTS names. The value is extracted from the last column via a leading\n    numeric regex.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects per-arm results across all markdown files"}