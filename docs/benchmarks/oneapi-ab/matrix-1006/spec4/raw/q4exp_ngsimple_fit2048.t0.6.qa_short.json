3804512024]]}, {"t": "VA", "lp": -0.7137265205383301, "top": [["VA", -0.7137265205383301], ["V", -1.5489907264709473]]}, {"t": "-API", "lp": -0.0016732497606426477, "top": [["-API", -0.0016732497606426477], ["API", -6.736320972442627]]}, {"t": "**", "lp": -0.27209681272506714, "top": [["**", -0.27209681272506714], [" with", -2.77199387550354]]}, {"t": " or", "lp": -1.4519129991531372, "top": [[" with", -0.8221674561500549], [" or", -1.4519129991531372]]}, {"t": " **", "lp": -0.0004903087974525988, "top": [[" **", -0.0004903087974525988], [" `", -8.584076881408691]]}, {"t": "VA", "lp": -2.6242802143096924, "top": [["V", -1.3184387683868408], ["VD", -1.4952175617218018]]}, {"t": "-API", "lp": -0.5186471343040466, "top": [["-API", -0.5186471343040466], ["-", -2.047029495239258]]}, {"t": " with", "lp": -1.2860660552978516, "top": [[" with", -1.2860660552978516], [" +", -1.7681561708450317]]}, {"t": " Intel", "lp": -1.7267860174179077, "top": [[" Intel", -1.7267860174179077], [" `", -1.7365039587020874]]}, {"t": " Media", "lp": -0.32607370615005493, "top": [[" Media", -0.32607370615005493], ["\u2019s", -2.4995336532592773]]}, {"t": " SDK", "lp": -0.5693930387496948, "top": [[" SDK", -0.5693930387496948], [" Stack", -1.8949984312057495]]}, {"t": "**.", "lp": -0.10751432180404663, "top": [["**.", -0.10751432180404663], ["/", -3.261664390563965]]}, {"t": " The", "lp": -1.2582907676696777, "top": [[" There", -0.9670519828796387], [" The", -1.2582907676696777]]}, {"t": " relevant", "lp": -1.7859866619110107, "top": [[" backend", -1.11504065990448], [" driver", -1.1405476331710815]]}, {"t": " drivers", "lp": -3.4110686779022217, "top": [[" settings", -0.8618399500846863], [" driver", -2.4725844860076904]]}, {"t": " are", "lp": -0.0944649800658226, "top": [[" are", -0.0944649800658226], ["/settings", -3.9087159633636475]]}], "text": "Actually, there is a critical misunderstanding in your question: **`ccs_mode` is not a valid configuration option for Intel Arc GPUs under the XE driver (or any standard Linux/Windows driver).**\n\n### Key Clarifications:\n\n1. **`ccs_mode` is a concept from the Intel Compute Shader Compiler (ISPC) or internal compiler internals**, not a runtime driver setting you can toggle in `xrandr`, `vainfo`, or kernel parameters.\n2. **Intel Arc A770 uses the Xe-Core architecture**, which has **no CCS (Cross-Call Scheduling) mode** in the way you\u2019re describing it. The term \"CCS\" may refer to **Compute Shader Scheduling** in compiler contexts, but it is not exposed as a user-configurable \"mode 1/2/4\" in the driver.\n3. **There is no \"mode 1, 2, or 4\" for CCS on Intel Arc GPUs.** You may be confusing this with:\n   - **VAAPI/VA-API device settings** (e.g., `i915` vs `intel` drivers)\n   - **OpenCL platform/device selection**\n   - **Level Zero (oneAPI) device indices**\n   - **Kernel parameters like `force_i915=1`** (which forces the legacy i915 driver, not recommended for Arc)\n   - **`i915` driver\u2019s `force_gpu_active=1` or `disable_t64_megadriver`** (legacy options)\n\n---\n\n### What you *might* be asking about:\n\n#### Option A: **VAAPI/Video Acceleration Backend Selection**\nOn Intel Arc GPUs, video acceleration uses **VA-API** or **VA-API with Intel Media SDK**. The relevant drivers are"}