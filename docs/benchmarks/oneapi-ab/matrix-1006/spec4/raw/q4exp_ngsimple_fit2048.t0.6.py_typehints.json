: -0.6340702772140503, "top": [[" each", -0.6340702772140503], [" means", -1.7010258436203003]]}, {"t": " arm", "lp": -0.001501972321420908, "top": [[" arm", -0.001501972321420908], [" test", -6.6783952713012695]]}, {"t": "'s", "lp": -0.0014730807160958648, "top": [["'s", -0.0014730807160958648], [",", -6.886667728424072]]}, {"t": " average", "lp": -1.9146568775177002, "top": [[" mean", -0.49333125352859497], [" average", -1.9146568775177002]]}, {"t": " scores", "lp": -0.20453016459941864, "top": [[" scores", -0.20453016459941864], [" score", -2.18587064743042]]}, {"t": " alongside", "lp": -3.08332896232605, "top": [[" and", -0.5596720576286316], [" along", -1.0255151987075806]]}, {"t": "\n", "lp": -0.0018891047220677137, "top": [["\n", -0.0018891047220677137], [" \n", -6.314242362976074]]}, {"t": "   ", "lp": -0.0002590157091617584, "top": [["   ", -0.0002590157091617584], ["       ", -9.721001625061035]]}, {"t": " the", "lp": -0.09280967712402344, "top": [[" the", -0.09280967712402344], [" percentage", -2.922088623046875]]}, {"t": " percentage", "lp": -0.11004716157913208, "top": [[" percentage", -0.11004716157913208], [" delta", -2.868300199508667]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a Markdown table file and extract test scores.\n    \n    Reads the file at path p, parses each line as a Markdown table row,\n    and returns a dictionary mapping test names to their numeric values.\n    Only rows where the second-to-last column matches a known TEST name\n    and the last column starts with a number are included.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a directory of benchmark results.\n    \n    Aggregates results from all .md files in the directory d (excluding those\n    with '.a.' or '.b.' in the filename), computes the mean score per test per\n    arm, and prints a Markdown table showing each arm's average scores alongside\n    the percentage"}