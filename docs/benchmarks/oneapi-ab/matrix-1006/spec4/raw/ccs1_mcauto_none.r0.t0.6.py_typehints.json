1], [" directory", -4.9114909172058105]]}, {"t": "   ", "lp": -0.000137696202727966, "top": [["   ", -0.000137696202727966], ["       ", -11.064641952514648]]}, {"t": " directory", "lp": -0.010728182271122932, "top": [[" directory", -0.010728182271122932], [" sub", -4.559424877166748]]}, {"t": ",", "lp": -0.08835668116807938, "top": [[",", -0.08835668116807938], [" (", -2.839228391647339]]}, {"t": " computes", "lp": -0.22615347802639008, "top": [[" computes", -0.22615347802639008], [" then", -2.1586925983428955]]}, {"t": " the", "lp": -0.02943548560142517, "top": [[" the", -0.02943548560142517], [" per", -3.8740856647491455]]}, {"t": " mean", "lp": -0.003264086088165641, "top": [[" mean", -0.003264086088165641], [" per", -5.813238620758057]]}, {"t": " over", "lp": -0.817909836769104, "top": [[" over", -0.817909836769104], [" value", -0.8610978722572327]]}, {"t": " rounds", "lp": -0.0009171398705802858, "top": [[" rounds", -0.0009171398705802858], [" repeats", -8.324960708618164]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown results file into a dict of {test_name: value}.\n\n    Reads the file line by line, expecting pipe-delimited table rows. For each\n    row, the second-to-last column must match one of the known TESTS names and\n    the last column must begin with a numeric value. Matching rows are collected.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matched test name to the parsed float value from its row.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for one result directory.\n\n    Collects all round results per arm from the markdown files in the given\n    directory, computes the mean over rounds"}