 in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Reads all matching markdown files in ``ROOT/<d>``, aggregates the parsed metric\n    values per arm (identified by"}