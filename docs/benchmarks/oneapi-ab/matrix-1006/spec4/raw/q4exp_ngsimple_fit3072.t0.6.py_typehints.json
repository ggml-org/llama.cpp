t.\n\n    Returns:\n        A dictionary mapping test names (strings) to their corresponding\n        float values. Only tests present in the TESTS list are included.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory of benchmarks.\n\n    Scans all markdown files in the given directory (excluding those with\n    '.a.' or '.b.' in their"}