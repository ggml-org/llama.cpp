0.5647802352905273, "top": [[" Collect", -0.5647802352905273], [" Ag", -1.8341093063354492]]}, {"t": "s", "lp": -0.000789715675637126, "top": [["s", -0.000789715675637126], [" results", -8.737675666809082]]}, {"t": " per", "lp": -0.5906868577003479, "top": [[" per", -0.5906868577003479], [" results", -1.9652215242385864]]}, {"t": "-arm", "lp": -0.03993864357471466, "top": [["-arm", -0.03993864357471466], ["-round", -3.443373441696167]]}, {"t": " metrics", "lp": -2.590137004852295, "top": [[" results", -1.0637356042861938], [" mean", -1.8345123529434204]]}, {"t": " across", "lp": -0.1540401726961136, "top": [[" across", -0.1540401726961136], [" from", -2.4003474712371826]]}, {"t": " all", "lp": -0.003750912845134735, "top": [[" all", -0.003750912845134735], [" the", -6.899558067321777]]}, {"t": " matching", "lp": -0.6251798272132874, "top": [[" matching", -0.6251798272132874], [" markdown", -1.5147900581359863]]}, {"t": " markdown", "lp": -0.08461889624595642, "top": [[" markdown", -0.08461889624595642], [" .", -3.2895500659942627]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file, returning a mapping of test name to value.\n\n    Scans each line of the file, splitting on the '|' delimiter. For lines whose\n    second-to-last cell matches one of the TESTS names and whose last cell begins\n    with a numeric value, the test name is mapped to that parsed float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each test name (e.g. \"pp512\") found in the file to its\n        corresponding float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory's results.\n\n    Collects per-arm metrics across all matching markdown"}