t": "\n", "lp": -0.12082350254058838, "top": [["\n", -0.12082350254058838], [" showing", -2.765646457672119]]}, {"t": "   ", "lp": -9.29875677684322e-05, "top": [["   ", -9.29875677684322e-05], ["           ", -10.567863464355469]]}, {"t": " showing", "lp": -0.25561070442199707, "top": [[" showing", -0.25561070442199707], [" with", -2.2208855152130127]]}, {"t": " performance", "lp": -1.5815001726150513, "top": [[" performance", -1.5815001726150513], [" means", -1.874186635017395]]}, {"t": " deltas", "lp": -0.27358558773994446, "top": [[" deltas", -0.27358558773994446], [" relative", -2.188908815383911]]}, {"t": " relative", "lp": -0.3123765289783478, "top": [[" relative", -0.3123765289783478], [" compared", -1.7273203134536743]]}, {"t": " to", "lp": -2.1934749383945018e-05, "top": [[" to", -2.1934749383945018e-05], [" the", -11.49514389038086]]}, {"t": " the", "lp": -0.2638187110424042, "top": [[" the", -0.2638187110424042], [" a", -1.4637222290039062]]}, {"t": " baseline", "lp": -0.02251400239765644, "top": [[" baseline", -0.02251400239765644], [" specified", -4.104747295379639]]}, {"t": " arm", "lp": -0.0004913822049275041, "top": [[" arm", -0.0004913822049275041], [".", -9.26410961151123]]}, {"t": ".", "lp": -0.0028921423945575953, "top": [[".", -0.0028921423945575953], ["'s", -6.0626091957092285]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm and test, and prints a formatted markdown table\n    showing performance deltas relative to the baseline arm."}