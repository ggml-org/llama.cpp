 rounds", "lp": -0.004074458498507738, "top": [[" rounds", -0.004074458498507738], [" repeats", -6.837709903717041]]}, {"t": " for", "lp": -0.005196998827159405, "top": [[" for", -0.005196998827159405], [" per", -5.397397518157959]]}, {"t": " each", "lp": -0.0003561415651347488, "top": [[" each", -0.0003561415651347488], [" every", -8.729161262512207]]}, {"t": " test", "lp": -0.04747499153017998, "top": [[" test", -0.04747499153017998], [" known", -3.8167524337768555]]}, {"t": ",", "lp": -0.05419328808784485, "top": [[",", -0.05419328808784485], [" per", -3.551927328109741]]}, {"t": " and", "lp": -0.004734740126878023, "top": [[" and", -0.004734740126878023], [" then", -5.557425022125244]]}, {"t": " prints", "lp": -0.7232329845428467, "top": [[" prints", -0.7232329845428467], [" reports", -0.8054625988006592]]}, {"t": " the", "lp": -1.8712161779403687, "top": [[" a", -0.27569034695625305], [" the", -1.8712161779403687]]}, {"t": " mean", "lp": -0.6269754767417908, "top": [[" mean", -0.6269754767417908], [" values", -1.8102316856384277]]}, {"t": " alongside", "lp": -1.7816625833511353, "top": [[" along", -0.5949751734733582], [" alongside", -1.7816625833511353]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown results file and extract per-test numeric values.\n\n    Reads the file line by line, treating each line as a pipe-delimited table row.\n    For rows whose second-to-last column matches one of the known TESTS, the leading\n    numeric token of the last column is captured as a float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matched test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single experiment directory.\n\n    Collects per-arm results across all markdown files in the directory, computes the\n    mean over rounds for each test, and prints the mean alongside"}