069763184]]}, {"t": " source", "lp": -0.3955324590206146, "top": [[" source", -0.3955324590206146], [" tree", -1.2877405881881714]]}, {"t": ")", "lp": -0.0017820372013375163, "top": [[")", -0.0017820372013375163], [" if", -7.181915760040283]]}, {"t": "\n", "lp": -0.0009844378801062703, "top": [["\n", -0.0009844378801062703], ["\n\n", -7.3543877601623535]]}, {"t": "3", "lp": -0.0003394464438315481, "top": [["3", -0.0003394464438315481], ["4", -10.524209976196289]]}, {"t": ".", "lp": -0.0007314376416616142, "top": [[".", -0.0007314376416616142], [" Testing", -8.249781608581543]]}, {"t": " Testing", "lp": -0.11584553867578506, "top": [[" Testing", -0.11584553867578506], [" Checking", -2.89972186088562]]}, {"t": " with", "lp": -0.5470049381256104, "top": [[" with", -0.5470049381256104], [" empir", -1.63313889503479]]}, {"t": " your", "lp": -0.20299483835697174, "top": [[" your", -0.20299483835697174], [" `", -2.160855770111084]]}, {"t": " specific", "lp": -0.17795327305793762, "top": [[" specific", -0.17795327305793762], [" actual", -1.8148589134216309]]}, {"t": " workload", "lp": -0.04161973297595978, "top": [[" workload", -0.04161973297595978], [" work", -3.237900972366333]]}], "text": "# CCS Modes on Intel Arc (xe driver)\n\nThe `ccs_mode` parameter controls how Compute Slice (CCS) contexts are handled by the Xe driver. Here's what each mode does:\n\n## CCS Mode 1\n- **Context stealing / preemption-based**\n- CCS contexts can be scheduled on the same physical contexts as GUC-managed contexts\n- More flexible but can have contention between different context types\n- Generally the default and most compatible option\n\n## CCS Mode 2\n- **Dedicated CCS contexts**\n- CCS contexts get their own dedicated context slots, separate from GUC contexts\n- Reduces contention between CCS and GUC workloads\n- Can improve predictability for mixed workloads\n\n## CCS Mode 4\n- **Dedicated CCS contexts with additional isolation**\n- Provides the strongest separation between context types\n- Useful when you want maximum isolation and want to avoid any potential interference between CCS and GUC contexts\n\n## When to use each\n\n| Mode | Best for |\n|------|----------|\n| **1** | General use, maximum compatibility, default behavior |\n| **2** | Mixed workloads where you want some separation without full isolation |\n| **4** | Workloads needing strong isolation, or when you're hitting contention/instability with other modes |\n\n---\n\n**A note of caution:** I want to be transparent that my knowledge of these specific driver parameters is somewhat limited, and the exact semantics of these modes can vary between driver versions. The Xe driver has evolved significantly, and these details may have changed.\n\nI'd recommend:\n1. Checking `dmesg` output after loading the driver to see which mode is active\n2. Consulting the latest kernel documentation (`Documentation/gpu/xe.rst` or similar in your kernel source)\n3. Testing with your specific workload"}