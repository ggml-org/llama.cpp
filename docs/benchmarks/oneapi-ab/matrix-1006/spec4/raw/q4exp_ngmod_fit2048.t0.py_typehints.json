ing", -1.6784240007400513]]}, {"t": "\n", "lp": -0.2897516191005707, "top": [["\n", -0.2897516191005707], [" \n", -1.4628397226333618]]}, {"t": "   ", "lp": -0.00048267567763105035, "top": [["   ", -0.00048267567763105035], ["       ", -8.881208419799805]]}, {"t": " performance", "lp": -1.4907642602920532, "top": [[" performance", -1.4907642602920532], [" each", -1.7223869562149048]]}, {"t": " deltas", "lp": -0.3629071116447449, "top": [[" deltas", -0.3629071116447449], [" metrics", -1.9856830835342407]]}, {"t": " relative", "lp": -0.30093666911125183, "top": [[" relative", -0.30093666911125183], [" compared", -1.6173925399780273]]}, {"t": " to", "lp": -2.2053962311474606e-05, "top": [[" to", -2.2053962311474606e-05], [" the", -11.478530883789062]]}, {"t": " the", "lp": -0.2518197000026703, "top": [[" the", -0.2518197000026703], [" a", -1.5044766664505005]]}, {"t": " baseline", "lp": -0.022336192429065704, "top": [[" baseline", -0.022336192429065704], [" specified", -4.073977470397949]]}, {"t": " arm", "lp": -0.0003423084563110024, "top": [[" arm", -0.0003423084563110024], [" arms", -9.673432350158691]]}, {"t": ".", "lp": -0.004006713163107634, "top": [[".", -0.004006713163107634], ["'s", -5.814645290374756]]}, {"t": "\n", "lp": -0.010810122825205326, "top": [["\n", -0.010810122825205326], [" Files", -5.703574180603027]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm and test, and prints a markdown table showing\n    performance deltas relative to the baseline arm.\n"}