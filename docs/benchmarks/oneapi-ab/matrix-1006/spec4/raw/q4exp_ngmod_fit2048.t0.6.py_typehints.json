-0.6530295014381409], [".", -0.9708453416824341]]}, {"t": " delta", "lp": -1.0200647115707397, "top": [[" percentage", -0.6925938725471497], [" delta", -1.0200647115707397]]}, {"t": " calculations", "lp": -0.12783357501029968, "top": [[" calculations", -0.12783357501029968], [" calculation", -2.2105934619903564]]}, {"t": ".", "lp": -1.561653880344238e-05, "top": [[".", -1.561653880344238e-05], ["\n        \n", -11.567351341247559]]}, {"t": "\n", "lp": -0.00010717489203670993, "top": [["\n", -0.00010717489203670993], ["\n\n", -9.36256217956543]]}, {"t": "        \n", "lp": -0.03836417570710182, "top": [["        \n", -0.03836417570710182], ["   ", -3.393125295639038]]}, {"t": "   ", "lp": -0.005309765692800283, "top": [["   ", -0.005309765692800283], ["       ", -5.316230297088623]]}, {"t": " Note", "lp": -1.9918885231018066, "top": [[" This", -1.2072453498840332], [" Note", -1.9918885231018066]]}, {"t": ":", "lp": -0.0005761852371506393, "top": [[":", -0.0005761852371506393], [" that", -7.657444000244141]]}, {"t": "\n", "lp": -0.09510796517133713, "top": [["\n", -0.09510796517133713], [" Files", -3.1373558044433594]]}, {"t": "       ", "lp": -0.0010191028704866767, "top": [["       ", -0.0010191028704866767], ["      ", -7.722218036651611]]}, {"t": " Files", "lp": -0.31148868799209595, "top": [[" Files", -0.31148868799209595], [" This", -2.124610424041748]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown file and extract test results.\n    \n    Args:\n        p: Path to the markdown file containing test results in table format.\n        \n    Returns:\n        A dictionary mapping test names to their corresponding float values.\n        Only lines with at least 3 columns and where the second-to-last column\n        matches one of the TESTS are considered. The last column is parsed\n        as a float using regex.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Args:\n        d: Directory name under ROOT containing markdown files with results.\n        base: Name of the baseline arm to compare against for delta calculations.\n        \n    Note:\n        Files"}