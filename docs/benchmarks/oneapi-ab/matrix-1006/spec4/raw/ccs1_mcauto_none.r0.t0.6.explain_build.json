0926189423, "top": [["_COMPILER", -0.0022959820926189423], [".compiler", -7.549952983856201]]}, {"t": "_LA", "lp": -0.0007740870350971818, "top": [["_LA", -0.0007740870350971818], [".LA", -7.441229820251465]]}, {"t": "UNCH", "lp": -0.00020106667943764478, "top": [["UNCH", -0.00020106667943764478], ["UCH", -9.181563377380371]]}, {"t": "ER", "lp": -0.00013018501340411603, "top": [["ER", -0.00013018501340411603], ["ERC", -10.287817001342773]]}, {"t": "=", "lp": -0.001506867236457765, "top": [["=", -0.001506867236457765], ["=\\", -7.401487827301025]]}, {"t": "\n", "lp": -0.0007002420607022941, "top": [["\n", -0.0007002420607022941], [" \n", -8.723543167114258]]}], "text": "# PKGBUILD build() Function Explained\n\nLet me break down the `build()` function line by line. Note that the function appears to be **cut off** in your paste (it ends mid-command at `-DGGML_SYCL_DEVICE`), so I'll explain what's shown and note where it stops.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nLoads the Intel oneAPI environment variables (paths, compiler locations, etc.) so that `icx`/`icpx` are available. The `--force` flag makes it work even if invoked in an unusual shell context.\n\n```bash\nset -e\n```\nMakes the script exit immediately if any command fails (standard safety in build functions).\n\n## The CMake Configuration\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S`: source directory (the git checkout)\n- `-B`: build directory\n- `-G Ninja`: use the Ninja build system (declared in `makedepends`)\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimized build with optimizations enabled, no debug symbols.\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib\n```\nWhere files will be installed (`/usr`, with libraries in `/usr/lib`).\n\n## Compiler Selection\n\n```bash\n-DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx\n```\nUse Intel's DPC++/ICX compilers instead of GCC. This is essential for **SYCL** GPU support (the whole point of this fork).\n\n```bash\n-DCMAKE_C_COMPILER_LAUNCHER= -DCMAKE_CXX_COMPILER_LAUNCHER=\n"}