, -0.00020404750830493867], ["/lib", -9.36916732788086]]}, {"t": "6", "lp": -5.221503306529485e-05, "top": [["6", -5.221503306529485e-05], ["/x", -9.98119831085205]]}, {"t": "4", "lp": -3.051804378628731e-05, "top": [["4", -3.051804378628731e-05], ["3", -13.234996795654297]]}, {"t": "`)", "lp": -0.6138216853141785, "top": [["`)", -0.6138216853141785], ["`,", -1.2027803659439087]]}, {"t": "\n\n", "lp": -0.0007524936809204519, "top": [["\n\n", -0.0007524936809204519], [" \u2014", -8.107012748718262]]}, {"t": "##", "lp": -0.14074155688285828, "top": [["##", -0.14074155688285828], ["```", -2.4167139530181885]]}, {"t": " Compiler", "lp": -0.031476229429244995, "top": [[" Compiler", -0.031476229429244995], [" The", -3.7639572620391846]]}, {"t": " Selection", "lp": -0.004859433509409428, "top": [[" Selection", -0.004859433509409428], [" Assignment", -6.512420177459717]]}, {"t": "\n\n", "lp": -0.16632477939128876, "top": [["\n\n", -0.16632477939128876], [" (", -1.9897043704986572]]}], "text": "# PKGBUILD build() Function \u2014 Step by Step\n\nLet me break down this `build()` function line by line, explaining each component and the flags it uses.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads Intel's oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be reconfigured even if it's already sourced. This is essential because `icx`/`icpx` (Intel's DPC++/SYCL compilers) need proper PATH and library configuration to work.\n\n```bash\nset -e\n```\nThis makes the shell exit immediately if any command returns a non-zero status. A safety net so a failed command doesn't leave a broken build.\n\n## The CMake Invocation\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S` \u2014 the **source directory** (where the llama.cpp code lives)\n- `-B` \u2014 the **build directory** (where compilation output goes)\n- `-G Ninja` \u2014 selects the **Ninja generator**, a fast build system that's more efficient than Make for large projects\n\n## Configuration Flags\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nSets the **optimization level**. `Release` enables compiler optimizations (`-O3`, `-DNDEBUG`) for a fast, production binary.\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib\n```\n- `CMAKE_INSTALL_PREFIX` \u2014 where `make install` will place files (system standard `/usr`)\n- `CMAKE_INSTALL_LIBDIR` \u2014 where libraries go (`lib` rather than `lib64`)\n\n## Compiler Selection\n\n"}