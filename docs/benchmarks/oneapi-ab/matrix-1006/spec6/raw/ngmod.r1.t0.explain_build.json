4917]]}, {"t": "=", "lp": -0.00031237711664289236, "top": [["=", -0.00031237711664289236], [" ic", -11.636646270751953]]}, {"t": "ic", "lp": -4.4466054532676935e-05, "top": [["ic", -4.4466054532676935e-05], [" ic", -10.559823989868164]]}, {"t": "px", "lp": -6.056015263311565e-05, "top": [["px", -6.056015263311565e-05], ["\n", -11.969223976135254]]}, {"t": "\n", "lp": -0.0005395079497247934, "top": [["\n", -0.0005395079497247934], [" -", -10.041743278503418]]}, {"t": "```", "lp": -9.108004451263696e-05, "top": [["```", -9.108004451263696e-05], [" ```", -11.636505126953125]]}, {"t": "\n", "lp": -0.0001703645830275491, "top": [["\n", -0.0001703645830275491], ["\n\n", -9.692971229553223]]}, {"t": "-", "lp": -0.2794038951396942, "top": [["-", -0.2794038951396942], ["Use", -1.588014841079712]]}, {"t": " **", "lp": -0.47435668110847473, "top": [[" **", -0.47435668110847473], [" `", -0.9753018021583557]]}, {"t": "`", "lp": -0.2064843326807022, "top": [["`", -0.2064843326807022], ["ic", -1.685743808746338]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line, explaining each flag and its purpose.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. This is essential because we're using Intel's `icx`/`icpx` compilers.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command returns a non-zero status (an error). A safety net so a failed command doesn't cascade into broken output.\n\n## The CMake Invocation\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S \"${srcdir}/llama.cpp\"` \u2014 **Source directory**: where the source code lives\n- `-B \"${srcdir}/build\"` \u2014 **Build directory**: where build artifacts go\n- `-G Ninja` \u2014 **Generator**: use Ninja as the build system (fast, efficient task runner)\n\n## Build Type & Installation\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimized build with performance flags enabled (no debug symbols, maximum optimization).\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr\n```\nWhere files will be installed (`/usr` \u2014 the standard system location).\n\n```bash\n-DCMAKE_INSTALL_LIBDIR=lib\n```\nWhere libraries go (`lib` rather than `lib64`, matching Arch's layout).\n\n## Compiler Selection\n\n```bash\n-DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx\n```\n- **`"}