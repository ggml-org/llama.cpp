033931732], [" M", -2.2563886642456055]]}, {"t": "\n\n", "lp": -0.46747472882270813, "top": [["\n\n", -0.46747472882270813], [" settings", -1.7736709117889404]]}, {"t": "Would", "lp": -0.551654577255249, "top": [["Would", -0.551654577255249], ["Is", -1.7510793209075928]]}, {"t": " you", "lp": -0.00099285040050745, "top": [[" you", -0.00099285040050745], [" like", -8.36740779876709]]}, {"t": " like", "lp": -0.1441027671098709, "top": [[" like", -0.1441027671098709], [" tell", -2.649162769317627]]}, {"t": " me", "lp": -0.03171658143401146, "top": [[" me", -0.03171658143401146], [" help", -3.5807392597198486]]}, {"t": " to", "lp": -0.0003656817425508052, "top": [[" to", -0.0003656817425508052], [" effort", -10.16353702545166]]}, {"t": " help", "lp": -0.41089490056037903, "top": [[" help", -0.41089490056037903], [" try", -1.9735113382339478]]}, {"t": " you", "lp": -0.08509364724159241, "top": [[" you", -0.08509364724159241], [" with", -3.420428514480591]]}, {"t": " think", "lp": -1.3766919374465942, "top": [[" find", -1.1686040163040161], [" think", -1.3766919374465942]]}, {"t": " through", "lp": -0.009446575306355953, "top": [[" through", -0.009446575306355953], [" about", -4.685513973236084]]}], "text": "# CCS Modes on Intel Arc with the Xe Driver\n\nThe CCS (Compute Command Streamer) modes control how the GPU's compute engines are partitioned and how work is distributed, particularly relevant for the A770's MRO (Multi-Ring Option) architecture.\n\n## CCS Mode 1\n\nThis mode uses **individual CCS instances**. Each CCS engine is assigned to a specific queue, giving you finer-grained control over which compute engine handles which workload. This is useful when you want explicit affinity to particular hardware queues.\n\n## CCS Mode 2\n\nThis mode uses a **single CCS instance** that can service multiple queues. The scheduler routes work through one unified compute engine. This tends to be more efficient for general-purpose workloads where you don't need explicit per-engine control, and it can improve work distribution across the GPU's compute resources.\n\n## CCS Mode 4\n\nMode 4 is typically used for **specific advanced configurations**\u2014often related to **virtualization, multi-tenant scenarios, or advanced SLA/QoS requirements** where you need to guarantee dedicated compute resources or isolate workloads. It's less commonly used in standard single-GPU desktop setups.\n\n---\n\n**A note of honesty here:** I want to flag that my specific knowledge of the exact per-mode behavior in the `xe` driver has some uncertainty. The precise semantics of these modes (which CCS engines map to which MRO instances, exact routing behavior) can be nuanced and version-dependent.\n\nFor accurate, authoritative details I'd recommend:\n- The **`xe` driver documentation** in the kernel source (`drivers/gpu/drm/xe/`)\n- The `xe` driver's module parameters (often settable via `modprobe xe <param>=...`)\n- Intel's internal or public developer forums where the driver maintainers discuss these\n\nWould you like me to help you think through"}