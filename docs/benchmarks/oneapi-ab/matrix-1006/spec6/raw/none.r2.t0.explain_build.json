90344732999802, "top": [[" code", -0.10990344732999802], ["/", -2.317108154296875]]}, {"t": ")", "lp": -0.07275419682264328, "top": [[")", -0.07275419682264328], [",", -2.701467752456665]]}, {"t": "\n\n", "lp": -0.11627086997032166, "top": [["\n\n", -0.11627086997032166], ["\n", -2.2217445373535156]]}, {"t": "These", "lp": -0.2933965027332306, "top": [["These", -0.2933965027332306], ["##", -2.3306736946105957]]}, {"t": " are", "lp": -0.3004720211029053, "top": [[" are", -0.3004720211029053], [" enable", -1.8909776210784912]]}, {"t": " required", "lp": -0.5659677982330322, "top": [[" required", -0.5659677982330322], [" what", -2.057039499282837]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line, explaining each flag and its purpose.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag ensures it works even if already sourced. Without this, `icx`/`icpx` wouldn't be found.\n\n```bash\nset -e\n```\nStops the build immediately if any command fails (exits non-zero).\n\n## The CMake Invocation\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S` : **source directory** (where the source code lives)\n- `-B` : **build directory** (where compilation output goes)\n- `-G Ninja` : use the **Ninja** build generator (fast, parallel-friendly)\n\n## Build Type & Installation\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimized build with `-O3`-level optimizations (no debug symbols).\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib\n```\n- Install binaries to `/usr`\n- Install libraries to `/usr/lib` (not `/usr/lib64`)\n\n## The Compilers\n\n```bash\n-DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx\n```\nUse Intel's **DPC++/SYCL compilers**:\n- `icx` = Intel oneAPI C++ compiler (for C code)\n- `icpx` = Intel oneAPI C++ compiler (for C++ code)\n\nThese are required"}