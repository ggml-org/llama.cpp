6916932762, "top": [["```", -0.00022312506916932762], ["<tool_call>", -11.476752281188965]]}, {"t": "\n", "lp": -0.000491024402435869, "top": [["\n", -0.000491024402435869], ["\n\n", -8.08176326751709]]}, {"t": "Use", "lp": -0.050149738788604736, "top": [["Use", -0.050149738788604736], ["**", -4.151491165161133]]}, {"t": " Intel", "lp": -0.16222505271434784, "top": [[" Intel", -0.16222505271434784], [" **", -1.9472668170928955]]}, {"t": "'s", "lp": -0.007620928343385458, "top": [["'s", -0.007620928343385458], [" compilers", -5.019976615905762]]}, {"t": " **", "lp": -0.6857554316520691, "top": [[" **", -0.6857554316520691], [" compilers", -1.0683962106704712]]}, {"t": "ic", "lp": -0.25876477360725403, "top": [["ic", -0.25876477360725403], ["IC", -2.5174050331115723]]}, {"t": "x", "lp": -0.004651080816984177, "top": [["x", -0.004651080816984177], ["X", -6.003746032714844]]}], "text": "# PKGBUILD `build()` Function Explained\n\nLet me walk through this function line by line, flag by flag. This is building llama.cpp with Intel SYCL support for GPU acceleration.\n\n## Setting Up the Environment\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compilers, libraries, paths). The `--force` flag forces the environment to be set even if it appears already configured. Without this, `icx`/`icpx` wouldn't be found.\n\n```bash\nset -e\n```\nMakes the script exit immediately if any command returns a non-zero status. Essential for catching build failures.\n\n## The CMake Configuration\n\nNow the main `cmake` command. Let me break down each flag:\n\n| Flag | Purpose |\n|------|---------|\n| `-S \"${srcdir}/llama.cpp\"` | **S**ource directory \u2014 where the source code lives |\n| `-B \"${srcdir}/build\"` | **B**uild directory \u2014 where compiled output goes |\n| `-G Ninja` | Use the **Ninja** build system (fast, efficient Makefile alternative) |\n\n### Build Type & Installation\n```\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimized build with performance flags enabled (no debugging).\n\n```\n-DCMAKE_INSTALL_PREFIX=/usr\n```\nInstall location root \u2014 `/usr` (standard system location).\n\n```\n-DCMAKE_INSTALL_LIBDIR=lib\n```\nPut libraries in `/usr/lib` (not `/usr/lib64` or `/usr/lib/x86_64-linux-gnu`).\n\n### Compilers\n```\n-DCMAKE_C_COMPILER=icx\n-DCMAKE_CXX_COMPILER=icpx\n```\nUse Intel's **icx"}