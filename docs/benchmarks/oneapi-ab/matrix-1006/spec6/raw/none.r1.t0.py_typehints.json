3243103027]]}, {"t": " and", "lp": -0.02742450311779976, "top": [[" and", -0.02742450311779976], [" then", -3.7629687786102295]]}, {"t": " prints", "lp": -0.32177960872650146, "top": [[" prints", -0.32177960872650146], [" reports", -1.5069793462753296]]}, {"t": " a", "lp": -0.17189250886440277, "top": [[" a", -0.17189250886440277], [" the", -2.5156540870666504]]}, {"t": " table", "lp": -0.09266842156648636, "top": [[" table", -0.09266842156648636], [" markdown", -2.971759796142578]]}, {"t": " showing", "lp": -0.15761740505695343, "top": [[" showing", -0.15761740505695343], [" including", -3.1534459590911865]]}, {"t": " the", "lp": -0.9539557695388794, "top": [[" the", -0.9539557695388794], [" those", -1.161030888557434]]}, {"t": " mean", "lp": -0.0606578029692173, "top": [[" mean", -0.0606578029692173], [" means", -3.3474297523498535]]}, {"t": " for", "lp": -0.9927353262901306, "top": [[" for", -0.9927353262901306], [" value", -1.3292487859725952]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown results file.\n\n    Reads the file line by line, treating each line as a pipe-delimited table row.\n    For rows whose second-to-last column matches one of the known TESTS, extracts\n    the leading numeric value from the last column and stores it keyed by the test name.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matched test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Collects per-arm results across all markdown files in the directory, computes\n    the mean over rounds for each test, and prints a table showing the mean for"}