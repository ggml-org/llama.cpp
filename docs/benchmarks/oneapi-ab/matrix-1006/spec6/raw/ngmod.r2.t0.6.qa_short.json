9984741]]}, {"t": " allocation", "lp": -0.6106224060058594, "top": [[" allocation", -0.6106224060058594], [" behavior", -1.9929370880126953]]}, {"t": " behavior", "lp": -1.6911925077438354, "top": [[" if", -0.6102064847946167], [" behavior", -1.6911925077438354]]}, {"t": " if", "lp": -0.27593672275543213, "top": [[" if", -0.27593672275543213], [" when", -1.561562180519104]]}, {"t": " something", "lp": -1.778968334197998, "top": [[" you", -0.6532072424888611], [" debugging", -1.664781093597412]]}, {"t": " looks", "lp": -0.5423004627227783, "top": [[" looks", -0.5423004627227783], [" seems", -1.613185167312622]]}, {"t": " wrong", "lp": -0.20337052643299103, "top": [[" wrong", -0.20337052643299103], [" off", -1.7053656578063965]]}, {"t": "\n\n", "lp": -0.010852842591702938, "top": [["\n\n", -0.010852842591702938], ["\n", -4.612497329711914]]}, {"t": "Would", "lp": -0.7737904787063599, "top": [["Would", -0.7737904787063599], ["---", -1.9309827089309692]]}, {"t": " you", "lp": -0.0018526777857914567, "top": [[" you", -0.0018526777857914567], [" like", -7.602795124053955]]}, {"t": " like", "lp": -0.0004777857393492013, "top": [[" like", -0.0004777857393492013], [" tell", -8.788063049316406]]}], "text": "# CCS Modes on Intel Arc (xe driver)\n\nThe `ccs_mode` kernel parameter controls how Compute Slice (CCS) contexts are allocated on your GPU. This matters for compute workloads and can significantly affect performance.\n\n## The Modes\n\n**Mode 0 (default)**\n- The driver uses its default heuristics for CCS allocation\n- Generally fine for most workloads, no manual tuning required\n\n**Mode 1**\n- Uses a **flat/linear** CCS allocation strategy\n- CCS IDs are assigned in a simple sequential manner across the device\n- Can help avoid certain allocation conflicts that occur with the default mode\n\n**Mode 2**\n- Uses a **grouped/clustered** allocation strategy\n- CCS IDs are grouped together, which can better match the physical layout of the compute slices\n- Often provides better performance for compute-heavy workloads because it reduces cross-CCS communication overhead and better aligns with hardware topology\n\n## When to Use Mode 4\n\nMode 4 is a **diagnostic/debugging** mode. It's used when you want to:\n\n- **Dump CCS allocation information** for troubleshooting\n- **Inspect how the driver is mapping CCS IDs** to physical resources\n- Diagnose issues related to context switching, compute scheduling, or CCS exhaustion\n\nYou'd typically reach for mode 4 when something isn't working correctly and you need visibility into what the driver is doing under the hood\u2014not as a performance setting.\n\n## Practical Note\n\nThe exact behavioral differences can vary slightly depending on your driver version and Arc generation (the A770 is Alchemist). If you're tuning for performance:\n\n1. Start with the default (mode 0)\n2. Try mode 2 if you're doing heavy compute and see scheduling issues\n3. Use mode 4 to inspect allocation behavior if something looks wrong\n\nWould you like"}