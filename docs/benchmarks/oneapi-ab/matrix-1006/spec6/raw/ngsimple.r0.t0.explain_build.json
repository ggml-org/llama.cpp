10.648004531860352]]}, {"t": " Use", "lp": -0.0005281770136207342, "top": [[" Use", -0.0005281770136207342], [" Intel", -8.350284576416016]]}, {"t": " Intel", "lp": -0.0002763056836556643, "top": [[" Intel", -0.0002763056836556643], ["Intel", -8.48515796661377]]}, {"t": "'s", "lp": -4.6373490476980805e-05, "top": [["'s", -4.6373490476980805e-05], ["\u7684", -10.636398315429688]]}, {"t": " **", "lp": -0.009301995858550072, "top": [[" **", -0.009301995858550072], [" C", -5.345880508422852]]}, {"t": "C", "lp": -1.6212594346143305e-05, "top": [["C", -1.6212594346143305e-05], ["c", -13.033190727233887]]}, {"t": "++", "lp": -0.0006543750059790909, "top": [["++", -0.0006543750059790909], ["XX", -7.365327835083008]]}, {"t": "**", "lp": -0.022428782656788826, "top": [["**", -0.022428782656788826], ["/", -4.04440450668335]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. This is essential because we're compiling with Intel's `icx`/`icpx` compilers, not the default GCC.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command returns a non-zero (error) status. A safety net so a failed command doesn't cascade into broken output.\n\n## The CMake Configuration\n\nNow the main `cmake` command. Let me flag each part:\n\n| Flag | Purpose |\n|------|---------|\n| `-S \"${srcdir}/llama.cpp\"` | **Source directory** \u2014 where the source code lives |\n| `-B \"${srcdir}/build\"` | **Build directory** \u2014 where build artifacts go (out-of-source build) |\n| `-G Ninja` | Use the **Ninja** build system (fast, efficient) instead of Make |\n| `-DCMAKE_BUILD_TYPE=Release` | Optimize build with performance flags (`-O3`, etc.) |\n| `-DCMAKE_INSTALL_PREFIX=/usr` | Where files will be installed (standard system location) |\n| `-DCMAKE_INSTALL_LIBDIR=lib` | Install libraries to `lib/` (not `lib64/`) |\n| `-DCMAKE_C_COMPILER=icx` | Use Intel's **C** compiler (`icx`) |\n| `-DCMAKE_CXX_COMPILER=icpx` | Use Intel's **C++**"}