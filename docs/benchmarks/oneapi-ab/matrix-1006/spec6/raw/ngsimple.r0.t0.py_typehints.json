: -0.00039483950240537524, "top": [["   ", -0.00039483950240537524], [" the", -10.574037551879883]]}, {"t": " the", "lp": -0.02264556661248207, "top": [[" the", -0.02264556661248207], [" mean", -4.37814474105835]]}, {"t": " mean", "lp": -0.0002293253637617454, "top": [[" mean", -0.0002293253637617454], [" average", -9.509041786193848]]}, {"t": " over", "lp": -0.43253329396247864, "top": [[" over", -0.43253329396247864], [" value", -1.1711406707763672]]}, {"t": " rounds", "lp": -0.0018298669019713998, "top": [[" rounds", -0.0018298669019713998], [" repeats", -7.755577564239502]]}, {"t": " for", "lp": -0.0035039708018302917, "top": [[" for", -0.0035039708018302917], [" per", -6.436918258666992]]}, {"t": " each", "lp": -0.00016774154209997505, "top": [[" each", -0.00016774154209997505], [" the", -10.691007614135742]]}, {"t": " test", "lp": -0.021881114691495895, "top": [[" test", -0.021881114691495895], [" arm", -4.470001220703125]]}, {"t": ".", "lp": -0.2679598033428192, "top": [[".", -0.2679598033428192], [" and", -2.0844614505767822]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict mapping test name to value.\n\n    Reads the file line by line, expecting pipe-delimited table rows. For each row,\n    the second-to-last column must be one of the known TESTS; the last column is\n    parsed as a float. Matching entries are collected into a dict.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects per-arm results across all markdown files in the directory, computing\n    the mean over rounds for each test."}