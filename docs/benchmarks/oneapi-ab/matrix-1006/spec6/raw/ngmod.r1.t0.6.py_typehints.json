utes", -0.13811612129211426], ["\n", -3.005650758743286]]}, {"t": "\n", "lp": -0.00046240052324719727, "top": [["\n", -0.00046240052324719727], [" the", -9.526247024536133]]}, {"t": "   ", "lp": -0.0003944817290175706, "top": [["   ", -0.0003944817290175706], [" the", -10.569879531860352]]}, {"t": " the", "lp": -0.0015749214217066765, "top": [[" the", -0.0015749214217066765], [" per", -7.281136989593506]]}, {"t": " mean", "lp": -0.0005461872788146138, "top": [[" mean", -0.0005461872788146138], [" per", -8.553118705749512]]}, {"t": " over", "lp": -0.49629339575767517, "top": [[" over", -0.49629339575767517], [" value", -1.2388604879379272]]}, {"t": " rounds", "lp": -0.0033661690540611744, "top": [[" rounds", -0.0033661690540611744], [" the", -6.306033611297607]]}, {"t": " for", "lp": -0.006670440547168255, "top": [[" for", -0.006670440547168255], [" per", -5.121160984039307]]}, {"t": " each", "lp": -0.002388346940279007, "top": [[" each", -0.002388346940279007], [" every", -6.089348316192627]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file.\n\n    Reads the file line by line and extracts throughput values from rows that\n    represent a known test. Each line is expected to be pipe-delimited; the\n    test name lives in the second-to-last column and the numeric value in the\n    last column.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each detected test name to the float value parsed from\n        the last matching line for that test.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Collects per-arm results across all markdown files in ``ROOT / d``, computes\n    the mean over rounds for each"}