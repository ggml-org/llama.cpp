" per", "lp": -1.1953539848327637, "top": [[" per", -1.1953539848327637], [" all", -1.6293731927871704]]}, {"t": "-arm", "lp": -0.14619241654872894, "top": [["-arm", -0.14619241654872894], ["-round", -2.0402793884277344]]}, {"t": " metric", "lp": -0.38492530584335327, "top": [[" metric", -0.38492530584335327], [" metrics", -1.4870409965515137]]}, {"t": " values", "lp": -0.07865763455629349, "top": [[" values", -0.07865763455629349], [" means", -3.141634464263916]]}, {"t": " across", "lp": -0.20644688606262207, "top": [[" across", -0.20644688606262207], [" from", -1.7888615131378174]]}, {"t": " all", "lp": -0.02936244010925293, "top": [[" all", -0.02936244010925293], [" every", -3.658554792404175]]}, {"t": " matching", "lp": -1.778448224067688, "top": [[" markdown", -1.2117711305618286], [" round", -1.7646448612213135]]}, {"t": " markdown", "lp": -0.15889492630958557, "top": [[" markdown", -0.15889492630958557], [" `.", -3.426095485687256]]}, {"t": " files", "lp": -0.0007651394698768854, "top": [[" files", -0.0007651394698768854], [" round", -8.080764770507812]]}], "text": "Here's the complete file with docstrings added to every function:\n\n```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse one matrix result markdown file into a dict of arm -> metric value.\n\n    Reads the file line by line, keeping only rows whose second-to-last column\n    is one of the known TESTS arms. The last column is expected to be a numeric\n    value, which is captured with a leading regex match.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each qualifying arm name to the float value parsed from\n        the corresponding row.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for one experiment directory.\n\n    Collects per-arm metric values across all matching markdown files"}