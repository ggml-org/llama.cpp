 "top": [[" timings", -0.148445263504982], [" round", -2.4790232181549072]]}, {"t": " across", "lp": -0.37001147866249084, "top": [[" across", -0.37001147866249084], [" for", -1.5701744556427002]]}, {"t": " all", "lp": -0.07270124554634094, "top": [[" all", -0.07270124554634094], [" every", -2.67574405670166]]}, {"t": " round", "lp": -1.4574333429336548, "top": [[" round", -1.4574333429336548], [" markdown", -1.5992447137832642]]}, {"t": " files", "lp": -0.0587814524769783, "top": [[" files", -0.0587814524769783], [" markdown", -3.265477180480957]]}, {"t": " in", "lp": -0.29542696475982666, "top": [[" in", -0.29542696475982666], [" (*.", -2.117936849594116]]}, {"t": " ROOT", "lp": -2.016101837158203, "top": [[" `", -1.159759521484375], [" <", -1.1630288362503052]]}, {"t": "/<", "lp": -0.03878616914153099, "top": [["/<", -0.03878616914153099], ["/d", -3.3189775943756104]]}, {"t": "d", "lp": -0.07126190513372421, "top": [["d", -0.07126190513372421], ["dir", -2.749779224395752]]}, {"t": ">,", "lp": -0.23828299343585968, "top": [[">,", -0.23828299343585968], [">", -1.7864091396331787]]}], "text": "Here's the complete file with docstrings added to every function:\n\n```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file and extract per-arm timings.\n\n    Reads the file line by line, looking for table rows whose second-to-last\n    column matches one of the TESTS names. The last column is expected to\n    contain a numeric value (the round's timing), which is captured via a\n    leading-number regex.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for one experiment directory.\n\n    Collects parsed timings across all round files in ROOT/<d>,"}