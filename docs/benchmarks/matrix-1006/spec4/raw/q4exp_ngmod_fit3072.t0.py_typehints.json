66, "top": [[" and", -0.9464677572250366], [" per", -0.9619382619857788]]}, {"t": " test", "lp": -0.090262271463871, "top": [[" test", -0.090262271463871], [" per", -2.4783942699432373]]}, {"t": ",", "lp": -0.032835617661476135, "top": [[",", -0.032835617661476135], [" type", -3.7127139568328857]]}, {"t": " and", "lp": -0.18805070221424103, "top": [[" and", -0.18805070221424103], [" calculates", -2.5438990592956543]]}, {"t": " prints", "lp": -0.11744418740272522, "top": [[" prints", -0.11744418740272522], [" calculates", -3.1630890369415283]]}, {"t": " a", "lp": -0.007075846660882235, "top": [[" a", -0.007075846660882235], [" them", -5.872445583343506]]}, {"t": " markdown", "lp": -0.5765706300735474, "top": [[" markdown", -0.5765706300735474], [" formatted", -0.9784203767776489]]}, {"t": " table", "lp": -0.25381097197532654, "top": [[" table", -0.25381097197532654], ["-form", -1.6857300996780396]]}, {"t": " showing", "lp": -0.31159377098083496, "top": [[" showing", -0.31159377098083496], [" comparing", -1.8868443965911865]]}, {"t": "\n", "lp": -0.2785274386405945, "top": [["\n", -0.2785274386405945], [" \n", -1.4904072284698486]]}, {"t": "   ", "lp": -0.0004810059326700866, "top": [["   ", -0.0004810059326700866], ["       ", -8.860295295715332]]}, {"t": " each", "lp": -1.5093711614608765, "top": [[" each", -1.5093711614608765], [" performance", -1.5381301641464233]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float results from the last column of matching table rows.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm and test, and prints a markdown table showing\n    each"}