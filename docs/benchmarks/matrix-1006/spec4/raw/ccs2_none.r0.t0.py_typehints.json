   m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Collects results across all round files in `ROOT/<d>`, computes the mean\n    value per test for each arm, and prints"}