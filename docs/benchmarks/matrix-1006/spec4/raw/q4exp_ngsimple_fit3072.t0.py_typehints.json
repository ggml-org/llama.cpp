", -0.39798498153686523], [" comparing", -1.6586432456970215]]}, {"t": "\n", "lp": -0.3065092861652374, "top": [["\n", -0.3065092861652374], [" \n", -1.4169142246246338]]}, {"t": "   ", "lp": -0.0005173829267732799, "top": [["   ", -0.0005173829267732799], ["       ", -8.790814399719238]]}, {"t": " performance", "lp": -1.4462741613388062, "top": [[" performance", -1.4462741613388062], [" each", -1.722057580947876]]}, {"t": " deltas", "lp": -0.32918283343315125, "top": [[" deltas", -0.32918283343315125], [" metrics", -2.0836803913116455]]}, {"t": " relative", "lp": -0.30821940302848816, "top": [[" relative", -0.30821940302848816], [" compared", -1.6134945154190063]]}, {"t": " to", "lp": -2.4915052563301288e-05, "top": [[" to", -2.4915052563301288e-05], [" the", -11.327081680297852]]}, {"t": " the", "lp": -0.2407011091709137, "top": [[" the", -0.2407011091709137], [" a", -1.544495940208435]]}, {"t": " baseline", "lp": -0.025213250890374184, "top": [[" baseline", -0.025213250890374184], [" specified", -3.928720474243164]]}, {"t": " arm", "lp": -0.00031190013396553695, "top": [[" arm", -0.00031190013396553695], [" arms", -9.685587882995605]]}, {"t": ".", "lp": -0.004398767836391926, "top": [[".", -0.004398767836391926], ["'s", -5.67797327041626]]}, {"t": "\n", "lp": -0.012190012261271477, "top": [["\n", -0.012190012261271477], ["\n\n", -5.576208114624023]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm and test, and prints a markdown table showing\n    performance deltas relative to the baseline arm.\n"}