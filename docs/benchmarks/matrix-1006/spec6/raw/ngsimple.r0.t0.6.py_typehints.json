TS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single results directory.\n\n    Collects the parsed results for every round file in ``ROOT / d``, computes\n    the mean value per arm and per test, and prints a markdown table showing the\n"}