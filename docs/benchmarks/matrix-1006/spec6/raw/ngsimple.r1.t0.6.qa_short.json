1.468037605285645]]}, {"t": " entries", "lp": -0.8099418878555298, "top": [[" entries", -0.8099418878555298], [" attributes", -1.5452038049697876]]}, {"t": ".", "lp": -0.6202573180198669, "top": [[".", -0.6202573180198669], [",", -2.252169609069824]]}, {"t": "\n\n", "lp": -0.0006611744174733758, "top": [["\n\n", -0.0006611744174733758], [" Would", -8.613612174987793]]}, {"t": "Would", "lp": -0.15418745577335358, "top": [["Would", -0.15418745577335358], ["4", -2.7013561725616455]]}, {"t": " you", "lp": -0.001406167633831501, "top": [[" you", -0.001406167633831501], [" it", -7.097690105438232]]}, {"t": " like", "lp": -0.04698602855205536, "top": [[" like", -0.04698602855205536], [" tell", -3.315247058868408]]}, {"t": " me", "lp": -0.5451345443725586, "top": [[" me", -0.5451345443725586], [" help", -1.1755704879760742]]}, {"t": " to", "lp": -0.0007390726241283119, "top": [[" to", -0.0007390726241283119], [" help", -9.033538818359375]]}, {"t": " help", "lp": -0.1755867898464203, "top": [[" help", -0.1755867898464203], [" walk", -2.618694305419922]]}], "text": "# CCS Modes on Intel Arc Xe Driver\n\nThe Xe driver exposes different CCS (Compute and Graphics Engine) modes that control how the GPU's compute engines are partitioned and exposed. Here's the breakdown:\n\n## CCS Mode 1\n- Exposes the GPU's compute engines in a **single, unified configuration**\n- The compute subsystem is presented as one large resource\n- Simpler addressing model; the driver treats the engines collectively\n- Good default choice for most workloads\n\n## CCS Mode 2\n- Partitions the compute engines into **separate, smaller units**\n- Allows finer-grained control over compute partitioning\n- Useful when you want to isolate or dedicate specific compute resources\n- Can matter for workloads that benefit from explicit engine separation\n\n## CCS Mode 4\nThis is typically used when you want **maximum partitioning** or a specific **MIG-like (Multi-Instance GPU) style partitioning** where you need to carve the GPU into independent slices.\n\n---\n\n## A Note on Accuracy\n\nI want to be honest about my uncertainty here. The exact numeric semantics of these CCS mode values aren't something I can state with high confidence\u2014they vary by driver version and the values may have specific meanings documented in Intel's kernel driver code (`xe` driver) that I don't want to guess at incorrectly.\n\n**To get a definitive answer, I'd recommend:**\n\n1. **Checking the driver source** \u2014 the mode definitions live in the `xe` driver (now merged into mainline Linux kernel). Look for the mode enum in the relevant driver files.\n\n2. **Looking at `xe` documentation** in the kernel tree (`Documentation/` or driver headers).\n\n3. **Using `xe` sysfs/debugfs** \u2014 the actual exposed mode on your system can be read from sysfs entries.\n\nWould you like me to help"}