"`,", "lp": -0.0010192221961915493, "top": [["`,", -0.0010192221961915493], ["`.", -7.141149044036865]]}, {"t": " computing", "lp": -0.5716496109962463, "top": [[" computing", -0.5716496109962463], [" computes", -1.2601680755615234]]}, {"t": " the", "lp": -0.07037375122308731, "top": [[" the", -0.07037375122308731], ["\n", -2.727033853530884]]}, {"t": "\n", "lp": -0.001023935852572322, "top": [["\n", -0.001023935852572322], [" mean", -7.919276237487793]]}, {"t": "   ", "lp": -0.0003072495455853641, "top": [["   ", -0.0003072495455853641], [" mean", -10.826900482177734]]}, {"t": " mean", "lp": -0.000873291224706918, "top": [[" mean", -0.000873291224706918], [" per", -8.172706604003906]]}, {"t": " value", "lp": -0.6489418745040894, "top": [[" value", -0.6489418745040894], [" over", -0.806660532951355]]}, {"t": " per", "lp": -0.49366527795791626, "top": [[" per", -0.49366527795791626], [" over", -1.6626392602920532]]}, {"t": " test", "lp": -0.6227813959121704, "top": [[" test", -0.6227813959121704], [" round", -0.7843567132949829]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single matrix report markdown file.\n\n    Reads the file line by line, treating each line as a pipe-delimited table row.\n    For rows whose second-to-last column matches one of the known TESTS, the leading\n    numeric value from the last column is extracted and stored in a dict keyed by\n    the test name.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matched test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of reports.\n\n    Collects per-arm metrics across all markdown files in `ROOT/<d>`, computing the\n    mean value per test"}