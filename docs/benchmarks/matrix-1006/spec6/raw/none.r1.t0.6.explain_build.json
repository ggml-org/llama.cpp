4741516113]]}, {"t": "\n", "lp": -0.0031192621681839228, "top": [["\n", -0.0031192621681839228], [" \\", -5.985994338989258]]}, {"t": "```", "lp": -6.675942859146744e-05, "top": [["```", -6.675942859146744e-05], ["-", -11.984111785888672]]}, {"t": "\n", "lp": -0.0007808872614987195, "top": [["\n", -0.0007808872614987195], ["\n\n", -7.387070655822754]]}, {"t": "-", "lp": -0.04938577115535736, "top": [["-", -0.04938577115535736], ["This", -4.138636112213135]]}, {"t": " `", "lp": -0.31086376309394836, "top": [[" `", -0.31086376309394836], [" **", -1.3227665424346924]]}, {"t": "ic", "lp": -0.00033229149994440377, "top": [["ic", -0.00033229149994440377], [" ic", -9.99166202545166]]}, {"t": "x", "lp": -0.0005846540443599224, "top": [["x", -0.0005846540443599224], [" x", -9.843993186950684]]}, {"t": "`", "lp": -0.0008692345581948757, "top": [["`", -0.0008692345581948757], ["`=", -7.664862155914307]]}], "text": "# PKGBUILD build() Function: Step by Step\n\nLet me break down this `build()` function in detail. This is building a specialized version of llama.cpp for AMD Ryzen (Zen 4) and Intel Arc GPU hardware using Intel's SYCL toolkit.\n\n## Overview\n\nThe `build()` function compiles llama.cpp using Intel's oneAPI DPC++/C++ compiler (`icx`/`icpx`) with SYCL GPU support. Let me explain each component.\n\n## Line-by-Line Breakdown\n\n### 1. Setting up the Intel oneAPI environment\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables, making the `icx` and `icpx` compilers available in your shell's PATH. The `--force` flag ensures it works even if the environment was previously initialized.\n\n**Why?** The SYCL compilers aren't part of a normal Arch installation\u2014you must source Intel's script to access them.\n\n### 2. Enabling strict error handling\n```bash\nset -e\n```\nThis makes the script exit immediately if any command fails (returns non-zero). This is standard practice in build functions to catch errors early.\n\n### 3. The CMake Configuration\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S \"${srcdir}/llama.cpp\"` \u2014 Source directory (where the CMakeLists.txt lives)\n- `-B \"${srcdir}/build\"` \u2014 Build output directory\n- `-G Ninja` \u2014 Use the Ninja build system (faster than Make)\n\n### Compiler Selection Flags\n\n```bash\n-DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx\n```\n- `icx`"}