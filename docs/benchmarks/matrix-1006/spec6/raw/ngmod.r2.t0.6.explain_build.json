51808968e-05], [" |", -10.479352951049805]]}, {"t": " `-", "lp": -0.408019483089447, "top": [[" `-", -0.408019483089447], [" **", -1.11868417263031]]}, {"t": "S", "lp": -8.845720731187612e-05, "top": [["S", -8.845720731187612e-05], ["B", -12.194258689880371]]}, {"t": " \"${", "lp": -0.01511440984904766, "top": [[" \"${", -0.01511440984904766], ["`", -5.2514119148254395]]}, {"t": "src", "lp": -0.0013996019260957837, "top": [["src", -0.0013996019260957837], [" src", -8.843725204467773]]}, {"t": "dir", "lp": -0.00122855044901371, "top": [["dir", -0.00122855044901371], ["dist", -8.607477188110352]]}], "text": "# PKGBUILD build() Function \u2014 Step by Step\n\nThis is the `build()` function for a custom `llama.cpp` package compiled for a **Ryzen 9 7900X3D CPU** and **Intel Arc A770 GPU** using Intel's SYCL toolchain. Let me break down each piece.\n\n---\n\n## The Two Main Steps\n\nThe `build()` function has exactly **two** operations:\n\n1. **Set up the Intel oneAPI environment** (`source ... /setvars.sh`)\n2. **Run CMake** to configure the build\n\n---\n\n## Step 1: Environment Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\n\nThis loads Intel's oneAPI environment variables (paths to `icx`/`icpx` compilers, libraries, etc.) into the current shell.\n\n- **`/opt/intel/oneapi/setvars.sh`** \u2014 Intel's standard env-setup script.\n- **`--force`** \u2014 Forces the environment to be configured even if variables are already set. Without this, the script may refuse to change an existing configuration.\n\n> Without this line, the `icx`/`icpx` compilers wouldn't be found by CMake.\n\n```bash\nset -e\n```\n\nStands for **\"exit on error.\"** If any command fails, the build aborts immediately. This prevents a broken build from silently producing a bad binary.\n\n---\n\n## Step 2: CMake Configuration\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n\nThis configures the build. Let's flag by flag:\n\n| Flag | Meaning |\n|------|---------|\n| `-S \"${srcdir"}