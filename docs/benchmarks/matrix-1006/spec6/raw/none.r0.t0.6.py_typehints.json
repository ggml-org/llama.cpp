: [[" by", -0.011188880540430546], [" per", -4.5101399421691895]]}, {"t": " arm", "lp": -0.3387826681137085, "top": [[" arm", -0.3387826681137085], [" \"", -1.3712762594223022]]}, {"t": ".", "lp": -0.514389157295227, "top": [[".", -0.514389157295227], [" (", -1.4003716707229614]]}, {"t": " Computes", "lp": -0.6680450439453125, "top": [[" Computes", -0.6680450439453125], [" For", -1.317728042602539]]}, {"t": " the", "lp": -0.06640864163637161, "top": [[" the", -0.06640864163637161], [" mean", -3.1481080055236816]]}, {"t": " mean", "lp": -0.006131154019385576, "top": [[" mean", -0.006131154019385576], [" average", -6.209904670715332]]}, {"t": " value", "lp": -0.6134386658668518, "top": [[" value", -0.6134386658668518], [" over", -1.2149440050125122]]}, {"t": " per", "lp": -1.0130878686904907, "top": [[" for", -0.6981254816055298], [" per", -1.0130878686904907]]}, {"t": " test", "lp": -0.05833204463124275, "top": [[" test", -0.05833204463124275], [" round", -3.133897304534912]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown file and extract benchmark results.\n\n    Reads the file line by line, splitting each line on the pipe character ('|').\n    For lines that contain at least three pipe-delimited fields and whose second-to-last\n    field matches one of the known TESTS, the trailing numeric value is captured and stored.\n\n    Args:\n        p (Path): Path to the markdown file to parse.\n\n    Returns:\n        dict: A mapping of test name to the parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a given directory.\n\n    Collects benchmark data from all matching markdown files in the specified directory,\n    grouping results by arm. Computes the mean value per test"}