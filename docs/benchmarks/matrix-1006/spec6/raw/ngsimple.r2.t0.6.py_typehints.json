 out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Aggregates the parsed values from every ``*.md`` file in ``ROOT / d`` by arm, computes\n    the mean over rounds for each test, and prints the mean per arm together with the\n    percentage delta relative"}