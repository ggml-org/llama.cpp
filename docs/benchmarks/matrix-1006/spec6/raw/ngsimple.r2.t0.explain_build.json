, -10.003913879394531]]}, {"t": "=", "lp": -0.0004377727163955569, "top": [["=", -0.0004377727163955569], [" ic", -11.330191612243652]]}, {"t": "ic", "lp": -1.1682578588079195e-05, "top": [["ic", -1.1682578588079195e-05], [" ic", -12.13181209564209]]}, {"t": "px", "lp": -5.2572679123841226e-05, "top": [["px", -5.2572679123841226e-05], ["pz", -12.3646821975708]]}, {"t": "\n", "lp": -0.0007851821137592196, "top": [["\n", -0.0007851821137592196], [" \n", -8.457809448242188]]}, {"t": "```", "lp": -0.00012780052202288061, "top": [["```", -0.00012780052202288061], ["<tool_call>", -11.595806121826172]]}, {"t": "\n", "lp": -0.00027582873008213937, "top": [["\n", -0.00027582873008213937], ["\n\n", -8.612564086914062]]}, {"t": "Use", "lp": -0.5208285450935364, "top": [["Use", -0.5208285450935364], ["-", -1.4107038974761963]]}, {"t": " Intel", "lp": -0.0967940017580986, "top": [[" Intel", -0.0967940017580986], [" **", -2.424570083618164]]}, {"t": "'s", "lp": -0.015107753686606884, "top": [["'s", -0.015107753686606884], [" compilers", -4.444518566131592]]}, {"t": " **", "lp": -0.8231503367424011, "top": [[" **", -0.8231503367424011], [" compilers", -1.7876182794570923]]}, {"t": "ic", "lp": -0.28530383110046387, "top": [["ic", -0.28530383110046387], ["D", -2.5011069774627686]]}, {"t": "x", "lp": -0.008894965052604675, "top": [["x", -0.008894965052604675], ["X", -4.949681282043457]]}, {"t": "**", "lp": -0.0003213206655345857, "top": [["**", -0.0003213206655345857], ["**(", -9.26089096069336]]}, {"t": " (", "lp": -0.01919526793062687, "top": [[" (", -0.01919526793062687], [" for", -3.979072332382202]]}, {"t": "C", "lp": -0.0002965770836453885, "top": [["C", -0.0002965770836453885], ["for", -9.67064380645752]]}, {"t": ")", "lp": -0.2722681760787964, "top": [[")", -0.2722681760787964], [" compiler", -1.453531265258789]]}, {"t": " and", "lp": -0.0002718937466852367, "top": [[" and", -0.0002718937466852367], [" /", -9.168055534362793]]}, {"t": " **", "lp": -0.0006374364020302892, "top": [[" **", -0.0006374364020302892], [" *", -9.657478332519531]]}, {"t": "ic", "lp": -0.00011158612323924899, "top": [["ic", -0.00011158612323924899], [" ic", -10.565033912658691]]}, {"t": "px", "lp": -0.00020822070655412972, "top": [["px", -0.00020822070655412972], ["x", -10.137988090515137]]}, {"t": "**", "lp": -0.0011546122841536999, "top": [["**", -0.0011546122841536999], ["**(", -10.023587226867676]]}, {"t": " (", "lp": -0.0006494842818938196, "top": [[" (", -0.0006494842818938196], [" C", -8.169410705566406]]}, {"t": "C", "lp": -4.041276406496763e-05, "top": [["C", -4.041276406496763e-05], ["++)", -10.792144775390625]]}, {"t": "++)", "lp": -0.658728301525116, "top": [["++)", -0.658728301525116], ["++", -0.7317301630973816]]}, {"t": " compilers", "lp": -0.567209005355835, "top": [[" compilers", -0.567209005355835], [" SY", -1.1263234615325928]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. This is essential because we're using Intel's SYCL compilers (`icx`/`icpx`) rather than the default GCC.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command returns a non-zero (error) status. A safety net so the build stops on failure rather than continuing with broken state.\n\n## The CMake Configuration\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S` : source directory (the cloned git repo)\n- `-B` : build directory\n- `-G Ninja` : use the **Ninja** build generator (fast, minimal output) instead of Make\n\n## Build Type & Install Paths\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimized build with compiler optimizations enabled (no debug symbols). This aligns with the `!debug` option noted earlier.\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib\n```\nInstall location: `/usr` with libraries going to `/usr/lib` (not `/usr/lib64`, which some distros use).\n\n## The Compilers\n\n```bash\n-DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx\n```\nUse Intel's **icx** (C) and **icpx** (C++) compilers"}