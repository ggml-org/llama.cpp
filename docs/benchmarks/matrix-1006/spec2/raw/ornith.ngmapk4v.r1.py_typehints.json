 "top": [[" across", -0.1355726271867752], [" from", -2.2207376956939697]]}, {"t": " all", "lp": -0.003150174394249916, "top": [[" all", -0.003150174394249916], [" every", -6.617728233337402]]}, {"t": " markdown", "lp": -0.7230979800224304, "top": [[" markdown", -0.7230979800224304], [" matching", -1.017268419265747]]}, {"t": " files", "lp": -0.0002913303324021399, "top": [[" files", -0.0002913303324021399], [" match", -9.874431610107422]]}, {"t": " in", "lp": -0.010029254481196404, "top": [[" in", -0.010029254481196404], [" matching", -4.9240593910217285]]}, {"t": " ROOT", "lp": -1.337518334388733, "top": [[" ROOT", -1.337518334388733], [" `", -1.413272500038147]]}, {"t": "/<", "lp": -0.10238856822252274, "top": [["/<", -0.10238856822252274], ["/d", -2.366132974624634]]}, {"t": "d", "lp": -0.28557294607162476, "top": [["d", -0.28557294607162476], ["dir", -1.4093550443649292]]}, {"t": ">,", "lp": -0.04961436986923218, "top": [[">,", -0.04961436986923218], [">", -3.3969712257385254]]}, {"t": " computing", "lp": -0.5962218046188354, "top": [[" computing", -0.5962218046188354], [" computes", -1.0790594816207886]]}], "text": "Here's the file with docstrings added to every function:\n\n```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, looking for table rows whose second-to-last\n    column matches one of the TESTS names. The last column is expected to\n    contain a numeric value, which is extracted with a regex and stored.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects per-arm results across all markdown files in ROOT/<d>, computing"}