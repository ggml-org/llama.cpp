125091553]]}, {"t": "ROC", "lp": -0.8387707471847534, "top": [["ROC", -0.8387707471847534], ["compute", -2.3461902141571045]]}, {"t": "m", "lp": -0.0002597311686258763, "top": [["m", -0.0002597311686258763], ["min", -8.77131462097168]]}, {"t": ",", "lp": -0.13971227407455444, "top": [[",", -0.13971227407455444], ["/V", -2.966341972351074]]}, {"t": " CUDA", "lp": -0.9017776250839233, "top": [[" CUDA", -0.9017776250839233], [" one", -2.152357578277588]]}, {"t": " equivalents", "lp": -1.6336101293563843, "top": [[" equivalents", -1.6336101293563843], [" via", -1.7225916385650635]]}, {"t": ",", "lp": -0.0058509474620223045, "top": [[",", -0.0058509474620223045], [" on", -5.629263877868652]]}, {"t": " or", "lp": -0.5273465514183044, "top": [[" or", -0.5273465514183044], [" etc", -1.4811753034591675]]}, {"t": " compute", "lp": -0.9844896197319031, "top": [[" compute", -0.9844896197319031], [" Open", -2.0879995822906494]]}, {"t": " benchmarks", "lp": -0.06822662055492401, "top": [[" benchmarks", -0.06822662055492401], [" kernels", -2.8564345836639404]]}], "text": "# CCS Modes on Intel Arc (xe driver)\n\nThe `ccs_mode` parameter controls how Compute Slice (CCS) contexts are handled by the Xe driver. Here's what each mode does:\n\n## CCS Mode 1\n- **Context stealing / preemption-based**\n- The driver uses hardware preemption to manage compute contexts\n- CCS contexts can be preempted and resumed\n- More flexible for mixed workloads but can have overhead from preemption management\n\n## CCS Mode 2\n- **Dedicated CCS allocation**\n- Compute contexts get dedicated CCS resources\n- Less reliance on preemption\n- Can provide more predictable performance for sustained compute workloads\n\n## CCS Mode 4\n- Typically relates to **how CCS contexts are pinned or their priority handling**\n- Often used for scenarios requiring **guaranteed compute availability** or specific scheduling behavior\n\n---\n\n## Important Caveat\n\nI want to be honest with you: **I'm not fully certain about the exact semantics of these specific mode numbers** for the Xe driver. The `ccs_mode` parameter is fairly niche, and the precise meaning of modes 1, 2, and 4 can vary between driver versions and kernel releases.\n\n## What I'd Recommend\n\n1. **Check your actual driver documentation:**\n   ```bash\n   modinfo xe | grep ccs_mode\n   cat /sys/module/xe/parameters/ccs_mode\n   ```\n\n2. **Look at kernel source** if you have it:\n   ```\n   drivers/gpu/driver/xe/xe_gpu_scheduler.c\n   ```\n\n3. **For performance tuning**, the practical guidance is usually:\n   - Default mode is often fine for most workloads\n   - Higher modes may help with dedicated compute servers\n   - Test with your specific workload (ROCm, CUDA equivalents, or compute benchmarks"}