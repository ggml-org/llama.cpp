977825164795], ["\n", -1.2372864484786987]]}, {"t": "\n", "lp": -0.004756778944283724, "top": [["\n", -0.004756778944283724], [" prints", -5.666099548339844]]}, {"t": "   ", "lp": -4.4466054532676935e-05, "top": [["   ", -4.4466054532676935e-05], ["    ", -11.645211219787598]]}, {"t": " prints", "lp": -0.09085321426391602, "top": [[" prints", -0.09085321426391602], [" computes", -2.602266788482666]]}, {"t": " a", "lp": -0.05321329087018967, "top": [[" a", -0.05321329087018967], [" the", -3.4873526096343994]]}, {"t": " table", "lp": -0.22016558051109314, "top": [[" table", -0.22016558051109314], [" markdown", -1.8367122411727905]]}, {"t": " showing", "lp": -0.12088532000780106, "top": [[" showing", -0.12088532000780106], [" with", -3.260190486907959]]}, {"t": " the", "lp": -0.5530065298080444, "top": [[" the", -0.5530065298080444], [",", -1.5490907430648804]]}, {"t": " mean", "lp": -0.014171346090734005, "top": [[" mean", -0.014171346090734005], [" number", -5.257016658782959]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, treating each line as a pipe-delimited table.\n    For lines whose second-to-last column matches one of the TESTS names and whose\n    last column begins with a number, records that number keyed by the test name.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects per-arm mean values across all round files in the directory, then\n    prints a table showing the mean"}