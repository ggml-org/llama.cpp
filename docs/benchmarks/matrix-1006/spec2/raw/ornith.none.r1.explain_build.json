0.0006568800890818238], [" usr", -9.666748046875]]}, {"t": "`", "lp": -0.00022360202274285257, "top": [["`", -0.00022360202274285257], ["**", -10.052046775817871]]}, {"t": "**", "lp": -6.246761768124998e-05, "top": [["**", -6.246761768124998e-05], ["**:", -10.73225212097168]]}, {"t": " \u2014", "lp": -0.00012160086771473289, "top": [[" \u2014", -0.00012160086771473289], [" where", -9.923547744750977]]}, {"t": " Where", "lp": -0.18919587135314941, "top": [[" Where", -0.18919587135314941], [" Install", -2.59615159034729]]}, {"t": " `", "lp": -0.04933629930019379, "top": [[" `", -0.04933629930019379], [" files", -3.8280398845672607]]}, {"t": "make", "lp": -0.10594285279512405, "top": [["make", -0.10594285279512405], ["cm", -2.78031849861145]]}, {"t": " install", "lp": -0.0006237186607904732, "top": [[" install", -0.0006237186607904732], ["install", -8.206319808959961]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. This is essential because we're compiling with Intel's `icx`/`icpx` compilers, not the default GCC.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command fails (returns a non-zero exit code). A safety net so a broken build doesn't continue silently.\n\n## The CMake Invocation\n\nNow the main `cmake` command. Let me flag each part:\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja \\\n```\n- **`-S \"${srcdir}/llama.cpp`** \u2014 Source directory (where the CMakeLists.txt lives). `${srcdir}` is the build directory where the git clone was extracted.\n- **`-B \"${srcdir}/build`** \u2014 Build directory (where all compiled artifacts go).\n- **`-G Ninja`** \u2014 Use the **Ninja** build generator (fast, minimal output) instead of the default Makefiles.\n\n```bash\n    -DCMAKE_BUILD_TYPE=Release \\\n```\n- Compiles with **optimizations enabled** (`-O3`, `-DNDEBUG`). This is the production build type.\n\n```bash\n    -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib \\\n```\n- **`-DCMAKE_INSTALL_PREFIX=/usr`** \u2014 Where `make install"}