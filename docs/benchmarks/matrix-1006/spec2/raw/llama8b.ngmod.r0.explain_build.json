x-parallel-link-jobs=${_link_jobs}\" \\\n        # Enable native Zen 4 CPU and Arc A770 SYCL F16 AOT support\n        -DGGML_NATIVE=ON -DGGML_SYCL=ON -DGGML_SYCL_F16=ON \\\n        # Specify the SYCL device\n        -DGGML_SYCL_DEVICE=\"Zen4\" \\\n        # Specify the SYCL DNN flag\n        -DGGML_SYCL_DNN=${_sycl_dnn} \\\n        # Specify the large GRF flag\n        -DGGML_SYCL_FA_LARGE_GRF=${_fa_large_grf} \\\n        # Specify the number of jobs for the build process\n        -j${"}