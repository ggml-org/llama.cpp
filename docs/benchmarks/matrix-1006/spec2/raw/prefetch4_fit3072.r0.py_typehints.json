: -0.29876863956451416, "top": [[" then", -0.29876863956451416], [" computing", -2.582601308822632]]}, {"t": " prints", "lp": -0.24350321292877197, "top": [[" prints", -0.24350321292877197], [" computes", -1.8094898462295532]]}, {"t": " a", "lp": -0.01430610939860344, "top": [[" a", -0.01430610939860344], [" an", -5.408978462219238]]}, {"t": " markdown", "lp": -0.953251302242279, "top": [[" markdown", -0.953251302242279], [" table", -0.9918885231018066]]}, {"t": " table", "lp": -0.0031617742497473955, "top": [[" table", -0.0031617742497473955], ["-form", -6.726661205291748]]}, {"t": " showing", "lp": -0.1155124381184578, "top": [[" showing", -0.1155124381184578], [" with", -3.351935863494873]]}, {"t": " the", "lp": -0.5978310108184814, "top": [[" the", -0.5978310108184814], [" each", -1.2295163869857788]]}, {"t": " mean", "lp": -0.004515575710684061, "top": [[" mean", -0.004515575710684061], [" value", -6.201664924621582]]}, {"t": " for", "lp": -0.21983188390731812, "top": [[" for", -0.21983188390731812], [" per", -1.9968894720077515]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, expecting pipe-delimited table rows. For each\n    row whose second-to-last column matches one of the known TESTS, the trailing\n    numeric token in the last column is extracted and stored as a float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects per-arm mean values across all round files in the given directory,\n    then prints a markdown table showing the mean for"}