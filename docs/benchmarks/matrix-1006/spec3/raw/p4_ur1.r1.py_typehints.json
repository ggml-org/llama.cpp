": " showing", "lp": -0.2400680035352707, "top": [[" showing", -0.2400680035352707], [" that", -2.044459819793701]]}, {"t": "\n", "lp": -0.013040141202509403, "top": [["\n", -0.013040141202509403], [" the", -4.462666034698486]]}, {"t": "   ", "lp": -0.0006813939544372261, "top": [["   ", -0.0006813939544372261], ["       ", -9.738260269165039]]}, {"t": " the", "lp": -0.8451359868049622, "top": [[" the", -0.8451359868049622], [" each", -0.9411938786506653]]}, {"t": " mean", "lp": -0.11537797003984451, "top": [[" mean", -0.11537797003984451], [" delta", -2.8539528846740723]]}, {"t": " value", "lp": -1.0033104419708252, "top": [[" value", -1.0033104419708252], [" and", -1.1675312519073486]]}, {"t": " and", "lp": -0.9617290496826172, "top": [[" and", -0.9617290496826172], [" plus", -1.4192676544189453]]}, {"t": " the", "lp": -0.7039570212364197, "top": [[" the", -0.7039570212364197], [" its", -0.7147526144981384]]}, {"t": " percentage", "lp": -0.040590640157461166, "top": [[" percentage", -0.040590640157461166], [" delta", -3.4991133213043213]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single markdown results file.\n\n    Reads the file line by line, extracting rows that look like table entries\n    (pipe-delimited) whose second-to-last column matches one of the TESTS names.\n    The trailing numeric value from the last column is stored as a float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dict mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Collects per-arm results across all markdown files in the directory,\n    computes the mean over rounds for each test, and prints a table showing\n    the mean value and the percentage"}