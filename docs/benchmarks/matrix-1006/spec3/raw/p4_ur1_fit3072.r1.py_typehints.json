p() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single experiment directory.\n\n    Collects parsed results across all markdown files in `ROOT/<d>`, grouping\n    values by arm (derived from the file stem) and"}