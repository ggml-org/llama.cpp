]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory.\n\n    Reads all markdown files in matrix-1006/<dir>/ (excluding per-round files),\n    groups their parsed values by arm, computes the mean over rounds for"}