"top": [[" showing", -0.38529694080352783], [" comparing", -1.6931449174880981]]}, {"t": "\n", "lp": -0.30488380789756775, "top": [["\n", -0.30488380789756775], [" \n", -1.4163416624069214]]}, {"t": "   ", "lp": -0.00043980017653666437, "top": [["   ", -0.00043980017653666437], ["       ", -8.952260971069336]]}, {"t": " performance", "lp": -1.4127451181411743, "top": [[" performance", -1.4127451181411743], [" each", -1.751723051071167]]}, {"t": " deltas", "lp": -0.34112969040870667, "top": [[" deltas", -0.34112969040870667], [" metrics", -2.0155279636383057]]}, {"t": " relative", "lp": -0.3228590488433838, "top": [[" relative", -0.3228590488433838], [" compared", -1.557848334312439]]}, {"t": " to", "lp": -2.0265784769435413e-05, "top": [[" to", -2.0265784769435413e-05], [" the", -11.47336196899414]]}, {"t": " the", "lp": -0.23493628203868866, "top": [[" the", -0.23493628203868866], [" a", -1.5657888650894165]]}, {"t": " baseline", "lp": -0.023089159280061722, "top": [[" baseline", -0.023089159280061722], [" specified", -4.040759086608887]]}, {"t": " arm", "lp": -0.00033109899959526956, "top": [[" arm", -0.00033109899959526956], [" arms", -9.617584228515625]]}, {"t": ".", "lp": -0.0036925815511494875, "top": [[".", -0.0036925815511494875], ["'s", -5.884565353393555]]}, {"t": "\n", "lp": -0.010658478364348412, "top": [["\n", -0.010658478364348412], [" Sk", -5.7121124267578125]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm and test, and prints a markdown table showing\n    performance deltas relative to the baseline arm.\n"}