5644226074], [" comparing", -1.6164565086364746]]}, {"t": "\n", "lp": -0.28829309344291687, "top": [["\n", -0.28829309344291687], [" \n", -1.470322847366333]]}, {"t": "   ", "lp": -0.0004603730340022594, "top": [["   ", -0.0004603730340022594], ["       ", -8.890341758728027]]}, {"t": " performance", "lp": -1.4357242584228516, "top": [[" performance", -1.4357242584228516], [" each", -1.7224215269088745]]}, {"t": " deltas", "lp": -0.33462557196617126, "top": [[" deltas", -0.33462557196617126], [" metrics", -2.0843546390533447]]}, {"t": " relative", "lp": -0.316962867975235, "top": [[" relative", -0.316962867975235], [" compared", -1.5673558712005615]]}, {"t": " to", "lp": -2.2411597456084564e-05, "top": [[" to", -2.2411597456084564e-05], [" the", -11.44918441772461]]}, {"t": " the", "lp": -0.25849032402038574, "top": [[" the", -0.25849032402038574], [" a", -1.4814059734344482]]}, {"t": " baseline", "lp": -0.02431008592247963, "top": [[" baseline", -0.02431008592247963], [" specified", -3.9879369735717773]]}, {"t": " arm", "lp": -0.00035900360671803355, "top": [[" arm", -0.00035900360671803355], [" arms", -9.596661567687988]]}, {"t": ".", "lp": -0.0038441300857812166, "top": [[".", -0.0038441300857812166], ["'s", -5.856781959533691]]}, {"t": "\n", "lp": -0.010118001140654087, "top": [["\n", -0.010118001140654087], [" Sk", -5.789519786834717]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm and test, and prints a markdown table showing\n    performance deltas relative to the baseline arm.\n"}