530975342]]}, {"t": " I", "lp": -0.001810101792216301, "top": [[" I", -0.001810101792216301], [" it", -7.436429977416992]]}, {"t": "'d", "lp": -2.9206701583461836e-05, "top": [["'d", -2.9206701583461836e-05], [" recommend", -10.717822074890137]]}, {"t": " recommend", "lp": -0.011984951794147491, "top": [[" recommend", -0.011984951794147491], [" strongly", -5.082327842712402]]}, {"t": " checking", "lp": -0.1023319885134697, "top": [[" checking", -0.1023319885134697], [":", -2.4600954055786133]]}, {"t": ":", "lp": -0.7013304233551025, "top": [[":", -0.7013304233551025], [" the", -0.836231529712677]]}, {"t": "\n\n", "lp": -0.13272668421268463, "top": [["\n\n", -0.13272668421268463], ["\n", -2.085373878479004]]}, {"t": "1", "lp": -0.1491844654083252, "top": [["1", -0.1491844654083252], ["-", -2.599595308303833]]}, {"t": ".", "lp": -0.00011253989941906184, "top": [[".", -0.00011253989941906184], ["-", -10.260331153869629]]}, {"t": " Your", "lp": -0.7809253931045532, "top": [[" Your", -0.7809253931045532], [" The", -1.1567150354385376]]}, {"t": " specific", "lp": -0.393728643655777, "top": [[" specific", -0.393728643655777], [" exact", -1.442571997642517]]}, {"t": " `", "lp": -0.5898106098175049, "top": [[" `", -0.5898106098175049], [" kernel", -1.6113083362579346]]}, {"t": "xe", "lp": -0.0030087148770689964, "top": [["xe", -0.0030087148770689964], ["driver", -7.019116401672363]]}], "text": "# CCS Modes on Intel Arc (xe driver)\n\nThe `ccs_mode` parameter controls how Compute Slice (CCS) contexts are distributed across the GPU's compute units. This is set via the `xe.ccs_mode=` kernel module parameter.\n\n## The Modes\n\n**ccs_mode 0 (default)**\n- CCS contexts are distributed across **all** compute slices\n- The kernel spreads work across every available CCS\n- Best for general-purpose workloads where you want maximum parallelism\n\n**ccs_mode 1**\n- CCS contexts are restricted to a **subset** of compute slices\n- Work is confined to specific slices rather than spread everywhere\n- Useful when you want more **predictable** behavior or need to isolate work\n\n**ccs_mode 2**\n- Similar restriction but with a **different distribution strategy**\n- Typically used for specific scheduling or isolation requirements\n\n## When to Use Mode 4\n\nMode 4 is generally used for **specific benchmarking or testing scenarios**. It's often associated with:\n\n- **Isolated testing** where you want deterministic CCS allocation\n- **Performance analysis** where consistent slice assignment matters\n- Debugging scenarios where you need to reproduce specific scheduling behaviors\n\n## Practical Guidance\n\nFor most users, **the default (mode 0)** is the right choice\u2014it gives the kernel maximum flexibility to schedule work efficiently.\n\nYou'd typically only bother changing this if:\n- You're **debugging** a specific scheduling issue\n- You're doing **performance research** and want to compare scheduling strategies\n- You have a **very specific workload** that benefits from slice isolation\n\n---\n\n**A note on accuracy:** The CCS mode parameter is fairly low-level and the exact semantics of each numeric value can vary between driver versions. If you're making a production decision, I'd recommend checking:\n\n1. Your specific `xe"}