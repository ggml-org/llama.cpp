", -0.3530174195766449], [" differently", -1.2289234399795532]]}, {"t": "ently", "lp": -8.261545008281246e-05, "top": [["ently", -8.261545008281246e-05], ["entially", -10.76585865020752]]}, {"t": ".", "lp": -0.5491108298301697, "top": [[".", -0.5491108298301697], ["\n", -0.9012036323547363]]}, {"t": "\n", "lp": -0.0008585561299696565, "top": [["\n", -0.0008585561299696565], ["\n\n", -8.473549842834473]]}, {"t": "2", "lp": -0.00043538748286664486, "top": [["2", -0.00043538748286664486], ["3", -10.585061073303223]]}, {"t": ".", "lp": -0.00010955933976219967, "top": [[".", -0.00010955933976219967], [" Some", -11.67923641204834]]}, {"t": " Default", "lp": -1.5221636295318604, "top": [[" Default", -1.5221636295318604], [" Some", -1.8794634342193604]]}, {"t": " behavior", "lp": -0.1267678290605545, "top": [[" behavior", -0.1267678290605545], [" values", -3.2167069911956787]]}], "text": "# CCS Modes on Intel Arc (xe driver)\n\nThe `ccs_mode` parameter controls how Compute Slice (CCS) contexts are handled by the Xe driver. Here's what each mode does:\n\n## CCS Mode 1\n- **Behavior**: Uses a **dedicated CCS** (Compute Compute Slice) for each context that requests one.\n- Each GPU context gets its own dedicated CCS instance.\n- This is the more \"correct\" isolation model\u2014contexts don't share CCS state.\n\n## CCS Mode 2\n- **Behavior**: Uses a **shared CCS** across multiple contexts.\n- Multiple contexts can share the same CCS instance.\n- More resource-efficient but contexts may contend for CCS resources.\n\n## CCS Mode 4\n- **Behavior**: Typically relates to **CCS eviction/disabled** behavior or a specific fallback mode depending on driver version.\n- Often used when you want to **disable CCS usage** or force a particular scheduling path.\n\n---\n\n## When to Use Each\n\n| Mode | Use Case |\n|------|----------|\n| **1** | Default for most workloads; best isolation and predictability |\n| **2** | Higher context counts where CCS resources are limited; better throughput under heavy multi-context load |\n| **4** | Debugging, specific performance tuning, or when you need to bypass CCS entirely |\n\n---\n\n## \u26a0\ufe0f Important Caveat\n\nThe `ccs_mode` parameter and its exact semantics have been **in flux across driver versions**, and the numbering/meaning has shifted between:\n- Kernel `xe` driver versions\n- Different Mesa/ROCm-adjacent stacks\n- Firmware versions\n\n**I'd recommend verifying against your specific driver version** because:\n1. The exact semantics of mode 4 in particular have been documented inconsistently.\n2. Default behavior"}