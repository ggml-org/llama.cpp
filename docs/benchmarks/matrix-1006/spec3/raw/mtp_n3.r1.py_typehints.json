owing", -0.3042864203453064], [" comparing", -1.9708703756332397]]}, {"t": "\n", "lp": -0.318878173828125, "top": [["\n", -0.318878173828125], [" \n", -1.4068489074707031]]}, {"t": "   ", "lp": -0.00045423093251883984, "top": [["   ", -0.00045423093251883984], ["           ", -8.904806137084961]]}, {"t": " means", "lp": -1.4753884077072144, "top": [[" means", -1.4753884077072144], [" each", -1.48222815990448]]}, {"t": " and", "lp": -0.03425970301032066, "top": [[" and", -0.03425970301032066], [" along", -4.118555068969727]]}, {"t": " percentage", "lp": -0.18532386422157288, "top": [[" percentage", -0.18532386422157288], [" deltas", -2.2252635955810547]]}, {"t": " deltas", "lp": -0.040886156260967255, "top": [[" deltas", -0.040886156260967255], [" differences", -3.4781458377838135]]}, {"t": " relative", "lp": -0.43580278754234314, "top": [[" relative", -0.43580278754234314], [" compared", -1.5596259832382202]]}, {"t": " to", "lp": -4.398919554660097e-05, "top": [[" to", -4.398919554660097e-05], [" the", -10.546370506286621]]}, {"t": " the", "lp": -0.05802835896611214, "top": [[" the", -0.05802835896611214], [" a", -2.90373158454895]]}, {"t": " baseline", "lp": -0.012722253799438477, "top": [[" baseline", -0.012722253799438477], [" specified", -4.731281757354736]]}, {"t": " arm", "lp": -0.0002766634279396385, "top": [[" arm", -0.0002766634279396385], [" arms", -9.491532325744629]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a markdown file and extract test results.\n    \n    Reads the given markdown file, parses table rows, and extracts numeric values\n    for known test names. Returns a dictionary mapping test names to their float values.\n    \n    Args:\n        p: Path to the markdown file to parse.\n        \n    Returns:\n        A dictionary where keys are test names (from TESTS list) and values are \n        the parsed float measurements.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Generate and print a summary table for a specific directory.\n    \n    Aggregates results from all markdown files in the specified directory,\n    computes means per arm per test, and prints a markdown table showing\n    means and percentage deltas relative to the baseline arm"}