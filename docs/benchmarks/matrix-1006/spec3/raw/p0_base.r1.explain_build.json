45996], ["++)", -1.0823187828063965]]}, {"t": "/", "lp": -0.5059217214584351, "top": [["/", -0.5059217214584351], ["),", -1.58771550655365]]}, {"t": "SY", "lp": -0.001419000793248415, "top": [["SY", -0.001419000793248415], [" SY", -7.756431579589844]]}, {"t": "CL", "lp": -0.00023159086413215846, "top": [["CL", -0.00023159086413215846], [" CL", -9.374787330627441]]}, {"t": ")", "lp": -0.002154882298782468, "top": [[")", -0.002154882298782468], [" targets", -8.187429428100586]]}, {"t": "\n\n", "lp": -0.002451501786708832, "top": [["\n\n", -0.002451501786708832], ["\n", -6.164169788360596]]}, {"t": "These", "lp": -0.2635543644428253, "top": [["These", -0.2635543644428253], ["```", -1.5548428297042847]]}], "text": "# PKGBUILD build() Function: Step-by-Step Explanation\n\nLet me break down this `build()` function line by line.\n\n## The Setup\n\n```bash\nsource /opt/intel/oneapi/setvars.sh --force\n```\nThis loads the Intel oneAPI environment variables (compiler paths, library paths, etc.). The `--force` flag forces the environment to be set up even if it appears already configured. This is essential because we're using Intel's `icx`/`icpx` compilers, which aren't on the default PATH.\n\n```bash\nset -e\n```\nThis makes the script exit immediately if any command returns a non-zero (error) status. A safety net so a failed command doesn't cascade into broken output.\n\n## The CMake Configuration\n\n```bash\ncmake -S \"${srcdir}/llama.cpp\" -B \"${srcdir}/build\" -G Ninja\n```\n- `-S` : source directory (the cloned git repo)\n- `-B` : build directory\n- `-G Ninja` : use the **Ninja** build generator (fast, minimal output) instead of Make\n\n## Build Type & Install Paths\n\n```bash\n-DCMAKE_BUILD_TYPE=Release\n```\nOptimized build with performance flags enabled (no debug symbols).\n\n```bash\n-DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib\n```\nWhere files get installed: `/usr` as root, libraries in `/usr/lib`.\n\n## The Compilers\n\n```bash\n-DCMAKE_C_COMPILER=icx -DCMAKE_CXX_COMPILER=icpx\n```\n- **icx** : Intel oneAPI DPC++/C compiler (C)\n- **icpx** : Intel oneAPI DPC++/C++ compiler (C++/SYCL)\n\nThese"}