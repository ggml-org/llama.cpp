top": [[" a", -0.2719898819923401], ["\n", -1.4386272430419922]]}, {"t": "\n", "lp": -0.00022467513917945325, "top": [["\n", -0.00022467513917945325], [" table", -9.090167999267578]]}, {"t": "   ", "lp": -0.0007428901153616607, "top": [["   ", -0.0007428901153616607], ["           ", -7.943665504455566]]}, {"t": " table", "lp": -0.32377779483795166, "top": [[" table", -0.32377779483795166], [" markdown", -1.4410643577575684]]}, {"t": " showing", "lp": -0.12045041471719742, "top": [[" showing", -0.12045041471719742], [" that", -3.383256435394287]]}, {"t": " the", "lp": -0.12015517055988312, "top": [[" the", -0.12015517055988312], [",", -3.0752599239349365]]}, {"t": " mean", "lp": -0.2172854244709015, "top": [[" mean", -0.2172854244709015], [" number", -2.5805437564849854]]}, {"t": " per", "lp": -0.5237983465194702, "top": [[" per", -0.5237983465194702], [" for", -1.530745029449463]]}, {"t": " arm", "lp": -0.28381890058517456, "top": [[" arm", -0.28381890058517456], [" round", -1.6630914211273193]]}], "text": "```python\n#!/usr/bin/env python3\n\"\"\"Summarise matrix-1006/<dir>/*.md: mean over rounds per arm, delta vs the dir's baseline arm.\"\"\"\nimport re, sys, statistics as st\nfrom collections import defaultdict\nfrom pathlib import Path\n\nROOT = Path(\"/mnt/nvme1/oneapi-ab/matrix-1006\")\nTESTS = [\"pp512\", \"tg64\", \"pp512 @ d8192\", \"tg64 @ d8192\"]\n\ndef parse(p: Path) -> dict:\n    \"\"\"Parse a single results markdown file into a dict of {test_name: value}.\n\n    Reads the file line by line, treating each line as a pipe-delimited table.\n    For lines whose second-to-last column matches one of the known TESTS, the\n    leading numeric token of the last column is extracted and stored as a float.\n\n    Args:\n        p: Path to the markdown file to parse.\n\n    Returns:\n        A dictionary mapping each matching test name to its parsed float value.\n    \"\"\"\n    out = {}\n    for line in p.read_text().splitlines():\n        c = [x.strip() for x in line.strip(\"|\").split(\"|\")]\n        if len(c) > 2 and c[-2] in TESTS:\n            m = re.match(r\"([\\d.]+)\", c[-1])\n            if m: out[c[-2]] = float(m.group(1))\n    return out\n\ndef table(d: str, base: str):\n    \"\"\"Build and print a summary table for a single directory of results.\n\n    Collects per-arm mean values across all rounds for each test, then prints a\n    table showing the mean per arm"}