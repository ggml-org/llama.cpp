<script>
	import { specimen } from './lib/specimen';
	import { view, nearest, variantNotes } from './lib/view.svelte';
	import Masthead from './lib/components/Masthead.svelte';
	import Metrics from './lib/components/Metrics.svelte';
	import Controls from './lib/components/Controls.svelte';
	import Tester from './lib/components/Tester.svelte';
	import InUse from './lib/components/InUse.svelte';
	import Waterfall from './lib/components/Waterfall.svelte';
	import Setting from './lib/components/Setting.svelte';
	import GlyphGrid from './lib/components/GlyphGrid.svelte';
	import Notes from './lib/components/Notes.svelte';
	import Note from './lib/components/Note.svelte';
	import CompareSwitch from './lib/components/CompareSwitch.svelte';

	const { axis, glyphCount, styles } = specimen;
	const stems = styles.map((s) => s.stem);
</script>

<Masthead variant={view.variant}>

The sans of the Llama family, with Mono and Serif to follow. A neo-grotesk with an even stroke, round bowls and open, angle-cut terminals, in two variable fonts from {axis.min} to {axis.max} that share every outline: Display for headlines, UI for interfaces and running text.

</Masthead>

<Metrics />

