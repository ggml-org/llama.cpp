	import { deg, lower, r, trim } from './lib/blueprint';
	import Blueprint from './lib/components/Blueprint.svelte';
	import Sketch from './lib/components/Sketch.svelte';
	import Figures from './lib/components/Figures.svelte';
	import OriginStep from './lib/components/OriginStep.svelte';
	import Rule from './lib/components/Rule.svelte';
	import Specs from './lib/components/Specs.svelte';

