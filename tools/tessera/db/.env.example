# Tessera Studio data layer environment.
#
# Copy to .env and edit; docker compose reads .env automatically.
# These values flow into docker-compose.yml (services) AND into the
# Swift client through TesseraDataStore.Configuration at runtime;
# the canonical .env is the source of truth for dev credentials.

POSTGRES_DB=tessera
POSTGRES_USER=tessera
POSTGRES_PASSWORD=tessera
POSTGRES_PORT=5432

VALKEY_PORT=6379
# Uncomment to require auth in dev (default is open for localhost-only):
# VALKEY_PASSWORD=changeme
