cmake_minimum_required(VERSION 3.18)
include("${PROJECT_SOURCE_DIR}/ggml/src/ggml-cuda/kv-stream-runtime.cmake")

set(directory "${CMAKE_CURRENT_BINARY_DIR}/kv-runtime-config-test")
file(MAKE_DIRECTORY "${directory}")
ggml_cuda_kv_stream_runtime_instances("${PROJECT_SOURCE_DIR}/ggml/src/ggml-cuda" "${directory}" sources)
list(LENGTH sources count)
if (NOT count EQUAL 6)
    message(FATAL_ERROR "Expected six D512 tile files, got ${count}")
endif()
set(expected 1-8 2-8 4-8 8-8 4-2 8-2)
foreach(geometry IN LISTS expected)
    set(path "${directory}/kv-stream-mma-runtime-${geometry}.cu")
    if (NOT path IN_LIST sources OR NOT EXISTS "${path}")
        message(FATAL_ERROR "Missing shared geometry ${geometry}")
    endif()
    file(READ "${path}" text)
    if (text MATCHES "@KV_STREAM" OR text MATCHES "template<ggml_type" OR
            NOT text MATCHES "ggml_cuda_kv_stream_mma_runtime_kernel")
        message(FATAL_ERROR "Unexpected format-specialized or incomplete runtime instance: ${path}")
    endif()
endforeach()

# Format selection changes admission, not the number of large arithmetic bodies.
set(GGML_CUDA_FA_QUANTS q8_0-q4_0)
ggml_cuda_kv_stream_runtime_instances("${PROJECT_SOURCE_DIR}/ggml/src/ggml-cuda" "${directory}" reduced)
if (NOT "${sources}" STREQUAL "${reduced}")
    message(FATAL_ERROR "Selected K/V pairs changed the shared arithmetic inventory")
endif()
message(STATUS "D512 runtime kernel generation checks passed")
