MAPLE_TQ2_PLAN 1
require_dot 0
buffer dummy 16 "-"
buffer input 1024 "input.input.bin"
buffer router_w 8192 "router_w.input.bin"
buffer up 135168 "up.input.bin"
buffer gate 135168 "gate.input.bin"
buffer down 135168 "down.input.bin"
buffer control 16 "-"
fill control 0 16 0
buffer ids 8 "-"
buffer scores 8 "-"
buffer logits 32 "-"
dispatch router_logits 1 1 1 3 1 8 256 4 input router_w logits control
dispatch router_select 1 1 1 5 1 8 2 0 0 4 logits ids scores control
dump logits "logits.actual.bin"
buffer intermediate 2048 "-"
dispatch project_q0_f1_r1 16 1 1 12 256 256 1 2 8 1 0 0 0 0 0 0 9 up gate dummy input dummy ids dummy control intermediate
buffer expert_out 2048 "-"
dispatch project_q0_f0_r1 16 1 1 12 256 256 2 2 8 1 1 0 0 0 0 0 9 down dummy dummy intermediate dummy ids dummy control expert_out
buffer moe_out 1024 "-"
dispatch reduce_experts 1 1 1 3 1 256 2 3 expert_out scores moe_out
buffer wq 16896 "wq.input.bin"
buffer wk 4224 "wk.input.bin"
buffer wv 4224 "wv.input.bin"
buffer q_out 1024 "-"
buffer k_out 256 "-"
buffer v_out 256 "-"
buffer qkv_out 1536 "-"
dispatch project_q0_f2_r1 12 1 1 12 256 384 1 1 1 0 0 256 64 0 0 0 9 wq wk wv input dummy dummy dummy control qkv_out
dispatch split_qkv 2 1 1 4 1 256 64 64 4 qkv_out q_out k_out v_out
dump ids "ids.actual.bin"
dump scores "scores.actual.bin"
dump intermediate "intermediate.actual.bin"
dump expert_out "expert_out.actual.bin"
dump moe_out "moe_out.actual.bin"
dump q_out "q_out.actual.bin"
dump k_out "k_out.actual.bin"
dump v_out "v_out.actual.bin"
dump control "control.actual.bin"
