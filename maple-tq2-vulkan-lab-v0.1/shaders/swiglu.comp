void main(){uint i=(gl_WorkGroupID.x+gl_WorkGroupID.y*gl_NumWorkGroups.x)*256u+gl_LocalInvocationID.x;if(i>=p.n)return;float g=min(gate[i],7.0),u=clamp(up[i],-7.0,7.0);float s=g>=0.0?1.0/(1.0+exp(-g)):exp(g)/(1.0+exp(g));y[i]=(g*s)*u;}
