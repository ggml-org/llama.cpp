+    simd<T,N>r;for(int i=0;i<N;++i)std::memcpy(&r[i],reinterpret_cast<const uint8_t*>(p)+o[i],sizeof(T));return r;}
+template<class T,int N>void scatter(T*p,const simd<uint32_t,N>&o,const simd<T,N>&a){
