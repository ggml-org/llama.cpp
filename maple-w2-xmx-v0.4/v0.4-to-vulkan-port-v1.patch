+static void throws(const std::function<void()>& fn){bool ok=false;try{fn();}catch(const std::exception&){ok=true;}test(ok);}
+int main()try {
+    using S=MoeSchedule;
+    test(!choose_moe_schedule(S::auto_select,false,2048,8,256,true).grouped);
