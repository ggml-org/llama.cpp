+    enqueue_a8_token_tiles(q,p,o,{a.q.data(),a.scale.data(),iv.data(),false},nullptr,{});
+    test(st[3]==1);for(uint32_t r=0;r<s.m;++r)test(y[3*s.m+r]==0.f);
