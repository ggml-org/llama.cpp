+// S3: KV sliding-window eviction. See llama.h for the contract.
+size_t llama_memory_seq_evict_oldest(
+        llama_memory_t mem,
+          llama_seq_id seq_id,
+             uint32_t keep_recent) {
+    if (!mem) {
+        return 0;
+    }
+
+    const llama_pos pos_max = mem->seq_pos_max(seq_id);
+    if (pos_max < 0) {
+        return 0; // empty sequence
+    }
+
+    // Total positions present; cache is dense [0, pos_max] per the API contract.
+    const uint32_t total = (uint32_t) pos_max + 1;
+
+    // No-op when we are already within the keep budget.
+    if (total <= keep_recent) {
+        return 0;
+    }
+
+    // The memory must support shifting (the suffix needs its positions rewritten).
+    if (!mem->get_can_shift()) {
+        return 0;
+    }
+
+    const uint32_t drop_n = total - keep_recent;
+    if (drop_n == 0) {
+        return 0;
+    }
+
+    // 1. Drop the oldest drop_n positions: [0, drop_n).
+    mem->seq_rm(seq_id, 0, (llama_pos) drop_n);
+    // 2. Shift the surviving suffix [drop_n, pos_max] down by drop_n so the
+    //    cache stays dense [0, pos_max - drop_n].
+    mem->seq_add(seq_id, (llama_pos) drop_n, pos_max + 1, -(llama_pos) drop_n);
+
+    return (size_t) drop_n;
+}
