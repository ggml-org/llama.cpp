    int i12 = im%ne12;
    int i13 = im/ne12;

    int offset_src0 = first_row*nb01 + (i12/r2)*nb02 + (i13/r3)*nb03;
    int offset_src1 =        r1*nb11 + (i12   )*nb12 + (i13   )*nb13;

    global block_iq2_s * x = (global block_iq2_s *) (src0 + offset_src0);
    global float         * y = (global float         *) (src1 + offset_src1);

    float yl[32];
    float sumf[N_DST] = {0.f};
    float all_sum;

    global float * y4 = y + ix * QK_K + 32 * it;

    for (int ib = ix; ib < nb; ib += BLOCK_STRIDE) {
        for (int i = 0; i < 32; ++i) {
            yl[i] = y4[i];
        }

        global char * xrow = (global char *)(x + ib);

        // only ne01 output rows exist; reading past them can pull in an inf scale
        for (int row = 0; row < N_DST && first_row + row < ne01; row++) {
            global block_iq2_s * xb = (global block_iq2_s *)(xrow + row*nb01);

            uchar scb = xb->scales[it];
            float dlo = (float)xb->d * (0.5f + (float)(scb & 0xf)) * 0.25f;
            float dhi = (float)xb->d * (0.5f + (float)(scb >>  4)) * 0.25f;

            uchar qhb = xb->qh[it];
            global uchar * qsb = xb->qs + 4*it;
            global uchar * sgb = xb->qs + 32 + 4*it;

            float alo = 0.f, ahi = 0.f;
            for (int l = 0; l < 4; ++l) {
                uint  gi = (uint)qsb[l] | (((uint)qhb << (8-2*l)) & 0x300);
                uchar sg = sgb[l];
                uint  lo = iq2s_grid[2*gi+0];
                uint  hi = iq2s_grid[2*gi+1];
                float a  = 0.f;
                for (int j = 0; j < 4; ++j) {
                    a += yl[8*l+j+0] * (float)((lo >> (8*j)) & 0xFF) * ((sg & (1 << j))     ? -1.f : 1.f);
                    a += yl[8*l+j+4] * (float)((hi >> (8*j)) & 0xFF) * ((sg & (1 << (j+4))) ? -1.f : 1.f);
                }
                if (l < 2) alo += a; else ahi += a;
            }

            sumf[row] += dlo * alo + dhi * ahi;
        }

        y4 += BLOCK_STRIDE * QK_K;
    }

    global float * dst_f32 = (global float *) dst + im*ne0*ne1 + r1*ne0;

    for (int row = 0; row < N_DST; ++row) {
        all_sum = sub_group_reduce_add(sumf[row]);
        if (first_row + row < ne01) {
            if (get_sub_group_local_id() == 0) {
                dst_f32[first_row + row] = all_sum;
            }
        }
    }
}
