#pragma OPENCL EXTENSION cl_khr_fp16 : enable

#ifdef cl_intel_required_subgroup_size
#define INTEL_GPU 1
#endif

#define QK_K 256
#define IQ3S_N_SCALE (QK_K/64)

typedef struct {
    half  d;
    uchar qs[QK_K/4];
    uchar qh[QK_K/32];
    uchar signs[QK_K/8];
    uchar scales[IQ3S_N_SCALE];
} block_iq3_s;

// iq3s_grid: 512 entries x 4 bytes = 2 KB
constant uint iq3s_grid[512] = {
