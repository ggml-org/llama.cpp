#ifdef U32_DEQUANT_HELPERS
fn dequant_q4_0_packed_to_shmem(q_packed: u32, d: f32, dst_idx: u32) {
    for (var k = 0u; k < 4u; k++) {
        let q_byte = get_byte(q_packed, k);
        let q_hi = (f32((q_byte >> 4) & 0xFu) - 8.0) * d;
        let q_lo = (f32(q_byte & 0xFu) - 8.0) * d;
        QUANT_SHMEM[dst_idx + k] = QUANT_OUT_TYPE(q_lo);
        QUANT_SHMEM[dst_idx + k + 16u] = QUANT_OUT_TYPE(q_hi);
    }
}

fn dequant_q8_0_packed_to_shmem(q_packed: u32, d: f32, dst_idx: u32) {
    for (var k = 0u; k < 4u; k++) {
        let q_byte = get_byte_i32(q_packed, k);
        let q_val = f32(q_byte) * d;
        QUANT_SHMEM[dst_idx + k] = QUANT_OUT_TYPE(q_val);
    }
}
#endif
