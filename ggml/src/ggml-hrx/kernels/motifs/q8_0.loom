// Plain ggml block_q8_0: f16 scale, then 32 signed 8-bit codes. A block has 34 bytes and only 2-byte alignment.

template.decl @ggml.f16.bits_f32(%bits: i16) -> (f32)

template.decl @ggml.mem.half(%weight: buffer, %span: index, %index: index) -> (i16)

template.decl @ggml.mem.half_word(%weight: buffer, %span: index, %index: index) -> (vector<1xi32>)

template.decl @ggml.q8_0.decode8_f16(%q: vector<4xi16>, %d_bits: i16) -> (vector<8xf16>)

template.def<@ggml.q8_0.decode8_f16> device @ggml_q8_0_decode8_f16(%q: vector<4xi16>, %d_bits: i16) -> (vector<8xf16>) {
  %q_i8 = vector.bitcast %q : vector<4xi16> to vector<8xi8>
  %q_f32 = vector.sitofp %q_i8 : vector<8xi8> to vector<8xf32>
  %d_vector = vector.from_elements %d_bits : vector<1xi16>
  %d_half_vector = vector.bitcast %d_vector : vector<1xi16> to vector<1xf16>
  %d_half = vector.extract %d_half_vector[0] : vector<1xf16> -> f16
  %d = scalar.extf %d_half : f16 to f32
  %d_splat = vector.splat %d : vector<8xf32>
  %values = vector.mulf %q_f32, %d_splat : vector<8xf32>
  %values_f16 = vector.fptrunc %values : vector<8xf32> to vector<8xf16>
  template.return %values_f16 : vector<8xf16>
}

template.decl @ggml.weight.block(%wtype: index) -> (index, index)

template.def<@ggml.weight.block> device @ggml_q8_0_block_shape(%wtype: index) -> (index, index) where [eq(%wtype, 4)] {
  %values = index.constant 32 : index
  %units = index.constant 17 : index
  template.return %values, %units : index, index
}

template.decl @ggml.weight.values4(%wtype: index, %weight: buffer, %w_span: index, %block_base: index, %j: index) -> (vector<4xf32>)

// j is a multiple of 4 and below 32.
template.def<@ggml.weight.values4> device @ggml_q8_0_values4(%wtype: index, %weight: buffer, %w_span: index, %block_base: index, %j: index) -> (vector<4xf32>) where [eq(%wtype, 4)] {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %d_bits = template.apply<@ggml.mem.half>(%weight, %w_span, %block_base) : (buffer, index, index) -> (i16)
  %d = template.apply<@ggml.f16.bits_f32>(%d_bits) : (i16) -> (f32)
  %q_half0 = index.div %j, %c2 : index
  %q_half = index.add %q_half0, %c1 : index
  %q_index = index.add %block_base, %q_half : index
  %q_word = template.apply<@ggml.mem.half_word>(%weight, %w_span, %q_index) : (buffer, index, index) -> (vector<1xi32>)
  %q_i8 = vector.bitcast %q_word : vector<1xi32> to vector<4xi8>
  %q_f32 = vector.sitofp %q_i8 : vector<4xi8> to vector<4xf32>
  %d_vector = vector.splat %d : vector<4xf32>
  %result = vector.mulf %q_f32, %d_vector : vector<4xf32>
  template.return %result : vector<4xf32>
}

template.decl @ggml.weight.superblock(%wtype: index) -> (offset, offset, index)

template.def<@ggml.weight.superblock> device @ggml_q8_0_superblock(%wtype: index) -> (offset, offset, index) where [eq(%wtype, 4)] {
  %unit = index.constant 2 : offset
  %sb = index.constant 272 : offset
  %units = index.constant 136 : index
  template.return %unit, %sb, %units : offset, offset, index
}

func.def inline @ggml_q8_0_s8x4(%word: i32, %d: f32) -> (vector<4xf32>) {
  %word_vector = vector.from_elements %word : vector<1xi32>
  %bytes = vector.bitcast %word_vector : vector<1xi32> to vector<4xi8>
  %values = vector.sitofp %bytes : vector<4xi8> to vector<4xf32>
  %d_vector = vector.splat %d : vector<4xf32>
  %result = vector.mulf %values, %d_vector : vector<4xf32>
  func.return %result : vector<4xf32>
}

// Q8_0 and Q4_0 superblocks are 8 blocks of 32 values. A part is one half of a block.
func.def inline @ggml_block32_offsets16(%part: index) -> (index, index, index, index) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c12 = index.constant 12 : index
  %c16 = index.constant 16 : index
  %c32 = index.constant 32 : index
  %part_in = index.assume %part [range(%part, 0, 15)] : index
  %blk = index.div %part_in, %c2 : index
  %half = index.rem %part_in, %c2 : index
  %o_blk = index.mul %blk, %c32 : index
  %o_half = index.mul %half, %c16 : index
  %o0 = index.add %o_blk, %o_half : index
  %o1 = index.add %o0, %c4 : index
  %o2 = index.add %o0, %c8 : index
  %o3 = index.add %o0, %c12 : index
  func.return %o0, %o1, %o2, %o3 : index, index, index, index
}

template.decl @ggml.weight.part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index)

template.def<@ggml.weight.part16> device @ggml_q8_0_part16(%wtype: index, %weight: buffer, %sb_byte: offset, %part: index) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index) where [eq(%wtype, 4)] {
  %c0 = index.constant 0 : index
  %c2 = index.constant 2 : index
  %b2 = index.constant 2 : offset
  %b16 = index.constant 16 : offset
  %b34 = index.constant 34 : offset
  %part_in = index.assume %part [range(%part, 0, 15)] : index
  %blk = index.div %part_in, %c2 : index
  %half = index.rem %part_in, %c2 : index
  %blk_add = index.scale %blk, %b34 : index, offset -> offset
  %blk_byte = index.add %sb_byte, %blk_add : offset
  %qs_add = index.scale %half, %b16 : index, offset -> offset
  %qs_byte0 = index.add %blk_byte, %qs_add : offset
  %qs_byte = index.add %qs_byte0, %b2 : offset
  %d_view = buffer.view %weight[%blk_byte] : buffer -> view<1xf16>
  %qs_view = buffer.view %weight[%qs_byte] : buffer -> view<4xi32>
  %d_half = view.load %d_view[%c0] : view<1xf16> -> f16
  %qs = vector.load %qs_view[%c0] : view<4xi32> -> vector<4xi32>
  %d = scalar.extf %d_half : f16 to f32
  %q0 = vector.extract %qs[0] : vector<4xi32> -> i32
  %q1 = vector.extract %qs[1] : vector<4xi32> -> i32
  %q2 = vector.extract %qs[2] : vector<4xi32> -> i32
  %q3 = vector.extract %qs[3] : vector<4xi32> -> i32
  %w0 = func.call @ggml_q8_0_s8x4(%q0, %d) : (i32, f32) -> (vector<4xf32>)
  %w1 = func.call @ggml_q8_0_s8x4(%q1, %d) : (i32, f32) -> (vector<4xf32>)
  %w2 = func.call @ggml_q8_0_s8x4(%q2, %d) : (i32, f32) -> (vector<4xf32>)
  %w3 = func.call @ggml_q8_0_s8x4(%q3, %d) : (i32, f32) -> (vector<4xf32>)
  %o0, %o1, %o2, %o3 = func.call @ggml_block32_offsets16(%part_in) : (index) -> (index, index, index, index)
  template.return %w0, %w1, %w2, %w3, %o0, %o1, %o2, %o3 : vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, index, index, index, index
}

template.decl @ggml.weight.offsets16(%wtype: index, %part: index) -> (index, index, index, index)

template.def<@ggml.weight.offsets16> device @ggml_q8_0_offsets16(%wtype: index, %part: index) -> (index, index, index, index) where [eq(%wtype, 4)] {
  %o0, %o1, %o2, %o3 = func.call @ggml_block32_offsets16(%part) : (index) -> (index, index, index, index)
  template.return %o0, %o1, %o2, %o3 : index, index, index, index
}

func.def inline @ggml_q8_0_block8(%weight: buffer, %w_span: index, %block_base0: index, %valid: i1, %part: index) -> (vector<8xf16>) {
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c16 = index.constant 16 : index
  %c0_offset = index.constant 0 : offset
  %c0_i16 = scalar.constant 0 : i16
  %zero4 = vector.splati 0 : vector<4xi16>
  %halves = buffer.view %weight[%c0_offset] : buffer -> view<[%w_span]xi16>
  %block_base = index.assume %block_base0 [range(%block_base0, 0, 2147483600)] : index
  %part_halves = index.mul %part, %c4 : index
  %q_local = index.add %part_halves, %c1 : index
  %q_index = index.add %block_base, %q_local : index
  %block_last = index.add %block_base, %c16 : index
  %q, %d_bits = scf.if %valid -> (vector<4xi16>, i16) {
    %in_span = index.cmp ult, %block_last, %w_span : index
    %l_q, %l_d = scf.if %in_span -> (vector<4xi16>, i16) {
      %v_d = view.load %halves[%block_base] : view<[%w_span]xi16> -> i16
      %v_q = vector.load %halves[%q_index] : view<[%w_span]xi16> -> vector<4xi16>
      scf.yield %v_q, %v_d : vector<4xi16>, i16
    } else {
      scf.yield %zero4, %c0_i16 : vector<4xi16>, i16
    }
    scf.yield %l_q, %l_d : vector<4xi16>, i16
  } else {
    scf.yield %zero4, %c0_i16 : vector<4xi16>, i16
  }
  %values = template.apply<@ggml.q8_0.decode8_f16>(%q, %d_bits) : (vector<4xi16>, i16) -> (vector<8xf16>)
  func.return %values : vector<8xf16>
}

template.decl @ggml.weight.wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>)

// The second block can be past K.
template.def<@ggml.weight.wmma16> device @ggml_q8_0_wmma16(%wtype: index, %weight: buffer, %w_span: index, %row_base: index, %row_valid: i1, %k: index, %k_size: index, %part: index) -> (vector<8xf16>, vector<8xf16>) where [eq(%wtype, 4)] {
  %c17 = index.constant 17 : index
  %c32 = index.constant 32 : index
  %k_bounded = index.assume %k [range(%k, 0, 2147483646)] : index
  %block = index.div %k_bounded, %c32 : index
  %block_offset = index.mul %block, %c17 : index
  %block_base = index.add %row_base, %block_offset : index
  %block_base1 = index.add %block_base, %c17 : index
  %k1 = index.add %k_bounded, %c32 : index
  %k1_in = index.cmp ult, %k1, %k_size : index
  %valid1 = scalar.andi %row_valid, %k1_in : i1
  %low = func.call @ggml_q8_0_block8(%weight, %w_span, %block_base, %row_valid, %part) : (buffer, index, index, i1, index) -> (vector<8xf16>)
  %high = func.call @ggml_q8_0_block8(%weight, %w_span, %block_base1, %valid1, %part) : (buffer, index, index, i1, index) -> (vector<8xf16>)
  template.return %low, %high : vector<8xf16>, vector<8xf16>
}
