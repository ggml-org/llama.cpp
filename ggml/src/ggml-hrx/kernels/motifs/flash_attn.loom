  %n4, %n5, %n6, %n7 = func.call @ggml_hrx_fa_pv_group_gfx12(%p_frag, %alpha_f, %row_bits, %rv, %row, %tq, %masked, %p_view, %ps_view, %v_tile, %d_v, %v_layout, %c1, %a4, %a5, %a6, %a7) : (vector<4xf16>, vector<4xf32>, i32, i1, index, index, i1, view<16x24xf16>, view<16x24xf16>, view<16x[%d_v]xf16, %v_layout>, index, encoding<layout>, index, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
