  }

  // A row with no unmasked token gets 0, as on the CPU. With more than one split, the reduce kernel divides by the sum.
  %one_split = index.cmp eq, %n_split, %c1 : index
  %many_split = index.cmp ne, %n_split, %c1 : index
  %n_rows = index.div %dst_span, %d_v : index
  %pml_base = index.mul %n_split, %dst_span : index
  %row_l = index.add %row, %c16 : index
  scf.if %quad_lead {
    view.store %m_w, %ml_view[%wave, %row] : f32, view<16x32xf32>
    view.store %l_w, %ml_view[%wave, %row_l] : f32, view<16x32xf32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.if %quad_lead {
    %m_all = scf.for %w = [%c0 to %waves step %c1](%mx = %neg_large : f32) -> (f32) {
      %w_s = index.assume %w [range(%w, 0, 15)] : index
      %mw = view.load %ml_view[%w_s, %row] : view<16x32xf32> -> f32
      %mx_n = scalar.maxnumf %mx, %mw : f32
      scf.yield %mx_n : f32
    }
    %l_all = scf.for %w = [%c0 to %waves step %c1](%ls = %zero_f32 : f32) -> (f32) {
      %w_s = index.assume %w [range(%w, 0, 15)] : index
      %mw = view.load %ml_view[%w_s, %row] : view<16x32xf32> -> f32
      %lw = view.load %ml_view[%w_s, %row_l] : view<16x32xf32> -> f32
      %d = scalar.subf %mw, %m_all : f32
      %e = scalar.expf<afn> %d : f32
      %ls_n = scalar.fmaf %lw, %e, %ls : f32
      scf.yield %ls_n : f32
    }
    %dm = scalar.subf %m_w, %m_all : f32
    %em = scalar.expf<afn> %dm : f32
    %l_pos = scalar.cmpf ogt, %l_all, %zero_f32 : f32
    %l_safe = scf.select %l_pos, %l_all, %one_f32 : f32
    %g0 = scalar.divf %em, %l_safe : f32
    %g1 = scf.select %l_pos, %g0, %zero_f32 : f32
    %g = scf.select %one_split, %g1, %em : f32
    view.store %g, %a_view[%row] : f32, view<16xf32>
    %w0 = index.cmp eq, %wave, %c0 : index
    %pub0 = scalar.andi %w0, %rv : i1
    %pub = scalar.andi %pub0, %many_split : i1
    scf.if %pub {
      %ro_t0 = index.mul %iq3, %n_q : index
      %ro_t = index.add %ro_t0, %row_tok : index
      %ro_th = index.mul %ro_t, %n_head : index
      %ro = index.add %ro_th, %row_head : index
      %ml_r0 = index.mul %split, %n_rows : index
      %ml_r = index.add %ml_r0, %ro : index
      %ml_o = index.mul %ml_r, %c2 : index
      %ml_i0 = index.add %pml_base, %ml_o : index
      %ml_i = index.assume %ml_i0 [range(%ml_i0, 0, 2147483640)] : index
      %ml_j = index.add %ml_i, %c1 : index
      %ml_ok = index.cmp ult, %ml_j, %part_span : index
      scf.if %ml_ok {
        view.store %m_all, %part_view[%ml_i] : f32, view<[%part_span]xf32>
        view.store %l_all, %part_view[%ml_j] : f32, view<[%part_span]xf32>
