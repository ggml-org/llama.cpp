      %k1 = index.mul %win0, %k_s1 : index
      %k2 = index.add %k_head, %k1 : index
      %k_off = index.scale %k2, %f16_bytes : index, offset -> offset
      %k_tile = buffer.view %k_aligned[%k_off] : buffer -> view<16x[%d_k]xf16, %k_layout>
      %s_init = vector.fragment<init> %zero4 shape [%c16, %c16] : vector<4xf32>
      %s_ev, %s_od = scf.for %kc = [%c0 to %d_k step %c64](%se = %s_init : vector<4xf32>, %so = %s_init : vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
        // A step past d_k loads the last fragment again. The select drops it.
        %kc1 = index.add %kc, %c16 : index
        %kc2 = index.add %kc, %c32 : index
        %kc3 = index.add %kc, %c48 : index
        %h1 = index.cmp ult, %kc1, %d_k : index
        %h2 = index.cmp ult, %kc2, %d_k : index
        %h3 = index.cmp ult, %kc3, %d_k : index
        %kx0 = index.assume %kc [lt(%kc, %dk_last)] : index
        %kc1m = index.min %kc1, %dk_top : index
        %kc2m = index.min %kc2, %dk_top : index
        %kc3m = index.min %kc3, %dk_top : index
        %kx1 = index.assume %kc1m [lt(%kc1m, %dk_last)] : index
        %kx2 = index.assume %kc2m [lt(%kc2m, %dk_last)] : index
        %kx3 = index.assume %kc3m [lt(%kc3m, %dk_last)] : index
        %e2s, %o3s = template.apply<@ggml.flash_attn.qk_k64>(%k_tile, %d_k, %k_layout, %q_t_view, %q_t_layout, %kx0, %kx1, %kx2, %kx3, %h1, %h2, %h3, %se, %so) : (view<16x[%d_k]xf16, %k_layout>, index, encoding<layout>, view<256x16xf16, %q_t_layout>, encoding<layout>, index, index, index, index, i1, i1, i1, vector<4xf32>, vector<4xf32>) -> (vector<4xf32>, vector<4xf32>)
        scf.yield %e2s, %o3s : vector<4xf32>, vector<4xf32>
      }
      %s_frag = vector.addf %s_ev, %s_od : vector<4xf32>
      vector.fragment.store<result> %s_frag, %s_t_view[%c0, %c0] shape [%c16, %c16] : vector<4xf32>, view<16x16xf32, %s_t_layout>
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

      %sv = vector.load %s_view[%row, %tq] : view<16x20xf32> -> vector<4xf32>
      %smask = vector.addf %sv, %mv : vector<4xf32>
      %valid = vector.cmpf ogt, %mv, %neg4 : vector<4xf32> -> vector<4xi1>
      %sm = vector.select %valid, %smask, %neg4 : vector<4xf32>
      %lmax = vector.reduce<maxnumf> %sm, %neg_large : vector<4xf32>, f32
      %rmax = kernel.subgroup.reduce<maxnumf> %lmax {cluster_size = 4} : f32
      %m_new = scalar.maxnumf %m_run, %rmax : f32
      %m_new4 = vector.splat %m_new : vector<4xf32>
      %sd = vector.subf %sm, %m_new4 : vector<4xf32>
      %pe = vector.expf<afn> %sd : vector<4xf32>
      %p = vector.select %valid, %pe, %zero4 : vector<4xf32>
      %lsum = vector.reduce<addf> %p, %zero_f32 : vector<4xf32>, f32
      %rsum = kernel.subgroup.reduce<addf> %lsum {cluster_size = 4} : f32
      %md = scalar.subf %m_run, %m_new : f32
      %alpha = scalar.expf<afn> %md : f32
      %l_new = scalar.fmaf %l_run, %alpha, %rsum : f32
      %p_h = vector.fptrunc %p : vector<4xf32> to vector<4xf16>
      vector.store %p_h, %p_view[%row, %tq] : vector<4xf16>, view<16x24xf16>
      scf.if %quad_lead {
        view.store %alpha, %a_view[%row] : f32, view<16xf32>
      }
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)

      %true1 = scalar.constant true : i1
      %all4 = vector.reduce<andi> %valid, %true1 : vector<4xi1>, i1
      %no_row = scalar.xori %rv, %true1 : i1
      %row_unmasked = scalar.ori %no_row, %all4 : i1
      %unmasked = kernel.subgroup.vote.all %row_unmasked : i1
      %vv1 = index.mul %win0, %v_s1 : index
      %vv2 = index.add %v_head, %vv1 : index
      %v_off = index.scale %vv2, %f16_bytes : index, offset -> offset
      %v_tile = buffer.view %v_aligned[%v_off] : buffer -> view<16x[%d_v]xf16, %v_layout>
      %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7, %n8, %n9, %n10, %n11, %n12, %n13, %n14, %n15 = template.apply<@ggml.flash_attn.pv>(%p_view, %ps_view, %a_bcast, %row_layout, %v_tile, %d_v, %v_layout, %valid, %unmasked, %rv, %row, %tq, %a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7, %a8, %a9, %a10, %a11, %a12, %a13, %a14, %a15) : (view<16x24xf16>, view<16x24xf16>, view<16x16xf32, %row_layout>, encoding<layout>, view<16x[%d_v]xf16, %v_layout>, index, encoding<layout>, vector<4xi1>, i1, i1, index, index, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
      // The next sub-block writes this LDS again.
      kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
      scf.yield %m_new, %l_new, %n0, %n1, %n2, %n3, %n4, %n5, %n6, %n7, %n8, %n9, %n10, %n11, %n12, %n13, %n14, %n15 : f32, f32, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    } else {
      scf.yield %m_run, %l_run, %a0, %a1, %a2, %a3, %a4, %a5, %a6, %a7, %a8, %a9, %a10, %a11, %a12, %a13, %a14, %a15 : f32, f32, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>
    }
