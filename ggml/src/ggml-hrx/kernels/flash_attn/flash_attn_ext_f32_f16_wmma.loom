  kernel.barrier<workgroup> scope(subgroup) ordering(acq_rel)
  %g_f = vector.fragment.load<result> %a_bcast[%c0, %c0] shape [%c16, %c16] : view<16x16xf32, %row_layout> -> vector<4xf32>
  // The output stage overwrites the Q stage and the wave regions.
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  scf.for %w = [%c0 to %waves step %c1] {
    %mine = index.cmp eq, %w, %wave : index
    scf.if %mine {
      %first = index.cmp eq, %w, %c0 : index
      scf.for %tt = [%c0 to %c16 step %c1] unroll {
        %ch0 = index.mul %tt, %c16 : index
        %tile_ok = index.cmp ult, %ch0, %d_v : index
        scf.if %tile_ok {
          %ch = index.assume %ch0 [range(%ch0, 0, 240)] : index
          %acc = func.call @ggml_hrx_fa_pick16(%tt, %a0_f, %a1_f, %a2_f, %a3_f, %a4_f, %a5_f, %a6_f, %a7_f, %a8_f, %a9_f, %a10_f, %a11_f, %a12_f, %a13_f, %a14_f, %a15_f) : (index, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>) -> (vector<4xf32>)
          %scaled = vector.mulf %acc, %g_f : vector<4xf32>
          %sum = scf.if %first -> (vector<4xf32>) {
            scf.yield %scaled : vector<4xf32>
          } else {
            %prev = vector.fragment.load<result> %out_view[%c0, %ch] shape [%c16, %c16] : view<16x260xf32> -> vector<4xf32>
            %s = vector.addf %prev, %scaled : vector<4xf32>
            scf.yield %s : vector<4xf32>
