          vector.fragment.store<result> %sum, %out_view[%c0, %ch] shape [%c16, %c16] : vector<4xf32>, view<16x260xf32>
        }
      }
    }
    kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  }

  %c_ok = index.cmp ult, %t, %d_v : index
  %seq_tok = index.mul %iq3, %n_q : index
  scf.if %c_ok {
    %tc = index.assume %t [range(%t, 0, 255)] : index
    scf.for %r = [%c0 to %c16 step %c1] {
      %r_s = index.assume %r [range(%r, 0, 15)] : index
      %pr = index.add %p0, %r : index
      %tok_r = index.div %pr, %hg : index
      %hl_r = index.rem %pr, %hg : index
      %head_r = index.add %h0, %hl_r : index
      %r_ok = index.cmp ult, %tok_r, %n_q : index
      scf.if %r_ok {
