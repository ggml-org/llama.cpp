          %p_raw = index.add %p_base, %o_idx : index
          %p_idx = index.assume %p_raw [range(%p_raw, 0, 2147483646)] : index
          %p_in = index.cmp ult, %p_idx, %part_span : index
          scf.if %p_in {
            view.store %y, %part_view[%p_idx] : f32, view<[%part_span]xf32>
