// In the single-tensor form, x and g bind the same tensor. x_off and g_off select the two halves of each row.
// dst must be contiguous.

config.decl @ggml.elementwise.wg_size : %value: index where [range(%value, 64, 1024), multiple_of(%value, 64)]

target.decl @ggml_wave64

func.def inline @ggml_hrx_swiglu(%x: f32, %g: f32) -> (f32) {
  %c1 = scalar.constant 1.0 : f32
  %neg = scalar.negf %x : f32
  %exp_neg = scalar.expf<afn> %neg : f32
  %den = scalar.addf %c1, %exp_neg : f32
  %silu = scalar.divf %x, %den : f32
  %r = scalar.mulf %silu, %g : f32
  func.return %r : f32
}

kernel.def target(@ggml_wave64) export("ggml_swiglu_f32_rows") @ggml_swiglu_f32_rows(%n: index) {
  %one = index.constant 1 : index
  %wg_size = config.get @ggml.elementwise.wg_size : index
  %wg_x2 = index.add %wg_size, %wg_size : index
  %per_group = index.add %wg_x2, %wg_x2 : index
  %round = index.sub %per_group, %one : index
  %n_round = index.add %n, %round : index
  %groups = index.div %n_round, %per_group : index
  kernel.launch.config workgroups(%groups, %one, %one) workgroup_size(%wg_size, %one, %one) : index
} launch(%n_in: index, %d0_in: index, %x_off_in: index, %x_rs_in: index, %x_span_in: index, %g_off_in: index, %g_rs_in: index, %g_span_in: index, %x: buffer, %g: buffer, %dst: buffer) {
  // The caller checks these ranges. n and d0 must be multiples of 4.
  %n = index.assume %n_in [range(%n_in, 4, 2147483644)] : index
  %d0 = index.assume %d0_in [range(%d0_in, 4, 2147483644)] : index
  %x_off = index.assume %x_off_in [range(%x_off_in, 0, 2147483647)] : index
  %x_rs = index.assume %x_rs_in [range(%x_rs_in, 0, 2147483647)] : index
  %x_span = index.assume %x_span_in [range(%x_span_in, 1, 2147483647)] : index
  %g_off = index.assume %g_off_in [range(%g_off_in, 0, 2147483647)] : index
  %g_rs = index.assume %g_rs_in [range(%g_rs_in, 0, 2147483647)] : index
  %g_span = index.assume %g_span_in [range(%g_span_in, 1, 2147483647)] : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %wg_size = config.get @ggml.elementwise.wg_size : index
  %wg_x2 = index.add %wg_size, %wg_size : index
  %per_group = index.add %wg_x2, %wg_x2 : index
  %group = kernel.workgroup.id<x> : index
  %item = kernel.workitem.id<x> : index
  %base = index.mul %group, %per_group : index
  %lane = index.mul %item, %c4 : index
  %j_raw = index.add %base, %lane : index
  %j = index.assume %j_raw [range(%j_raw, 0, 2147483644)] : index
  %j_last = index.add %j, %c3 : index
  %zero = index.constant 0 : offset
  %x_view = buffer.view %x[%zero] : buffer -> view<[%x_span]xf32>
  %g_view = buffer.view %g[%zero] : buffer -> view<[%g_span]xf32>
  %dst_view = buffer.view %dst[%zero] : buffer -> view<[%n]xf32>
  %in_bounds = index.cmp ult, %j_last, %n : index
  scf.if %in_bounds {
    %r = index.div %j, %d0 : index
    %r_start = index.mul %r, %d0 : index
    %c = index.sub %j, %r_start : index
    %x_row = index.mul %r, %x_rs : index
    %x_row_off = index.add %x_row, %x_off : index
    %x_idx = index.add %x_row_off, %c : index
    %g_row = index.mul %r, %g_rs : index
    %g_row_off = index.add %g_row, %g_off : index
    %g_idx = index.add %g_row_off, %c : index
    // The prover reads only branch conditions. Thus cap the offsets and check one bound in each scf.if.
    %x_pos = index.assume %x_idx [range(%x_idx, 0, 2147483640)] : index
    %g_pos = index.assume %g_idx [range(%g_idx, 0, 2147483640)] : index
    %x_last = index.add %x_pos, %c3 : index
    %g_last = index.add %g_pos, %c3 : index
    %x_ok = index.cmp ult, %x_last, %x_span : index
    scf.if %x_ok {
      %g_ok = index.cmp ult, %g_last, %g_span : index
      scf.if %g_ok {
        %xv = vector.load %x_view[%x_pos] : view<[%x_span]xf32> -> vector<4xf32>
        %gv = vector.load %g_view[%g_pos] : view<[%g_span]xf32> -> vector<4xf32>
        %x0 = vector.extract %xv[0] : vector<4xf32> -> f32
        %x1 = vector.extract %xv[1] : vector<4xf32> -> f32
        %x2 = vector.extract %xv[2] : vector<4xf32> -> f32
        %x3 = vector.extract %xv[3] : vector<4xf32> -> f32
        %g0 = vector.extract %gv[0] : vector<4xf32> -> f32
        %g1 = vector.extract %gv[1] : vector<4xf32> -> f32
        %g2 = vector.extract %gv[2] : vector<4xf32> -> f32
        %g3 = vector.extract %gv[3] : vector<4xf32> -> f32
        %y0 = func.call @ggml_hrx_swiglu(%x0, %g0) : (f32, f32) -> (f32)
        %y1 = func.call @ggml_hrx_swiglu(%x1, %g1) : (f32, f32) -> (f32)
        %y2 = func.call @ggml_hrx_swiglu(%x2, %g2) : (f32, f32) -> (f32)
        %y3 = func.call @ggml_hrx_swiglu(%x3, %g3) : (f32, f32) -> (f32)
        %y = vector.from_elements %y0, %y1, %y2, %y3 : vector<4xf32>
        vector.store %y, %dst_view[%j] : vector<4xf32>, view<[%n]xf32>
      }
    }
  }
  kernel.return
}
