      %t1 = index.div %r, %ne1 : index
      %i2 = index.rem %t1, %ne2 : index
      %i3 = index.div %t1, %ne2 : index

      %io0 = index.mul %i1, %ids_s0 : index
      %io1 = index.mul %i2, %ids_s1 : index
