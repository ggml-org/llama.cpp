// Skinny GGML matmul for contiguous 2D F32 activations.
//
// The accumulation core covers low-token direct F32 and staged quantized
// activation paths. This wrapper selects the output epilogue.
template.decl @ggml.matmul.skinny_input_f32_dequant_accumulate_f32.core(%weight_format: index, %token_count: index, %input_size0: index, %output_size0: index, %output_accumulation: index, %output_unary_op: index, %epilogue: index, %epsilon: f32, %channel_tile: index, %token_tile: index, %input: buffer, %weight: buffer, %bias: buffer, %output: buffer, %residual_input: buffer, %residual_output: buffer, %norm_weight: buffer, %normalized_output: buffer, %completion_counters: buffer)

template.decl @ggml.matmul.skinny_input_f32_dequant_accumulate_f32.finish_tile(%token_count: index, %output_size: index, %output_tile_count: index, %token_tile_count: index, %output_accumulation: index, %output_unary_op: index, %epsilon: f32, %channel_tile: index, %token_tile: index, %bias: buffer, %output: buffer, %residual_input: buffer, %residual_output: buffer, %norm_weight: buffer, %normalized_output: buffer, %completion_counters: buffer)

template.decl @ggml.matmul.skinny_input_f32_dequant_accumulate_f32.launch(%token_capacity: index, %input_size: index, %output_size: index, %weight_format: index) -> (index, index, index, index)

template.decl @ggml.matmul.skinny_input_f32_dequant_accumulate_f32.publish_vector4(%publish_word: i1, %token0: index, %channel: index, %token_count0: index, %output_size0: index, %output_accumulation: index, %output_unary_op: index, %epilogue: index, %values: vector<4xf32>, %bias: buffer, %output: buffer, %residual_input: buffer, %residual_output: buffer, %norm_weight: buffer, %normalized_output: buffer, %completion_counters: buffer)

template.decl @ggml.matmul.skinny_postprocess_f32.add_bias_vector4(%output_size0: index, %channel: index, %values: vector<4xf32>, %bias: buffer) -> (vector<4xf32>)

template.decl @ggml.matmul.skinny_postprocess_f32.add_residual_vector4(%token_count0: index, %output_size0: index, %token0: index, %channel: index, %values: vector<4xf32>, %residual_input: buffer) -> (vector<4xf32>)

template.decl @ggml.matmul.skinny_publish_f32.store_vector4(%token_count0: index, %output_size0: index, %token0: index, %channel: index, %values: vector<4xf32>, %output: buffer)

template.decl @ggml.unary_f32.apply_vector4(%op: index, %values: vector<4xf32>) -> (vector<4xf32>)

amdgpu.target<gfx11-generic> @ggml_matmul_skinny_input_f32_publish_f32_gfx11_wave64 {subgroup_size = 64}

config.decl @ggml.mul_mat.input_size : %value: index where [range(%value, 256, 32768), mul(%value, 32)]

config.decl @ggml.mul_mat.output_size : %value: index where [range(%value, 1, 262144)]

config.decl @ggml.mul_mat.output_accumulation : %value: index where [range(%value, 0, 1)]

config.decl @ggml.mul_mat.output_unary_op : %value: index where [range(%value, 0, 23)]

config.decl @ggml.mul_mat.weight_format : %value: index where [range(%value, 4, 81)]

config.decl @ggml.mul_mat_postops.input_size : %value: index where [range(%value, 256, 32768), mul(%value, 256)]

config.decl @ggml.mul_mat_postops.output_size : %value: index where [range(%value, 1, 262144)]

config.decl @ggml.mul_mat_postops.weight_format : %value: index where [range(%value, 4, 81)]

config.decl @ggml.mul_mat_postops.epilogue : %value: index where [range(%value, 1, 3)]

config.decl @ggml.workload.token_capacity : %value: index where [range(%value, 2, 5)]

template.def<@ggml.matmul.skinny_input_f32_dequant_accumulate_f32.publish_vector4> device @ggml_matmul_skinny_input_f32_publish_f32_vector4(%publish_word: i1, %token0: index, %channel: index, %token_count0: index, %output_size0: index, %output_accumulation: index, %output_unary_op: index, %epilogue: index, %values: vector<4xf32>, %bias: buffer, %output: buffer, %residual_input: buffer, %residual_output: buffer, %norm_weight: buffer, %normalized_output: buffer, %completion_counters: buffer) {
  %token_count = index.assume %token_count0 [range(%token_count0, 2, 5)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 262144)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c3 = index.constant 3 : index
  %c0_offset = index.constant 0 : offset
  %c0_f32x4 = vector.constant 0.0 : vector<4xf32>
  %uses_bias_only = index.cmp eq, %epilogue, %c1 : index
  %uses_residual_only = index.cmp eq, %epilogue, %c2 : index
  %uses_bias_residual = index.cmp eq, %epilogue, %c3 : index
  %uses_bias = scalar.ori %uses_bias_only, %uses_bias_residual : i1
  %uses_residual = scalar.ori %uses_residual_only, %uses_bias_residual : i1
  %output_noalias = buffer.assume.noalias %output : buffer
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%token_count]x[%output_size]xf32>
  %accumulates_output = index.cmp eq, %output_accumulation, %c1 : index
  scf.if %publish_word {
    %token, %launch_token_count = index.assume %token0, %token_count [lt(%token0, %token_count)] : index, index
    %mask = vector.mask.range [%channel to %output_size step %c1] : index -> vector<4xi1>
    %accumulated = scf.if %accumulates_output -> (vector<4xf32>) {
      %residual = vector.load.mask %output_view[%token, %channel], %mask, %c0_f32x4 : view<[%token_count]x[%output_size]xf32>, vector<4xi1>, vector<4xf32>
      %sum = vector.addf %residual, %values : vector<4xf32>
      scf.yield %sum : vector<4xf32>
    } else {
      scf.yield %values : vector<4xf32>
    }
    %biased = scf.if %uses_bias -> (vector<4xf32>) {
      %with_bias = template.apply<@ggml.matmul.skinny_postprocess_f32.add_bias_vector4>(%output_size0, %channel, %accumulated, %bias) : (index, index, vector<4xf32>, buffer) -> (vector<4xf32>)
      scf.yield %with_bias : vector<4xf32>
    } else {
      scf.yield %accumulated : vector<4xf32>
    }
    %residual_added = scf.if %uses_residual -> (vector<4xf32>) {
      %with_residual = template.apply<@ggml.matmul.skinny_postprocess_f32.add_residual_vector4>(%token_count0, %output_size0, %token0, %channel, %biased, %residual_input) : (index, index, index, index, vector<4xf32>, buffer) -> (vector<4xf32>)
      scf.yield %with_residual : vector<4xf32>
    } else {
      scf.yield %biased : vector<4xf32>
    }
    %published = template.apply<@ggml.unary_f32.apply_vector4>(%output_unary_op, %residual_added) : (index, vector<4xf32>) -> (vector<4xf32>)
    scf.if %uses_residual {
      template.apply<@ggml.matmul.skinny_publish_f32.store_vector4>(%token_count0, %output_size0, %token0, %channel, %published, %residual_output) : (index, index, index, index, vector<4xf32>, buffer)
    } else {
      template.apply<@ggml.matmul.skinny_publish_f32.store_vector4>(%token_count0, %output_size0, %token0, %channel, %published, %output) : (index, index, index, index, vector<4xf32>, buffer)
    }
  }
  template.return
}

template.def<@ggml.matmul.skinny_input_f32_dequant_accumulate_f32.finish_tile> device @ggml_matmul_skinny_input_f32_publish_f32_finish_tile(%token_count: index, %output_size: index, %output_tile_count: index, %token_tile_count: index, %output_accumulation: index, %output_unary_op: index, %epsilon: f32, %channel_tile: index, %token_tile: index, %bias: buffer, %output: buffer, %residual_input: buffer, %residual_output: buffer, %norm_weight: buffer, %normalized_output: buffer, %completion_counters: buffer) {
  template.return
}

kernel.def target(@ggml_matmul_skinny_input_f32_publish_f32_gfx11_wave64) @ggml_mul_mat_skinny_input_f32_publish_f32(%token_count: index) {
  %output_size = config.get @ggml.mul_mat.output_size : index
  %token_capacity = config.get @ggml.workload.token_capacity : index
  %c1 = index.constant 1 : index
  %input_size = config.get @ggml.mul_mat.input_size : index
  %weight_format = config.get @ggml.mul_mat.weight_format : index
  %launch_x, %launch_y, %launch_z, %workgroup_size = template.apply<@ggml.matmul.skinny_input_f32_dequant_accumulate_f32.launch>(%token_capacity, %input_size, %output_size, %weight_format) pure : (index, index, index, index) -> (index, index, index, index)
  kernel.launch.config workgroups(%launch_x, %launch_y, %launch_z) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %output: buffer) {
  %input_size = config.get @ggml.mul_mat.input_size : index
  %output_size = config.get @ggml.mul_mat.output_size : index
  %token_capacity = config.get @ggml.workload.token_capacity : index
  %output_accumulation = config.get @ggml.mul_mat.output_accumulation : index
  %output_unary_op = config.get @ggml.mul_mat.output_unary_op : index
  %weight_format = config.get @ggml.mul_mat.weight_format : index
  %epilogue = index.constant 0 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %bounded_token_count = index.assume %token_count [range(%token_count, 2, 5), le(%token_count, %token_capacity)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token_tile = kernel.workgroup.id<y> : index
  template.apply<@ggml.matmul.skinny_input_f32_dequant_accumulate_f32.core>(%weight_format, %bounded_token_count, %input_size, %output_size, %output_accumulation, %output_unary_op, %epilogue, %c0_f32, %channel_tile, %token_tile, %input, %weight, %output, %output, %output, %output, %output, %output, %output) : (index, index, index, index, index, index, index, f32, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}



kernel.def target(@ggml_matmul_skinny_input_f32_publish_f32_gfx11_wave64) @ggml_mul_mat_skinny_input_f32_bias_residual_publish_f32(%token_count: index) {
  %output_size = config.get @ggml.mul_mat_postops.output_size : index
  %token_capacity = config.get @ggml.workload.token_capacity : index
  %c1 = index.constant 1 : index
  %input_size = config.get @ggml.mul_mat_postops.input_size : index
  %weight_format = config.get @ggml.mul_mat_postops.weight_format : index
  %launch_x, %launch_y, %launch_z, %workgroup_size = template.apply<@ggml.matmul.skinny_input_f32_dequant_accumulate_f32.launch>(%token_capacity, %input_size, %output_size, %weight_format) pure : (index, index, index, index) -> (index, index, index, index)
  kernel.launch.config workgroups(%launch_x, %launch_y, %launch_z) workgroup_size(%workgroup_size, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %bias: buffer, %residual_input: buffer, %residual_output: buffer) {
  %input_size = config.get @ggml.mul_mat_postops.input_size : index
  %output_size = config.get @ggml.mul_mat_postops.output_size : index
  %token_capacity = config.get @ggml.workload.token_capacity : index
  %weight_format = config.get @ggml.mul_mat_postops.weight_format : index
  %c0 = index.constant 0 : index
  %identity = index.constant 23 : index
  %epilogue = config.get @ggml.mul_mat_postops.epilogue : index
  %c0_f32 = scalar.constant 0.0 : f32
  %bounded_token_count = index.assume %token_count [range(%token_count, 2, 5), le(%token_count, %token_capacity)] : index
  %channel_tile = kernel.workgroup.id<x> : index
  %token_tile = kernel.workgroup.id<y> : index
  template.apply<@ggml.matmul.skinny_input_f32_dequant_accumulate_f32.core>(%weight_format, %bounded_token_count, %input_size, %output_size, %c0, %identity, %epilogue, %c0_f32, %channel_tile, %token_tile, %input, %weight, %bias, %residual_output, %residual_input, %residual_output, %residual_output, %residual_output, %residual_output) : (index, index, index, index, index, index, index, f32, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  kernel.return
}
