amdgpu.target<gfx11-generic> @ggml_matmul_vector_postops_gfx11_wave64 {subgroup_size = 64}

config.decl @ggml.matmul.vector_postops.input_size : %value: index where [range(%value, 256, 32768), mul(%value, 32)]

config.decl @ggml.matmul.vector_postops.output_size : %value: index where [range(%value, 1, 524288)]

config.decl @ggml.matmul.vector_postops.weight_format : %value: index where [range(%value, 0, 81)]

config.decl @ggml.matmul.vector_postops.apply_bias : %value: index where [range(%value, 0, 1)]

config.decl @ggml.matmul.vector_postops.apply_residual : %value: index where [range(%value, 0, 1)]

config.decl @ggml.workload.token_capacity : %value: index where [range(%value, 1, 1)]

template.def<@ggml.matmul.vector_activation.publish_vector4> device @ggml_mul_mat_vector_postops_publish_vector4(%publish_word: i1, %token0: index, %channel: index, %token_count0: index, %output_size0: index, %output_accumulation: index, %output_unary_op: index, %publish_format: index, %values: vector<4xf32>, %bias: buffer, %output: buffer, %residual_input: buffer, %residual_output: buffer, %norm_weight: buffer, %normalized_output: buffer, %completion_counters: buffer, %next_output: buffer) {
  %apply_bias0 = config.get @ggml.matmul.vector_postops.apply_bias : index
  %apply_residual0 = config.get @ggml.matmul.vector_postops.apply_residual : index
  %c1 = index.constant 1 : index
  %apply_bias = index.cmp eq, %apply_bias0, %c1 : index
  %apply_residual = index.cmp eq, %apply_residual0, %c1 : index
  scf.if %publish_word {
    %with_bias = scf.if %apply_bias -> (vector<4xf32>) {
      %biased = template.apply<@ggml.matmul.vector_activation.add_bias_vector4>(%output_size0, %channel, %values, %bias) : (index, index, vector<4xf32>, buffer) -> (vector<4xf32>)
      scf.yield %biased : vector<4xf32>
    } else {
      scf.yield %values : vector<4xf32>
    }
    %published = scf.if %apply_residual -> (vector<4xf32>) {
      %residual = template.apply<@ggml.matmul.vector_activation.add_residual_vector4>(%token_count0, %output_size0, %token0, %channel, %with_bias, %residual_input) : (index, index, index, index, vector<4xf32>, buffer) -> (vector<4xf32>)
      scf.yield %residual : vector<4xf32>
    } else {
      scf.yield %with_bias : vector<4xf32>
    }
    template.apply<@ggml.matmul.vector_activation.store_vector4>(%token_count0, %output_size0, %token0, %channel, %published, %residual_output) : (index, index, index, index, vector<4xf32>, buffer)
    template.apply<@ggml.matmul.vector_publish.next_vector4>(%publish_word, %publish_format, %token_count0, %output_size0, %token0, %channel, %published, %next_output) : (i1, index, index, index, index, index, vector<4xf32>, buffer)
  }
  template.return
}

template.def<@ggml.matmul.vector_activation.publish_pair2> device @ggml_mul_mat_vector_postops_publish_pair2(%publish_pair: i1, %token0: index, %channel: index, %token_count0: index, %output_size0: index, %row1_valid: i1, %value0: f32, %value1: f32, %output_accumulation: index, %output_unary_op: index, %publish_format: index, %bias: buffer, %output: buffer, %residual_input: buffer, %residual_output: buffer, %norm_weight: buffer, %normalized_output: buffer, %completion_counters: buffer, %next_output: buffer) {
  %apply_bias0 = config.get @ggml.matmul.vector_postops.apply_bias : index
  %apply_residual0 = config.get @ggml.matmul.vector_postops.apply_residual : index
  %token_count = index.assume %token_count0 [range(%token_count0, 1, 5)] : index
  %output_size = index.assume %output_size0 [range(%output_size0, 1, 524288)] : index
  %c1 = index.constant 1 : index
  %c0_offset = index.constant 0 : offset
  %apply_bias = index.cmp eq, %apply_bias0, %c1 : index
  %apply_residual = index.cmp eq, %apply_residual0, %c1 : index
  %token, %launch_token_count = index.assume %token0, %token_count [lt(%token0, %token_count)] : index, index
  %bias_noalias, %residual_input_noalias, %residual_output_noalias = buffer.assume.noalias %bias, %residual_input, %residual_output : buffer, buffer, buffer
  %bias_view = buffer.view %bias_noalias[%c0_offset] : buffer -> view<[%output_size]xf32>
  %residual_input_view = buffer.view %residual_input_noalias[%c0_offset] : buffer -> view<[%token_count]x[%output_size]xf32>
  %residual_output_view = buffer.view %residual_output_noalias[%c0_offset] : buffer -> view<[%token_count]x[%output_size]xf32>
  scf.if %publish_pair {
    %biased0 = scf.if %apply_bias -> (f32) {
      %bias_value = view.load %bias_view[%channel] : view<[%output_size]xf32> -> f32
      %sum = scalar.addf %value0, %bias_value : f32
      scf.yield %sum : f32
    } else {
      scf.yield %value0 : f32
    }
    %published0 = scf.if %apply_residual -> (f32) {
      %residual = view.load %residual_input_view[%token, %channel] : view<[%token_count]x[%output_size]xf32> -> f32
      %sum = scalar.addf %biased0, %residual : f32
      scf.yield %sum : f32
    } else {
      scf.yield %biased0 : f32
    }
    view.store %published0, %residual_output_view[%token, %channel] : f32, view<[%token_count]x[%output_size]xf32>
  }
  scf.if %row1_valid {
    scf.if %publish_pair {
      %row1 = index.add %channel, %c1 : index
      %biased1 = scf.if %apply_bias -> (f32) {
        %bias_value = view.load %bias_view[%row1] : view<[%output_size]xf32> -> f32
        %sum = scalar.addf %value1, %bias_value : f32
        scf.yield %sum : f32
      } else {
        scf.yield %value1 : f32
      }
      %published1 = scf.if %apply_residual -> (f32) {
        %residual = view.load %residual_input_view[%token, %row1] : view<[%token_count]x[%output_size]xf32> -> f32
        %sum = scalar.addf %biased1, %residual : f32
        scf.yield %sum : f32
      } else {
        scf.yield %biased1 : f32
      }
      view.store %published1, %residual_output_view[%token, %row1] : f32, view<[%token_count]x[%output_size]xf32>
    }
  }
  template.return
}

