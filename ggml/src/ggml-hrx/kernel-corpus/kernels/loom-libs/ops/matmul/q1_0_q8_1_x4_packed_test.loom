func.def inline @ggml_q1_0_q8_1_x4_generic_row_lane(%input_size: index, %weight: buffer, %weight_row_byte_base: offset, %q8_input: buffer, %q8_row_byte_base: offset, %lane: index) -> (f32) {
  %bounded_input_size = index.assume %input_size [range(%input_size, 128, 32768), mul(%input_size, 128)] : index
  %bounded_lane = index.assume %lane [range(%lane, 0, 31)] : index
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %c128 = index.constant 128 : index
  %c0_f32 = scalar.constant 0.0 : f32
  %block_count = index.div %bounded_input_size, %c128 : index
  %lane_k = index.mul %bounded_lane, %c4 : index
  %block_in_q1 = index.div %bounded_lane, %c8 : index
  %word_in_block = index.rem %bounded_lane, %c8 : index
  %result = scf.for %block = [%c0 to %block_count step %c1](%accumulator = %c0_f32 : f32) -> (f32) {
    %block_k = index.mul %block, %c128 : index
    %k = index.add %block_k, %lane_k : index
    %weight_values = func.call @ggml_q1_0_f32_vector4(%weight, %weight_row_byte_base, %k) : (buffer, offset, index) -> (vector<4xf32>)
    %q8_block_base = index.mul %block, %c4 : index
    %q8_block = index.add %q8_block_base, %block_in_q1 : index
    %q8_values_i8, %q8_d = func.call @ggml_q8_1_x4_word(%q8_input, %q8_row_byte_base, %q8_block, %word_in_block) : (buffer, offset, index, index) -> (vector<4xi8>, f32)
    %q8_values_f32 = vector.sitofp %q8_values_i8 : vector<4xi8> to vector<4xf32>
    %q8_scale = vector.splat %q8_d : vector<4xf32>
    %activation = vector.mulf %q8_values_f32, %q8_scale : vector<4xf32>
    %products = vector.mulf %weight_values, %activation : vector<4xf32>
    %contribution = vector.reduce<addf> %products, %c0_f32 : vector<4xf32>, f32
    %next = scalar.addf %accumulator, %contribution : f32
    scf.yield %next : f32
  }
  func.return %result : f32
}

