// Test-only direct comparison between the existing Q1_0 F32 decoder and the
// inactive native Q1_0 x Q8_1 x4 packed contraction motif.
func.decl @ggml_q1_0_f32_vector4(%weight: buffer, %row_byte_base: offset, %k: index) -> (vector<4xf32>)

