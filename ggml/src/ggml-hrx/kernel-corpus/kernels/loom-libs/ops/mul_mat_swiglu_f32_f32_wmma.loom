      %u_sum = func.call @ggml_swiglu_q8_reduce(%total_u4, %partitioned) : (f32, i1) -> (f32)
      scf.if %leader {
        %value = func.call @ggml_mul_mat_swiglu_apply_scalar(%op, %g_sum, %u_sum) : (index, f32, f32) -> (f32)
        view.store %value, %out_view[%p4, %row] : f32, view<[%tokens]x[%n]xf32>
