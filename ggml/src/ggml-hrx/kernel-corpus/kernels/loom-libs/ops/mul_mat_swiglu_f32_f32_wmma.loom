    %peer16, %ok16 = kernel.subgroup.shuffle<xor> %sum8, %off16, %width : f32, i32, i32
    %sum = scalar.addf %sum8, %peer16 : f32
    scf.yield %sum : f32
  } else {
    %zero = scalar.constant 0.0 : f32
    %sum = scalar.addf %sum8, %zero : f32
    scf.yield %sum : f32
  }
  func.return %result : f32
}

