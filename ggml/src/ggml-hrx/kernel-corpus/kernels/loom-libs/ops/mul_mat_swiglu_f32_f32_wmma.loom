// Two K teams amortize native weight service on large paired projections.
// Keep smaller/cache-resident and odd-block reductions on the original mapping.
func.def pure inline @ggml_swiglu_q8_reduction_partitions(%local: i1, %input_size: index, %output_size: index) -> (index) {
  %c0 = index.constant 0 : index
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c256 = index.constant 256 : index
  %minimum_blocks = index.constant 262144 : index
  %blocks = index.div %input_size, %c256 : index
  %tail = index.rem %blocks, %c2 : index
  %even = index.cmp eq, %tail, %c0 : index
  %weight_blocks = index.mul %blocks, %output_size : index
  %large = index.cmp uge, %weight_blocks, %minimum_blocks : index
  %eligible = scalar.andi %local, %even : i1
  %partitioned = scalar.andi %eligible, %large : i1
  %partitions = scf.select %partitioned, %c2, %c1 : index
  func.return %partitions : index
}

func.decl @ggml_lowtoken_reduce_cohort_f32(%value: f32) -> (f32)

func.def inline @ggml_swiglu_q8_reduce(%value: f32, %partitioned: i1) -> (f32) {
