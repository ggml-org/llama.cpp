        %u_cor = scalar.fmaf %u_wm1, %as1, %u_cor0 : f32
        %u_corrected = scalar.subf %u_contribution, %u_cor : f32
        %u_valid = scf.select %valid_block, %u_corrected, %zero : f32
        %u_updated = scalar.addf %acc_u4, %u_valid : f32
        scf.yield %g_updated, %u_updated : f32, f32
      } else {
