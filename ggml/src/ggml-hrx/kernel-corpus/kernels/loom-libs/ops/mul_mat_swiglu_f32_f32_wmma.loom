amdgpu.target<gfx11-generic> @ggml_mul_mat_swiglu_gfx11_wave32 {subgroup_size = 32}

// Low-token specializations keep FP32 operands and accumulation and avoid
// padding a handful of tokens to a full matrix tile.
// Share the activation load across gate/up while preserving token guards and FP32 update order.
func.def inline @ggml_mul_mat_swiglu_accumulate_token_pair(%tokens: index, %k: index, %input: view<[%tokens]x[%k]xf32>, %token: index, %kk: index, %gate: vector<4xf32>, %up: vector<4xf32>, %acc_gate: vector<4xf32>, %acc_up: vector<4xf32>) -> (vector<4xf32>, vector<4xf32>) {
  %valid = index.cmp ult, %token, %tokens : index
  %next_gate, %next_up = scf.if %valid -> (vector<4xf32>, vector<4xf32>) {
    %a = vector.load %input[%token, %kk] : view<[%tokens]x[%k]xf32> -> vector<4xf32>
    %gr = vector.fmaf %gate, %a, %acc_gate : vector<4xf32>
    %ur = vector.fmaf %up, %a, %acc_up : vector<4xf32>
    scf.yield %gr, %ur : vector<4xf32>, vector<4xf32>
  } else {
    scf.yield %acc_gate, %acc_up : vector<4xf32>, vector<4xf32>
  }
  func.return %next_gate, %next_up : vector<4xf32>, vector<4xf32>
}

