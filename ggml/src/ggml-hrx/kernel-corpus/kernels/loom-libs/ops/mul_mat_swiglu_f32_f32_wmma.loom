        view.store %value, %out_view[%p0, %row] : f32, view<[%tokens]x[%n]xf32>
        scf.if %publish_q8 {
          view.store %value, %epilogue_view[%p0, %epilogue_row] : f32, view<5x32xf32>
        }
      }
    }
    %p1 = index.constant 1 : index
    %pv1 = index.cmp ult, %p1, %tokens : index
    scf.if %pv1 {
