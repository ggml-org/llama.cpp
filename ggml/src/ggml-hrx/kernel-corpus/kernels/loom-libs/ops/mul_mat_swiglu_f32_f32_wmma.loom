      }
      scf.yield %next_g0, %next_g1, %next_g2, %next_g3, %next_g4, %next_u0, %next_u1, %next_u2, %next_u3, %next_u4, %next_g_headers, %next_u_headers, %next_g_raw, %next_u_raw : f32, f32, f32, f32, f32, f32, f32, f32, f32, f32, vector<4xi32>, vector<4xi32>, vector<2xi32>, vector<2xi32>
    }
    %leader = index.cmp eq, %team_lane, %c0 : index
