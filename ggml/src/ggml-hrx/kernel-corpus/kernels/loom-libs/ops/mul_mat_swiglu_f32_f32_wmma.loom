    %count, %capacity = index.assume %token_count, %token_capacity [range(%token_count, 512, 2048), mul(%token_count, 512), eq(%token_count, %token_capacity)] : index, index
    scf.yield %count : index
  } else {
    %count = index.assume %token_count [range(%token_count, 256, 2048), mul(%token_count, 256), le(%token_count, %token_capacity)] : index
    scf.yield %count : index
  }
  %bounded_output_size = index.assume %output_size [range(%output_size, 64, 262144), mul(%output_size, 64)] : index
  %channel_tile = kernel.workgroup.id<y> : index
  %token_tile = kernel.workgroup.id<x> : index
  %paired = scalar.constant true : i1
  %prefill_weight_format = index.constant 44 : index
  %binary_op = config.get @ggml.mul_mat_swiglu.op : index
  %f16_output_layout = config.get @ggml.mul_mat_swiglu.f16_output_layout : index
  %packed_layout = index.constant 1 : index
