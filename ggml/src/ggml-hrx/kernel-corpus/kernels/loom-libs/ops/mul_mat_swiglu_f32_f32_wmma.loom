template.def<@ggml.mul_mat_swiglu.launch> @ggml_mul_mat_swiglu_f32_f32_wmma_launch(%token_capacity: index, %output_size: index) -> (index, index, index, index) {
  %c1 = index.constant 1 : index
  %c31 = index.constant 31 : index
  %c32 = index.constant 32 : index
  %c63 = index.constant 63 : index
  %c64 = index.constant 64 : index
  %c128 = index.constant 128 : index
  %padded_output_size = index.add %output_size, %c63 : index
  %output_tiles = index.div %padded_output_size, %c64 : index
  %padded_token_count = index.add %token_capacity, %c31 : index
  %token_tiles = index.div %padded_token_count, %c32 : index
  template.return %output_tiles, %token_tiles, %c1, %c128 : index, index, index, index
}

kernel.def target(@ggml_mul_mat_swiglu_gfx11_wave64) @ggml_mul_mat_swiglu_f32_f32_wmma(%token_count: index) {
  %output_size = config.get @ggml.mul_mat_swiglu.output_size : index
