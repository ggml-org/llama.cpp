    } else {
      scf.yield %values : vector<4xf32>
    }
    %published = scf.if %has_residual -> (vector<4xf32>) {
      %added = template.apply<@ggml.matmul_id.skinny_f32_f32.add_residual_vector4>(%token_count0, %route_count0, %output_size0, %assignment, %channel, %with_bias, %residual_input) : (index, index, index, index, index, vector<4xf32>, buffer) -> (vector<4xf32>)
      scf.yield %added : vector<4xf32>
    } else {
      scf.yield %with_bias : vector<4xf32>
    }
    template.apply<@ggml.matmul_id.skinny_f32_f32.store_vector4>(%token_count0, %route_count0, %output_size0, %assignment, %channel, %published, %output) : (index, index, index, index, index, vector<4xf32>, buffer)
  }
  template.return
}

