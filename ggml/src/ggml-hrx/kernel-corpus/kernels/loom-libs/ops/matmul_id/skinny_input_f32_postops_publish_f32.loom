template.def<@ggml.matmul_id.skinny_f32_f32.publish_vector4> device @ggml_mul_mat_id_skinny_postops_publish_vector4(%publish_word: i1, %assignment: index, %token: index, %route: index, %channel: index, %token_count0: index, %route_count0: index, %output_size0: index, %values: vector<4xf32>, %bias: buffer, %output: buffer, %residual_input: buffer, %residual_output: buffer, %norm_weight: buffer, %normalized_output: buffer, %completion_counters: buffer) {
  %has_bias_value = config.get @ggml.mul_mat_id_postops.has_bias : index
  %has_residual_value = config.get @ggml.mul_mat_id_postops.has_residual : index
  %c0 = index.constant 0 : index
  %has_bias = index.cmp ne, %has_bias_value, %c0 : index
  %has_residual = index.cmp ne, %has_residual_value, %c0 : index
