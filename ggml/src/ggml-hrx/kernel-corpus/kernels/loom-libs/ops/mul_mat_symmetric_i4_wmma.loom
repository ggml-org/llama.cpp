        %f16_row_end0 = index.add %f16_row1, %f16_c4 : index
        %f16_token, %f16_row, %f16_row_end, %f16_cols, %f16_rows = index.assume %f16_token0, %f16_row1, %f16_row_end0, %cols_b, %rows_b [lt(%f16_token0, %cols_b), le(%f16_row_end0, %rows_b)] : index, index, index, index, index
        vector.store %f16_narrow, %dst_f16_view[%f16_token, %f16_row] : vector<4xf16>, view<[%cols_b]x[%rows_b]xf16>
