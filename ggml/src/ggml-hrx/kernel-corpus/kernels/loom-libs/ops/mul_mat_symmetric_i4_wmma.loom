        %u4_sum1 = scalar.addi %u4_lane_sum, %u4_sum1_peer : i32
        %u4_sum2_peer, %u4_sum2_valid = kernel.subgroup.shuffle<xor> %u4_sum1, %u4_xor2, %u4_shuffle_width : i32, i32, i32
