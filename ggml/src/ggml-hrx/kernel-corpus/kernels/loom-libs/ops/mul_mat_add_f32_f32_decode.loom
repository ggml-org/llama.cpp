    %residual0 = view.load %residual_input_view[%token, %channel] : view<[%launch_token_count]x[%output_size]xf32> -> f32
    %sum0 = scalar.addf %value0, %residual0 : f32
    view.store %sum0, %output_view[%token, %channel] : f32, view<[%launch_token_count]x[%output_size]xf32>
  }
  scf.if %row1_valid {
