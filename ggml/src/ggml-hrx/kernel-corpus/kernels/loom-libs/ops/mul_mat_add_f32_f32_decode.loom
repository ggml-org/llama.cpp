template.def<@ggml.mul_mat_f32_f32_decode.publish_pair2> device priority(20) @ggml_mul_mat_add_f32_f32_decode_publish_pair2(%publish_pair: i1, %token0: index, %channel: index, %token_count0: index, %output_size0: index, %row1_valid: i1, %value0: f32, %value1: f32, %output: buffer, %residual_input: buffer, %aux1: buffer, %aux2: buffer, %aux3: buffer) {
