template.decl @ggml.rmsnorm_f32.row_scale(%token_count: index, %token: index, %hidden_size: index, %input_stride: index, %epsilon: f32, %input: buffer) -> (f32, index, index, i1)

template.decl @ggml.rmsnorm_f32.apply(%value: f32, %scale: f32) -> (f32)
template.decl @ggml.binary_f32.apply(%op: index, %lhs: f32, %rhs: f32) -> (f32)

amdgpu.target<gfx11-generic> @ggml_rmsnorm_mul_add_gfx11_wave32 {subgroup_size = 32}

config.decl @ggml.rmsnorm_mul_add_f32.hidden_size : %value: index where [range(%value, 128, 32768), mul(%value, 128)]

config.decl @ggml.rmsnorm_mul_add_f32.rms_epsilon : f32
config.decl @ggml.rmsnorm_mul_add_f32.normalized_op : %value: index where [range(%value, 0, 3)]
config.decl @ggml.rmsnorm_mul_add_f32.output_op : %value: index where [range(%value, 0, 3)]
config.decl @ggml.rmsnorm_mul_add_f32.binary_lhs : %value: index where [range(%value, 0, 1)]

kernel.def target(@ggml_rmsnorm_mul_add_gfx11_wave32) export("ggml_rmsnorm_mul_add_f32") @ggml_rmsnorm_mul_add_f32(%token_count: index) {
  %c1 = index.constant 1 : index
  %c256 = index.constant 256 : index
  kernel.launch.config workgroups(%token_count, %c1, %c1) workgroup_size(%c256, %c1, %c1) : index
} launch(%token_count: index, %input: buffer, %weight: buffer, %residual: buffer, %output: buffer) where [range(%token_count, 1, 1048576)] {
  %hidden0 = config.get @ggml.rmsnorm_mul_add_f32.hidden_size : index
  %hidden = index.assume %hidden0 [range(%hidden0, 128, 32768), mul(%hidden0, 128)] : index
  %epsilon = config.get @ggml.rmsnorm_mul_add_f32.rms_epsilon : f32
  %normalized_op = config.get @ggml.rmsnorm_mul_add_f32.normalized_op : index
  %output_op = config.get @ggml.rmsnorm_mul_add_f32.output_op : index
  %binary_lhs = config.get @ggml.rmsnorm_mul_add_f32.binary_lhs : index
  %token0 = kernel.workgroup.id<x> : index
  %workitem = kernel.workitem.id<x> : index
  %c0_offset = index.constant 0 : offset
  %c256 = index.constant 256 : index
  %input_noalias, %weight_noalias, %residual_noalias, %output_noalias = buffer.assume.noalias %input, %weight, %residual, %output : buffer, buffer, buffer, buffer
  %row_scale, %token, %launch_token_count, %valid_token = template.apply<@ggml.rmsnorm_f32.row_scale>(%token_count, %token0, %hidden, %hidden, %epsilon, %input_noalias) : (index, index, index, index, f32, buffer) -> (f32, index, index, i1)
  %input_view = buffer.view %input_noalias[%c0_offset] : buffer -> view<[%launch_token_count]x[%hidden]xf32>
  %weight_view = buffer.view %weight_noalias[%c0_offset] : buffer -> view<[%hidden]xf32>
  %residual_view = buffer.view %residual_noalias[%c0_offset] : buffer -> view<[%launch_token_count]x[%hidden]xf32>
  %output_view = buffer.view %output_noalias[%c0_offset] : buffer -> view<[%launch_token_count]x[%hidden]xf32>
  scf.if %valid_token {
    scf.for %channel = [%workitem to %hidden step %c256] {
      %value = view.load %input_view[%token, %channel] : view<[%launch_token_count]x[%hidden]xf32> -> f32
      %weight_value = view.load %weight_view[%channel] : view<[%hidden]xf32> -> f32
      %residual_value = view.load %residual_view[%token, %channel] : view<[%launch_token_count]x[%hidden]xf32> -> f32
      %normalized = template.apply<@ggml.rmsnorm_f32.apply>(%value, %row_scale) : (f32, f32) -> (f32)
      %scaled = template.apply<@ggml.binary_f32.apply>(%normalized_op, %normalized, %weight_value) : (index, f32, f32) -> (f32)
      %c1 = index.constant 1 : index
      %is_binary_lhs = index.cmp eq, %binary_lhs, %c1 : index
      %lhs = scf.select %is_binary_lhs, %scaled, %residual_value : f32
      %rhs = scf.select %is_binary_lhs, %residual_value, %scaled : f32
      %result = template.apply<@ggml.binary_f32.apply>(%output_op, %lhs, %rhs) : (index, f32, f32) -> (f32)
      view.store %result, %output_view[%token, %channel] : f32, view<[%launch_token_count]x[%hidden]xf32>
    }
  }
  kernel.return
}

check.case public @ggml_rmsnorm_mul_add_f32_case {
  %token_count = check.literal value(1) : index
  %input = check.generate.fill value(2.0) : tensor<128xf32>
  %weight = check.generate.iota offset(0.25) step(0.01) : tensor<128xf32>
  %residual = check.generate.fill value(3.0) : tensor<128xf32>
  %output = check.generate.fill value(0.0) : tensor<128xf32>
  %expected = check.generate.iota offset(3.25) step(0.01) : tensor<128xf32>
  kernel.launch @ggml_rmsnorm_mul_add_f32[%token_count](%token_count, %input, %weight, %residual, %output) : [index](index, tensor<128xf32>, tensor<128xf32>, tensor<128xf32>, tensor<128xf32>)
  check.expect.close actual(%output) expected(%expected) atol(9.9999999999999991e-06) rtol(9.9999999999999991e-06) nan(same) : tensor<128xf32>
  check.return
}

check.benchmark<@ggml_rmsnorm_mul_add_f32_case> @ggml_rmsnorm_mul_add_f32_decode
