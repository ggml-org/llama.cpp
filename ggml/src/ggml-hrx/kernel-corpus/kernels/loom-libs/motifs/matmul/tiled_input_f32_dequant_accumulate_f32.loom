  %output_tile_count = index.div %padded_output_size, %c64 : index
  %padded_token_count = index.add %bounded_token_count, %c31 : index
  %token_tile_count = index.div %padded_token_count, %c32 : index
  %padded_input_size = index.add %bounded_input_size, %c255 : index
  %quant_block_count = index.div %padded_input_size, %c256 : index
