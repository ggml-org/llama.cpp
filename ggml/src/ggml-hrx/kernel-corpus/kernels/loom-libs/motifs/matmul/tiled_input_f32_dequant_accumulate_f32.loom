          %row_byte_base = index.scale %channel, %weight_row_bytes : index, offset -> offset
          %decoded = func.call @ggml_dequant_f16_vector4(%iq4nl_table, %iq3s_grid_low0, %iq3s_grid_low1, %iq3s_grid_low2, %iq3s_grid_low3, %iq3s_grid_low4, %iq3s_grid_low5, %iq3s_grid_low6, %iq3s_grid_low7, %iq3s_grid_low8, %iq3s_grid_low9, %iq3s_grid_low10, %iq3s_grid_low11, %iq3s_grid_low12, %iq3s_grid_low13, %iq3s_grid_low14, %iq3s_grid_low15, %iq3s_grid_high0, %iq3s_grid_high1, %iq3s_grid_high2, %iq3s_grid_high3, %iq3s_grid_high4, %iq3s_grid_high5, %iq3s_grid_high6, %iq3s_grid_high7, %iq3s_grid_high8, %iq3s_grid_high9, %iq3s_grid_high10, %iq3s_grid_high11, %iq3s_grid_high12, %iq3s_grid_high13, %iq3s_grid_high14, %iq3s_grid_high15, %weight_format, %weight_noalias, %row_byte_base, %bounded_input_size, %quant_block, %quant_group, %load_packet, %weight_k) : (vector<16xi8>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, vector<32xf32>, index, buffer, offset, index, index, index, index, index) -> (vector<4xf16>)
          scf.yield %decoded : vector<4xf16>
        } else {
          scf.yield %c0_f16x4 : vector<4xf16>
        }
        vector.store %weight_values, %weight_stage_view[%local_row, %load_k] : vector<4xf16>, view<64x40xf16>
        %is_activation_row = index.cmp ult, %local_row, %c32 : index
        scf.if %is_activation_row {
          %activation_row = index.assume %local_row [range(%local_row, 0, 31)] : index
          %token = index.add %token_tile_base, %activation_row : index
          %tail_valid_token = index.cmp ult, %token, %bounded_token_count : index
          %valid_token = scalar.ori %full_token_tiles, %tail_valid_token : i1
          %input_k = index.add %k_origin, %load_k : index
          %valid_input = index.cmp ult, %input_k, %bounded_input_size : index
          %valid_activation = scalar.andi %valid_token, %valid_input : i1
          %activation_values = scf.if %valid_activation -> (vector<4xf16>) {
            %row_element_offset = index.mul %token, %bounded_input_size : index
            %f16_row_byte_offset = index.scale %row_element_offset, %f16_element_bytes : index, offset -> offset
            %f32_row_byte_offset = index.scale %row_element_offset, %f32_element_bytes : index, offset -> offset
            %input_f16_row = buffer.view %input_noalias[%f16_row_byte_offset] : buffer -> view<[%bounded_input_size]xf16>
            %input_f32_row = buffer.view %input_noalias[%f32_row_byte_offset] : buffer -> view<[%bounded_input_size]xf32>
            %mask = vector.mask.range [%input_k to %bounded_input_size step %c1] : index -> vector<4xi1>
            %converted = scf.if %uses_f16_activation -> (vector<4xf16>) {
              %loaded = vector.load.mask %input_f16_row[%input_k], %mask, %c0_f16x4 : view<[%bounded_input_size]xf16>, vector<4xi1>, vector<4xf16>
              scf.yield %loaded : vector<4xf16>
            } else {
              %loaded = vector.load.mask %input_f32_row[%input_k], %mask, %c0_f32x4 : view<[%bounded_input_size]xf32>, vector<4xi1>, vector<4xf32>
              %narrow = vector.fptrunc %loaded : vector<4xf32> to vector<4xf16>
