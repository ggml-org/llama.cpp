  %publish_token0 = index.div %lane, %c4 : index
  %publish_token = index.assume %publish_token0 [range(%publish_token0, 0, 15)] : index
  %publish_packet0 = index.rem %lane, %c4 : index
  %publish_packet = index.assume %publish_packet0 [range(%publish_packet0, 0, 3)] : index
  %publish_channel_add = index.mul %publish_packet, %c4 : index
