template.def<@ggml.matmul.vector_activation.launch> pure @ggml_matmul_vector_codebook_launch(%token_capacity: index, %input_size: index, %output_size: index, %weight_format: index) -> (index, index, index, index) {
  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c64 = index.constant 64 : index
  %rounded_output = index.add %output_size, %c1 : index
  %output_groups = index.div %rounded_output, %c2 : index
  template.return %output_groups, %c1, %c1, %c64 : index, index, index, index
}

