      }
      %next0 = scalar.addf<reassoc|nnan|ninf|nsz> %row_acc0, %contribution0 : f32
      %next1 = scalar.addf<reassoc|nnan|ninf|nsz> %row_acc1, %contribution1 : f32
      scf.yield %next0, %next1 : f32, f32
    }
    %sum0 = kernel.workgroup.reduce<addf> %acc0 : f32
    %sum1 = kernel.workgroup.reduce<addf> %acc1 : f32
    %is_lane_zero = index.cmp eq, %lane, %c0 : index
    %publish_pair = scalar.andi %publish_output, %is_lane_zero : i1
    template.apply<@ggml.matmul.vector_activation.publish_pair2>(%publish_pair, %token, %row0, %launch_tokens, %launch_n, %row1_valid, %sum0, %sum1, %output_accumulation, %output_unary_op, %publish_format, %bias, %output, %residual_input, %residual_output, %norm_weight, %normalized_output, %completion_counters, %next_output) : (i1, index, index, index, index, i1, f32, f32, index, index, index, buffer, buffer, buffer, buffer, buffer, buffer, buffer, buffer)
  }
  func.return
}
