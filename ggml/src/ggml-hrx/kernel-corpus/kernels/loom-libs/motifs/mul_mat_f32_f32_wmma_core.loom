  %qh = vector.load %raw_view[%half128, %c2, %row_lane, %packet] : view<2x3x64x8xi32> -> vector<4xi32>
  func.return %dh, %si, %ql, %qh : f16, i8, vector<4xi32>, vector<4xi32>
}

func.def inline @ggml_q6_q8_lowtoken_activation_values(%pipelined: i1, %token: index, %q8_row_bytes: offset, %q8_block_add: offset, %capacity: index, %current_slot: index, %q8_block0: index, %q8_input: buffer, %q8_word0: index, %q8_meta: index) -> (vector<16xi8>, f32) {
  %code_offset = index.constant 16 : offset
