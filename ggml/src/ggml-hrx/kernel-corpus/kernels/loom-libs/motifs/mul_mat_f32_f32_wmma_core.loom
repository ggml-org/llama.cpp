    %qc = index.add %qb, %code_offset : offset
    %q_view = buffer.view %q8_input[%qc] : buffer -> view<32xi32>
    %ds_view = buffer.view %q8_input[%qb] : buffer -> view<8xf16>
    %words = vector.load %q_view[%q8_word0] : view<32xi32> -> vector<4xi32>
    %a = vector.bitcast %words : vector<4xi32> to vector<16xi8>
    %scale = view.load %ds_view[%q8_meta] : view<8xf16> -> f16
