func.def inline @ggml_q8_1_x4_publish_lowtoken_half_slab(%stage: buffer, %capacity0: index, %slot0: index, %values: vector<4xi32>) {
  %capacity = index.assume %capacity0 [range(%capacity0, 1, 5)] : index
  %slot = index.assume %slot0 [range(%slot0, 0, 1)] : index
