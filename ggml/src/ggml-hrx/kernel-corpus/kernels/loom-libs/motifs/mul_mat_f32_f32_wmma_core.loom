  %contracting = scalar.andi %wide, %contracts : i1
  %eligible = scalar.andi %four_tokens, %contracting : i1
  func.return %eligible : i1
}

func.def inline @ggml_q4_q8_lowtoken_adjacent_scale_min(%scale0: i32, %scale1: i32, %scale2: i32, %pair0: index) -> (i32, i32, i32, i32) {
