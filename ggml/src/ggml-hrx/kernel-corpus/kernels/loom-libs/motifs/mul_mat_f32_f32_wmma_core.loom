  %c1 = index.constant 1 : index
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c7 = index.constant 7 : index
  %c8 = index.constant 8 : index
  %c16 = index.constant 16 : index
  %c64 = index.constant 64 : index
  %c256 = index.constant 256 : index
  %base = index.constant 0 : offset
  %zero = vector.constant 0.0 : vector<4xf32>
  %tokens = index.assume %token_count [range(%token_count, 1, 5)] : index
  %k = index.assume %input_size0 [range(%input_size0, 256, 32768), mul(%input_size0, 256)] : index
  %n = index.assume %output_size0 [range(%output_size0, 1, 262144)] : index
