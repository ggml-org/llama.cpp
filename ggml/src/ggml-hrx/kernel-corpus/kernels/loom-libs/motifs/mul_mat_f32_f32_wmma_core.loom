      %copy_bytes = index.scale %copy_inner, %packet_bytes : index, offset -> offset
      %copy_base0 = index.add %copy_row, %slab_byte_add : offset
      %copy_base = index.add %copy_base0, %copy_bytes : offset
      %source = buffer.view %input[%copy_base] : buffer -> view<4xi32>
