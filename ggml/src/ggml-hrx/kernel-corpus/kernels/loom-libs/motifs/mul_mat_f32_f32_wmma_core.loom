  %safe_inner = scf.select %copy_valid, %copy_inner, %c0 : index
  %copy_row = index.scale %copy_token, %global_row_bytes : index, offset -> offset
  %slot_bytes = index.scale %slot_begin, %block_bytes : index, offset -> offset
  %copy_bytes = index.scale %safe_inner, %packet_bytes : index, offset -> offset
  %copy_base0 = index.add %copy_row, %slot_bytes : offset
  %copy_base = index.add %copy_base0, %copy_bytes : offset
  %source = buffer.view %input[%copy_base] : buffer -> view<4xi32>
