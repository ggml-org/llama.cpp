// Native Q4_K bytes and Q8_1_x4 activations, with one 16-lane cohort per row.
// Retain the wrapper publication hooks so bias, residual and RMSNorm fusions
// share this contraction without a separate dispatch or intermediate output.
func.def pure inline @ggml_q4_q8_lowtoken_token_pairs(%capacity: index, %tokens: index, %k: index, %n: index) -> (i1) {
  %c4 = index.constant 4 : index
