  %tile_rows = scf.select %full_wave, %c4, %c8 : index
  %wave_rows = scf.select %full_wave, %c1, %c4 : index
  %step_width = scf.select %full_wave, %c256, %c64 : index
  %steps_per_block = scf.select %full_wave, %c1, %c4 : index
