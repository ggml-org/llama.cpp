// Call uniformly at a slab boundary; only the final slab may be partial.
func.def inline @ggml_q8_1_x4_stage_lowtoken_slab(%input: buffer, %stage: buffer, %capacity: index, %slab_begin: index, %blocks: index, %global_row_bytes: offset) {
