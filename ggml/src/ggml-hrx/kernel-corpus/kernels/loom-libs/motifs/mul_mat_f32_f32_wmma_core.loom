        %is_activation_row = index.cmp ult, %local_row, %c32 : index
        scf.if %is_activation_row {
          %activation_row = index.assume %local_row [range(%local_row, 0, 31)] : index
          %token = index.add %token_tile_base, %activation_row : index
          %valid_token = index.cmp ult, %token, %bounded_token_count : index
          %input_k = index.add %k_origin, %load_k : index
          %valid_input = index.cmp ult, %input_k, %bounded_input_size : index
          %valid_activation = scalar.andi %valid_token, %valid_input : i1
          %activation_values = scf.if %valid_activation -> (vector<4xf16>) {
            %bounded_token, %input_token_count = index.assume %token, %bounded_token_count [lt(%token, %bounded_token_count)] : index, index
            %mask = vector.mask.range [%input_k to %bounded_input_size step %c1] : index -> vector<4xi1>
