  %sign_mask = scalar.andi %signs, %sign_bit : i32
  %negative = scalar.cmpi ne, %sign_mask, %c0_i32 : i32
  %sign = scf.select %negative, %cneg1_f32, %c1_f32 : f32
  %signed = scalar.mulf %value_f32, %sign : f32
  %result = scalar.mulf %signed, %scale : f32
  func.return %result : f32
}

func.def inline @ggml_iq2s_f32_vector4(%weight: buffer, %row_byte_base: offset, %iq2_block: index, %iq2_group: index, %packet: index) -> (vector<4xf32>) {
