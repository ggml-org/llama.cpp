  %selected_word1_high22 = scf.select %is_chunk22, %iq2s_word1_high_22, %selected_word1_high21 : vector<32xf32>
  %selected_word1_high23 = scf.select %is_chunk23, %iq2s_word1_high_23, %selected_word1_high22 : vector<32xf32>
