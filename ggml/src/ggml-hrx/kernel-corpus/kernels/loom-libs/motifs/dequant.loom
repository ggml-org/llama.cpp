// Reuse immutable Q5 metadata across all four 64-element quarters.
func.def inline @ggml_q5k_load_decode_state(%weight: buffer, %row_base: offset, %block: index, %packet: index) -> (vector<2xf16>, vector<3xi32>, vector<4xi8>) {
  %c0 = index.constant 0 : index
  %c4 = index.constant 4 : index
  %block_bytes = index.constant 176 : offset
  %qh_offset = index.constant 16 : offset
  %block_add = index.scale %block, %block_bytes : index, offset -> offset
  %block_base = index.add %row_base, %block_add : offset
  %qh_base = index.add %block_base, %qh_offset : offset
  %header_view = buffer.view %weight[%block_base] : buffer -> view<4xi32>
  %header = vector.load %header_view[%c0] : view<4xi32> -> vector<4xi32>
  %dm_word = vector.extract %header[0] : vector<4xi32> -> i32
  %dm_vector = vector.from_elements %dm_word : vector<1xi32>
  %dm = vector.bitcast %dm_vector : vector<1xi32> to vector<2xf16>
  %s0 = vector.extract %header[1] : vector<4xi32> -> i32
  %s1 = vector.extract %header[2] : vector<4xi32> -> i32
  %s2 = vector.extract %header[3] : vector<4xi32> -> i32
  %scales = vector.from_elements %s0, %s1, %s2 : vector<3xi32>
  %qh_view = buffer.view %weight[%qh_base] : buffer -> view<32xi8>
  %packet_base = index.mul %packet, %c4 : index
  %qh = vector.load %qh_view[%packet_base] : view<32xi8> -> vector<4xi8>
  func.return %dm, %scales, %qh : vector<2xf16>, vector<3xi32>, vector<4xi8>
}

func.def inline @ggml_q5k_preloaded_f32_vector4(%weight: buffer, %row_byte_base: offset, %q5_block: index, %q5_group: index, %packet: index, %dm: vector<2xf16>, %scales: vector<3xi32>, %qh_bytes: vector<4xi8>) -> (vector<4xf32>) {
  %c2 = index.constant 2 : index
  %c4 = index.constant 4 : index
  %c8 = index.constant 8 : index
  %block_bytes = index.constant 176 : offset
  %code_offset = index.constant 48 : offset
