}

func.def inline @ggml_iq2s_value_f32(%grid_word: i32, %shift: i32, %signs: i32, %sign_bit: i32, %scale: f32) -> (f32) {
  %c0_i32 = scalar.constant 0 : i32
  %c255_i32 = scalar.constant 255 : i32
  %c1_f32 = scalar.constant 1.0 : f32
  %cneg1_f32 = scalar.constant -1.0 : f32
