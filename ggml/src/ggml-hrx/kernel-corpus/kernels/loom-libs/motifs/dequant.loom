    %words = vector.concat<0> %loaded, %padding : vector<2xi32>, vector<2xi32> -> vector<4xi32>
    scf.yield %words : vector<4xi32>
  } else {
    %view = buffer.view %weight[%offset] : buffer -> view<4xi32>
    %words = vector.load %view[%zero] : view<4xi32> -> vector<4xi32>
    scf.yield %words : vector<4xi32>
