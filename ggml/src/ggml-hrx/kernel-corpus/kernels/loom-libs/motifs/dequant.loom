func.def public inline @ggml_codebook_f32_vector4(%weight_format: index, %codebook: buffer, %weight: buffer, %row_byte_base: offset, %quant_block: index, %quant_group: index, %packet: index) -> (vector<4xf32>) {
  %iq1_s_format = index.constant 19 : index
  %iq3_xxs_format = index.constant 18 : index
  %iq3_s_format = index.constant 21 : index
  %iq1_m_format = index.constant 29 : index
  %iq2_xxs_format = index.constant 24 : index
  %iq2_xs_format = index.constant 25 : index
  %is_iq1_s = index.cmp eq, %weight_format, %iq1_s_format : index
  %is_iq3_xxs = index.cmp eq, %weight_format, %iq3_xxs_format : index
  %is_iq3_s = index.cmp eq, %weight_format, %iq3_s_format : index
  %is_iq1_m = index.cmp eq, %weight_format, %iq1_m_format : index
  %is_iq2_xxs = index.cmp eq, %weight_format, %iq2_xxs_format : index
  %is_iq2_xs = index.cmp eq, %weight_format, %iq2_xs_format : index
  %other_values = scf.if %is_iq3_s -> (vector<4xf32>) {
    %values = func.call @ggml_iq3s_global_f32_vector4(%codebook, %weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, buffer, offset, index, index, index) -> (vector<4xf32>)
    scf.yield %values : vector<4xf32>
  } else {
    %iq2_values = scf.if %is_iq2_xxs -> (vector<4xf32>) {
      %values = func.call @ggml_iq2xxs_global_f32_vector4(%codebook, %weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, buffer, offset, index, index, index) -> (vector<4xf32>)
      scf.yield %values : vector<4xf32>
    } else {
      %xs_or_s = scf.if %is_iq2_xs -> (vector<4xf32>) {
        %values = func.call @ggml_iq2xs_global_f32_vector4(%codebook, %weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, buffer, offset, index, index, index) -> (vector<4xf32>)
        scf.yield %values : vector<4xf32>
      } else {
        %values = func.call @ggml_iq2s_global_f32_vector4(%codebook, %weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, buffer, offset, index, index, index) -> (vector<4xf32>)
        scf.yield %values : vector<4xf32>
      }
      scf.yield %xs_or_s : vector<4xf32>
    }
    scf.yield %iq2_values : vector<4xf32>
  }
  %iq3_xxs_or_other = scf.if %is_iq3_xxs -> (vector<4xf32>) {
    %values = func.call @ggml_iq3xxs_global_f32_vector4(%codebook, %weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, buffer, offset, index, index, index) -> (vector<4xf32>)
    scf.yield %values : vector<4xf32>
  } else {
    scf.yield %other_values : vector<4xf32>
  }
  %iq1_m_or_other = scf.if %is_iq1_m -> (vector<4xf32>) {
    %values = func.call @ggml_iq1m_global_f32_vector4(%codebook, %weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, buffer, offset, index, index, index) -> (vector<4xf32>)
    scf.yield %values : vector<4xf32>
  } else {
    scf.yield %iq3_xxs_or_other : vector<4xf32>
  }
  %result = scf.if %is_iq1_s -> (vector<4xf32>) {
    %values = func.call @ggml_iq1s_global_f32_vector4(%codebook, %weight, %row_byte_base, %quant_block, %quant_group, %packet) : (buffer, buffer, offset, index, index, index) -> (vector<4xf32>)
    scf.yield %values : vector<4xf32>
  } else {
    scf.yield %iq1_m_or_other : vector<4xf32>
  }
  func.return %result : vector<4xf32>
}

