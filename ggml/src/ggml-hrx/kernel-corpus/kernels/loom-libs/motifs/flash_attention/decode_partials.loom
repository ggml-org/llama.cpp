  %query_head_valid1 = index.cmp ult, %query_head1, %query_head_count : index
  %query_head_valid2 = index.cmp ult, %query_head2, %query_head_count : index
  %query_head_valid3 = index.cmp ult, %query_head3, %query_head_count : index
