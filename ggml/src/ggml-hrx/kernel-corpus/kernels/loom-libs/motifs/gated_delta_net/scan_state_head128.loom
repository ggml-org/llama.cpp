        // The ordinary graph contract appends updated state after attention.
        template.apply<@llm.gated_delta_net.publish_f32.state_head128>(%wcol, %s_v, %state_offset, %attn_elems, %row0, %k128, %dst_view, %sf0, %sf1, %sf2, %sf3, %sf4, %sf5, %sf6, %sf7, %sf8, %sf9, %sf10, %sf11, %sf12, %sf13, %sf14, %sf15) : (index, index, index, index, index, index, view<1073741824xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>, vector<4xf32>)
      }
    }
  }
  scf.if %publish_q8 {
    %t0 = index.constant 0 : index
      template.apply<@llm.gated_delta_net.rmsnorm_gate.publish_head128>(%base, %n_tokens, %n_heads, %n_seqs, %lane, %wave, %t0, %seq, %c0, %h_idx, %k4, %k8, %k16, %k128, %rms_epsilon, %rms_gate_op, %publish_q8, %lds, %rms_weight, %raw_gate, %norm_output, %half_output) : (offset, index, index, index, index, index, index, index, index, index, index, index, index, index, f32, index, i1, buffer, buffer, buffer, buffer, buffer)
    
  }

  template.return
}
