    %result3 = vector.insert %out3 into %result2[%c3] : f32, vector<4xf32>
    vector.store %result3, %output_view[%token, %channel] : vector<4xf32>, view<[%token_count]x[%hidden]xf32>
    template.apply<@ggml.normalization.publish_f16.k16_vector4>(%result3, %channel, %token, %token_count, %hidden, %pair, %f16_output) : (vector<4xf32>, index, index, index, index, index, buffer)
