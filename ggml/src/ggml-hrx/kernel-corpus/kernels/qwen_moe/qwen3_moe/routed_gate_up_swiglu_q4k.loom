kernel.def @qwen3_moe_routed_gate_up_swiglu_q4k_q8(%token_count: index, %route_count: index, %route_stride: index, %expert_count: index, %output_size: index) {
  %configured_route_count = config.get @qwen3_moe.routed_gate_up.route_count : index
  %configured_output_size = config.get @qwen3_moe.routed_gate_up.output_size : index
  %unit = index.constant 1 : index
  %c3 = index.constant 3 : index
  %c4 = index.constant 4 : index
  %workgroup_size = index.constant 128 : index
