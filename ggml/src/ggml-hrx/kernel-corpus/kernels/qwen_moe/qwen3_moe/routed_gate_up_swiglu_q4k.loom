    view.store %old_counter, %counter_scratch_view[%c0] : i32, view<1xi32>
  }
  kernel.barrier<workgroup> scope(workgroup) ordering(acq_rel)
  %old_counter = view.load %counter_scratch_view[%c0] : view<1xi32> -> i32
  %group_size_i32 = index.cast %c128 : index to i32
  %last_arrival_i32 = scalar.subi %group_size_i32, %c4_i32 : i32
  %negative_group_size_i32 = scalar.subi %c0_i32, %group_size_i32 : i32
  %is_last_arrival = scalar.cmpi eq, %old_counter, %last_arrival_i32 : i32
