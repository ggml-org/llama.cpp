    %table_descriptor_ordinal, %table_descriptor_capacity = index.assume %descriptor_ordinal, %maximum_partition_count [lt(%descriptor_ordinal, %maximum_partition_count)] : index, index
    %lane_descriptor_i32 = scf.if %is_workitem_zero -> (i32) {
