  %q8_input = check.generate.fill value(1) : tensor<[%token_count]x2304xi8>
  %query_weight = check.generate.fill value(0) : tensor<4096x8x144xi8>
  %key_weight = check.generate.fill value(0) : tensor<512x8x144xi8>
  %value_weight = check.generate.fill value(0) : tensor<512x8x210xi8>
  %query_output = check.generate.fill value(1.0) : tensor<[%token_count]x4096xf32>
  %key_output = check.generate.fill value(1.0) : tensor<[%token_count]x512xf32>
  %value_output = check.generate.fill value(1.0) : tensor<[%token_count]x512xf32>
  %expected_query = check.generate.fill value(0.0) : tensor<[%token_count]x4096xf32>
  %expected_key = check.generate.fill value(0.0) : tensor<[%token_count]x512xf32>
  %expected_value = check.generate.fill value(0.0) : tensor<[%token_count]x512xf32>
