  check.expect.close actual(%actual) expected(%expected) atol(0.0) rtol(0.0) nan(same) : tensor<2x65xf32>
  check.return
}

// The production output geometry requires all 256 tiles to publish the
// accumulated hidden row before the final workgroup can normalize and pack it.
// Reuse each oversized attention-input Q8 allocation in place, invoke the fused
// kernel twice through one completion word, and compare every semantic output
// with the ordinary two-dispatch composition.
check.case public @qwen3_moe_dense_linear_q4k_q8_1_x4_next_q8_differential_case {
  %token_count = check.literal value(1) : index
  %input_size = check.literal value(4096) : index
