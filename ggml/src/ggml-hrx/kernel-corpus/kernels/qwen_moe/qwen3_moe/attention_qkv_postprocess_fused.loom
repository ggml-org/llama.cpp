// Uses the production head geometry, nonzero rotary position, and distinct K/V
// cache rows. Two fused calls reuse the same counters after comparison with
// the ordinary storage-selected composition. The value buffer has production
// Q6_K capacity and is intentionally oversized when the Q4_K config is tested.
check.case public @qwen3_moe_attention_qkv_postprocess_fused_differential_case {
  %token_count = check.literal value(1) : index
  %cache_row_count = check.literal value(4) : index
