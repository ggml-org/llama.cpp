#include "ggml-cuda/kv-stream-tile.cuh"
#include "ggml-cuda/fattn-tile.cuh"
#include "ggml-cuda/fattn-tile-resume.cuh"

template<ggml_type V>
static fattn_kernel_t tile_kernel(uint32_t ncols1, uint32_t ncols2) {
    using reader = ggml_cuda_fattn_tile_resume_kv<GGML_TYPE_@KV_STREAM_KEY@,V>;
#define TILE(C1, C2) if (ncols1 == C1 && ncols2 == C2) return flash_attn_tile<256,256,C1,C2,false,reader>;
    TILE(2,1) TILE(4,1) TILE(8,1)
    TILE(1,2) TILE(2,2) TILE(4,2) TILE(8,2)
    TILE(1,4) TILE(2,4) TILE(4,4) TILE(8,4)
    TILE(1,8) TILE(2,8) TILE(4,8)
#undef TILE
    return nullptr;
}

// Use the same compiled-pair flags as the upstream vector registry.
fattn_kernel_t ggml_cuda_kv_stream_tile_kernel_@KV_STREAM_KEY@(ggml_type value, uint32_t ncols1, uint32_t ncols2) {
    GGML_UNUSED_VARS(value,ncols1,ncols2);
#ifndef GGML_CUDA_NO_FA
    switch (value) {
#if GGML_CUDA_FA_@KV_STREAM_COMPILED_KEY@_F16
        case GGML_TYPE_F32: return tile_kernel<GGML_TYPE_F32>(ncols1,ncols2);
        case GGML_TYPE_F16: return tile_kernel<GGML_TYPE_F16>(ncols1,ncols2);
#endif
#if GGML_CUDA_FA_@KV_STREAM_COMPILED_KEY@_BF16
        case GGML_TYPE_BF16: return tile_kernel<GGML_TYPE_BF16>(ncols1,ncols2);
#endif
#if GGML_CUDA_FA_@KV_STREAM_COMPILED_KEY@_Q4_0
        case GGML_TYPE_Q4_0: return tile_kernel<GGML_TYPE_Q4_0>(ncols1,ncols2);
#endif
#if GGML_CUDA_FA_@KV_STREAM_COMPILED_KEY@_Q4_1
        case GGML_TYPE_Q4_1: return tile_kernel<GGML_TYPE_Q4_1>(ncols1,ncols2);
#endif
#if GGML_CUDA_FA_@KV_STREAM_COMPILED_KEY@_Q5_0
        case GGML_TYPE_Q5_0: return tile_kernel<GGML_TYPE_Q5_0>(ncols1,ncols2);
#endif
#if GGML_CUDA_FA_@KV_STREAM_COMPILED_KEY@_Q5_1
        case GGML_TYPE_Q5_1: return tile_kernel<GGML_TYPE_Q5_1>(ncols1,ncols2);
#endif
#if GGML_CUDA_FA_@KV_STREAM_COMPILED_KEY@_Q8_0
        case GGML_TYPE_Q8_0: return tile_kernel<GGML_TYPE_Q8_0>(ncols1,ncols2);
#endif
        default: break;
    }
#endif
    return nullptr;
}
