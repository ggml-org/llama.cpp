#version 450

#extension GL_EXT_control_flow_attributes : enable

layout (push_constant) uniform parameter
{
    uint KX;
    uint KY;
    uint ne00;
    uint ne01;
    uint ne02;
    uint ne12;
    uint ne13;
    uint nb11;
    uint nb12;
    uint nb13;
    float scale;
    float max_bias;
    float m0;
    float m1;
    uint n_head_log2;
    uint nrows_x;
    uint has_sinks;
    uint ne0_1mp, ne0_1L;
    uint ne0_12mp, ne0_12L;
} p;

#include "types.glsl"
#include "utils.glsl"

layout(constant_id = 0) const uint BLOCK_SIZE = 256;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer X {A_TYPE data_a[];};
layout (binding = 1) readonly buffer Y {B_TYPE data_b[];};
layout (binding = 2) readonly buffer Z {float data_c[];};
layout (binding = 3) buffer D {D_TYPE data_d[];};

const uint MAX_COLS = 8;

void main() {
    const uint rowx = gl_GlobalInvocationID.z * 262144 + gl_GlobalInvocationID.y * 512 + gl_GlobalInvocationID.x;

    if (rowx >= p.nrows_x) {
        return;
    }

    const uint i03 = fastdiv(rowx, p.ne0_12mp, p.ne0_12L);
    const uint i012 = rowx - i03 * p.ne01 * p.ne02;
    const uint i02 = fastdiv(i012, p.ne0_1mp, p.ne0_1L);
    const uint i01 = i012 - i02 * p.ne01;

    uint rowy_start = 0;
    if (p.KY > 0) {
        rowy_start = i01 * p.nb11 + fastmod(i02, p.ne12) * p.nb12 + fastmod(i03, p.ne13) * p.nb13;
    }

    float slope = 1.0f;

    if (p.max_bias > 0.0f) {
        const float base = i02 < p.n_head_log2 ? p.m0 : p.m1;
        const uint   exp = i02 < p.n_head_log2 ? i02 + 1 : 2*(i02 - p.n_head_log2) + 1;

        slope = pow(base, exp);
    }

    FLOAT_TYPE vals[MAX_COLS];
    FLOAT_TYPE max_val = p.has_sinks == 0 ? uintBitsToFloat(0xFF800000) : data_c[i02];

    [[unroll]] for (uint col = 0; col < MAX_COLS; ++col) {
        if (col < p.KX) {
            const FLOAT_TYPE b = p.KY > 0 ? FLOAT_TYPE(data_b[rowy_start + col]) : FLOAT_TYPE(0.0f);
            vals[col] = FLOAT_TYPE(data_a[rowx * p.KX + col]) * p.scale + slope * b;
            max_val = max(max_val, vals[col]);
        }
    }

    FLOAT_TYPE sum = p.has_sinks == 0 ? FLOAT_TYPE(0.0f) : FLOAT_TYPE(exp(FLOAT_TYPE(data_c[i02]) - max_val));

    [[unroll]] for (uint col = 0; col < MAX_COLS; ++col) {
        if (col < p.KX) {
            vals[col] = exp(vals[col] - max_val);
            sum += vals[col];
        }
    }

    const FLOAT_TYPE rcpdivisor = 1.0/sum;

    [[unroll]] for (uint col = 0; col < MAX_COLS; ++col) {
        if (col < p.KX) {
            data_d[rowx * p.KX + col] = D_TYPE(vals[col] * rcpdivisor);
        }
    }
}
