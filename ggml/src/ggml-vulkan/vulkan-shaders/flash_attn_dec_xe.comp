#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require
#extension GL_EXT_shader_explicit_arithmetic_types_int8 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_integer_dot_product : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_shuffle : require
#extension GL_KHR_shader_subgroup_vote : require


// Single-token flash attention for Intel Xe2/Xe3 iGPUs: Q8_0 K and V of head size 128, 16 query
// heads per KV head (Qwen3-235B-A22B and models of the same attention shape). Needs subgroups of 16.
//
// One workgroup takes CH consecutive KV positions of one KV head for all 16 of its query heads.
// The time of a workgroup is a chain of trips to memory and barriers, so the steps are laid out to
// keep that chain short and shared memory small (all workgroups of a 2K context resident at once):
//   1. scores: subgroup k takes positions k*PS .. k*PS+PS-1, lane h query head h. The subgroup's K
//      rows are read with consecutive lanes on consecutive 8-byte pieces, issued first thing; each lane
//      keeps its head's Q (8-bit, realigned to the dwords of a Q8_0 row) in registers and takes the K
//      dwords from the lane that holds them, so the dot products need no shared memory;
//   2. the max and the sum of each head: one exchange of the subgroups' values each, two barriers;
//   3. P x V: four streams each walk a quarter of the chunk, a thread owning 4 values of the head
//      dimension for all 16 heads; P comes from shared memory U positions at a time, one read per lane,
//      and is passed between lanes; the streams are added up through the same shared memory.
// The result is always the split-k partial (unnormalized O, row sum L, row max M) that
// fa_split_k_reduce combines, so sinks and the division by L happen there.
//
// A Q8_0 row of 128 values is 136 bytes: blocks (2-byte scale + 32 int8) at bytes 0, 34, 68, 102.
// K rows are read as 8-byte pieces and V as dwords (the host checks the alignment): each pair of
// blocks is 17 dwords, the even block's scale is the low half of dword 0 and its quants start
// mid-dword, the odd block's scale is the high half of dword 8 and its quants are dwords 9..16.
// The dot product of the even block runs over dwords 0..8 against Q shifted by two bytes, with zeros
// where the scales are.

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

layout (constant_id = 0) const uint WG = 128;      // threads; steps 1 and 3 need exactly 128
layout (constant_id = 1) const uint CH = 128;      // KV positions per workgroup: 32, 64 or 128
layout (constant_id = 2) const uint HAS_MASK = 1;

const uint D   = 128;            // head size of K and V
const uint G   = 16;             // query heads per KV head, = subgroup size
const uint NC  = G / 4;          // columns of 4 heads
const uint NSG = 8;              // subgroups
const uint PS  = CH / NSG;       // positions per subgroup in step 1
const uint KR  = (PS * 17 + 15) / 16;   // 8-byte pieces of K per lane
const uint U   = 8;              // positions per iteration of P x V (4, 8 or 16; divides CH / 4)
const uint CPL = U / 4;          // columns of P per lane per iteration

layout (push_constant) uniform parameter {
    uint32_t N;
    uint32_t KV;

    uint32_t ne1;
    uint32_t ne2;
    uint32_t ne3;

    uint32_t neq2;
    uint32_t neq3;
    uint32_t nek2;
    uint32_t nek3;
    uint32_t nev2;
    uint32_t nev3;
    uint32_t nem1;
    uint32_t nem2;
    uint32_t nem3;

    uint32_t nb01;
    uint32_t nb02;
    uint32_t nb03;
    uint32_t nb11;
    uint32_t nb12;
    uint32_t nb13;
    uint32_t nb21;
    uint32_t nb22;
    uint32_t nb23;

    float scale;
    float max_bias;
    float logit_softcap;

    uint32_t mask_n_head_log2;
    float m0;
    float m1;

    uint32_t gqa_ratio;
    uint32_t split_kv;
    uint32_t k_num;
} p;

layout (binding = 0) readonly buffer Q {vec4 data_qv4[];};
layout (binding = 1) readonly buffer K {uvec2 data_k2[];};
layout (binding = 2) readonly buffer V {uint data_v[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};
layout (binding = 5) writeonly buffer O {float data_o[];};
layout (binding = 5) writeonly buffer OV4 {vec4 data_ov4[];};

shared ivec4 qq[G * D / 16];     // Q as int8: head h, block b at [h * 8 + b * 2 + 0..1]
shared float qdsh[G * D / 32];   // Q scales: head h, block b at [h * 4 + b]
shared vec4  psh[CH * NC];       // exp(score - max): heads 4c..4c+3 of position j at [c * CH + j]; then the streams' O
shared float redm[NSG * G];      // per subgroup and head: max, then sum
shared float reds[NSG * G];

// dword d of the K row of position pp of this subgroup, from the lane that read it
#define KDW(pp, d) subgroupShuffle((((d) & 1) == 0) ? kr[((pp) * 17 + (d) / 2) / 16].x : kr[((pp) * 17 + (d) / 2) / 16].y, ((pp) * 17 + (d) / 2) % 16)

#define NEG_FLT_MAX_OVER_2 uintBitsToFloat(0xFEFFFFFF)
#define NEG_INF uintBitsToFloat(0xFF800000)

void main() {
    const uint tid   = gl_LocalInvocationID.x;
    const uint chunk = gl_WorkGroupID.x;
    const uint ik2   = gl_WorkGroupID.y;            // KV head
    const uint iq3   = gl_WorkGroupID.z;
    // its first query head; with the attention rebalance head map (q_off in mask_n_head_log2, 0 otherwise) the 16
    // heads can start before 0 or run past neq2: those load zero Q and store nothing
    const int  iq2   = int(ik2 * G) - int(p.mask_n_head_log2);
    const uint ik3   = iq3 / (p.neq3 / p.nek3);
    const uint iv3   = iq3 / (p.neq3 / p.nev3);

    const uint j0 = chunk * CH;
    const uint nj = min(CH, p.KV - j0);
    const uint sg = tid / 16;                       // subgroup
    const uint sl = tid % 16;                       // lane; in steps 1 and 2 the query head
    const uint pj = sg * PS;                        // the subgroup's first position in step 1
    const uint np = nj > pj ? min(PS, nj - pj) : 0;

    // the subgroup's K rows: piece e = r * 16 + lane is 8-byte piece e % 17 of row e / 17
    uvec2 kr[KR];
    {
        const uint kb = (ik2 * p.nb12 + ik3 * p.nb13 + (j0 + pj) * p.nb11 * 34) / 8;
        const uint ks = p.nb11 * 34 / 8;
        [[unroll]] for (uint r = 0; r < KR; ++r) {
            const uint e = r * 16 + sl;
            const uint row = e / 17;
            kr[r] = uvec2(0);
            if (row < np) {
                kr[r] = data_k2[kb + row * ks + (e - row * 17)];
            }
        }
    }
    float mk = 0.0;
    if (HAS_MASK != 0 && sl < np) {
        mk = float(data_m[j0 + pj + sl]);
    }

    // 0. Q times the softmax scale as int8, one 32-value block per thread
    if (tid < G * D / 32) {
        const uint h = tid / (D / 32);
        const uint b = tid % (D / 32);
        const int  hq = iq2 + int(h);
        const bool hv = hq >= 0 && hq < int(p.neq2);
        const uint qb = (uint(max(hq, 0)) * p.nb02 + iq3 * p.nb03) / 16 + b * 8;
        vec4 x[8];
        float amax = 0.0;
        [[unroll]] for (uint i = 0; i < 8; ++i) {
            x[i] = hv ? data_qv4[qb + i] * p.scale : vec4(0.0);
            const vec4 a = abs(x[i]);
            amax = max(amax, max(max(a.x, a.y), max(a.z, a.w)));
        }
        const float d = amax / 127.0;
        const float id = d != 0.0 ? 1.0 / d : 0.0;
        [[unroll]] for (uint i = 0; i < 2; ++i) {
            qq[h * 8 + b * 2 + i] = ivec4(pack32(i8vec4(round(x[i * 4 + 0] * id))),
                                          pack32(i8vec4(round(x[i * 4 + 1] * id))),
                                          pack32(i8vec4(round(x[i * 4 + 2] * id))),
                                          pack32(i8vec4(round(x[i * 4 + 3] * id))));
        }
        qdsh[h * 4 + b] = d;
    }
    barrier();

    // 1. scores of head sl for the subgroup's positions. Q of the head, per pair of blocks: the even
    // block shifted by two bytes over dwords 0..8 (zeros against the scales), the odd block as is.
    uint qe[2][9], qo[2][8];
    float qd[4];
    [[unroll]] for (uint pr = 0; pr < 2; ++pr) {
        const uvec4 a0 = uvec4(qq[sl * 8 + pr * 4 + 0]);
        const uvec4 a1 = uvec4(qq[sl * 8 + pr * 4 + 1]);
        const uvec4 b0 = uvec4(qq[sl * 8 + pr * 4 + 2]);
        const uvec4 b1 = uvec4(qq[sl * 8 + pr * 4 + 3]);
        const uint e[8] = { a0.x, a0.y, a0.z, a0.w, a1.x, a1.y, a1.z, a1.w };
        qe[pr][0] = e[0] << 16;
        [[unroll]] for (uint i = 1; i < 8; ++i) {
            qe[pr][i] = (e[i - 1] >> 16) | (e[i] << 16);
        }
        qe[pr][8] = e[7] >> 16;
        qo[pr][0] = b0.x; qo[pr][1] = b0.y; qo[pr][2] = b0.z; qo[pr][3] = b0.w;
        qo[pr][4] = b1.x; qo[pr][5] = b1.y; qo[pr][6] = b1.z; qo[pr][7] = b1.w;
    }
    [[unroll]] for (uint b = 0; b < 4; ++b) {
        qd[b] = qdsh[sl * 4 + b];
    }

    float s[PS];
    [[unroll]] for (uint pp = 0; pp < PS; ++pp) {
        float acc = 0.0;
        [[unroll]] for (uint pr = 0; pr < 2; ++pr) {
            int ae = 0;
            [[unroll]] for (uint i = 0; i < 9; ++i) {
                ae += dotPacked4x8EXT(int(qe[pr][i]), int(KDW(pp, pr * 17 + i)));
            }
            int ao = 0;
            [[unroll]] for (uint i = 0; i < 8; ++i) {
                ao += dotPacked4x8EXT(int(qo[pr][i]), int(KDW(pp, pr * 17 + 9 + i)));
            }
            const float de = unpackHalf2x16(KDW(pp, pr * 17)).x;
            const float dd = unpackHalf2x16(KDW(pp, pr * 17 + 8)).y;
            acc += float(ae) * (qd[2 * pr] * de) + float(ao) * (qd[2 * pr + 1] * dd);
        }
        s[pp] = pp < np ? acc + subgroupShuffle(mk, pp) : NEG_INF;
    }

    // 2. max and sum of each head over the chunk: each subgroup's, then across the subgroups
    {
        float m = s[0];
        [[unroll]] for (uint pp = 1; pp < PS; ++pp) {
            m = max(m, s[pp]);
        }
        redm[sg * G + sl] = m;
    }
    barrier();
    float mx = NEG_INF;
    [[unroll]] for (uint k = 0; k < NSG; ++k) {
        mx = max(mx, redm[k * G + sl]);
    }
    // the floor keeps exp() finite in a fully masked chunk
    const bool any_live = subgroupAny(mx > NEG_FLT_MAX_OVER_2);
    mx = max(mx, NEG_FLT_MAX_OVER_2);
    {
        float ls = 0.0;
        [[unroll]] for (uint pp = 0; pp < PS; ++pp) {
            const float e = exp(s[pp] - mx);
            ls += e;
            psh[(sl / 4) * CH + pj + pp][sl % 4] = e;
        }
        reds[sg * G + sl] = ls;
    }
    barrier();

    // 3. O = P x V. Four streams of 32 threads each take a quarter of the chunk; in a stream, lane l
    // owns values 4g..4g+3 of all 16 heads. Within 16 lanes all blocks have the same parity: lanes
    // 0-7 block 0, 8-15 block 2, 16-23 block 1, 24-31 block 3. P of positions j..j+U-1: lane sl reads
    // position j + sl % U, columns (sl / U) * CPL .. + CPL - 1.
    const uint l   = tid % 32;
    const uint sid = tid / 32;
    const uint blk = ((l >> 3) & 1) * 2 + (l >> 4);
    const uint qi  = l & 7;
    const uint g   = blk * 8 + qi;
    const bool odd = (blk & 1) != 0;
    const uint pw  = (blk >> 1) * 17;
    const uint wq0 = pw + (odd ? 9 + qi : qi);
    const uint wq1 = odd ? wq0 : wq0 + 1;
    const uint wd  = pw + (odd ? 8 : 0);

    vec4 o[G];
    [[unroll]] for (uint h = 0; h < G; ++h) {
        o[h] = vec4(0.0);
    }
    const uint jn = any_live ? nj : 0;
    const uint ja = sid * (CH / 4);
    const uint jb = min(ja + CH / 4, jn);
    const uint vstride = p.nb21 * 34 / 4;
    uint vw = (ik2 * p.nb22 + iv3 * p.nb23 + (j0 + ja) * p.nb21 * 34) / 4;
    for (uint j = ja; j < jb; j += U, vw += U * vstride) {
        vec4 pv[CPL];
        [[unroll]] for (uint t = 0; t < CPL; ++t) {
            pv[t] = psh[((sl / U) * CPL + t) * CH + j + sl % U];
        }
        uint w0[U], w1[U], wdv[U];
        [[unroll]] for (uint u = 0; u < U; ++u) {
            if (j + u < jb) {
                w0[u]  = data_v[vw + u * vstride + wq0];
                w1[u]  = data_v[vw + u * vstride + wq1];
                wdv[u] = data_v[vw + u * vstride + wd];
            }
        }
        [[unroll]] for (uint u = 0; u < U; ++u) {
            if (j + u < jb) {
                const vec2 dv = unpackHalf2x16(wdv[u]);
                const uint qv = odd ? w0[u] : ((w0[u] >> 16) | (w1[u] << 16));
                const vec4 vf = vec4(unpack8(int32_t(qv)));
                const float d = odd ? dv.y : dv.x;
                [[unroll]] for (uint c = 0; c < NC; ++c) {
                    const uint src = (c / CPL) * U + u;
                    const vec4 pc = vec4(subgroupShuffle(pv[c % CPL].x, src), subgroupShuffle(pv[c % CPL].y, src),
                                         subgroupShuffle(pv[c % CPL].z, src), subgroupShuffle(pv[c % CPL].w, src)) * d;
                    o[c * 4 + 0] += pc.x * vf;
                    o[c * 4 + 1] += pc.y * vf;
                    o[c * 4 + 2] += pc.z * vf;
                    o[c * 4 + 3] += pc.w * vf;
                }
            }
        }
    }

    // add up the four streams through psh, free once every stream is done with P: HP heads per pass,
    // 3 and 2 into 1 and 0, then 1 into 0
    const uint HP = CH * NC / 64;
    barrier();
    [[unroll]] for (uint hb = 0; hb < G; hb += HP) {
        if (sid >= 2) {
            [[unroll]] for (uint h = 0; h < HP; ++h) {
                psh[((sid - 2) * HP + h) * 32 + l] = o[hb + h];
            }
        }
        barrier();
        if (sid < 2) {
            [[unroll]] for (uint h = 0; h < HP; ++h) {
                o[hb + h] += psh[(sid * HP + h) * 32 + l];
            }
        }
        barrier();
        if (sid == 1) {
            [[unroll]] for (uint h = 0; h < HP; ++h) {
                psh[h * 32 + l] = o[hb + h];
            }
        }
        barrier();
        if (sid == 0) {
            [[unroll]] for (uint h = 0; h < HP; ++h) {
                o[hb + h] += psh[h * 32 + l];
            }
        }
        barrier();
    }
    if (sid == 0) {
        // split-k partials, laid out as fa_split_k_reduce reads them
        const uint ob = (D * p.ne1 * (chunk + p.k_num * p.ne2 * iq3)) / 4;
        [[unroll]] for (uint h = 0; h < G; ++h) {
            const int hq = iq2 + int(h);
            if (hq >= 0 && hq < int(p.neq2)) {
                data_ov4[ob + uint(hq) * (D / 4) + g] = o[h];
            }
        }
        if (l < G) {
            // lanes 0..15 of subgroup 0 hold head l's max; the sums are in reds
            float ls = 0.0;
            [[unroll]] for (uint k = 0; k < NSG; ++k) {
                ls += reds[k * G + l];
            }
            const uint lm = D * p.ne1 * p.ne2 * p.ne3 * p.k_num + p.ne1 * 2 * (chunk + p.k_num * p.ne2 * iq3);
            const int hq = iq2 + int(l);
            if (hq >= 0 && hq < int(p.neq2)) {
                data_o[lm + uint(hq)] = ls;
                data_o[lm + p.ne1 + uint(hq)] = mx;
            }
        }
    }
}
