#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require
#extension GL_EXT_bfloat16 : require
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_cooperative_matrix : enable
#ifdef COOPMAT2
#extension GL_NV_cooperative_matrix2 : enable
#else
#extension GL_EXT_cooperative_matrix_maintenance1 : enable
#endif

// Chunked gated-delta-net prefill (non-KDA, S_v == D == 128, K == 1).
// Faithful port of the CUDA MMA kernel (PR 29353): one workgroup owns one
// value block [v0, v0+V) of one (seq, head); its subgroups split the D x V
// state into round-robin [TM x TN] register tiles, mirror them (shared, or gmem
// scratch when GMEM_MIRROR) each chunk, and read the full state back for the
// projections. bf16 hi/lo 3x product for ~fp32 accuracy.
//
// One source, two coopmat backends selected by preproc:
//   COOPMAT2  -> GL_NV_cooperative_matrix2 (flexible dims, coopMatPerElementNV)
//   else      -> GL_KHR_cooperative_matrix + GL_EXT_cooperative_matrix_maintenance1
//                (m16n16k16 only, coopMatPerElementEXT). BF16ACC keeps the bf16
//                hi/lo split as accumulators; without it they are A-matrices via
//                the maintenance1 accumulator<->A/B relaxed conversion.
#define OPD bfloat16_t

#define C  16          // chunk size (tokens per step)
#define D  128         // head dim / value dim
#define TM 16          // tile rows
#define TN 16          // tile cols (bf16 cm has only m16n16k16; n8 would pad)
#ifndef V
#define V  64          // value columns per workgroup block (V=128 = whole head)
#endif
#define NSUB 16        // subgroups per workgroup
#ifndef SUBGROUP_SIZE
#define SUBGROUP_SIZE 32   // lanes per subgroup (32 = NVIDIA/wave32; 64 = RDNA wave64)
#endif
#define WGS (NSUB * SUBGROUP_SIZE)
#ifdef COOPMAT2
#define KT 32          // K-tile width for deep (K=D) matmuls (flexible dims)
#else
#define KT 16          // coopmat1: m16n16k16 only
#endif
#define PAD 8          // shared padding to break COL-load bank conflicts (keep LDP*2 a multiple of 16B)
#define LDP (D + PAD)  // padded leading dim for q/k [CxD] and state mirror [DxV]

// GMEM_MIRROR (set by the shader generator for the whole-head V=128 variant) mirrors
// the [D x V] state to a global scratch buffer instead of shared, so V can exceed the
// LDS budget. The default (V=64) keeps the mirror in shared.
// MERGE_QSKS runs qs=Q@S and ks=K@S on one subgroup (halves state reads) - a win on
// the memory/issue-bound coopmat1 (RDNA) path. The coopmat2 (NVIDIA) path is mma-
// product-bound, so it splits them across subgroups to keep the mma chain short.
#if !defined(COOPMAT2)
#define MERGE_QSKS
#endif

#define STATE_TILES ((D / TM) * (V / TN))
#define PER_WARP    (STATE_TILES / NSUB)
#define VT          (V / TN)   // value tiles (projection tiles)
#define CT          (C / TN)   // C-column tiles (gram/pmat halves)

// SEQ_HALF: whole-head (V=128) but the [D x V] state is too big for shared. Process the
// head in NH passes of VH value columns, keeping only a [D x VH] mirror in shared (same
// LDS footprint as V=64) while the full state stays in registers. gram/pmat/inversion are
// computed once per chunk and shared across the passes (unlike V=64's 2 blocks/head).
#ifdef SEQ_HALF
#ifndef VH
#define VH 64
#endif
#else
#define VH V
#endif
#define NH  (V / VH)   // value passes per chunk (2 for SEQ_HALF, else 1)
#define VTH (VH / TN)  // projection value tiles per pass

#define TILE_R(ti) (((ti) / VT) * TM)
#define TILE_C(ti) (((ti) % VT) * TN)

layout(local_size_x = WGS, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform Parameters {
    uint H;
    uint n_tokens;
    uint n_seqs;
    uint s_off;
    uint sq1, sq2, sq3;
    uint sv1, sv2, sv3;
    uint sb1, sb2, sb3;
    uint neq1, rq3;
    float scale;
    uint K;
} p;

layout(binding = 0) readonly  buffer QBuf     { float data_q[];     };
layout(binding = 1) readonly  buffer KBuf     { float data_k[];     };
layout(binding = 2) readonly  buffer VBuf     { float data_v[];     };
layout(binding = 3) readonly  buffer GBuf     { float data_g[];     };
layout(binding = 4) readonly  buffer BetaBuf  { float data_beta[];  };
layout(binding = 5) readonly  buffer StateBuf { float data_state[]; };
layout(binding = 6)           buffer DstBuf   { float data_dst[];   };
#ifdef GMEM_MIRROR
layout(binding = 7) coherent  buffer MirrorBuf { OPD data_mirror[]; };
#endif

shared OPD sh_qh[C * LDP], sh_ql[C * LDP];   // q*scale hi/lo (D padded)
shared OPD sh_kh[C * LDP], sh_kl[C * LDP];   // k hi/lo (D padded)
#ifndef GMEM_MIRROR
shared OPD sh_sh[LDP * VH], sh_sl[LDP * VH];   // state mirror [D x VH] column-major (D padded)
#endif
shared OPD sh_dh[C * VH], sh_dl[C * VH];   // delta (pre-inv) / delta2 [C x VH] row-major
shared OPD sh_soh[C * VH], sh_sol[C * VH]; // solved [C x VH] row-major
shared OPD sh_ph[C * C], sh_pl[C * C];   // decayed P
shared OPD sh_ih[C * C], sh_il[C * C];   // (I + L)^-1
shared float sh_lower[C * C];            // strictly-lower decayed L

shared float sh_prefix[C], sh_beta[C], sh_ep[C], sh_carry[C];

#define SG   gl_ScopeSubgroup
#define MUA  gl_MatrixUseA
#define MUB  gl_MatrixUseB
#define MACC gl_MatrixUseAccumulator
#define ROW  gl_CooperativeMatrixLayoutRowMajor
#define COL  gl_CooperativeMatrixLayoutColumnMajor

#ifdef COOPMAT2
#define coopMatPerElement coopMatPerElementNV
#else
#define coopMatPerElement coopMatPerElementEXT
#endif

// Use for the bf16 hi/lo split: accumulator when a bf16 accumulator type is
// available, otherwise an A-matrix reached through the maintenance1 relaxed
// accumulator<->A/B conversion (stored to shared, reloaded as A/B).
#if defined(COOPMAT2) || defined(BF16ACC)
#define ACCB MACC
#else
#define ACCB MUA
#endif

// 3x bf16 product accumulated into acc (hi/lo split for ~fp32 accuracy).
#define PRODUCT(acc, ah, al, bh, bl) \
    acc = coopMatMulAdd(al, bh, acc); \
    acc = coopMatMulAdd(ah, bl, acc); \
    acc = coopMatMulAdd(ah, bh, acc);

#define LOADQK(TT, VV) \
    [[unroll]] for (uint j = 0; j < C * D / WGS; j++) { \
        const uint i = tid + j * WGS; \
        const uint t = i / D, dk = i % D; \
        qreg[j] = 0.0; kreg[j] = 0.0; \
        if (t < (VV)) { \
            const uint off = iq3 * p.sq3 + ((TT) + t) * p.sq2 + iq1 * p.sq1 + dk; \
            qreg[j] = data_q[off] * p.scale; \
            kreg[j] = data_k[off]; \
        } \
    }

float StoreOut(const in uint32_t r, const in uint32_t c, const in float elem,
               const in uint32_t out_base, const in uint32_t valid) {
    if (r < valid) {
        data_dst[out_base + r * (D * p.H) + c] = elem;
    }
    return elem;
}

float StoreState(const in uint32_t r, const in uint32_t c, const in float elem,
                 const in uint32_t base) {
    data_dst[base + c * D + r] = elem;
    return elem;
}

float ComputeDelta(const in uint32_t r, const in uint32_t c, const in float ks,
                   const in uint32_t v_base, const in uint32_t sv2, const in uint32_t valid) {
    if (r >= valid) {
        return 0.0;
    }
    const float vv = data_v[v_base + r * sv2 + c];
    return sh_beta[r] * (vv - sh_ep[r] * ks);
}

float ApplyExpPrefix(const in uint32_t r, const in uint32_t c, const in float qs) {
    return sh_ep[r] * qs;
}

float StoreLower(const in uint32_t r, const in uint32_t c, const in float elem,
                 const in uint32_t c_o) {
    const uint cc = c_o + c;
    if (cc < r) {
        sh_lower[r * C + cc] = elem * exp(sh_prefix[r] - sh_prefix[cc]) * sh_beta[r];
    }
    return elem;
}

float StorePmat(const in uint32_t r, const in uint32_t c, const in float elem,
                const in uint32_t c_o) {
    const uint cc = c_o + c;
    float v = 0.0;
    if (cc <= r) {
        v = elem * exp(sh_prefix[r] - sh_prefix[cc]);
    }
    const OPD h = OPD(v);
    sh_ph[r * C + cc] = h;
    sh_pl[r * C + cc] = OPD(v - float(h));
    return elem;
}

void main() {
    const uint head_id = gl_WorkGroupID.z;
    const uint seq_id  = gl_WorkGroupID.y;
    const uint sg      = gl_SubgroupID;
    const uint tid     = gl_LocalInvocationID.x;
    const uint v0      = gl_WorkGroupID.x * V;

    const uint iq1 = head_id % p.neq1;
    const uint iq3 = seq_id / p.rq3;

    const uint state_base = (seq_id * p.H + head_id) * (D * D);

#ifdef GMEM_MIRROR
    const uint mir_stride = uint(LDP) * V;
    const uint mir_block  = (head_id * p.n_seqs + seq_id) * gl_NumWorkGroups.x + gl_WorkGroupID.x;
    const uint mir_h      = mir_block * mir_stride * 2u;
    const uint mir_l      = mir_h + mir_stride;
#endif

    coopmat<float, SG, TM, TN, MACC> state[PER_WARP];
    [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
        const uint ti = sg + j * NSUB;
        coopMatLoad(state[j], data_state, state_base + (v0 + TILE_C(ti)) * D + TILE_R(ti), D, COL);
    }

    float qreg[C * D / WGS], kreg[C * D / WGS];
    LOADQK(0u, min(C, p.n_tokens));

#ifdef SEQ_HALF
    // whole-head via NH sequential value passes: gram/pmat/inversion once, then per pass
    // mirror [D x VH] state to shared, project, solve, out, update the pass's register tiles.
    const uint sg_pass = (sg % VT) / VTH;  // which value pass (0..NH-1) owns this sg's state tiles
    for (uint t0 = 0; t0 < p.n_tokens; t0 += C) {
        const uint valid = min(C, p.n_tokens - t0);

        // ensure the previous chunk's last-pass reads of q/k (state update) and of
        // carry/ep/prefix are done before this chunk overwrites them (the per-pass loop
        // drops its end-of-pass barrier and relies on the next pass's post-mirror barrier).
        barrier();
        if (sg == 0) {
            const uint t = gl_SubgroupInvocationID;
            const uint gb = seq_id * p.sb3 + (t0 + t) * p.sb2 + head_id * p.sb1;
            const float g = t < valid ? data_g[gb] : 0.0;
            const float acc = subgroupInclusiveAdd(g);
            if (t < C) {
                sh_prefix[t] = acc;
                sh_ep[t] = exp(acc);
                sh_beta[t] = t < valid ? data_beta[gb] : 0.0;
            }
        }
        [[unroll]] for (uint j = 0; j < C * D / WGS; j++) {
            const uint i = tid + j * WGS;
            const uint pi = (i / D) * LDP + (i % D);
            const OPD qh = OPD(qreg[j]); sh_qh[pi] = qh; sh_ql[pi] = OPD(qreg[j] - float(qh));
            const OPD kh = OPD(kreg[j]); sh_kh[pi] = kh; sh_kl[pi] = OPD(kreg[j] - float(kh));
        }
        barrier();

        const uint nvalid = t0 + C < p.n_tokens ? min(C, p.n_tokens - (t0 + C)) : 0u;
        LOADQK(t0 + C, nvalid);

        const float plast  = sh_prefix[valid - 1];
        const float cdecay = exp(plast);
        if (tid < C) {
            sh_carry[tid] = exp(plast - sh_prefix[tid]);
        }

        // gram (sg0) -> L, pmat (sg1) -> P: value-independent, computed once per chunk.
        if (sg < 2 * CT) {
            const bool gram = sg < CT;
            const uint c_o  = (sg % CT) * TN;
            coopmat<float, SG, C, TN, MACC> x = coopmat<float, SG, C, TN, MACC>(0);
            [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
                coopmat<OPD, SG, C, KT, MUA> ah, al;
                if (gram) {
                    coopMatLoad(ah, sh_kh, kk, LDP, ROW);
                    coopMatLoad(al, sh_kl, kk, LDP, ROW);
                } else {
                    coopMatLoad(ah, sh_qh, kk, LDP, ROW);
                    coopMatLoad(al, sh_ql, kk, LDP, ROW);
                }
                coopmat<OPD, SG, KT, TN, MUB> bh, bl;
                coopMatLoad(bh, sh_kh, c_o * LDP + kk, LDP, COL);
                coopMatLoad(bl, sh_kl, c_o * LDP + kk, LDP, COL);
                PRODUCT(x, ah, al, bh, bl);
            }
            if (gram) {
                coopMatPerElement(x, x, StoreLower, c_o);
            } else {
                coopMatPerElement(x, x, StorePmat, c_o);
            }
        }
        barrier();

        // invert (I + L) by forward substitution: one subgroup per row, lane = column.
        {
            const uint col = gl_SubgroupInvocationID;
            [[unroll]] for (uint row = sg; row < C; row += NSUB) {
                float x = col < C ? (col == row ? 1.0 : (col < row ? -sh_lower[row * C + col] : 0.0)) : 0.0;
                for (int pivot = int(row) - 1; pivot > 0; pivot--) {
                    const float xp = subgroupShuffle(x, uint(pivot));
                    if (col < uint(pivot)) {
                        x -= xp * sh_lower[uint(pivot) * C + col];
                    }
                }
                if (col < C) {
                    const OPD h = OPD(x);
                    sh_ih[row * C + col] = h;
                    sh_il[row * C + col] = OPD(x - float(h));
                }
            }
        }
        barrier();

        [[unroll]] for (uint hv = 0; hv < NH; hv++) {
            const uint voff = hv * VH;   // value-column offset of this pass within the head

            // mirror this pass's register state tiles to shared [D x VH]
            if (sg_pass == hv) {
                [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
                    const uint ti = sg + j * NSUB;
                    const uint off = (TILE_C(ti) - voff) * LDP + TILE_R(ti);
                    const coopmat<OPD, SG, TM, TN, ACCB> hi = coopmat<OPD, SG, TM, TN, ACCB>(state[j]);
                    const coopmat<float, SG, TM, TN, MACC> hf = coopmat<float, SG, TM, TN, MACC>(hi);
                    const coopmat<OPD, SG, TM, TN, ACCB> lo = coopmat<OPD, SG, TM, TN, ACCB>(state[j] - hf);
                    coopMatStore(hi, sh_sh, off, LDP, COL);
                    coopMatStore(lo, sh_sl, off, LDP, COL);
                }
            }
            barrier();

            // qs=Q@S -> base_r (sg2..2+VTH-1); ks=K@S -> delta (remaining subgroups).
            coopmat<float, SG, C, TN, MACC> base_r = coopmat<float, SG, C, TN, MACC>(0);
            if (sg >= 2 * CT && sg - 2 * CT < VTH) {
                const uint c_o = (sg - 2 * CT) * TN;
                coopmat<float, SG, C, TN, MACC> qs = coopmat<float, SG, C, TN, MACC>(0);
                [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
                    coopmat<OPD, SG, C, KT, MUA> qh, ql;
                    coopMatLoad(qh, sh_qh, kk, LDP, ROW);
                    coopMatLoad(ql, sh_ql, kk, LDP, ROW);
                    coopmat<OPD, SG, KT, TN, MUB> sbh, sbl;
                    coopMatLoad(sbh, sh_sh, c_o * LDP + kk, LDP, COL);
                    coopMatLoad(sbl, sh_sl, c_o * LDP + kk, LDP, COL);
                    PRODUCT(qs, qh, ql, sbh, sbl);
                }
                coopMatPerElement(base_r, qs, ApplyExpPrefix);
            } else if (sg >= 2 * CT + VTH) {
                const uint ks_nsg = NSUB - (2 * CT + VTH);
                for (uint ti = sg - (2 * CT + VTH); ti < VTH; ti += ks_nsg) {
                    const uint c_o = ti * TN;
                    coopmat<float, SG, C, TN, MACC> ks = coopmat<float, SG, C, TN, MACC>(0);
                    [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
                        coopmat<OPD, SG, C, KT, MUA> kh, kl;
                        coopMatLoad(kh, sh_kh, kk, LDP, ROW);
                        coopMatLoad(kl, sh_kl, kk, LDP, ROW);
                        coopmat<OPD, SG, KT, TN, MUB> sbh, sbl;
                        coopMatLoad(sbh, sh_sh, c_o * LDP + kk, LDP, COL);
                        coopMatLoad(sbl, sh_sl, c_o * LDP + kk, LDP, COL);
                        PRODUCT(ks, kh, kl, sbh, sbl);
                    }
                    const uint v_base = seq_id * p.sv3 + head_id * p.sv1 + v0 + voff + c_o + t0 * p.sv2;
                    coopmat<float, SG, C, TN, MACC> delta;
                    coopMatPerElement(delta, ks, ComputeDelta, v_base, p.sv2, valid);
                    const coopmat<OPD, SG, C, TN, ACCB> dh = coopmat<OPD, SG, C, TN, ACCB>(delta);
                    const coopmat<float, SG, C, TN, MACC> df = coopmat<float, SG, C, TN, MACC>(dh);
                    const coopmat<OPD, SG, C, TN, ACCB> dl = coopmat<OPD, SG, C, TN, ACCB>(delta - df);
                    coopMatStore(dh, sh_dh, c_o, VH, ROW);
                    coopMatStore(dl, sh_dl, c_o, VH, ROW);
                }
            }
            barrier();

            // solved = (I+L)^-1 @ delta  (sg0..VTH-1)
            if (sg < VTH) {
                const uint c_o = sg * TN;
                coopmat<float, SG, C, TN, MACC> solved = coopmat<float, SG, C, TN, MACC>(0);
                coopmat<OPD, SG, C, C, MUA> ih, il;
                coopMatLoad(ih, sh_ih, 0, C, ROW);
                coopMatLoad(il, sh_il, 0, C, ROW);
                coopmat<OPD, SG, C, TN, MUB> dh, dl;
                coopMatLoad(dh, sh_dh, c_o, VH, ROW);
                coopMatLoad(dl, sh_dl, c_o, VH, ROW);
                PRODUCT(solved, ih, il, dh, dl);
                const coopmat<OPD, SG, C, TN, ACCB> sh = coopmat<OPD, SG, C, TN, ACCB>(solved);
                const coopmat<float, SG, C, TN, MACC> sf = coopmat<float, SG, C, TN, MACC>(sh);
                const coopmat<OPD, SG, C, TN, ACCB> sl = coopmat<OPD, SG, C, TN, ACCB>(solved - sf);
                coopMatStore(sh, sh_soh, c_o, VH, ROW);
                coopMatStore(sl, sh_sol, c_o, VH, ROW);
            }
            barrier();

            // out = base + P@solved  (sg2..2+VTH-1)
            if (sg >= 2 * CT && sg - 2 * CT < VTH) {
                const uint c_o = (sg - 2 * CT) * TN;
                coopmat<float, SG, C, TN, MACC> O = base_r;
                coopmat<OPD, SG, C, C, MUA> ph, pl;
                coopMatLoad(ph, sh_ph, 0, C, ROW);
                coopMatLoad(pl, sh_pl, 0, C, ROW);
                coopmat<OPD, SG, C, TN, MUB> svh, svl;
                coopMatLoad(svh, sh_soh, c_o, VH, ROW);
                coopMatLoad(svl, sh_sol, c_o, VH, ROW);
                PRODUCT(O, ph, pl, svh, svl);
                const uint out_base = (seq_id * p.n_tokens * p.H + head_id) * D + v0 + voff + c_o + t0 * (D * p.H);
                coopMatPerElement(O, O, StoreOut, out_base, valid);
            }
            // delta2 = solved * carry -> sh_dh/dl (all threads)
            for (uint i = tid; i < C * VH; i += WGS) {
                const uint t = i / VH;
                const float sv = float(sh_soh[i]) + float(sh_sol[i]);
                const float d2 = sv * sh_carry[t];
                const OPD h = OPD(d2);
                sh_dh[i] = h;
                sh_dl[i] = OPD(d2 - float(h));
            }
            barrier();

            // state = cdecay*state + K^T @ delta2 for this pass's register tiles
            if (sg_pass == hv) {
                [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
                    const uint ti = sg + j * NSUB;
                    coopmat<OPD, SG, TM, C, MUA> kth, ktl;
                    coopMatLoad(kth, sh_kh, TILE_R(ti), LDP, COL);
                    coopMatLoad(ktl, sh_kl, TILE_R(ti), LDP, COL);
                    coopmat<OPD, SG, C, TN, MUB> dh, dl;
                    coopMatLoad(dh, sh_dh, TILE_C(ti) - voff, VH, ROW);
                    coopMatLoad(dl, sh_dl, TILE_C(ti) - voff, VH, ROW);
                    state[j] = state[j] * cdecay;
                    PRODUCT(state[j], kth, ktl, dh, dl);
                }
            }
            // no end-of-pass barrier: the next pass's post-mirror barrier separates this
            // pass's state-update reads from the next pass's delta writes; the chunk boundary
            // is covered by the barrier at the top of the t0 loop.
        }
    }
#else
    for (uint t0 = 0; t0 < p.n_tokens; t0 += C) {
        const uint valid = min(C, p.n_tokens - t0);

        if (sg == 0) {
            const uint t = gl_SubgroupInvocationID;
            const uint gb = seq_id * p.sb3 + (t0 + t) * p.sb2 + head_id * p.sb1;
            const float g = t < valid ? data_g[gb] : 0.0;
            const float acc = subgroupInclusiveAdd(g);
            if (t < C) {
                sh_prefix[t] = acc;
                sh_ep[t] = exp(acc);
                sh_beta[t] = t < valid ? data_beta[gb] : 0.0;
            }
        }
        [[unroll]] for (uint j = 0; j < C * D / WGS; j++) {
            const uint i = tid + j * WGS;
            const uint pi = (i / D) * LDP + (i % D);
            const OPD qh = OPD(qreg[j]); sh_qh[pi] = qh; sh_ql[pi] = OPD(qreg[j] - float(qh));
            const OPD kh = OPD(kreg[j]); sh_kh[pi] = kh; sh_kl[pi] = OPD(kreg[j] - float(kh));
        }
        // mirror register state to shared as bf16 hi/lo
        [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
            const uint ti = sg + j * NSUB;
            const uint off = TILE_C(ti) * LDP + TILE_R(ti);
            const coopmat<OPD, SG, TM, TN, ACCB> hi = coopmat<OPD, SG, TM, TN, ACCB>(state[j]);
            const coopmat<float, SG, TM, TN, MACC> hf = coopmat<float, SG, TM, TN, MACC>(hi);
            const coopmat<OPD, SG, TM, TN, ACCB> lo = coopmat<OPD, SG, TM, TN, ACCB>(state[j] - hf);
#ifdef GMEM_MIRROR
            coopMatStore(hi, data_mirror, mir_h + off, LDP, COL);
            coopMatStore(lo, data_mirror, mir_l + off, LDP, COL);
#else
            coopMatStore(hi, sh_sh, off, LDP, COL);
            coopMatStore(lo, sh_sl, off, LDP, COL);
#endif
        }
#ifdef GMEM_MIRROR
        // mirror lives in gmem but is produced+consumed within this workgroup, so a
        // workgroup-scope buffer barrier is sufficient (avoids a device-scope L2 flush).
        controlBarrier(gl_ScopeWorkgroup, gl_ScopeWorkgroup,
                       gl_StorageSemanticsBuffer | gl_StorageSemanticsShared,
                       gl_SemanticsAcquireRelease);
#else
        barrier();
#endif

        // prefetch next chunk's q/k into registers, overlapping the deep phase
        const uint nvalid = t0 + C < p.n_tokens ? min(C, p.n_tokens - (t0 + C)) : 0u;
        LOADQK(t0 + C, nvalid);

        const float plast  = sh_prefix[valid - 1];
        const float cdecay = exp(plast);
        if (tid < C) {
            sh_carry[tid] = exp(plast - sh_prefix[tid]);
        }

        // Deep (K=D) phase: sg0 gram (K@K^T)->L, sg1 pmat (Q@K^T)->P, then one value
        // tile per subgroup (sg2..2+VT-1) computes qs=Q@S (->base) and ks=K@S (->delta)
        // together, sharing the state B-tiles.
        coopmat<float, SG, C, TN, MACC> base_r = coopmat<float, SG, C, TN, MACC>(0);
        if (sg < 2 * CT) {
            const bool gram = sg < CT;
            const uint c_o  = (sg % CT) * TN;
            coopmat<float, SG, C, TN, MACC> x = coopmat<float, SG, C, TN, MACC>(0);
            [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
                coopmat<OPD, SG, C, KT, MUA> ah, al;
                if (gram) {
                    coopMatLoad(ah, sh_kh, kk, LDP, ROW);
                    coopMatLoad(al, sh_kl, kk, LDP, ROW);
                } else {
                    coopMatLoad(ah, sh_qh, kk, LDP, ROW);
                    coopMatLoad(al, sh_ql, kk, LDP, ROW);
                }
                coopmat<OPD, SG, KT, TN, MUB> bh, bl;
                coopMatLoad(bh, sh_kh, c_o * LDP + kk, LDP, COL);
                coopMatLoad(bl, sh_kl, c_o * LDP + kk, LDP, COL);
                PRODUCT(x, ah, al, bh, bl);
            }
            if (gram) {
                coopMatPerElement(x, x, StoreLower, c_o);
            } else {
                coopMatPerElement(x, x, StorePmat, c_o);
            }
#ifdef MERGE_QSKS
        } else if (sg - 2 * CT < VT) {
            // qs=Q@S (->base) and ks=K@S (->delta) share the state B-tiles: load S once
            // per k-step and feed both matmuls, halving state-mirror reads. One value
            // tile per subgroup. Best when memory/issue-bound (RDNA); doubles the deep
            // mma critical path so the split below is used when mma-product-bound (NV).
            const uint ti  = sg - 2 * CT;
            const uint c_o = ti * TN;
            coopmat<float, SG, C, TN, MACC> qs = coopmat<float, SG, C, TN, MACC>(0);
            coopmat<float, SG, C, TN, MACC> ks = coopmat<float, SG, C, TN, MACC>(0);
            [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
                coopmat<OPD, SG, C, KT, MUA> qh, ql, kh, kl;
                coopMatLoad(qh, sh_qh, kk, LDP, ROW);
                coopMatLoad(ql, sh_ql, kk, LDP, ROW);
                coopMatLoad(kh, sh_kh, kk, LDP, ROW);
                coopMatLoad(kl, sh_kl, kk, LDP, ROW);
                coopmat<OPD, SG, KT, TN, MUB> sbh, sbl;
#ifdef GMEM_MIRROR
                coopMatLoad(sbh, data_mirror, mir_h + c_o * LDP + kk, LDP, COL);
                coopMatLoad(sbl, data_mirror, mir_l + c_o * LDP + kk, LDP, COL);
#else
                coopMatLoad(sbh, sh_sh, c_o * LDP + kk, LDP, COL);
                coopMatLoad(sbl, sh_sl, c_o * LDP + kk, LDP, COL);
#endif
                PRODUCT(qs, qh, ql, sbh, sbl);
                PRODUCT(ks, kh, kl, sbh, sbl);
            }
            coopMatPerElement(base_r, qs, ApplyExpPrefix);
            const uint v_base = seq_id * p.sv3 + head_id * p.sv1 + v0 + c_o + t0 * p.sv2;
            coopmat<float, SG, C, TN, MACC> delta;
            coopMatPerElement(delta, ks, ComputeDelta, v_base, p.sv2, valid);
            const coopmat<OPD, SG, C, TN, ACCB> dh = coopmat<OPD, SG, C, TN, ACCB>(delta);
            const coopmat<float, SG, C, TN, MACC> df = coopmat<float, SG, C, TN, MACC>(dh);
            const coopmat<OPD, SG, C, TN, ACCB> dl = coopmat<OPD, SG, C, TN, ACCB>(delta - df);
            coopMatStore(dh, sh_dh, c_o, V, ROW);
            coopMatStore(dl, sh_dl, c_o, V, ROW);
        }
#else
        } else if (sg - 2 * CT < VT) {
            // qs=Q@S -> base on its own subgroup; ks below on separate subgroups so the
            // deep-phase mma critical path stays short (mma-product-bound devices).
            const uint ti  = sg - 2 * CT;
            const uint c_o = ti * TN;
            coopmat<float, SG, C, TN, MACC> qs = coopmat<float, SG, C, TN, MACC>(0);
            [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
                coopmat<OPD, SG, C, KT, MUA> qh, ql;
                coopMatLoad(qh, sh_qh, kk, LDP, ROW);
                coopMatLoad(ql, sh_ql, kk, LDP, ROW);
                coopmat<OPD, SG, KT, TN, MUB> sbh, sbl;
#ifdef GMEM_MIRROR
                coopMatLoad(sbh, data_mirror, mir_h + c_o * LDP + kk, LDP, COL);
                coopMatLoad(sbl, data_mirror, mir_l + c_o * LDP + kk, LDP, COL);
#else
                coopMatLoad(sbh, sh_sh, c_o * LDP + kk, LDP, COL);
                coopMatLoad(sbl, sh_sl, c_o * LDP + kk, LDP, COL);
#endif
                PRODUCT(qs, qh, ql, sbh, sbl);
            }
            coopMatPerElement(base_r, qs, ApplyExpPrefix);
        } else {
            const uint ks_nsg = NSUB - (2 * CT + VT);
            for (uint ti = sg - (2 * CT + VT); ti < VT; ti += ks_nsg) {
                const uint c_o = ti * TN;
                coopmat<float, SG, C, TN, MACC> ks = coopmat<float, SG, C, TN, MACC>(0);
                [[unroll]] for (uint kk = 0; kk < D; kk += KT) {
                    coopmat<OPD, SG, C, KT, MUA> kh, kl;
                    coopMatLoad(kh, sh_kh, kk, LDP, ROW);
                    coopMatLoad(kl, sh_kl, kk, LDP, ROW);
                    coopmat<OPD, SG, KT, TN, MUB> sbh, sbl;
#ifdef GMEM_MIRROR
                    coopMatLoad(sbh, data_mirror, mir_h + c_o * LDP + kk, LDP, COL);
                    coopMatLoad(sbl, data_mirror, mir_l + c_o * LDP + kk, LDP, COL);
#else
                    coopMatLoad(sbh, sh_sh, c_o * LDP + kk, LDP, COL);
                    coopMatLoad(sbl, sh_sl, c_o * LDP + kk, LDP, COL);
#endif
                    PRODUCT(ks, kh, kl, sbh, sbl);
                }
                const uint v_base = seq_id * p.sv3 + head_id * p.sv1 + v0 + c_o + t0 * p.sv2;
                coopmat<float, SG, C, TN, MACC> delta;
                coopMatPerElement(delta, ks, ComputeDelta, v_base, p.sv2, valid);
                const coopmat<OPD, SG, C, TN, ACCB> dh = coopmat<OPD, SG, C, TN, ACCB>(delta);
                const coopmat<float, SG, C, TN, MACC> df = coopmat<float, SG, C, TN, MACC>(dh);
                const coopmat<OPD, SG, C, TN, ACCB> dl = coopmat<OPD, SG, C, TN, ACCB>(delta - df);
                coopMatStore(dh, sh_dh, c_o, V, ROW);
                coopMatStore(dl, sh_dl, c_o, V, ROW);
            }
        }
#endif
        barrier();

        // invert (I + L) by forward substitution: one subgroup per row, lane = column
        {
            const uint col = gl_SubgroupInvocationID;
            [[unroll]] for (uint row = sg; row < C; row += NSUB) {
                float x = col < C ? (col == row ? 1.0 : (col < row ? -sh_lower[row * C + col] : 0.0)) : 0.0;
                for (int pivot = int(row) - 1; pivot > 0; pivot--) {
                    const float xp = subgroupShuffle(x, uint(pivot));
                    if (col < uint(pivot)) {
                        x -= xp * sh_lower[uint(pivot) * C + col];
                    }
                }
                if (col < C) {
                    const OPD h = OPD(x);
                    sh_ih[row * C + col] = h;
                    sh_il[row * C + col] = OPD(x - float(h));
                }
            }
        }
        barrier();

        // solved = (I+L)^-1 @ delta  (sg0-3, one value tile each) -> shared
        if (sg < VT) {
            const uint c_o = sg * TN;
            coopmat<float, SG, C, TN, MACC> solved = coopmat<float, SG, C, TN, MACC>(0);
            coopmat<OPD, SG, C, C, MUA> ih, il;
            coopMatLoad(ih, sh_ih, 0, C, ROW);
            coopMatLoad(il, sh_il, 0, C, ROW);
            coopmat<OPD, SG, C, TN, MUB> dh, dl;
            coopMatLoad(dh, sh_dh, c_o, V, ROW);
            coopMatLoad(dl, sh_dl, c_o, V, ROW);
            PRODUCT(solved, ih, il, dh, dl);
            const coopmat<OPD, SG, C, TN, ACCB> sh = coopmat<OPD, SG, C, TN, ACCB>(solved);
            const coopmat<float, SG, C, TN, MACC> sf = coopmat<float, SG, C, TN, MACC>(sh);
            const coopmat<OPD, SG, C, TN, ACCB> sl = coopmat<OPD, SG, C, TN, ACCB>(solved - sf);
            coopMatStore(sh, sh_soh, c_o, V, ROW);
            coopMatStore(sl, sh_sol, c_o, V, ROW);
        }
        barrier();

        // out = base + P@solved  (sg4-7, one value tile each)
        if (sg >= 2 * CT && sg - 2 * CT < VT) {
            const uint ti  = sg - 2 * CT;
            const uint c_o = ti * TN;
            coopmat<float, SG, C, TN, MACC> O = base_r;
            coopmat<OPD, SG, C, C, MUA> ph, pl;
            coopMatLoad(ph, sh_ph, 0, C, ROW);
            coopMatLoad(pl, sh_pl, 0, C, ROW);
            coopmat<OPD, SG, C, TN, MUB> svh, svl;
            coopMatLoad(svh, sh_soh, c_o, V, ROW);
            coopMatLoad(svl, sh_sol, c_o, V, ROW);
            PRODUCT(O, ph, pl, svh, svl);
            const uint out_base = (seq_id * p.n_tokens * p.H + head_id) * D + v0 + c_o + t0 * (D * p.H);
            coopMatPerElement(O, O, StoreOut, out_base, valid);
        }
        // delta2 = solved * carry -> sh_dh/dl (all threads)
        for (uint i = tid; i < C * V; i += WGS) {
            const uint t = i / V, v = i % V;
            const float sv = float(sh_soh[i]) + float(sh_sol[i]);
            const float d2 = sv * sh_carry[t];
            const OPD h = OPD(d2);
            sh_dh[i] = h;
            sh_dl[i] = OPD(d2 - float(h));
        }
        barrier();

        // state = exp(prefix_last)*state + K^T @ delta2   (register tiles)
        [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
            const uint ti = sg + j * NSUB;
            coopmat<OPD, SG, TM, C, MUA> kth, ktl;
            coopMatLoad(kth, sh_kh, TILE_R(ti), LDP, COL);
            coopMatLoad(ktl, sh_kl, TILE_R(ti), LDP, COL);
            coopmat<OPD, SG, C, TN, MUB> dh, dl;
            coopMatLoad(dh, sh_dh, TILE_C(ti), V, ROW);
            coopMatLoad(dl, sh_dl, TILE_C(ti), V, ROW);
            state[j] = state[j] * cdecay;
            PRODUCT(state[j], kth, ktl, dh, dl);
        }
        barrier();
    }
#endif

    [[unroll]] for (uint j = 0; j < PER_WARP; j++) {
        const uint ti = sg + j * NSUB;
        coopMatPerElement(state[j], state[j], StoreState,
                            p.s_off + state_base + (v0 + TILE_C(ti)) * D + TILE_R(ti));
    }
}
