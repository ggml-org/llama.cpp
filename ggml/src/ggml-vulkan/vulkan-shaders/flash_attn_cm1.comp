#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_16bit_storage : require

#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#if defined(BFLOAT16)
#extension GL_EXT_bfloat16 : enable
#endif

#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_vote : enable
#extension GL_KHR_shader_subgroup_shuffle : enable
#extension GL_KHR_memory_scope_semantics : enable
#extension GL_KHR_cooperative_matrix : enable

#include "types.glsl"
#include "flash_attn_base.glsl"
#if !defined(BFLOAT16)
#include "flash_attn_dequant.glsl"
#endif

// These need to be supported N,M values for a MatBc x MatBr x 16 coopmatmuladd
const uint32_t MatBr = 16;
const uint32_t MatBc = 16;

const uint32_t rows_per_thread = Br / row_split;
const uint32_t cols_per_iter = gl_WorkGroupSize.x / row_split;
const uint32_t cols_per_thread = Bc / cols_per_iter;


layout (binding = 0) readonly buffer Q {float data_q[];};
layout (binding = 0) readonly buffer QV4 {vec4 data_qv4[];};
layout (binding = 1) readonly buffer K {FLOAT_TYPE data_k[];};
layout (binding = 1) readonly buffer KV4 {FLOAT_TYPEV4 data_kv4[];};
layout (binding = 2) readonly buffer V {FLOAT_TYPE data_v[];};
layout (binding = 2) readonly buffer VV4 {FLOAT_TYPEV4 data_vv4[];};
layout (binding = 3) readonly buffer M {float16_t data_m[];};
layout (binding = 1) readonly buffer KU {uvec4 data_ku[];};
layout (binding = 2) readonly buffer VU {uvec4 data_vu[];};

shared float tmpsh[FLIP ? 1 : row_split];

const uint32_t qstride = HSK_pad / 4 + 2;
shared FLOAT_TYPEV4 Qf[(Q_IN_REGS || FLIP) ? 1 : (Br * qstride)];

const uint psh_stride = Br / 4 + 2;
const uint32_t qchunk_dtiles = 4;
const uint32_t qchunk_stride = qchunk_dtiles * 16 / 4 + 2;
const uint32_t psh_size = Bc * psh_stride;
const uint32_t qchunk_size = Q_IN_REGS ? Br * qchunk_stride : 0;
shared FLOAT_TYPEV4 Psh[FLIP ? 1 : (psh_size >= qchunk_size ? psh_size : qchunk_size)];

// Avoid padding for hsk==256 to make it fit in 48KB shmem.
const uint32_t sfshstride = (HSK <= 128) ? (Br / 4 + 2) : Br / 4;
shared ACC_TYPEV4 sfsh[FLIP ? 1 : Bc * sfshstride];

const uint32_t D_pad = HSK_pad > HSV_pad ? HSK_pad : HSV_pad;
const uint32_t kvsh_stride = (SHMEM_STAGING != 0 ? D_pad : MatBr) / 4 + 2;
const uint v_cols = MatBc / 4 * row_split; // total cols, 4 vec4s per MatBc * number of subgroups
const uint vsh_stride = v_cols;
shared FLOAT_TYPEV4 kvsh[FLIP ? 1 : ((kvsh_stride >= vsh_stride) ? (Bc * kvsh_stride) : (Bc * vsh_stride))];

// PV result reuses sfsh
const uint32_t osh_stride = row_split * MatBr / 4;
#if defined(FLOAT16) && !defined(ACC_TYPE_MAX)
const uint32_t pv_per_acc = 2;
O_TYPEV4 pvsh_load(const uint32_t i) {
    const uvec2 u = floatBitsToUint(vec2(sfsh[i / 2][(i % 2) * 2], sfsh[i / 2][(i % 2) * 2 + 1]));
    return O_TYPEV4(unpackFloat2x16(u.x), unpackFloat2x16(u.y));
}
#else
const uint32_t pv_per_acc = 1;
O_TYPEV4 pvsh_load(const uint32_t i) {
    return O_TYPEV4(sfsh[i]);
}
#endif

shared ACC_TYPE slope[FLIP ? 1 : Br];

// Flipped coopmat1 FA: each subgroup owns 16 Q rows and the full head dim, the workgroup
// shares one K/V tile staged in LDS. Requires gqa_ratio == 1, aligned KV, f16/bf16 K/V,
// HSK/HSV multiples of 16, Br == row_split * 16.

const uint32_t FL_LPR = SubGroupSize / 16;
const uint32_t FL_CPL = Bc / FL_LPR;
const uint32_t FL_OCPL = 16 / FL_LPR;

const uint32_t FL_KLD = CEIL_DIV(Bc * HSK_pad / 8, WorkGroupSize);
const uint32_t FL_VLD = CEIL_DIV(Bc * HSV_pad / 8, WorkGroupSize);

// V^T staging: each thread packs FL_VLD consecutive KV rows (multiple of 4) of 8 d values
const bool FL_VT = (uint32_t(FLIP_VT) * uint32_t((FL_VLD % 4) == 0) * uint32_t((WorkGroupSize % (HSV_pad / 8)) == 0) *
                    uint32_t(FL_VLD * (WorkGroupSize / (HSV_pad / 8)) == Bc)) != 0;

// LDS in uvec2 (4 halfs) units
const uint32_t fl_kstride = D_pad / 4 + 2;
const uint32_t fl_vtstride = Bc / 4 + 2;
const uint32_t fl_vtsize = FLIP_VT ? HSV_pad * fl_vtstride : 0;
const uint32_t fl_kvbuf = fl_vtsize > Bc * fl_kstride ? fl_vtsize : Bc * fl_kstride;
shared uvec2 kvshf[FLIP ? (FLIP_KVSEP ? 2 : 1) * fl_kvbuf : 1];

#if defined(ACC_TYPE_MAX)
const uint32_t fl_sstride = Bc / 4 + 2;
#else
const uint32_t fl_sstride = Bc / 4 + 1;
#endif
shared ACC_TYPEV4 sshf[FLIP ? row_split * 16 * fl_sstride : 1];

// P and Q (the coopmat A operands) are staged through the S slab, which is idle
// between the S read and the PV matmul. f16 K/V aliases into sshf (f32acc packs two
// f16 rows per element, FL_PACK==2; f16acc stores natively, FL_PACK==1); bf16 keeps pshf.
#if defined(FLOAT16)
#define FL_P_IN_SSHF 1
#if defined(ACC_TYPE_MAX)
#define FL_PACK 1
#else
#define FL_PACK 2
#endif
#endif

const uint32_t fl_pstride = Bc / 4 + 2;
#if defined(FL_P_IN_SSHF)
shared FLOAT_TYPEV4 pshf[1];
#else
shared FLOAT_TYPEV4 pshf[FLIP ? row_split * 16 * fl_pstride : 1];
#endif

#if defined(FL_P_IN_SSHF)
// Store one f16vec4 (f16 column group cfv) of the A slab into sshf.
void fl_store_a(const uint32_t e_base, const uint32_t cfv, const FLOAT_TYPEV4 val) {
#if FL_PACK == 2
    const uint32_t e = e_base + cfv / 2;
    const uint32_t h = (cfv & 1u) * 2u;
    sshf[e][h]     = uintBitsToFloat(packFloat2x16(f16vec2(val.xy)));
    sshf[e][h + 1] = uintBitsToFloat(packFloat2x16(f16vec2(val.zw)));
#else
    sshf[e_base + cfv] = ACC_TYPEV4(val);
#endif
}
#endif

#if defined(ACC_TYPE_MAX)
const float FL_TAU = 0.0;
#else
const float FL_TAU = 8.0;
#endif

uvec4 fl_kr[FL_KLD];
uvec4 fl_vr[FL_VLD];

uint32_t fl_mo_offset, fl_mo_idx, fl_mo_word;

uint32_t fl_mask_bits(const uint32_t j) {
    if (!MASK_ENABLE || !USE_MASK_OPT) {
        return 0;
    }
    if (fl_mo_idx != j / 16) {
        fl_mo_idx = j / 16;
        fl_mo_word = data_mask_opt[fl_mo_offset + fl_mo_idx];
    }
    return (fl_mo_word >> ((j % 16) * 2)) & 0x3;
}

uint32_t fl_next_tile(uint32_t j) {
    while (j < end_j && fl_mask_bits(j) == MASK_OPT_ALL_NEG_INF) {
        ++j;
    }
    return j;
}

void fl_load_k(const uint32_t j, const uint32_t k_offset) {
    [[unroll]] for (uint32_t l = 0; l < FL_KLD; ++l) {
        const uint32_t idx = l * WorkGroupSize + gl_LocalInvocationIndex;
        if (idx < Bc * HSK_pad / 8) {
            const uint32_t c = idx / (HSK_pad / 8);
            const uint32_t d = idx % (HSK_pad / 8);
            fl_kr[l] = data_ku[(k_offset + (j * Bc + c) * k_stride) / 8 + d];
        }
    }
}

void fl_load_v(const uint32_t j, const uint32_t v_offset) {
    [[unroll]] for (uint32_t l = 0; l < FL_VLD; ++l) {
        const uint32_t idx = l * WorkGroupSize + gl_LocalInvocationIndex;
        if (idx < Bc * HSV_pad / 8) {
            uint32_t c = idx / (HSV_pad / 8);
            const uint32_t d = idx % (HSV_pad / 8);
            if (FL_VT) {
                c = (gl_LocalInvocationIndex / (HSV_pad / 8)) * FL_VLD + l;
            }
            fl_vr[l] = data_vu[(v_offset + (j * Bc + c) * v_stride) / 8 + d];
        }
    }
}

void fl_store_k() {
    [[unroll]] for (uint32_t l = 0; l < FL_KLD; ++l) {
        const uint32_t idx = l * WorkGroupSize + gl_LocalInvocationIndex;
        if (idx < Bc * HSK_pad / 8) {
            const uint32_t a = (idx / (HSK_pad / 8)) * fl_kstride + 2 * (idx % (HSK_pad / 8));
            kvshf[a] = fl_kr[l].xy;
            kvshf[a + 1] = fl_kr[l].zw;
        }
    }
}

void fl_store_v(const uint32_t base) {
    if (FL_VT) {
        const uint32_t d0 = (gl_LocalInvocationIndex % (HSV_pad / 8)) * 8;
        const uint32_t c0 = (gl_LocalInvocationIndex / (HSV_pad / 8)) * FL_VLD;
        [[unroll]] for (uint32_t dd = 0; dd < 8; ++dd) {
            const uint32_t ddv = (dd + gl_LocalInvocationIndex) & 7u;   // rotate store order to spread banks
            const uint32_t sh = (ddv % 2) * 16;
            [[unroll]] for (uint32_t l = 0; l < FL_VLD; l += 4) {
                const uvec2 w = uvec2(((fl_vr[l    ][ddv / 2] >> sh) & 0xFFFF) | (((fl_vr[l + 1][ddv / 2] >> sh) & 0xFFFF) << 16),
                                      ((fl_vr[l + 2][ddv / 2] >> sh) & 0xFFFF) | (((fl_vr[l + 3][ddv / 2] >> sh) & 0xFFFF) << 16));
                kvshf[base + (d0 + ddv) * fl_vtstride + (c0 + l) / 4] = w;
            }
        }
        return;
    }
    [[unroll]] for (uint32_t l = 0; l < FL_VLD; ++l) {
        const uint32_t idx = l * WorkGroupSize + gl_LocalInvocationIndex;
        if (idx < Bc * HSV_pad / 8) {
            const uint32_t a = base + (idx / (HSV_pad / 8)) * fl_kstride + 2 * (idx % (HSV_pad / 8));
            kvshf[a] = fl_vr[l].xy;
            kvshf[a + 1] = fl_vr[l].zw;
        }
    }
}

void fl_sg_barrier() {
    controlBarrier(gl_ScopeSubgroup, gl_ScopeSubgroup, gl_StorageSemanticsShared, gl_SemanticsAcquireRelease);
}

float fl_row_max(float v) {
    [[unroll]] for (uint32_t o = 1; o < FL_LPR; o *= 2) {
        v = max(v, subgroupShuffleXor(v, o));
    }
    return v;
}

float fl_row_sum(float v) {
    [[unroll]] for (uint32_t o = 1; o < FL_LPR; o *= 2) {
        v += subgroupShuffleXor(v, o);
    }
    return v;
}

void fl_rescale(inout coopmat<ACC_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> o, const uint32_t ss_base, const uint32_t lr, const uint32_t lc, const float alpha) {
    fl_sg_barrier();
    coopMatStore(o, sshf, ss_base, fl_sstride, gl_CooperativeMatrixLayoutRowMajor);
    fl_sg_barrier();
    [[unroll]] for (uint32_t v = 0; v < FL_OCPL / 4; ++v) {
        const uint32_t a = ss_base + lr * fl_sstride + lc * (FL_OCPL / 4) + v;
        sshf[a] = sshf[a] * ACC_TYPE(alpha);
    }
    fl_sg_barrier();
    coopMatLoad(o, sshf, ss_base, fl_sstride, gl_CooperativeMatrixLayoutRowMajor);
}

void main_flip() {
    const uint32_t sg = gl_SubgroupID;
    const uint32_t lane = gl_SubgroupInvocationID;
    const uint32_t lr = lane / FL_LPR;
    const uint32_t lc = lane % FL_LPR;
    const uint32_t row0 = i * Br + sg * 16;
    const uint32_t myrow = row0 + lr;

    const uint32_t ss_base = sg * 16 * fl_sstride;
#if !defined(FL_P_IN_SSHF)
    const uint32_t ps_base = sg * 16 * fl_pstride;
#endif

    const uint32_t q_offset = (iq2 * p.nb02 + iq3 * p.nb03) / 4;

    // Q (scaled) -> coopmat A registers, staged through this subgroup's A slab
    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> Qa[HSK_pad / 16];
#if defined(FL_P_IN_SSHF)
    const uint32_t qdt = fl_sstride * FL_PACK / 4;
    [[unroll]] for (uint32_t dbase = 0; dbase < HSK_pad / 16; dbase += qdt) {
        [[unroll]] for (uint32_t idx0 = 0; idx0 < 16 * qdt * 4; idx0 += SubGroupSize) {
            const uint32_t idx = idx0 + lane;
            const uint32_t r = idx / (qdt * 4);
            const uint32_t dv = idx % (qdt * 4);
            const uint32_t d = dbase * 4 + dv;
            if (r < 16) {
                FLOAT_TYPEV4 val = FLOAT_TYPEV4(0);
                if (d < HSK / 4 && row0 + r < N) {
                    val = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (row0 + r) * p.nb01 / 4 + d] * p.scale);
                }
                fl_store_a(ss_base + r * fl_sstride, dv, val);
            }
        }
        fl_sg_barrier();
        [[unroll]] for (uint32_t dd = 0; dd < qdt; ++dd) {
            if (dbase + dd < HSK_pad / 16) {
                coopMatLoad(Qa[dbase + dd], sshf, ss_base + dd * (4 / FL_PACK), fl_sstride, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        fl_sg_barrier();
    }
#else
    const uint32_t qdt = fl_pstride * 4 / 16;
    [[unroll]] for (uint32_t dbase = 0; dbase < HSK_pad / 16; dbase += qdt) {
        [[unroll]] for (uint32_t idx0 = 0; idx0 < 16 * qdt * 4; idx0 += SubGroupSize) {
            const uint32_t idx = idx0 + lane;
            const uint32_t r = idx / (qdt * 4);
            const uint32_t dv = idx % (qdt * 4);
            const uint32_t d = dbase * 4 + dv;
            if (r < 16) {
                FLOAT_TYPEV4 val = FLOAT_TYPEV4(0);
                if (d < HSK / 4 && row0 + r < N) {
                    val = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (row0 + r) * p.nb01 / 4 + d] * p.scale);
                }
                pshf[ps_base + r * fl_pstride + dv] = val;
            }
        }
        fl_sg_barrier();
        [[unroll]] for (uint32_t dd = 0; dd < qdt; ++dd) {
            if (dbase + dd < HSK_pad / 16) {
                coopMatLoad(Qa[dbase + dd], pshf, ps_base + dd * 4, fl_pstride, gl_CooperativeMatrixLayoutRowMajor);
            }
        }
        fl_sg_barrier();
    }
#endif

    coopmat<ACC_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> Oacc[HSV_pad / 16];
    [[unroll]] for (uint32_t t = 0; t < HSV_pad / 16; ++t) {
        Oacc[t] = coopmat<ACC_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
    }

    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);
    float M = NEG_FLT_MAX_OVER_2;
    float L = 0;

    float slope_v = 1.0;
    if (p.max_bias > 0.0f) {
        slope_v = float(perElemOpComputeSlope(0, 0, ACC_TYPE(0), iq2));
    }

    const uint32_t k_offset = (ik2 * p.nb12 + ik3 * p.nb13) / FaBlockBytesK;
    const uint32_t v_offset = (iv2 * p.nb22 + iv3 * p.nb23) / FaBlockBytesV;
    uint32_t m_offset = 0;
    const uint32_t mo_stride = CEIL_DIV(KV, 16 * Bc);
    fl_mo_offset = mo_stride * i;
    fl_mo_idx = ~0u;
    fl_mo_word = 0;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
        fl_mo_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * CEIL_DIV(p.nem1, Br) * mo_stride;
    }

    const uint32_t vbase = FLIP_KVSEP ? fl_kvbuf : 0;

    uint32_t j = fl_next_tile(start_j);
    if (j < end_j) {
        fl_load_k(j, k_offset);
        if (FLIP_KVSEP || FLIP_PF2) {
            fl_load_v(j, v_offset);
        }
    }

    [[dont_unroll]]
    while (j < end_j) {
        const uint32_t jn = fl_next_tile(j + 1);
        const uint32_t mask_bits = fl_mask_bits(j);

        barrier();
        fl_store_k();
        if (FLIP_KVSEP) {
            fl_store_v(vbase);
        }
        barrier();
        if (FLIP_KVSEP) {
            if (jn < end_j) {
                fl_load_k(jn, k_offset);
                fl_load_v(jn, v_offset);
            }
        } else if (FLIP_PF2) {
            if (jn < end_j) {
                fl_load_k(jn, k_offset);
            }
        } else {
            fl_load_v(j, v_offset);
        }

        coopmat<ACC_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> Sacc[Bc / 16];
        [[unroll]] for (uint32_t c = 0; c < Bc / 16; ++c) {
            Sacc[c] = coopmat<ACC_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0);
        }
        [[unroll]] for (uint32_t d = 0; d < HSK_pad / 16; ++d) {
            [[unroll]] for (uint32_t c = 0; c < Bc / 16; ++c) {
                coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> Kb;
                coopMatLoad(Kb, kvshf, c * 16 * fl_kstride + d * 4, fl_kstride, gl_CooperativeMatrixLayoutColumnMajor);
                Sacc[c] = coopMatMulAdd(Qa[d], Kb, Sacc[c]);
            }
        }

        fl_sg_barrier();
        [[unroll]] for (uint32_t c = 0; c < Bc / 16; ++c) {
            coopMatStore(Sacc[c], sshf, ss_base + c * 4, fl_sstride, gl_CooperativeMatrixLayoutRowMajor);
        }
        fl_sg_barrier();
        float s[FL_CPL];
        [[unroll]] for (uint32_t v = 0; v < FL_CPL / 4; ++v) {
            const vec4 sv = vec4(sshf[ss_base + lr * fl_sstride + lc * (FL_CPL / 4) + v]);
            [[unroll]] for (uint32_t k = 0; k < 4; ++k) {
                s[v * 4 + k] = sv[k];
            }
        }

        if (LOGIT_SOFTCAP) {
            [[unroll]] for (uint32_t k = 0; k < FL_CPL; ++k) {
                s[k] = p.logit_softcap * tanh(s[k]);
            }
        }

        if (MASK_ENABLE && mask_bits != MASK_OPT_ALL_ZERO && myrow < p.nem1) {
            const uint32_t moff = m_offset + myrow * KV + j * Bc + lc * FL_CPL;
            [[unroll]] for (uint32_t k = 0; k < FL_CPL; ++k) {
                s[k] += slope_v * float(data_m[moff + k]);
            }
        }

        float mx = s[0];
        [[unroll]] for (uint32_t k = 1; k < FL_CPL; ++k) {
            mx = max(mx, s[k]);
        }
        mx = fl_row_max(mx) + FATTN_KQ_MAX_OFFSET;

        if (subgroupAny(mx > M + FL_TAU)) {
            const float Mn = max(M, mx);
            const float alpha = exp(M - Mn);
            M = Mn;
            L *= alpha;
            if (!subgroupAll(alpha == 0.0)) {
                [[unroll]] for (uint32_t t = 0; t < HSV_pad / 16; ++t) {
                    fl_rescale(Oacc[t], ss_base, lr, lc, alpha);
                }
#if defined(FL_P_IN_SSHF)
                // rescale left O in the S slab; fence before P reuses it
                fl_sg_barrier();
#endif
            }
        }

#if defined(FL_P_IN_SSHF)
        // P reuses the S slab. Within a wave64 subgroup the S read retires (waitcnt forced
        // by the exp below) before these writes; only the rescale path above needs a fence.
#if FL_PACK == 2
        [[unroll]] for (uint32_t v = 0; v < FL_CPL / 4; v += 2) {
            const vec4 pv0 = exp(vec4(s[v * 4    ], s[v * 4 + 1], s[v * 4 + 2], s[v * 4 + 3]) - M);
            const vec4 pv1 = exp(vec4(s[v * 4 + 4], s[v * 4 + 5], s[v * 4 + 6], s[v * 4 + 7]) - M);
            L += pv0.x + pv0.y + pv0.z + pv0.w + pv1.x + pv1.y + pv1.z + pv1.w;
            sshf[ss_base + lr * fl_sstride + lc * (FL_CPL / 8) + v / 2] =
                uintBitsToFloat(uvec4(packFloat2x16(f16vec2(pv0.xy)), packFloat2x16(f16vec2(pv0.zw)),
                                      packFloat2x16(f16vec2(pv1.xy)), packFloat2x16(f16vec2(pv1.zw))));
        }
#else
        [[unroll]] for (uint32_t v = 0; v < FL_CPL / 4; ++v) {
            const vec4 pv = exp(vec4(s[v * 4], s[v * 4 + 1], s[v * 4 + 2], s[v * 4 + 3]) - M);
            L += pv.x + pv.y + pv.z + pv.w;
            sshf[ss_base + lr * fl_sstride + lc * (FL_CPL / 4) + v] = ACC_TYPEV4(pv);
        }
#endif
        fl_sg_barrier();

        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> Pa[Bc / 16];
        [[unroll]] for (uint32_t c = 0; c < Bc / 16; ++c) {
            coopMatLoad(Pa[c], sshf, ss_base + c * (4 / FL_PACK), fl_sstride, gl_CooperativeMatrixLayoutRowMajor);
        }
#else
        [[unroll]] for (uint32_t v = 0; v < FL_CPL / 4; ++v) {
            const vec4 pv = exp(vec4(s[v * 4], s[v * 4 + 1], s[v * 4 + 2], s[v * 4 + 3]) - M);
            L += pv.x + pv.y + pv.z + pv.w;
            pshf[ps_base + lr * fl_pstride + lc * (FL_CPL / 4) + v] = FLOAT_TYPEV4(pv);
        }
        fl_sg_barrier();

        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> Pa[Bc / 16];
        [[unroll]] for (uint32_t c = 0; c < Bc / 16; ++c) {
            coopMatLoad(Pa[c], pshf, ps_base + c * 4, fl_pstride, gl_CooperativeMatrixLayoutRowMajor);
        }
#endif

        if (!FLIP_KVSEP) {
            barrier();
            fl_store_v(0);
            barrier();
            if (jn < end_j) {
                if (FLIP_PF2) {
                    fl_load_v(jn, v_offset);
                } else {
                    fl_load_k(jn, k_offset);
                }
            }
        }

        [[unroll]] for (uint32_t t = 0; t < HSV_pad / 16; ++t) {
            [[unroll]] for (uint32_t c = 0; c < Bc / 16; ++c) {
                coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> Vb;
                if (FL_VT) {
                    coopMatLoad(Vb, kvshf, vbase + t * 16 * fl_vtstride + c * 4, fl_vtstride, gl_CooperativeMatrixLayoutColumnMajor);
                } else {
                    coopMatLoad(Vb, kvshf, vbase + c * 16 * fl_kstride + t * 4, fl_kstride, gl_CooperativeMatrixLayoutRowMajor);
                }
                Oacc[t] = coopMatMulAdd(Pa[c], Vb, Oacc[t]);
            }
        }

        j = jn;
    }

    L = fl_row_sum(L);

    float oscale = 1.0;
    uint32_t o_row_offset;
    if (p.k_num > 1) {
        o_row_offset = HSV * p.ne1 * (split_k_index + p.k_num * (myrow + p.ne2 * iq3)) / 4 + iq2 * HSV / 4;
        if (myrow < N && lc == 0) {
            const uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (myrow + p.ne2 * iq3));
            data_o[lm_offset + iq2] = D_TYPE(L);
            data_o[lm_offset + p.ne1 + iq2] = D_TYPE(M);
        }
    } else {
        if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0) {
            const float sink = float(perElemOpGetSink(0, 0u, ACC_TYPE(0), iq2));
            float ms = 1.0f;
            float vs = 1.0f;
            if (sink > M) {
                ms = exp(M - sink);
            } else {
                vs = exp(sink - M);
            }
            L = L * ms + vs;
            oscale = ms;
        }
        oscale *= (L == 0.0) ? 0.0 : (1.0 / L);
        o_row_offset = (iq3 * p.ne2 * p.ne1 * HSV + iq2 * HSV + myrow * p.ne1 * HSV) / 4;
    }

    [[unroll]] for (uint32_t t = 0; t < HSV_pad / 16; ++t) {
        fl_sg_barrier();
        coopMatStore(Oacc[t], sshf, ss_base, fl_sstride, gl_CooperativeMatrixLayoutRowMajor);
        fl_sg_barrier();
        [[unroll]] for (uint32_t v = 0; v < FL_OCPL / 4; ++v) {
            const uint32_t d4 = t * 4 + lc * (FL_OCPL / 4) + v;
            vec4 o = vec4(sshf[ss_base + lr * fl_sstride + lc * (FL_OCPL / 4) + v]) * oscale;
#if defined(FLOAT_TYPE_MAX)
            if (p.k_num <= 1) {
                o = clamp(o, vec4(-FLOAT_TYPE_MAX), vec4(FLOAT_TYPE_MAX));
            }
#endif
            if (myrow < N && d4 < HSV / 4) {
                data_ov4[o_row_offset + d4] = D_TYPEV4(o);
            }
        }
    }
}

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    if (fa_type_needs_shmem(FaTypeK) || fa_type_needs_shmem(FaTypeV)) {
        init_iq_shmem(gl_WorkGroupSize);
    }
#endif

    init_indices();

    if (FLIP) {
        main_flip();
        return;
    }

    const uint32_t tid = gl_LocalInvocationIndex;

    const uint32_t threads_per_rowgroup = gl_WorkGroupSize.x / row_split;
    const uint32_t d_per_thread = (HSV/4 + threads_per_rowgroup - 1) / threads_per_rowgroup;
    const uint32_t row_tid = gl_LocalInvocationIndex / threads_per_rowgroup;
    const uint32_t col_tid = gl_LocalInvocationIndex % threads_per_rowgroup;

#define tile_row(r) (row_tid * rows_per_thread + (r))

    const uint32_t q_tiles = Br / MatBr;
    const uint32_t d_tiles = HSK_pad / 16;

    uint32_t q_offset = gqa_iq1*p.nb01 + (iq2*p.nb02+iq3*p.nb03) / 4;

    coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBr, gl_MatrixUseB> Qreg[Q_IN_REGS ? (d_tiles * q_tiles) : 1];

    if (Q_IN_REGS) {
        [[unroll]] for (uint32_t dbase = 0; dbase < d_tiles; dbase += qchunk_dtiles) {
            [[unroll]] for (uint32_t idx = 0; idx < Br * qchunk_dtiles * 16 / 4; idx += gl_WorkGroupSize.x) {
                uint32_t dvec = (idx + tid) % (qchunk_dtiles * 16 / 4);
                uint32_t r = (idx + tid) / (qchunk_dtiles * 16 / 4);
                if (r < Br) {
                    uint32_t d = dbase * 4 + dvec;
                    FLOAT_TYPEV4 val = FLOAT_TYPEV4(0);
                    if (d < HSK / 4 && i * Br + r < N) {
                        val = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d] * p.scale);
                    }
                    Psh[r * qchunk_stride + dvec] = val;
                }
            }
            barrier();
            [[unroll]] for (uint32_t dd = 0; dd < qchunk_dtiles && dbase + dd < d_tiles; ++dd) {
                [[unroll]] for (uint32_t q = 0; q < q_tiles; ++q) {
                    coopMatLoad(Qreg[(dbase + dd) * q_tiles + q], Psh, dd * 16 / 4 + q * MatBr * qchunk_stride, qchunk_stride, gl_CooperativeMatrixLayoutColumnMajor);
                }
            }
            barrier();
        }
    } else {
        // Zero-initialize Qf when HSK is not a multiple of 16 (HSK_pad > HSK).
        if ((HSK % 16) != 0) {
            [[unroll]] for (uint ii = 0; ii < Br * qstride; ii += gl_WorkGroupSize.x) {
                if (ii + tid < Br * qstride) {
                    Qf[ii + tid] = FLOAT_TYPEV4(0);
                }
            }
            barrier();
        }

        [[unroll]] for (uint32_t idx = 0; idx < Br * HSK / 4; idx += gl_WorkGroupSize.x) {
            uint32_t d = (idx + tid) % (HSK / 4);
            uint32_t r = (idx + tid) / (HSK / 4);
            if (r < Br && d < HSK / 4 &&
                i * Br + r < N) {
                Qf[r * qstride + d] = FLOAT_TYPEV4(data_qv4[q_offset / 4 + (i * Br + r) * q_stride / 4 + d] * p.scale);
            }
        }
        barrier();
    }

    O_TYPEV4 Of[rows_per_thread][d_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        [[unroll]] for (uint32_t d = 0; d < d_per_thread; ++d) {
            Of[r][d] = O_TYPEV4(0.0);
        }
    }

    float Lf[rows_per_thread], Mf[rows_per_thread];

    // Use -FLT_MAX/2 rather than -inf to reduce the possibility of NaNs, e.g. when computing Mold-M.
    const float NEG_FLT_MAX_OVER_2 = uintBitsToFloat(0xFEFFFFFF);

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = 0;
        Mf[r] = NEG_FLT_MAX_OVER_2;
    }

    // ALiBi
    if (p.max_bias > 0.0f) {
        if (tid < Br) {
            uint r = tid;
            slope[r] = perElemOpComputeSlope(r, col_tid, ACC_TYPE(0), iq2);
        }
    } else {
        if (tid < Br) {
            uint r = tid;
            slope[r] = ACC_TYPE(1.0);
        }
    }

    const uint32_t mo_stride = CEIL_DIV(KV, 16 * Bc);
    // mo_offset will point to the tile starting at row i*Br and col 0
    uint32_t mo_offset = mo_stride * i;

    // FaBlockBytesK/V == 2 for f16 (sizeof f16) and == 16 for f32 (vec4) and == ggml block size for quants.
    uint32_t k_offset = (ik2*p.nb12 + ik3*p.nb13) / FaBlockBytesK;
    uint32_t v_offset = (iv2*p.nb22 + iv3*p.nb23) / FaBlockBytesV;
    uint32_t m_offset = gqa_iq1*KV;
    if (p.nem2 != 1 || p.nem3 != 1) {
        m_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * p.nem1 * KV;
        mo_offset += ((iq3 % p.nem3) * p.nem2 + (iq2 % p.nem2)) * CEIL_DIV(p.nem1, Br) * mo_stride;
    }

    uint32_t mask_opt = 0;
    uint32_t mask_opt_idx = ~0;
    uint32_t mask_opt_bits = 0;
    f16vec4 mask_cache[Bc * Br / 4 / WorkGroupSize];

    [[dont_unroll]]
    for (uint32_t j = start_j; j < end_j; ++j) {

        [[unroll]] for (uint32_t idx = 0; idx < mask_cache.length(); ++idx) {
            mask_cache[idx] = f16vec4(0);
        }

        if (MASK_ENABLE) {
            if (USE_MASK_OPT && mask_opt_idx != j / 16) {
                mask_opt_idx = j / 16;
                mask_opt = data_mask_opt[mo_offset + mask_opt_idx];
            }
            mask_opt_bits = (mask_opt >> ((j % 16) * 2)) & 0x3;
            if (mask_opt_bits == MASK_OPT_ALL_NEG_INF) {
                // skip this block
                continue;
            }
            // Only load if the block is not all zeros
            if (mask_opt_bits != MASK_OPT_ALL_ZERO) {
                bool nem1_bounds_check = !(p.gqa_ratio > 1) && (p.nem1 % Br) != 0;

                float max_mask = NEG_FLT_MAX_OVER_2;
                [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t c = (idx + tid) / (Br / 4);
                    uint32_t r = (idx + tid) % (Br / 4);
                    if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                        uint32_t kcol;
                        bool kv_active = fa_kv_index(j * Bc + c, kcol);
                        if (kv_active) {
                            f16vec4 m;
                            if (USE_SPARSE) {
                                // sparse is gqa-gated (m_stride == 0): all four rows share the value
                                FLOAT_TYPE mv = FLOAT_TYPE(data_m[m_offset + kcol]);
                                m = f16vec4(mv);
                                max_mask = max(max_mask, float(mv));
                            } else if (!nem1_bounds_check || i * Br + r * 4 + 3 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 2) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 3) * m_stride + (j * Bc + c)]);
                                max_mask = max(max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2])), float(m[3]));
                            } else if (i * Br + r * 4 + 2 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 2) * m_stride + (j * Bc + c)],
                                            0.0);
                                max_mask = max(max(max(max_mask, float(m[0])), float(m[1])), float(m[2]));
                            } else if (i * Br + r * 4 + 1 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            data_m[m_offset + (i * Br + r * 4 + 1) * m_stride + (j * Bc + c)],
                                            0.0,
                                            0.0);
                                max_mask = max(max(max_mask, float(m[0])), float(m[1]));
                            } else if (i * Br + r * 4 < p.nem1) {
                                m = f16vec4(data_m[m_offset + (i * Br + r * 4    ) * m_stride + (j * Bc + c)],
                                            0.0,
                                            0.0,
                                            0.0);
                                max_mask = max(max_mask, float(m[0]));
                            } else {
                                m = f16vec4(0.0);
                            }
                            mask_cache[idx / WorkGroupSize] = m;
                        } else if (USE_SPARSE) {
                            mask_cache[idx / WorkGroupSize] = f16vec4(NEG_FLT_MAX_OVER_2);
                        }
                    }
                }
                // skip the block if the mask is entirely -inf
                bool all_less = subgroupAll(max_mask <= NEG_FLT_MAX_OVER_2);
                barrier();
                if (gl_SubgroupInvocationID == 0) {
                    tmpsh[gl_SubgroupID] = all_less ? NEG_FLT_MAX_OVER_2 : 0.0f;
                }
                barrier();
                [[unroll]] for (uint s = 0; s < gl_NumSubgroups; ++s) {
                    max_mask = max(max_mask, tmpsh[s]);
                }
                if (max_mask <= NEG_FLT_MAX_OVER_2) {
                    continue;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSK_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSK_pad / 4);
                uint32_t c = (idx + tid) / (HSK_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSK_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                    uint32_t kcol;
                    bool kv_active = fa_kv_index(j * Bc + c, kcol);
                    if (kv_active && (HSK == HSK_pad || d < HSK / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_K) {
                            uint coord = kcol * k_stride * BLOCK_SIZE_K + 4 * d;
                            uint ib = coord / BLOCK_SIZE_K;
                            uint iqs = (coord % BLOCK_SIZE_K);
                            K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                        } else
#endif
                        {
                            K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + kcol * k_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = K_Tf;
                }
            }
            barrier();
        }

        // K * Q^T -> S^T: Bc x HSK_pad * HSK_pad x Br -> Bc x Br
        // Bc split across workgroup (four subgroups), loop over HSK in chunks of 16: 16 x 16 * 16 x 16 -> 16 x 16
        // This is written transposed in order to allow for N being 8 if implementations need it
        coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> SfMat[q_tiles];
        [[unroll]] for (uint32_t q = 0; q < q_tiles; ++q) {
            SfMat[q] = coopmat<ACC_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
        }
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, MatBc, 16, gl_MatrixUseA> KMat;
        coopmat<FLOAT_TYPE, gl_ScopeSubgroup, 16, MatBr, gl_MatrixUseB> QMat;

        [[unroll]] for (uint32_t d = 0; d < d_tiles; ++d) {
            // If SHMEM_STAGING is set, a Bc * HSK_pad size tile of K is loaded to shmem
            // If not, K is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatBr size staging buffer.
            // If K is a quant type, then it is always staged for dequantization.
            if (SHMEM_STAGING == 0) {
            // For quants we always need to dequant into kvsh; for f16/bf16 we can load
            // directly from global memory when alignment / bounds allow it.
            const bool stage_k = USE_DECODE_K || KV_bounds_check || USE_SPARSE || d * 16 + 16 > HSK;
            if (stage_k) {
                barrier();
                [[unroll]] for (uint32_t idx = 0; idx < Bc * MatBr / 4; idx += gl_WorkGroupSize.x) {
                    uint32_t col_vec = (idx + tid) % (MatBr / 4);
                    uint32_t row = (idx + tid) / (MatBr / 4);
                    if (idx + tid < Bc * MatBr / 4) {
                        FLOAT_TYPEV4 K_Tf = FLOAT_TYPEV4(0);
                        uint32_t kcol;
                        bool kv_active = fa_kv_index(j * Bc + row, kcol);
                        if (kv_active && (HSK == HSK_pad || d * 16 + col_vec * 4 < HSK)) {
#if !defined(BFLOAT16)
                            if (USE_DECODE_K) {
                                uint coord = kcol * k_stride * BLOCK_SIZE_K + d * 16 + col_vec * 4;
                                uint ib = coord / BLOCK_SIZE_K;
                                uint iqs = (coord % BLOCK_SIZE_K);
                                K_Tf = dequantize4(ib, iqs, k_offset, BINDING_IDX_K);
                            } else
#endif
                            {
                                K_Tf = FLOAT_TYPEV4(data_kv4[k_offset / 4 + kcol * k_stride / 4 + d * 16 / 4 + col_vec]);
                            }
                        }

                        kvsh[row * kvsh_stride + col_vec] = K_Tf;
                    }
                }
                barrier();
            }

            if (stage_k) {
                uint coord = (gl_SubgroupID * MatBc) * kvsh_stride;
                coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
            } else {
                const uint coord = k_offset / 4 + (j * Bc + gl_SubgroupID * MatBc) * k_stride / 4 + d * 16 / 4;
                coopMatLoad(KMat, data_kv4, coord, k_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
            }
            } else {
                uint coord = (gl_SubgroupID * MatBc) * kvsh_stride + d * 16 / 4;
                coopMatLoad(KMat, kvsh, coord, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
            }

            [[unroll]] for (uint32_t q = 0; q < q_tiles; ++q) {
                if (Q_IN_REGS) {
                    SfMat[q] = coopMatMulAdd(KMat, Qreg[d * q_tiles + q], SfMat[q]);
                } else {
                    coopMatLoad(QMat, Qf, d * 16 / 4 + q * MatBr * qstride, qstride, gl_CooperativeMatrixLayoutColumnMajor);
                    SfMat[q] = coopMatMulAdd(KMat, QMat, SfMat[q]);
                }
            }
        }

        [[unroll]] for (uint32_t q = 0; q < q_tiles; ++q) {
            uint coord = gl_SubgroupID * MatBc * sfshstride + q * (MatBr / 4);
            coopMatStore(SfMat[q], sfsh, coord, sfshstride, gl_CooperativeMatrixLayoutRowMajor);
        }
        barrier();

        if (LOGIT_SOFTCAP) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    sfsh[c * sfshstride + r] = ACC_TYPEV4(p.logit_softcap * tanh(sfsh[c * sfshstride + r]));
                }
            }
            barrier();
        }

        if (MASK_ENABLE && mask_opt_bits != MASK_OPT_ALL_ZERO) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * Br / 4; idx += gl_WorkGroupSize.x) {
                uint32_t c = (idx + tid) / (Br / 4);
                uint32_t r = (idx + tid) % (Br / 4);
                if (idx + tid < Bc * Br / 4 || idx + gl_WorkGroupSize.x <= Bc * Br / 4) {
                    if (!KV_bounds_check || j * Bc + c < KV) {
                        // Mask nem1 bounds check is handled when loading masks
                        ACC_TYPEV4 masks = ACC_TYPEV4(mask_cache[idx / WorkGroupSize]);
                        ACC_TYPEV4 slopes = ACC_TYPEV4(slope[r * 4], slope[r * 4 + 1], slope[r * 4 + 2], slope[r * 4 + 3]);
                        sfsh[c * sfshstride + r] += slopes * masks;
                    }
                }
            }
            barrier();
        }

        float eMf[rows_per_thread];
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            const uint r_vec  = tile_row(r) / 4;
            const uint r_comp = tile_row(r) % 4;

            float rowmaxf = NEG_FLT_MAX_OVER_2;
            [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
                if (KV_bounds_check && j * Bc + c * cols_per_iter + col_tid >= KV) {
                    continue;
                }
                rowmaxf = max(rowmaxf, float(sfsh[r_vec + (c * cols_per_iter + col_tid) * sfshstride][r_comp]));
            }
            rowmaxf += FATTN_KQ_MAX_OFFSET;
            float Moldf = Mf[r];

            // Compute max across the row
            rowmaxf = subgroupMax(rowmaxf);

            // M = max(rowmax, Mold)
            // P = e^(S - M)
            // eM = e^(Mold - M)
            Mf[r] = max(rowmaxf, Moldf);
            eMf[r] = exp(Moldf - Mf[r]);

            Lf[r] = eMf[r]*Lf[r];
        }

        [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
            const uint d_local = d0 / threads_per_rowgroup;
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                Of[r][d_local] = O_TYPE(eMf[r]) * Of[r][d_local];
            }
        }

        // Calculate and store Pf in Psh
        [[unroll]] for (uint32_t c = 0; c < cols_per_thread; ++c) {
            const uint col = c * cols_per_iter + col_tid;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; r += 4) {
                const uint row = tile_row(r);
                if (KV_bounds_check && j * Bc + col >= KV) {
                    Psh[col * psh_stride + row / 4] = FLOAT_TYPEV4(0.0f);
                } else {
                    const vec4 mfvec = vec4(Mf[r], Mf[r + 1], Mf[r + 2], Mf[r + 3]);
                    const FLOAT_TYPEV4 Pf = FLOAT_TYPEV4(exp(vec4(sfsh[row / 4 + col * sfshstride]) - mfvec));
                    [[unroll]] for (uint32_t vec_idx = 0; vec_idx < 4; ++vec_idx) {
                        Lf[r + vec_idx] += Pf[vec_idx];
                    }
                    Psh[col * psh_stride + row / 4] = Pf;
                }
            }
        }

        if (SHMEM_STAGING != 0) {
            [[unroll]] for (uint32_t idx = 0; idx < Bc * HSV_pad / 4; idx += gl_WorkGroupSize.x) {
                uint32_t d = (idx + tid) % (HSV_pad / 4);
                uint32_t c = (idx + tid) / (HSV_pad / 4);
                if (idx + gl_WorkGroupSize.x <= Bc * HSV_pad / 4 || c < Bc) {
                    FLOAT_TYPEV4 V_Tf = FLOAT_TYPEV4(0);
                    uint32_t v_row;
                    bool kv_active = fa_kv_index(j * Bc + c, v_row);
                    if (kv_active && (HSV == HSV_pad || d < HSV / 4)) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            uint coord = v_row * v_stride * BLOCK_SIZE_V + 4 * d;
                            uint ib = coord / BLOCK_SIZE_V;
                            uint iqs = (coord % BLOCK_SIZE_V);
                            V_Tf = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            V_Tf = FLOAT_TYPEV4(data_vv4[v_offset / 4 + v_row * v_stride / 4 + d]);
                        }
                    }

                    kvsh[c * kvsh_stride + d] = V_Tf;
                }
            }
        }
        barrier();

        const uint num_hsv_tiles = (HSV + MatBc * row_split - 1) / (MatBc * row_split); // round up

        // Each subgroup handles HSV/4 columns
        [[unroll]] for (uint32_t hsv_tile = 0; hsv_tile < num_hsv_tiles; ++hsv_tile) {
            const uint hsv_offset = (hsv_tile * row_split + gl_SubgroupID) * 16;

            coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator> PVMat[q_tiles];
            [[unroll]] for (uint32_t q = 0; q < q_tiles; ++q) {
                PVMat[q] = coopmat<O_TYPE, gl_ScopeSubgroup, MatBc, MatBr, gl_MatrixUseAccumulator>(0);
            }

            // Preload V tiles for [Bc, 16 * num subgroups]
            const uint v_rows = Bc;
            const uint v_total = v_rows * v_cols;
            const uint v_loads_per_thread = v_total / gl_WorkGroupSize.x;

            // If SHMEM_STAGING is set, a Bc * HSV_pad size tile of V is loaded to shmem.
            // If not, V is loaded directly from global memory if aligned, otherwise
            // staged through a Bc * MatBr size staging buffer.
            // If V is a quant type, then it is always staged for dequantization.
            if (SHMEM_STAGING == 0) {
            // For quants we always preload via kvsh. For f16/bf16 we only preload when
            // alignment / bounds force it (otherwise we coopMatLoad direct from data_vv4).
            const bool stage_v = USE_DECODE_V || KV_bounds_check || USE_SPARSE;
            if (stage_v) {
                [[unroll]] for (uint32_t i = 0; i < v_loads_per_thread; ++i) {
                    const uint idx = i * gl_WorkGroupSize.x + tid;
                    const uint row = idx / v_cols;
                    const uint col = idx % v_cols;

                    uint32_t v_row;
                    bool kv_active = fa_kv_index(j * Bc + row, v_row);
                    const uint v_col = hsv_tile * MatBc * row_split + col * 4;

                    const uint coord = v_row * v_stride * BLOCK_SIZE_V + v_col;
                    const uint ib = coord / BLOCK_SIZE_V;
                    const uint iqs = coord % BLOCK_SIZE_V;

                    if (USE_SPARSE ? (kv_active && v_col < HSV) : (!KV_bounds_check || (v_row < KV && v_col < HSV))) {
#if !defined(BFLOAT16)
                        if (USE_DECODE_V) {
                            kvsh[row * vsh_stride + col] = dequantize4(ib, iqs, v_offset, BINDING_IDX_V);
                        } else
#endif
                        {
                            kvsh[row * vsh_stride + col] = data_vv4[(v_offset + v_row * v_stride + v_col) / 4];
                        }
                    } else {
                        kvsh[row * vsh_stride + col] = FLOAT_TYPEV4(0.0f);
                    }
                }
            }
            }
            barrier();

            const uint o_offset = gl_SubgroupID * MatBr / 4;

            if (hsv_offset < HSV_pad) {
                [[unroll]] for (uint32_t bc_chunk = 0; bc_chunk < Bc / MatBc; ++bc_chunk) {
                    if (SHMEM_STAGING == 0) {
                    if (!USE_DECODE_V && !KV_bounds_check && !USE_SPARSE) {
                        // F16/BF16 values can be loaded directly from global memory
                        const uint v_tile_row = j * Bc + bc_chunk * MatBc;
                        const uint v_tile_offset = v_offset / 4 + v_tile_row * v_stride / 4 + hsv_offset / 4;
                        coopMatLoad(QMat, data_vv4, v_tile_offset, v_stride / 4, gl_CooperativeMatrixLayoutRowMajor);
                    } else {
                        const uint v_tile_offset = bc_chunk * MatBr * v_cols + gl_SubgroupID * (MatBc / 4);
                        coopMatLoad(QMat, kvsh, v_tile_offset, vsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }
                    } else {
                        const uint v_tile_offset = bc_chunk * MatBc * kvsh_stride + (hsv_tile * row_split + gl_SubgroupID) * (MatBc / 4);
                        coopMatLoad(QMat, kvsh, v_tile_offset, kvsh_stride, gl_CooperativeMatrixLayoutRowMajor);
                    }

                    [[unroll]] for (uint32_t q = 0; q < q_tiles; ++q) {
                        coopMatLoad(KMat, Psh, bc_chunk * MatBc * psh_stride + q * (MatBc / 4), psh_stride, gl_CooperativeMatrixLayoutColumnMajor);
                        PVMat[q] = coopMatMulAdd(KMat, QMat, PVMat[q]);
                    }
                }

                [[unroll]] for (uint32_t q = 0; q < q_tiles; ++q) {
                    coopMatStore(PVMat[q], sfsh, (o_offset + q * MatBc * osh_stride) / pv_per_acc, osh_stride / pv_per_acc, gl_CooperativeMatrixLayoutRowMajor);
                }
            }

            barrier();

            const uint hsv_per_tile = row_split * MatBc;
            const uint hsv_base = hsv_tile * hsv_per_tile;
            const uint d_values_per_tile = hsv_per_tile / 4;

            const uint d_start = hsv_tile * d_values_per_tile;
            const uint d_end = min(d_start + d_values_per_tile, HSV / 4);

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);

                [[unroll]] for (uint32_t d_local = 0; d_local < d_per_thread; ++d_local) {
                    const uint d = d_local * threads_per_rowgroup + col_tid;
                    const uint hsv_col = 4 * d;

                    if (hsv_col >= hsv_base && hsv_col < hsv_base + hsv_per_tile && hsv_col < HSV) {
                        const uint local_hsv = (hsv_col - hsv_base) / 4;
                        Of[r][d_local] += pvsh_load(row * osh_stride + local_hsv);
                    }
                }
            }
        }

        barrier();
    }

    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lf[r] = subgroupAdd(Lf[r]);
    }

    // If there is split_k, then the split_k resolve shader does the final
    // division by L. Store the intermediate O value and per-row m and L values.
    if (p.k_num > 1) {
        if (p.gqa_ratio > 1) {
            // note: O and Q have swapped coord 1,2.
            uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3)) / 4;

            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                if (tile_row(r) < N) {
                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        const uint d_local = d0 / threads_per_rowgroup;
                        gqaStore(tile_row(r), d, Of[r][d_local], o_offset, iq2, N);
                    }
                }
            }

            o_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (gqa_iq1 + p.ne2 * iq3));
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                if (tile_row(r) < N) {
                    perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Lf[r]), o_offset, iq2, N);
                    perElemOpStoreCol0(tile_row(r), 0u, ACC_TYPE(Mf[r]), o_offset + p.ne1, iq2, N);
                }
            }
        } else {
            [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
                const uint row = tile_row(r);
                const uint global_row = i * Br + row;

                if (global_row < N) {
                    uint32_t o_offset = HSV * p.ne1 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3)) / 4;

                    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                        const uint d = d0 + col_tid;
                        if (d >= HSV/4) break;
                        data_ov4[o_offset + iq2 * HSV/4 + d] = D_TYPEV4(Of[r][d/threads_per_rowgroup]);
                    }
                }

                if (global_row < N && col_tid == 0) {
                    uint32_t lm_offset = HSV * p.ne1 * p.k_num * p.ne2 * p.ne3 + p.ne1 * 2 * (split_k_index + p.k_num * (global_row + p.ne2 * iq3));
                    data_o[lm_offset + iq2] = D_TYPE(Lf[r]);
                    data_o[lm_offset + p.ne1 + iq2] = D_TYPE(Mf[r]);
                }
            }
        }

        return;
    }

    if ((p.mask_n_head_log2 & SINK_ENABLE_BIT) != 0) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            float sink = perElemOpGetSink(tile_row(r), 0u, ACC_TYPE(0), iq2);

            float ms = 1.0f;
            float vs = 1.0f;

            if (sink > Mf[r]) {
                ms = exp(Mf[r] - sink);

                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d_local = d0 / threads_per_rowgroup;
                    Of[r][d_local] *= O_TYPE(ms);
                }
            } else {
                vs = exp(sink - Mf[r]);
            }

            Lf[r] = Lf[r]*ms + vs;
        }
    }

    float Lfrcp[rows_per_thread];
    [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
        Lfrcp[r] = (Lf[r] == 0.0) ? 0.0 : (1.0 / Lf[r]);
    }

    [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
        const uint d_local = d0 / threads_per_rowgroup;
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            Of[r][d_local] *= O_TYPE(Lfrcp[r]);
#if defined(FLOAT_TYPE_MAX)
            Of[r][d_local] = clamp(Of[r][d_local], -FLOAT_TYPE_MAX, FLOAT_TYPE_MAX);
#endif
        }
    }

    uint32_t o_offset = (gqa_iq1*p.ne1*HSV + iq3*p.ne2*p.ne1*HSV) / 4;

    if (p.gqa_ratio > 1) {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (tile_row(r) < N) {
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    gqaStore(tile_row(r), d, Of[r][d_local], o_offset, iq2, N);
                }
            }
        }
    } else {
        [[unroll]] for (uint32_t r = 0; r < rows_per_thread; ++r) {
            if (i * Br + tile_row(r) < N) {
                [[unroll]] for (uint32_t d0 = 0; d0 < HSV / 4; d0 += threads_per_rowgroup) {
                    const uint d = d0 + col_tid;
                    if (d >= HSV / 4) break;
                    const uint d_local = d0 / threads_per_rowgroup;
                    data_ov4[o_offset + (iq2 * HSV + (i * Br + tile_row(r)) * p.ne1 * HSV) / 4 + d] = D_TYPEV4(Of[r][d_local]);
                }
            }
        }
    }
}
