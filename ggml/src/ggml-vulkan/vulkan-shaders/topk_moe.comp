#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

#include "types.glsl"

#define GATING_FUNC_SOFTMAX 0
#define GATING_FUNC_SIGMOID 1
#define GATING_FUNC_SOFTMAX_WEIGHT 2
#define GATING_FUNC_SQRT_SOFTPLUS 3

layout (push_constant) uniform parameter
{
    uint n_rows;
    uint n_experts_push;
    uint n_expert_used;
    float clamp_min;
    float clamp_max;
    uint gating_func;
    uint has_bias;
    uint with_norm;
    float output_scale;
    float output_bias;
};

layout(local_size_x_id = 0, local_size_y = 4, local_size_z = 1) in;

layout(constant_id = 0) const uint WARP_SIZE = 32;
layout(constant_id = 1) const uint n_experts_spec = 512;
layout(constant_id = 2) const bool nexperts_use_push = false;

uint n_experts = nexperts_use_push ? n_experts_push : n_experts_spec;

#define CEIL_DIV(a, b) (((a) + (b) - 1) / (b))

const uint experts_per_thread = CEIL_DIV(n_experts_spec, WARP_SIZE);

layout (binding = 0, std430) readonly buffer Logits {float logits[];};
layout (binding = 1, std430) readonly buffer BiasProbs {float bias[];};
layout (binding = 2, std430) writeonly buffer Weights {float weights[];};
layout (binding = 3, std430) writeonly buffer Ids {uint ids[];};

const float INFINITY = 1.0 / 0.0;

// Warp-local softmax used for both the pre-top-k logits and the post-top-k delayed path.
void softmax_warp_inplace(inout float vals[experts_per_thread], const uint limit, const uint lane, const bool use_limit) {
    float max_val = -INFINITY;

    [[unroll]]
    for (int i = 0; i < experts_per_thread; i++) {
        const uint idx       = lane + i * WARP_SIZE;
        const bool is_active = !use_limit || (idx < limit);
        if (is_active) {
            max_val = max(max_val, vals[i]);
        }
    }

    max_val = subgroupMax(max_val);

    float sum = 0.f;

    [[unroll]]
    for (int i = 0; i < experts_per_thread; i++) {
        const uint idx       = lane + i * WARP_SIZE;
        const bool is_active = !use_limit || (idx < limit);
        if (is_active) {
            const float val = exp(vals[i] - max_val);
            vals[i]         = val;
            sum += val;
        } else {
            vals[i] = 0.f;
        }
    }

    sum = subgroupAdd(sum);

    const float inv_sum = 1.0f / sum;

    [[unroll]]
    for (int i = 0; i < experts_per_thread; i++) {
        const uint idx       = lane + i * WARP_SIZE;
        const bool is_active = !use_limit || (idx < limit);
        if (is_active) {
            vals[i] *= inv_sum;
        }
    }
}

bool expert_precedes(const uvec3 a, const uvec3 b) {
    const float score_a = uintBitsToFloat(a.x);
    const float score_b = uintBitsToFloat(b.x);
    return score_a > score_b || (score_a == score_b && a.z < b.z);
}

uvec3 merge_expert_lanes(uvec3 a, const uint stride, const bool descending, const uint lane) {
    [[unroll]]
    for (uint mask = stride; mask > 0; mask /= 2) {
        const uvec3 b = subgroupShuffleXor(a, mask);
        const bool keep_first = descending == ((lane & mask) == 0);
        a = expert_precedes(b, a) == keep_first ? b : a;
    }
    return a;
}

shared uvec3 candidates[gl_WorkGroupSize.y * WARP_SIZE];

uvec3 sort_expert_lanes(uvec3 expert, const uint lane) {
    [[unroll]]
    for (uint size = 2; size <= WARP_SIZE; size *= 2) {
        expert = merge_expert_lanes(expert, size / 2, (lane & size) == 0, lane);
    }
    return expert;
}

bool sort_top_k(const float selection_probs[experts_per_thread], const float probs[experts_per_thread],
                const uint lane, const uint ids_offset, out float output_weights[experts_per_thread], inout float wt_sum) {
    const uvec3 empty = uvec3(floatBitsToUint(-INFINITY), 0, 0xffffffffu);
    uvec3 best = empty;
    uint nonfinite = 0;
    [[unroll]]
    for (uint i = 0; i < experts_per_thread; ++i) {
        const uint expert = i * WARP_SIZE + lane;
        if (expert < n_experts) {
            const float score = selection_probs[i];
            nonfinite |= uint(isnan(score) || isinf(score));
            const uvec3 candidate = uvec3(floatBitsToUint(score), 0, expert);
            if (expert_precedes(candidate, best)) {
                best = candidate;
            }
        }
    }
    if (subgroupOr(nonfinite) != 0) {
        return false;
    }

    // The Kth lane maximum is a lower bound for the Kth expert.
    best = sort_expert_lanes(best, lane);
    const uvec3 cutoff = subgroupShuffle(best, n_expert_used - 1);
    bool keep[experts_per_thread];
    uint count = 0;
    [[unroll]]
    for (uint i = 0; i < experts_per_thread; ++i) {
        const uint expert = i * WARP_SIZE + lane;
        const uvec3 candidate = uvec3(floatBitsToUint(selection_probs[i]), 0, expert);
        keep[i] = expert < n_experts && !expert_precedes(cutoff, candidate);
        count += uint(keep[i]);
    }
    const uint total = subgroupAdd(count);
    if (total > WARP_SIZE || total < n_expert_used) {
        return false;
    }

    const uint offset = gl_SubgroupID * WARP_SIZE;
    uint slot = offset + subgroupExclusiveAdd(count);
    [[unroll]]
    for (uint i = 0; i < experts_per_thread; ++i) {
        if (keep[i]) {
            candidates[slot++] = uvec3(floatBitsToUint(selection_probs[i]), floatBitsToUint(probs[i]), i * WARP_SIZE + lane);
        }
    }
    subgroupBarrier();

    const uvec3 expert = sort_expert_lanes(lane < total ? candidates[offset + lane] : empty, lane);
    output_weights[0] = lane < n_expert_used ? uintBitsToFloat(expert.y) : 0.f;
    [[unroll]]
    for (uint i = 1; i < experts_per_thread; ++i) {
        output_weights[i] = 0.f;
    }
    if (lane < n_expert_used) {
        ids[ids_offset + lane] = expert.z;
    }
    wt_sum = output_weights[0];
    return true;
}

void main() {
    const uint row = gl_WorkGroupID.x * gl_WorkGroupSize.y + gl_SubgroupID;
    if (row >= n_rows) {
        return;
    }

    const uint logits_offset = n_experts * row;
    const uint bias_offset = 0; // 1D
    const uint weights_offset = n_expert_used * row;
    const uint ids_offset = n_experts * row;
    const uint lane = gl_SubgroupInvocationID;

    float probs[experts_per_thread];
    [[unroll]]
    for (uint i = 0; i < experts_per_thread; ++i) {
        const uint expert = i * WARP_SIZE + lane;
        probs[i] = expert < n_experts ? logits[logits_offset + expert] : -INFINITY;
    }

    if (gating_func == GATING_FUNC_SOFTMAX) {
        softmax_warp_inplace(probs, n_experts, lane, nexperts_use_push);
    } else if (gating_func == GATING_FUNC_SIGMOID) {
        [[unroll]]
        for (uint i = 0; i < experts_per_thread; ++i) {
            const uint expert = i * WARP_SIZE + lane;
            if (expert < n_experts) {
                probs[i] = 1.f / (1.f + exp(-probs[i]));
            }
        }
    } else if (gating_func == GATING_FUNC_SQRT_SOFTPLUS) {
        [[unroll]]
        for (uint i = 0; i < experts_per_thread; ++i) {
            const uint expert = i * WARP_SIZE + lane;
            if (expert < n_experts) {
                const float val = probs[i];
                probs[i] = sqrt(val > 20.0f ? val : log(1.0f + exp(val)));
            }
        }
    }

    float selection_probs[experts_per_thread];
    if (has_bias != 0) {
        [[unroll]]
        for (uint i = 0; i < experts_per_thread; ++i) {
            const uint expert = i * WARP_SIZE + lane;
            selection_probs[i] = expert < n_experts ? probs[i] + bias[bias_offset + expert] : -INFINITY;
        }
    } else {
        [[unroll]]
        for (int i = 0; i < experts_per_thread; i++) {
            selection_probs[i] = probs[i];
        }
    }

    float wt_sum = 0.f;

    float output_weights[experts_per_thread];

    bool sorted = false;
    if (WARP_SIZE == 32 && n_experts_spec <= 1024 && n_expert_used >= WARP_SIZE / 4 && n_expert_used <= WARP_SIZE / 2) {
        sorted = sort_top_k(selection_probs, probs, lane, ids_offset, output_weights, wt_sum);
    }
    if (!sorted) {
        [[unroll]]
        for (int i = 0; i < experts_per_thread; i++) {
            output_weights[i] = 0.f;
        }
    }

    const uint n_rounds = sorted ? 0u : n_expert_used;
    for (uint k = 0; k < n_rounds; ++k) {
        float max_val    = probs[0];
        float max_val_s  = selection_probs[0];
        uint   max_expert = lane;

        [[unroll]]
        for (uint i = 1; i < experts_per_thread; ++i) {
            const uint expert = i * WARP_SIZE + lane;
            if (expert < n_experts && selection_probs[i] > max_val_s) {
                max_val    = probs[i];
                max_val_s  = selection_probs[i];
                max_expert = expert;
            }
        }

        [[unroll]]
        for (uint mask = WARP_SIZE / 2; mask > 0; mask /= 2) {
            const float val_s  = subgroupShuffleXor(max_val_s, mask);
            const uint  expert = subgroupShuffleXor(max_expert, mask);
            if (val_s > max_val_s || (val_s == max_val_s && expert < max_expert)) {
                max_val_s  = val_s;
                max_expert = expert;
            }
        }

        const uint winner_lane = max_expert & (WARP_SIZE - 1);
        max_val = subgroupShuffle(max_val, winner_lane);

        // Static array indices let the compiler keep the values in registers.
        [[unroll]]
        for (uint i = 0; i < experts_per_thread; ++i) {
            if (k / WARP_SIZE == i && (k & (WARP_SIZE - 1)) == lane) {
                output_weights[i] = max_val;
            }
        }

        if (lane == winner_lane) {
            ids[ids_offset + k] = max_expert;
            wt_sum += max_val;

            [[unroll]]
            for (uint i = 0; i < experts_per_thread; ++i) {
                if (max_expert == i * WARP_SIZE + lane) {
                    selection_probs[i] = -INFINITY;
                }
            }
        }
    }

    if (with_norm != 0) {
        wt_sum              = subgroupAdd(wt_sum);
        wt_sum              = clamp(wt_sum, clamp_min, clamp_max);
        const float inv_sum = 1.0f / wt_sum;

        [[unroll]]
        for (uint i = 0; i < experts_per_thread; ++i) {
            output_weights[i] *= inv_sum;
        }
    }

    if (gating_func == GATING_FUNC_SOFTMAX_WEIGHT) {
        softmax_warp_inplace(output_weights, n_expert_used, lane, true);
    }

    [[unroll]]
    for (uint i = 0; i < experts_per_thread; ++i) {
        uint idx = i * WARP_SIZE + lane;
        if (idx < n_expert_used) {
            weights[weights_offset + idx] = output_scale * output_weights[i] + output_bias;
        }
    }
}