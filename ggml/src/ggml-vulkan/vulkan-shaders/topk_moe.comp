#version 450

#extension GL_EXT_control_flow_attributes : require
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_arithmetic : enable
#extension GL_KHR_shader_subgroup_shuffle : enable

#include "types.glsl"

#define GATING_FUNC_SOFTMAX 0
#define GATING_FUNC_SIGMOID 1
#define GATING_FUNC_SOFTMAX_WEIGHT 2
#define GATING_FUNC_SQRT_SOFTPLUS 3

layout (push_constant) uniform parameter
{
    uint n_rows;
    uint n_experts_push;
    uint n_expert_used;
    float clamp_min;
    float clamp_max;
    uint gating_func;
    uint has_bias;
    uint with_norm;
    float output_scale;
    float output_bias;
};

layout(local_size_x_id = 0, local_size_y = 4, local_size_z = 1) in;

layout(constant_id = 0) const uint WARP_SIZE = 32;
layout(constant_id = 1) const uint n_experts_spec = 512;
layout(constant_id = 2) const bool nexperts_use_push = false;

uint n_experts = nexperts_use_push ? n_experts_push : n_experts_spec;

#define CEIL_DIV(a, b) (((a) + (b) - 1) / (b))

const uint n_tiles = CEIL_DIV(n_experts_spec, WARP_SIZE);

layout (binding = 0, std430) readonly buffer Logits { float logits[]; };
layout (binding = 1, std430) readonly buffer BiasProbs { float bias[]; };
layout (binding = 2, std430) writeonly buffer Weights { float weights[]; };
layout (binding = 3, std430) writeonly buffer Ids { uint ids[]; };

const float INFINITY = 1.0 / 0.0;

void softmax_warp_inplace
    (
    inout float vals[n_tiles],
    const uint limit,
    const uint lane,
    const bool use_limit
    )

{
    float max_val = -INFINITY;

    [[unroll]]
    for (uint i = 0; i < n_tiles; ++i)
    {
        const uint idx = lane + i * WARP_SIZE;
        if (!use_limit || idx < limit) {max_val = max(max_val, vals[i]);}
    }

    max_val = subgroupMax(max_val);
    float sum = 0.0f;

    [[unroll]]
    for (uint i = 0; i < n_tiles; ++i)
    {
        const uint idx = lane + i * WARP_SIZE;
        if (!use_limit || idx < limit) {
            const float val = exp(vals[i] - max_val);
            vals[i] = val;
            sum += val;
        } else {
            vals[i] = 0.0f;
        }
    }

    sum = subgroupAdd(sum);
    const float inv_sum = 1.0f / sum;

    [[unroll]]
    for (uint i = 0; i < n_tiles; ++i)
    {
        const uint idx = lane + i * WARP_SIZE;
        if (!use_limit || idx < limit) {
            vals[i] *= inv_sum;
        }
    }
}

bool expert_precedes(const uvec3 a, const uvec3 b) {
    const float score_a = uintBitsToFloat(a.x);
    const float score_b = uintBitsToFloat(b.x);
    return score_a > score_b || (score_a == score_b && a.z < b.z);
}

uvec3 merge_expert_lanes(uvec3 a, const uint stride, const bool descending, const uint lane) {
    [[unroll]] for (uint mask = stride; mask > 0; mask /= 2) {
        const uvec3 b = subgroupShuffleXor(a, mask);
        const bool keep_first = descending == ((lane & mask) == 0);
        a = expert_precedes(b, a) == keep_first ? b : a;
    }
    return a;
}

bool sort_all_experts(
    const float scores[n_tiles],
    const float probs[n_tiles],
    const uint lane,
    const uint ids_offset,
    out float out_weights[n_tiles]) {
    // Each entry holds the selection score, weight and expert ID.
    uvec3 experts[n_tiles];
    uint nonfinite = 0;
    [[unroll]] for (uint i = 0; i < n_tiles; ++i) {
        const float score = scores[i];
        nonfinite |= uint(isnan(score) || isinf(score));
        experts[i] = uvec3(floatBitsToUint(score), floatBitsToUint(probs[i]), i * WARP_SIZE + lane);
    }
    if (subgroupOr(nonfinite) != 0) {
        return false;
    }

    if (WARP_SIZE == 32) {
        // Keep each tile in registers across the lane exchanges.
        [[unroll]] for (uint i = 0; i < n_tiles; ++i) {
            const uint pos = i * WARP_SIZE + lane;
            uvec3 a = experts[i];
            [[unroll]] for (uint size = 2; size <= WARP_SIZE; size *= 2) {
                a = merge_expert_lanes(a, size / 2, (pos & size) == 0, lane);
            }
            experts[i] = a;
        }

        [[unroll]] for (uint size = WARP_SIZE * 2; size <= n_experts_spec; size *= 2) {
            [[unroll]] for (uint tile_mask = size / (2 * WARP_SIZE); tile_mask > 0; tile_mask /= 2) {
                [[unroll]] for (uint i = 0; i < n_tiles; ++i) {
                    if ((i & tile_mask) != 0) {
                        continue;
                    }
                    const uint peer = i ^ tile_mask;
                    const uvec3 a = experts[i];
                    const uvec3 b = experts[peer];
                    const bool descending = ((i * WARP_SIZE) & size) == 0;
                    if (expert_precedes(b, a) == descending) {
                        experts[i] = b;
                        experts[peer] = a;
                    }
                }
            }

            [[unroll]] for (uint i = 0; i < n_tiles; ++i)
            {
                const bool descending = ((i * WARP_SIZE) & size) == 0;
                experts[i] = merge_expert_lanes(experts[i], WARP_SIZE / 2, descending, lane);
            }

        }
    } else {
        for (uint size = 2; size <= n_experts_spec; size *= 2) {
            for (uint stride = size / 2; stride > 0; stride /= 2) {
                const uint tile_mask = stride / WARP_SIZE;
                [[unroll]] for (uint i = 0; i < n_tiles; ++i) {
                    if ((i & tile_mask) != 0) { continue; }

                    const uint peer = i ^ tile_mask;
                    const uvec3 a = experts[i];
                    uvec3 b;
                    if (tile_mask != 0) {
                        b = experts[peer];
                    } else if (n_experts_spec <= 256 && has_bias == 0) {
                        // Without bias the score also carries the weight.
                        const uvec2 key = subgroupShuffleXor(a.xz, stride);
                        b = uvec3(key.x, key.x, key.y);
                    } else {
                        b = subgroupShuffleXor(a, stride);
                    }
                    const bool b_first = expert_precedes(b, a);
                    const uint pos = i * WARP_SIZE + lane;
                    const bool keep_first = ((pos & size) == 0) == ((pos & stride) == 0);

                    if (b_first == keep_first) {
                        experts[i] = b;
                        if (tile_mask != 0) { experts[peer] = a; }
                    }
                }
            }
        }
    }

    [[unroll]] for (uint i = 0; i < n_tiles; ++i)
    {
        out_weights[i] = uintBitsToFloat(experts[i].y);
        ids[ids_offset + i * WARP_SIZE + lane] = experts[i].z;
    }
    return true;
}

void main()
{
    const uint row = gl_WorkGroupID.x * gl_WorkGroupSize.y + gl_SubgroupID;
    if (row >= n_rows) {return;}

    const uint logits_offset = n_experts * row;
    const uint weights_offset = n_expert_used * row;
    // Preserve the original IDs layout: n_experts elements per row, not Top-K per row.
    const uint ids_offset = n_experts * row;
    const uint lane = gl_SubgroupInvocationID;

    float probs[n_tiles];

    [[unroll]]
    for (uint tile = 0; tile < n_tiles; ++tile)
    {
        const uint expert = tile * WARP_SIZE + lane;
        probs[tile] = expert < n_experts
            ? logits[logits_offset + expert]
            : -INFINITY;
    }

    if (gating_func == GATING_FUNC_SOFTMAX)
    {
        softmax_warp_inplace(probs, n_experts, lane, nexperts_use_push);

    } else if (gating_func == GATING_FUNC_SIGMOID) {
        [[unroll]]
        for (uint tile = 0; tile < n_tiles; ++tile)
        {
            const uint expert = tile * WARP_SIZE + lane;
            if (expert < n_experts) {
                probs[tile] = 1.0f / (1.0f + exp(-probs[tile]));
            }
        }
    } else if (gating_func == GATING_FUNC_SQRT_SOFTPLUS) {
        [[unroll]]
        for (uint tile = 0; tile < n_tiles; ++tile)
        {
            const uint expert = tile * WARP_SIZE + lane;
            if (expert < n_experts) {
                const float val = probs[tile];
                probs[tile] = sqrt(val > 20.0f ? val : log(1.0f + exp(val)));
            }
        }
    }

    float scores[n_tiles];

    if (has_bias != 0) {
        [[unroll]]
        for (uint tile = 0; tile < n_tiles; ++tile) {
            const uint expert = tile * WARP_SIZE + lane;
            scores[tile] = expert < n_experts
                ? probs[tile] + bias[expert]
                : -INFINITY;
        }
    } else {
        [[unroll]]
        for (uint tile = 0; tile < n_tiles; ++tile) {
            scores[tile] = probs[tile];
        }
    }

    float weight_sum = 0.0f;
    float out_weights[n_tiles];

    const bool sorted = !nexperts_use_push && n_expert_used == n_experts_spec &&
                        n_experts_spec >= WARP_SIZE && with_norm == 0 &&
                        sort_all_experts(scores, probs, lane, ids_offset, out_weights);
    if (!sorted) {
        [[unroll]] for (uint i = 0; i < n_tiles; ++i) {
            out_weights[i] = 0.0f;
        }
    }

    const uint n_rounds = sorted ? 0u : n_expert_used;
    for (uint k = 0; k < n_rounds; ++k) {
        // Per-lane winner. Static array indices keep these values in registers.
        float best_weight = probs[0];
        float best_score = scores[0];
        uint best_id = lane;

        [[unroll]]
        for (uint tile = 1; tile < n_tiles; ++tile) {
            const uint expert = tile * WARP_SIZE + lane;
            if (expert < n_experts && scores[tile] > best_score) {
                best_weight = probs[tile];
                best_score = scores[tile];
                best_id = expert;
            }
        }

        // Reduce the score and ID before fetching the winner's weight.
        float score = best_score;
        uint id = best_id;

        [[unroll]]
        for (uint mask = WARP_SIZE / 2u; mask > 0u; mask /= 2u) {
            const float other_score = subgroupShuffleXor(score, mask);
            const uint other_id = subgroupShuffleXor(id, mask);
            if (other_score > score || (other_score == score && other_id < id)) {
                score = other_score;
                id = other_id;
            }
        }

        const uint winner_lane = id & (WARP_SIZE - 1u);
        const float weight = subgroupShuffle(best_weight, winner_lane);

        // k is a runtime value, so use predicated static writes instead of
        // dynamically indexing a register array.
        [[unroll]]
        for (uint i = 0; i < n_tiles; ++i) {
            if (k / WARP_SIZE == i && (k & (WARP_SIZE - 1u)) == lane) {
                out_weights[i] = weight;
            }
        }

        if (lane == winner_lane) {
            ids[ids_offset + k] = id;
            weight_sum += weight;

            // Static indices avoid spilling scores to local memory.
            [[unroll]]
            for (uint tile = 0; tile < n_tiles; ++tile) {
                if (id == tile * WARP_SIZE + lane) {
                    scores[tile] = -INFINITY;
                }
            }
        }
    }

    if (with_norm != 0) {
        weight_sum = subgroupAdd(weight_sum);
        weight_sum = clamp(weight_sum, clamp_min, clamp_max);
        const float inv_sum = 1.0f / weight_sum;

        [[unroll]]
        for (uint i = 0; i < n_tiles; ++i) {
            out_weights[i] *= inv_sum;
        }
    }

    if (gating_func == GATING_FUNC_SOFTMAX_WEIGHT) {
        softmax_warp_inplace(out_weights, n_expert_used, lane, true);
    }

    // Coalesced stores for the expert weights.
    [[unroll]]
    for (uint i = 0; i < n_tiles; ++i) {
        const uint idx = i * WARP_SIZE + lane;
        if (idx < n_expert_used) {
            weights[weights_offset + idx] = output_scale * out_weights[i] + output_bias;
        }
    }
}
