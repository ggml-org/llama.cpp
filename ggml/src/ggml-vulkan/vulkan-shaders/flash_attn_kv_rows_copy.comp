#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout (binding = 0) readonly buffer A {uvec4 data_a[];};
layout (binding = 1) writeonly buffer D {uvec4 data_d[];};
layout (binding = 2) readonly buffer R {int data_rows[];};

layout (push_constant) uniform parameter {
    uint head_size;
    uint n_heads;
    uint n_cols;
    uint n_cache_rows;
    uint n_elements;
} p;

void main() {
    const uint i = gl_GlobalInvocationID.x;
    if (i >= p.n_elements / 8) {
        return;
    }

    const uint head_vecs = p.head_size / 8;
    const uint d = i % head_vecs;
    const uint head = (i / head_vecs) % p.n_heads;
    const uint list_idx = i / (head_vecs * p.n_heads);
    const uint row = uint(data_rows[list_idx]);
    const uint dst = ((list_idx / p.n_cols * p.n_heads + head) * p.n_cols + list_idx % p.n_cols) * head_vecs + d;
    data_d[dst] = row < p.n_cache_rows ? data_a[(row * p.n_heads + head) * head_vecs + d] : uvec4(0);
}
