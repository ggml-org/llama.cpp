#version 450
#extension GL_EXT_shader_explicit_arithmetic_types_int32 : require

#include "mul_mat_vec_base.glsl"
#include "dequant_funcs.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

FLOAT_TYPE temp[NUM_COLS][NUM_ROWS];

// TQ1_0 ternary: 5 trits per byte in qs[48] + 4 trits per byte in qh[4].
// w = (xi - 1) * d where xi = ((byte * pow3[l]) & 0xFF * 3) >> 8
// sum = d * sum_e (xi_e - 1) * b_e = d * (sum_e xi_e * b_e - sum_e b_e)
void calc_superblock(const uint a_offset, const uint b_offset, const uint v_im,
                     const uint q_offset, const uint y_offset, const uint i,
                     const uint num_blocks_per_row, const uint first_row,
                     const uint num_rows) {
    if (i >= num_blocks_per_row) return;

    [[unroll]] for (uint n = 0; n < num_rows; ++n) {
        const uint ib0 = a_offset + (first_row + n) * num_blocks_per_row;
        const FLOAT_TYPE d = FLOAT_TYPE(data_a[ib0 + i].d);
        const uint y_idx = i * QUANT_K + y_offset;

        [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
            FLOAT_TYPE sumq = FLOAT_TYPE(0.0);
            FLOAT_TYPE sumb = FLOAT_TYPE(0.0);

            // Process 16 elements (y_offset..y_offset+15)
            [[unroll]] for (uint e = 0; e < 16; ++e) {
                uint idx = y_offset + e;
                FLOAT_TYPE b = FLOAT_TYPE(data_b[j * p.batch_stride_b + b_offset + i * QUANT_K + idx]);
                uint byte_val, trit;
                if (idx < 160u) {
                    byte_val = uint(data_a[ib0 + i].qs[idx % 32u]);
                    trit = idx / 32u;
                } else if (idx < 240u) {
                    uint loc = idx - 160u;
                    byte_val = uint(data_a[ib0 + i].qs[32u + loc % 16u]);
                    trit = loc / 16u;
                } else {
                    uint loc = idx - 240u;
                    byte_val = uint(data_a[ib0 + i].qh[loc % 4u]);
                    trit = loc / 4u;
                }
                uint p3 = (trit == 0u) ? 1u : (trit == 1u) ? 3u : (trit == 2u) ? 9u : (trit == 3u) ? 27u : 81u;
                uint q = (byte_val * p3) & 0xFFu;
                uint xi = (q * 3u) >> 8u;
                sumq = fma(FLOAT_TYPE(int(xi)), b, sumq);
                sumb += b;
            }
            temp[j][n] = fma(d, sumq - sumb, temp[j][n]);
        }
    }
}

void compute_outputs(const uint32_t first_row, const uint32_t num_rows) {
    uint a_offset, b_offset, d_offset;
    get_offsets(a_offset, b_offset, d_offset);

    const uint num_blocks_per_row = p.ncols / QUANT_K;

    // 16 threads per block, each processes 16 elements
    const uint it_size = gl_WorkGroupSize.x / 16;
    const uint tid = gl_LocalInvocationID.x;
    const uint itid = tid % 16;
    const uint ix = tid / 16;

    const uint y_offset = itid * 16;

    [[unroll]] for (uint j = 0; j < NUM_COLS; ++j) {
        [[unroll]] for (uint i = 0; i < NUM_ROWS; ++i) {
            temp[j][i] = FLOAT_TYPE(0);
        }
    }

    for (uint i0 = 0; i0 < num_blocks_per_row; i0 += it_size)
        calc_superblock(a_offset, b_offset, 0, 0, y_offset, i0 + ix, num_blocks_per_row, first_row, num_rows);

    reduce_result(temp, d_offset, first_row, num_rows, tid);
}

void main() {
    const uint first_row = NUM_ROWS * (gl_WorkGroupID.x + gl_NumWorkGroups.x * gl_WorkGroupID.z);

    if (first_row + NUM_ROWS <= p.stride_d) {
        compute_outputs(first_row, NUM_ROWS);
    } else {
        if (first_row >= p.stride_d) {
            return;
        }
        compute_outputs(first_row, p.stride_d - first_row);
    }
}
