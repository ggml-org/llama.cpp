#version 450

#include "types.glsl"

#if defined(SET_ROWS) && QUANT_K == 1
layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 512;
#else
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 32;
#endif

layout (binding = 0) readonly buffer S {S_TYPE data_s[];};

#if defined(SET_ROWS)
#include "generic_binary_head.glsl"
layout (binding = 1) readonly buffer C {B_TYPE data_i[];};
layout (binding = 2) writeonly buffer Q {A_TYPE data_q[];};

#if B_SIZE == 64
#define DATA_I_SWIZZLE .x
#else
#define DATA_I_SWIZZLE
#endif

#else
#include "generic_unary_head.glsl"
layout (binding = 1) writeonly buffer Q {A_TYPE data_q[];};
#endif

#if defined(DATA_A_Q2_0) || defined(DATA_A_Q4_0) || defined(DATA_A_Q5_0)
// round like the CPU reference: a correctly rounded 1/d (Vulkan only guarantees ~2.5 ulp for a divide, so pick the
// quotient or a neighbour by the smallest exact residual 1 - d*y, from an fma-free Dekker product), and precise to
// keep x*id + c from fusing
float recip_residual(float d, float y) {
    precise const float p  = d * y;
    precise const float cd = 4097.0 * d;
    precise const float dh = cd - (cd - d);
    precise const float dl = d - dh;
    precise const float cy = 4097.0 * y;
    precise const float yh = cy - (cy - y);
    precise const float yl = y - yh;
    precise const float e  = ((dh * yh - p) + dh * yl + dl * yh) + dl * yl; // d*y = p + e exactly
    precise const float r  = (1.0 - p) - e;
    return abs(r);
}

float recip_rn(float d) {
    precise const float y  = 1.0 / d;
    precise const float lo = uintBitsToFloat(floatBitsToUint(y) - 1u);
    precise const float hi = uintBitsToFloat(floatBitsToUint(y) + 1u);
    const float e  = recip_residual(d, y);
    const float el = recip_residual(d, lo);
    const float eh = recip_residual(d, hi);
    return el < e && el <= eh ? lo : (eh < e ? hi : y);
}
#endif

#if defined(DATA_A_Q4_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_0; ++j) {
        const float v = float(data_s[src_idx + j]);
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    const float d  = vmax * -0.125; // exact, same as the CPU's vmax / -8 (a GPU divide may not be)
    const float id = (d != 0.0) ? recip_rn(d) : 0.0;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_0/2; ++j) {
        // the min() is a no-op that keeps drivers from fusing x*id + c into an fma (Mesa ANV and llvmpipe fuse despite precise)
        precise const float x0 = min(float(data_s[src_idx + 0              + j])*id, 3.0e38);
        precise const float x1 = min(float(data_s[src_idx + QUANT_K_Q4_0/2 + j])*id, 3.0e38);
        precise const float y0 = x0 + 8.5;
        precise const float y1 = x1 + 8.5;

        const uint xi0 = min(15, int(y0));
        const uint xi1 = min(15, int(y1));

        data_q[dst_idx].qs[j]  = uint8_t(xi0 | (xi1 << 4));
    }
}
#endif

#if defined(DATA_A_Q4_1)
void quantize(uint dst_idx, uint src_idx)
{
    float vmin = 1.0/0.0;
    float vmax = -vmin;

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_1; ++j) {
        const float v = float(data_s[src_idx + j]);

        if (v < vmin) vmin = v;
        if (v > vmax) vmax = v;
    }

    const float d  = (vmax - vmin) / ((1 << 4) - 1);
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);
    data_q[dst_idx].m = float16_t(vmin);

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_1/2; ++j) {
        const float x0 = (float(data_s[src_idx + 0              + j]) - vmin)*id;
        const float x1 = (float(data_s[src_idx + QUANT_K_Q4_1/2 + j]) - vmin)*id;

        const uint xi0 = min(15, int(x0 + 0.5));
        const uint xi1 = min(15, int(x1 + 0.5));

        data_q[dst_idx].qs[j]  = uint8_t(xi0 | (xi1 << 4));
    }
}
#endif

#if defined(DATA_A_Q5_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_Q5_0; ++j) {
        const float v = float(data_s[src_idx + j]);
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    const float d  = vmax * -0.0625; // exact, same as the CPU's vmax / -16
    const float id = (d != 0.0) ? recip_rn(d) : 0.0;

    data_q[dst_idx].d = float16_t(d);

    uint32_t qh = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_Q5_0/2; ++j) {
        // the min() is a no-op that keeps drivers from fusing x*id + c into an fma (Mesa ANV and llvmpipe fuse despite precise)
        precise const float x0 = min(float(data_s[src_idx + 0              + j])*id, 3.0e38);
        precise const float x1 = min(float(data_s[src_idx + QUANT_K_Q5_0/2 + j])*id, 3.0e38);
        precise const float y0 = x0 + 16.5;
        precise const float y1 = x1 + 16.5;

        const uint xi0 = min(31, int(y0));
        const uint xi1 = min(31, int(y1));

        data_q[dst_idx].qs[j]  = uint8_t((xi0 & 0xf) | ((xi1 & 0xf) << 4));
        qh |= ((xi0 & 0x10u) >> 4) << (j + 0);
        qh |= ((xi1 & 0x10u) >> 4) << (j + QUANT_K_Q5_0/2);
    }
    data_q[dst_idx].qh[0] = uint16_t(qh & 0xFFFF);
    data_q[dst_idx].qh[1] = uint16_t(qh >> 16);
}
#endif

#if defined(DATA_A_Q5_1)
void quantize(uint dst_idx, uint src_idx)
{
    float min = float(data_s[src_idx + 0]);
    float max = min;

    [[unroll]] for (int j = 1; j < QUANT_K_Q5_1; ++j) {
        const float v = float(data_s[src_idx + j]);
        min = v < min ? v : min;
        max = v > max ? v : max;
    }

    const float d  = (max - min) / 31;
    const float id = (d != 0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);
    data_q[dst_idx].m = float16_t(min);

    uint32_t qh = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_Q5_1/2; ++j) {
        const float x0 = (float(data_s[src_idx + 0              + j]) - min)*id;
        const float x1 = (float(data_s[src_idx + QUANT_K_Q5_1/2 + j]) - min)*id;

        const uint xi0 = uint(x0 + 0.5);
        const uint xi1 = uint(x1 + 0.5);

        data_q[dst_idx].qs[j]  = uint8_t((xi0 & 0xf) | ((xi1 & 0xf) << 4));
        qh |= ((xi0 & 0x10u) >> 4) << (j + 0);
        qh |= ((xi1 & 0x10u) >> 4) << (j + QUANT_K_Q5_1/2);
    }
    data_q[dst_idx].qh = qh;
}
#endif

#if defined(DATA_A_Q8_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0; // absolute max

    [[unroll]] for (int j = 0; j < QUANT_K_Q8_0; j++) {
        const float v = float(data_s[src_idx + j]);
        amax = max(amax, abs(v));
    }

    const float d = amax / ((1 << 7) - 1);
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q8_0; ++j) {
        const float x0 = float(data_s[src_idx + j])*id;

        data_q[dst_idx].qs[j] = int8_t(round(x0));
    }
}
#endif

#if defined(DATA_A_Q1_0)
void quantize(uint dst_idx, uint src_idx)
{
    float sum_abs = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_Q1_0; j++) {
        sum_abs += abs(float(data_s[src_idx + j]));
    }

    const float d = sum_abs / QUANT_K_Q1_0;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q1_0 / 8; ++j) {
        data_q[dst_idx].qs[j] = uint8_t(0);
    }

    [[unroll]] for (int j = 0; j < QUANT_K_Q1_0; ++j) {
        if (float(data_s[src_idx + j]) >= 0.0) {
            data_q[dst_idx].qs[j / 8] |= uint8_t(1 << (j % 8));
        }
    }
}
#endif

#if defined(DATA_A_Q2_0)
uint quantize_q2_0(float x)
{
    // exact roundf (half away from zero): floor(x + 0.5f) carries for x = 0.5 - 2^-25
    precise const float t = trunc(x);
    const int q = int(abs(x - t) >= 0.5f ? t + sign(x) : t) + 1;
    return uint(clamp(q, 0, 3));
}

void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0f;

    [[unroll]] for (int j = 0; j < QUANT_K_Q2_0; ++j) {
        amax = max(amax, abs(float(data_s[src_idx + j])));
    }

    const float d = amax;
    const float id = d != 0.0f ? recip_rn(d) : 0.0f;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q2_0 / 4; ++j) {
        precise const float v0 = float(data_s[src_idx + 4*j    ]) * id;
        precise const float v1 = float(data_s[src_idx + 4*j + 1]) * id;
        precise const float v2 = float(data_s[src_idx + 4*j + 2]) * id;
        precise const float v3 = float(data_s[src_idx + 4*j + 3]) * id;
        const uint q0 = quantize_q2_0(v0);
        const uint q1 = quantize_q2_0(v1);
        const uint q2 = quantize_q2_0(v2);
        const uint q3 = quantize_q2_0(v3);
        data_q[dst_idx].qs[j] = uint8_t(q0 | (q1 << 2u) | (q2 << 4u) | (q3 << 6u));
    }
}
#endif

#if defined(DATA_A_IQ4_NL)
uint best_index(float x) {
    if (x <= kvalues_iq4nl[0]) return 0;
    if (x >= kvalues_iq4nl[15]) return 15;
    int ml = 0, mu = 15;
    while (mu-ml > 1) {
        int mav = (ml+mu)/2;
        if (x < kvalues_iq4nl[mav]) mu = mav; else ml = mav;
    }
    return x - kvalues_iq4nl[mu-1] < kvalues_iq4nl[mu] - x ? mu-1 : mu;
}

void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_IQ4_NL; ++j) {
        const float v = float(data_s[src_idx + j]);
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    float d = vmax / kvalues_iq4nl[0];
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    float sumqx = 0, sumq2 = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_IQ4_NL/2; ++j) {
        const float x0 = float(data_s[src_idx + 0                + j])*id;
        const float x1 = float(data_s[src_idx + QUANT_K_IQ4_NL/2 + j])*id;
        const uint xi0 = best_index(x0);
        const uint xi1 = best_index(x1);
        data_q[dst_idx].qs[j] = uint8_t(xi0 | (xi1 << 4));
        const float v0 = kvalues_iq4nl[xi0];
        const float v1 = kvalues_iq4nl[xi1];
        const float w0 = float(data_s[src_idx + 0                + j])*float(data_s[src_idx + 0                + j]);
        const float w1 = float(data_s[src_idx + QUANT_K_IQ4_NL/2 + j])*float(data_s[src_idx + QUANT_K_IQ4_NL/2 + j]);
        sumqx += w0*v0*float(data_s[src_idx + j]) + w1*v1*float(data_s[src_idx + QUANT_K_IQ4_NL/2 + j]);
        sumq2 += w0*v0*v0 + w1*v1*v1;
    }

    data_q[dst_idx].d = float16_t(sumq2 > 0 ? sumqx/sumq2 : d);

}
#endif

#if defined(DATA_A_F32) || defined(DATA_A_F16)
void quantize(uint dst_idx, uint src_idx)
{
    data_q[dst_idx] = A_TYPE(float(data_s[src_idx]));
}
#endif

#if defined(DATA_A_BF16)
void quantize(uint dst_idx, uint src_idx)
{
    data_q[dst_idx] = A_TYPE(fp32_to_bf16(float(data_s[src_idx])));
}
#endif

#if defined(SET_ROWS)

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    const uint idx = ((gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x) * BLOCK_SIZE + gl_LocalInvocationID.x) * QUANT_K;

    if (idx >= p.ne) {
        return;
    }

    uint i00, i01, i02, i03;
    get_indices(idx, i00, i01, i02, i03);

    uint i12 = fastmod(i03, p.ne12);
    uint i11 = fastmod(i02, p.ne11);
    uint i10 = i01;

    uint i1 = data_i[src1_idx(i10, i11, i12, 0) + get_boffset()] DATA_I_SWIZZLE;

    uint src0_idx = src0_idx(i00, i01, i02, i03) + get_aoffset();
    uint dst_idx = dst_idx(i00 / QUANT_K, i1, i02, i03) + get_doffset();

    quantize(dst_idx, src0_idx);
}

#else

void main() {
#ifdef NEEDS_INIT_IQ_SHMEM
    init_iq_shmem(gl_WorkGroupSize);
#endif

    const uint idx = (gl_WorkGroupID.z * 262144 + gl_WorkGroupID.y * 512 + gl_WorkGroupID.x * 32 + gl_LocalInvocationID.x) * QUANT_K;

    if (idx >= p.ne) {
        return;
    }

    uint dst_idx = dst_idx_quant(idx, QUANT_K);
    uint src_idx = get_aoffset() + src0_idx(idx);

    quantize(dst_idx, src_idx);
}

#endif
