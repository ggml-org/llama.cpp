#version 450

#include "types.glsl"

#if defined(SET_ROWS) && QUANT_K == 1
layout(local_size_x = 512, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 512;
#else
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
const uint BLOCK_SIZE = 32;
#endif

layout (binding = 0) readonly buffer S {S_TYPE data_s[];};

#if defined(SET_ROWS)
#include "generic_binary_head.glsl"
layout (binding = 1) readonly buffer C {B_TYPE data_i[];};
layout (binding = 2) writeonly buffer Q {A_TYPE data_q[];};

#if B_SIZE == 64
#define DATA_I_SWIZZLE .x
#else
#define DATA_I_SWIZZLE
#endif

#else
#include "generic_unary_head.glsl"
layout (binding = 1) writeonly buffer Q {A_TYPE data_q[];};
#endif

#if defined(DATA_A_Q4_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_0; ++j) {
        const float v = float(data_s[src_idx + j]);
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    const float d  = vmax / -8;
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_0/2; ++j) {
        const float x0 = float(data_s[src_idx + 0              + j])*id;
        const float x1 = float(data_s[src_idx + QUANT_K_Q4_0/2 + j])*id;

        const uint xi0 = min(15, int(x0 + 8.5));
        const uint xi1 = min(15, int(x1 + 8.5));

        data_q[dst_idx].qs[j]  = uint8_t(xi0 | (xi1 << 4));
    }
}
#endif

#if defined(DATA_A_Q4_1)
void quantize(uint dst_idx, uint src_idx)
{
    float vmin = 1.0/0.0;
    float vmax = -vmin;

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_1; ++j) {
        const float v = float(data_s[src_idx + j]);

        if (v < vmin) vmin = v;
        if (v > vmax) vmax = v;
    }

    const float d  = (vmax - vmin) / ((1 << 4) - 1);
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);
    data_q[dst_idx].m = float16_t(vmin);

    [[unroll]] for (int j = 0; j < QUANT_K_Q4_1/2; ++j) {
        const float x0 = (float(data_s[src_idx + 0              + j]) - vmin)*id;
        const float x1 = (float(data_s[src_idx + QUANT_K_Q4_1/2 + j]) - vmin)*id;

        const uint xi0 = min(15, int(x0 + 0.5));
        const uint xi1 = min(15, int(x1 + 0.5));

        data_q[dst_idx].qs[j]  = uint8_t(xi0 | (xi1 << 4));
    }
}
#endif

#if defined(DATA_A_Q5_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_Q5_0; ++j) {
        const float v = float(data_s[src_idx + j]);
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    const float d  = vmax / -16;
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);

    uint32_t qh = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_Q5_0/2; ++j) {
        const float x0 = float(data_s[src_idx + 0              + j])*id;
        const float x1 = float(data_s[src_idx + QUANT_K_Q5_0/2 + j])*id;

        const uint xi0 = min(31, int(x0 + 16.5));
        const uint xi1 = min(31, int(x1 + 16.5));

        data_q[dst_idx].qs[j]  = uint8_t((xi0 & 0xf) | ((xi1 & 0xf) << 4));
        qh |= ((xi0 & 0x10u) >> 4) << (j + 0);
        qh |= ((xi1 & 0x10u) >> 4) << (j + QUANT_K_Q5_0/2);
    }
    data_q[dst_idx].qh[0] = uint16_t(qh & 0xFFFF);
    data_q[dst_idx].qh[1] = uint16_t(qh >> 16);
}
#endif

#if defined(DATA_A_Q5_1)
void quantize(uint dst_idx, uint src_idx)
{
    float min = float(data_s[src_idx + 0]);
    float max = min;

    [[unroll]] for (int j = 1; j < QUANT_K_Q5_1; ++j) {
        const float v = float(data_s[src_idx + j]);
        min = v < min ? v : min;
        max = v > max ? v : max;
    }

    const float d  = (max - min) / 31;
    const float id = (d != 0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);
    data_q[dst_idx].m = float16_t(min);

    uint32_t qh = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_Q5_1/2; ++j) {
        const float x0 = (float(data_s[src_idx + 0              + j]) - min)*id;
        const float x1 = (float(data_s[src_idx + QUANT_K_Q5_1/2 + j]) - min)*id;

        const uint xi0 = uint(x0 + 0.5);
        const uint xi1 = uint(x1 + 0.5);

        data_q[dst_idx].qs[j]  = uint8_t((xi0 & 0xf) | ((xi1 & 0xf) << 4));
        qh |= ((xi0 & 0x10u) >> 4) << (j + 0);
        qh |= ((xi1 & 0x10u) >> 4) << (j + QUANT_K_Q5_1/2);
    }
    data_q[dst_idx].qh = qh;
}
#endif

#if defined(DATA_A_Q8_0)
void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0; // absolute max

    [[unroll]] for (int j = 0; j < QUANT_K_Q8_0; j++) {
        const float v = float(data_s[src_idx + j]);
        amax = max(amax, abs(v));
    }

    const float d = amax / ((1 << 7) - 1);
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q8_0; ++j) {
        const float x0 = float(data_s[src_idx + j])*id;

        data_q[dst_idx].qs[j] = int8_t(round(x0));
    }
}
#endif

#if defined(DATA_A_Q1_0)
void quantize(uint dst_idx, uint src_idx)
{
    float sum_abs = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_Q1_0; j++) {
        sum_abs += abs(float(data_s[src_idx + j]));
    }

    const float d = sum_abs / QUANT_K_Q1_0;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q1_0 / 8; ++j) {
        data_q[dst_idx].qs[j] = uint8_t(0);
    }

    [[unroll]] for (int j = 0; j < QUANT_K_Q1_0; ++j) {
        if (float(data_s[src_idx + j]) >= 0.0) {
            data_q[dst_idx].qs[j / 8] |= uint8_t(1 << (j % 8));
        }
    }
}
#endif

#if defined(DATA_A_Q2_0)
uint quantize_q2_0(float x)
{
    const int q = int(x >= 0.0f ? floor(x + 0.5f) : ceil(x - 0.5f)) + 1;
    return uint(clamp(q, 0, 3));
}

void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0f;

    [[unroll]] for (int j = 0; j < QUANT_K_Q2_0; ++j) {
        amax = max(amax, abs(float(data_s[src_idx + j])));
    }

    const float d = amax;
    const float id = d != 0.0f ? 1.0f / d : 0.0f;

    data_q[dst_idx].d = float16_t(d);

    [[unroll]] for (int j = 0; j < QUANT_K_Q2_0 / 4; ++j) {
        const uint q0 = quantize_q2_0(float(data_s[src_idx + 4*j    ]) * id);
        const uint q1 = quantize_q2_0(float(data_s[src_idx + 4*j + 1]) * id);
        const uint q2 = quantize_q2_0(float(data_s[src_idx + 4*j + 2]) * id);
        const uint q3 = quantize_q2_0(float(data_s[src_idx + 4*j + 3]) * id);
        data_q[dst_idx].qs[j] = uint8_t(q0 | (q1 << 2u) | (q2 << 4u) | (q3 << 6u));
    }
}
#endif

#if defined(DATA_A_IQ4_NL)
uint best_index(float x) {
    if (x <= kvalues_iq4nl[0]) return 0;
    if (x >= kvalues_iq4nl[15]) return 15;
    int ml = 0, mu = 15;
    while (mu-ml > 1) {
        int mav = (ml+mu)/2;
        if (x < kvalues_iq4nl[mav]) mu = mav; else ml = mav;
    }
    return x - kvalues_iq4nl[mu-1] < kvalues_iq4nl[mu] - x ? mu-1 : mu;
}

void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;
    float vmax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_IQ4_NL; ++j) {
        const float v = float(data_s[src_idx + j]);
        if (amax < abs(v)) {
            amax = abs(v);
            vmax = v;
        }
    }

    float d = vmax / kvalues_iq4nl[0];
    const float id = (d != 0.0) ? 1.0/d : 0.0;

    float sumqx = 0, sumq2 = 0;
    [[unroll]] for (int j = 0; j < QUANT_K_IQ4_NL/2; ++j) {
        const float x0 = float(data_s[src_idx + 0                + j])*id;
        const float x1 = float(data_s[src_idx + QUANT_K_IQ4_NL/2 + j])*id;
        const uint xi0 = best_index(x0);
        const uint xi1 = best_index(x1);
        data_q[dst_idx].qs[j] = uint8_t(xi0 | (xi1 << 4));
        const float v0 = kvalues_iq4nl[xi0];
        const float v1 = kvalues_iq4nl[xi1];
        const float w0 = float(data_s[src_idx + 0                + j])*float(data_s[src_idx + 0                + j]);
        const float w1 = float(data_s[src_idx + QUANT_K_IQ4_NL/2 + j])*float(data_s[src_idx + QUANT_K_IQ4_NL/2 + j]);
        sumqx += w0*v0*float(data_s[src_idx + j]) + w1*v1*float(data_s[src_idx + QUANT_K_IQ4_NL/2 + j]);
        sumq2 += w0*v0*v0 + w1*v1*v1;
    }

    data_q[dst_idx].d = float16_t(sumq2 > 0 ? sumqx/sumq2 : d);

}
#endif

#if defined(DATA_A_Q3_K)
void quantize(uint dst_idx, uint src_idx)
{
    float scales[16];
    int quants[256];
    float max_scale = 0.0;
    float max_scale_value = 0.0;

    for (int j = 0; j < 16; ++j) {
        float amax = 0.0;
        float vmax = 0.0;
        for (int l = 0; l < 16; ++l) {
            const float v = data_s[src_idx + 16*j + l];
            if (amax < abs(v)) {
                amax = abs(v);
                vmax = v;
            }
        }
        if (amax < 1e-15) {
            scales[j] = 0.0;
        } else {
            float iscale = -4.0/vmax;
            float sumlx = 0.0;
            float suml2 = 0.0;
            for (int l = 0; l < 16; ++l) {
                const float x = data_s[src_idx + 16*j + l];
                const int q = clamp(int(roundEven(iscale*x)), -4, 3);
                quants[16*j + l] = q;
                const float w = x*x;
                sumlx += w*x*float(q);
                suml2 += w*float(q*q);
            }
            for (int itry = 0; itry < 5; ++itry) {
                int n_changed = 0;
                for (int l = 0; l < 16; ++l) {
                    const float x = data_s[src_idx + 16*j + l];
                    const float w = x*x;
                    const int q = quants[16*j + l];
                    float slx = sumlx - w*x*float(q);
                    if (slx > 0.0) {
                        float sl2 = suml2 - w*float(q*q);
                        const int new_q = clamp(int(roundEven(x*sl2/slx)), -4, 3);
                        if (new_q != q) {
                            slx += w*x*float(new_q);
                            sl2 += w*float(new_q*new_q);
                            if (sl2 > 0.0 && slx*slx*suml2 > sumlx*sumlx*sl2) {
                                quants[16*j + l] = new_q;
                                sumlx = slx;
                                suml2 = sl2;
                                ++n_changed;
                            }
                        }
                    }
                }
                if (n_changed == 0) {
                    break;
                }
            }
            scales[j] = suml2 > 0.0 ? sumlx/suml2 : 0.0;
        }
        if (max_scale < abs(scales[j])) {
            max_scale = abs(scales[j]);
            max_scale_value = scales[j];
        }
    }

    uint scale_bytes[12];
    for (int j = 0; j < 12; ++j) scale_bytes[j] = 0;

    float d_all = 0.0;
    if (max_scale == 0.0) {
        d_all = 0.0;
    } else {
        const float iscale = -32.0/max_scale_value;
        d_all = 1.0/iscale;
        for (int j = 0; j < 16; ++j) {
            int l = int(roundEven(iscale*scales[j]));
            l = min(31, max(-32, l)) + 32;
            if (j < 8) {
                scale_bytes[j] = uint(l & 0xF);
            } else {
                scale_bytes[j - 8] |= uint((l & 0xF) << 4);
            }
            scale_bytes[8 + j % 4] |= (uint(l) >> 4) << (2*(j/4));
        }
    }

    const float d_all_q = float(float16_t(d_all));
    for (int j = 0; j < 16; ++j) {
        const int sc = (j < 8 ? int(scale_bytes[j] & 0xF) : int(scale_bytes[j - 8] >> 4))
            | (int((scale_bytes[8 + j % 4] >> (2*(j/4))) & 3) << 4);
        const float d = d_all_q * float(sc - 32);
        for (int l = 0; l < 16; ++l) {
            int q = d == 0.0 ? 0 : int(roundEven(data_s[src_idx + 16*j + l]/d));
            quants[16*j + l] = min(3, max(-4, q)) + 4;
        }
    }

    for (int j = 0; j < 32; ++j) {
        data_q[dst_idx].hmask[j] = uint8_t(0);
    }
    for (int j = 0; j < 256; ++j) {
        if (quants[j] > 3) {
            data_q[dst_idx].hmask[j % 32] |= uint8_t(1 << (j / 32));
            quants[j] -= 4;
        }
    }
    for (int j = 0; j < 256; j += 128) {
        for (int l = 0; l < 32; ++l) {
            data_q[dst_idx].qs[j/4 + l] = uint8_t(quants[j + l] | (quants[j + l + 32] << 2) | (quants[j + l + 64] << 4) | (quants[j + l + 96] << 6));
        }
    }
    data_q[dst_idx].d = float16_t(d_all_q);
    for (int j = 0; j < 12; ++j) data_q[dst_idx].scales[j] = uint8_t(scale_bytes[j]);
}
#endif

#if defined(DATA_A_Q4_K)
void quantize(uint dst_idx, uint src_idx)
{
    float scales[8];
    float mins[8];
    float weights[32];
    int quants[256];
    int aux[32];
    float max_scale = 0.0;
    float max_min = 0.0;

    for (int j = 0; j < 8; ++j) {
        float vmin = data_s[src_idx + 32*j];
        float vmax = vmin;
        float sum_x2 = vmin*vmin;
        for (int l = 1; l < 32; ++l) {
            const float v = data_s[src_idx + 32*j + l];
            vmin = min(vmin, v);
            vmax = max(vmax, v);
            sum_x2 += v*v;
        }
        const float av_x = sqrt(sum_x2/32.0);
        float sum_w = 0.0;
        float sum_x = 0.0;
        for (int l = 0; l < 32; ++l) {
            const float x = data_s[src_idx + 32*j + l];
            weights[l] = av_x + abs(x);
            sum_w += weights[l];
            sum_x += weights[l]*x;
        }

        float group_min = min(vmin, 0.0);
        float group_scale = 0.0;
        if (vmax != group_min) {
            float iscale = 15.0/(vmax - group_min);
            group_scale = 1.0/iscale;
            float best_error = 0.0;
            for (int l = 0; l < 32; ++l) {
                const float x = data_s[src_idx + 32*j + l];
                const int q = clamp(int(roundEven(iscale*(x - group_min))), 0, 15);
                quants[32*j + l] = q;
                const float diff = group_scale*float(q) + group_min - x;
                best_error += weights[l]*diff*diff;
            }
            for (int step = 0; step <= 20; ++step) {
                iscale = (14.0 + 0.1*float(step))/(vmax - group_min);
                float sum_l = 0.0;
                float sum_l2 = 0.0;
                float sum_xl = 0.0;
                for (int l = 0; l < 32; ++l) {
                    const float x = data_s[src_idx + 32*j + l];
                    const int q = clamp(int(roundEven(iscale*(x - group_min))), 0, 15);
                    aux[l] = q;
                    const float w = weights[l];
                    sum_l += w*float(q);
                    sum_l2 += w*float(q*q);
                    sum_xl += w*float(q)*x;
                }
                const float determinant = sum_w*sum_l2 - sum_l*sum_l;
                if (determinant > 0.0) {
                    float trial_scale = (sum_w*sum_xl - sum_x*sum_l)/determinant;
                    float trial_min = (sum_l2*sum_x - sum_l*sum_xl)/determinant;
                    if (trial_min > 0.0) {
                        trial_min = 0.0;
                        trial_scale = sum_xl/sum_l2;
                    }
                    float error = 0.0;
                    for (int l = 0; l < 32; ++l) {
                        const float x = data_s[src_idx + 32*j + l];
                        const float diff = trial_scale*float(aux[l]) + trial_min - x;
                        error += weights[l]*diff*diff;
                    }
                    if (error < best_error) {
                        for (int l = 0; l < 32; ++l) {
                            quants[32*j + l] = aux[l];
                        }
                        best_error = error;
                        group_scale = trial_scale;
                        group_min = trial_min;
                    }
                }
            }
        } else {
            for (int l = 0; l < 32; ++l) {
                quants[32*j + l] = 0;
            }
        }
        mins[j] = -group_min;
        scales[j] = group_scale;
        max_scale = max(max_scale, scales[j]);
        max_min = max(max_min, mins[j]);
    }

    uint scale_bytes[12];
    for (int j = 0; j < 12; ++j) scale_bytes[j] = 0;
    const float d_all = float(float16_t(max_scale/63.0));
    const float dmin_all = float(float16_t(max_min/63.0));

    for (int j = 0; j < 8; ++j) {
        const int ls = min(63, int(roundEven(max_scale == 0.0 ? 0.0 : 63.0*scales[j]/max_scale)));
        const int lm = min(63, int(roundEven(max_min == 0.0 ? 0.0 : 63.0*mins[j]/max_min)));
        if (j < 4) {
            scale_bytes[j] = uint(ls);
            scale_bytes[j + 4] = uint(lm);
        } else {
            scale_bytes[j + 4] = uint((ls & 0xF) | ((lm & 0xF) << 4));
            scale_bytes[j - 4] |= uint((ls >> 4) << 6);
            scale_bytes[j] |= uint((lm >> 4) << 6);
        }
    }

    for (int j = 0; j < 8; ++j) {
        const int ls = j < 4 ? int(scale_bytes[j] & 0x3F) : int((scale_bytes[j + 4] & 0xF) | ((scale_bytes[j - 4] >> 6) << 4));
        const int lm = j < 4 ? int(scale_bytes[j + 4] & 0x3F) : int((scale_bytes[j + 4] >> 4) | ((scale_bytes[j] >> 6) << 4));
        const float d = d_all*float(ls);
        const float dm = dmin_all*float(lm);
        for (int l = 0; l < 32; ++l) {
            int q = d == 0.0 ? 0 : int(roundEven((data_s[src_idx + 32*j + l] + dm)/d));
            quants[32*j + l] = min(15, max(0, q));
        }
    }

    for (int j = 0; j < 256; j += 64) {
        for (int l = 0; l < 32; ++l) {
            data_q[dst_idx].qs[j/2 + l] = uint8_t(quants[j + l] | (quants[j + l + 32] << 4));
        }
    }
    for (int j = 0; j < 12; ++j) data_q[dst_idx].scales[j] = uint8_t(scale_bytes[j]);
    data_q[dst_idx].dm = f16vec2(vec2(d_all, dmin_all));
}
#endif

#if defined(DATA_A_MXFP4)
uint best_index_mxfp4(float x, float d)
{
    uint best_index = 0;
    float best_error = abs(float(kvalues_mxfp4[0]) * 0.5 * d - x);

    for (uint i = 1; i < 16; ++i) {
        const float error = abs(float(kvalues_mxfp4[i]) * 0.5 * d - x);
        if (error < best_error) {
            best_index = i;
            best_error = error;
        }
    }

    return best_index;
}

void quantize(uint dst_idx, uint src_idx)
{
    float amax = 0.0;

    [[unroll]] for (int j = 0; j < QUANT_K_MXFP4; ++j) {
        amax = max(amax, abs(float(data_s[src_idx + j])));
    }

    const int exponent = amax > 0.0 ? int(floor(log2(amax))) - 2 + 127 : 0;
    const uint8_t e = uint8_t(clamp(exponent, 0, 255));
    const float d = e8m0_to_fp32(e);

    data_q[dst_idx].e = e;

    [[unroll]] for (int j = 0; j < QUANT_K_MXFP4/2; ++j) {
        const uint q0 = best_index_mxfp4(float(data_s[src_idx + j]), d);
        const uint q1 = best_index_mxfp4(float(data_s[src_idx + QUANT_K_MXFP4/2 + j]), d);
        data_q[dst_idx].qs[j] = uint8_t(q0 | (q1 << 4));
    }
}
#endif

#if defined(DATA_A_F32) || defined(DATA_A_F16)
void quantize(uint dst_idx, uint src_idx)
{
    data_q[dst_idx] = A_TYPE(float(data_s[src_idx]));
}
#endif

#if defined(DATA_A_BF16)
void quantize(uint dst_idx, uint src_idx)
{
    data_q[dst_idx] = A_TYPE(fp32_to_bf16(float(data_s[src_idx])));
}
#endif

