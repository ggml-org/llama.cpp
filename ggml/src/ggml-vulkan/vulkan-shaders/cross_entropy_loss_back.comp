#version 450

layout(local_size_x = 256, local_size_y = 1, local_size_z = 1) in;

layout(push_constant) uniform parameter {
    uint nclasses;
    uint nrows;
} p;

layout(binding = 0) readonly  buffer GRAD   { float grad[]; };
layout(binding = 1) readonly  buffer LOGITS { float logits[]; };
layout(binding = 2) readonly  buffer LABELS { float labels[]; };
layout(binding = 3) writeonly buffer DST    { float dst[]; };

shared float reduction[256];

void main() {
    const uint lid = gl_LocalInvocationID.x;
    const uint row = gl_WorkGroupID.y;
    const uint base = row*p.nclasses;

    float labels_sum = 0.0;
    for (uint col = lid; col < p.nclasses; col += 256) {
        labels_sum += labels[base + col];
    }
    reduction[lid] = labels_sum;
    barrier();
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (lid < stride) {
            reduction[lid] += reduction[lid + stride];
        }
        barrier();
    }
    labels_sum = reduction[0];
    if (labels_sum == 0.0) {
        for (uint col = lid; col < p.nclasses; col += 256) {
            dst[base + col] = 0.0;
        }
        return;
    }

    float max_logit = -1.0/0.0;
    for (uint col = lid; col < p.nclasses; col += 256) {
        max_logit = max(max_logit, logits[base + col]);
    }
    reduction[lid] = max_logit;
    barrier();
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (lid < stride) {
            reduction[lid] = max(reduction[lid], reduction[lid + stride]);
        }
        barrier();
    }
    max_logit = reduction[0];

    float sum_exp = 0.0;
    for (uint col = lid; col < p.nclasses; col += 256) {
        sum_exp += exp(logits[base + col] - max_logit);
    }
    reduction[lid] = sum_exp;
    barrier();
    for (uint stride = 128; stride > 0; stride >>= 1) {
        if (lid < stride) {
            reduction[lid] += reduction[lid + stride];
        }
        barrier();
    }

    const float inv_sum = 1.0/reduction[0];
    const float scale = grad[0]/float(p.nrows);
    for (uint col = lid; col < p.nclasses; col += 256) {
        const float prob = exp(logits[base + col] - max_logit)*inv_sum;
        dst[base + col] = (prob*labels_sum - labels[base + col])*scale;
    }
}
