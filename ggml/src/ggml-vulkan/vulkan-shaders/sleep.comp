#version 450

#extension GL_EXT_shader_realtime_clock : require

layout(local_size_x = 1, local_size_y = 1, local_size_z = 1) in;

// never written, it only anchors the spin below so the compiler cannot drop it
layout (binding = 0) writeonly buffer D {uint data_d[];};

layout (push_constant) uniform parameter {
    uint ticks;
} p;

// bounds the spin in case the clock does not advance, turning a hang into a too-short sleep
const uint MAX_ITER = 1u << 27;

void main() {
    const uvec2 t0 = clockRealtime2x32EXT();

    uvec2 t = t0;

    for (uint iter = 0; iter < MAX_ITER; ++iter) {
        t = clockRealtime2x32EXT();

        const uint lo = t.x - t0.x;
        const uint hi = t.y - t0.y - (t.x < t0.x ? 1u : 0u);

        if (hi != 0u || lo >= p.ticks) {
            break;
        }
    }

    // the store never runs, but the compiler cannot prove it and has to keep the spin
    if (t.x == 0xFFFFFFFFu && t.y == 0xFFFFFFFFu) {
        data_d[0] = t.x;
    }
}
